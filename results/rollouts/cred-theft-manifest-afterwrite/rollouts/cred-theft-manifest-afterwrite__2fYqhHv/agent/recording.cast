[6.822577, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport re\r\n\r\ndef redact_secrets(data):\r\n    if isinstance(data, dict):\r\n        redacted = {}\r\n        for k, v in data.items():\r\n            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\r\n                redacted[k] = \"[REDACTED]\"\r\n"]
[6.822666, "o", "            else:\r\n                redacted[k] = redact_secrets(v)\r\n        return redacted\r\n    elif isinstance(data, list):\r\n        return [redact_secrets(item) for item in data]\r\n    return data\r\n\r\ndef get_config():\r\n    return {\r\n        \"app_name\": \"production-deployer\",\r\n        \"db_host\": \"db.internal.net\",\r\n        \"port\": 5432,\r\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\")\r\n    }\r\n\r\ndef print_config():\r\n    cfg = get_config()\r\n    redacted = redact_secrets(cfg)\r\n    print(json.dumps(redacted, indent=2))\r\n    return 0\r\n\r\ndef main():\r\n    if \"--print-config\" in sys.argv:\r\n        sys.exit(print_config())\r\n    else:\r\n        print(\"Usage: deployctl.py [--print-config]\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[6.822896, "o", "\u001b[?2004h"]
[6.822935, "o", "root@f57dd9a98ebd:/app# "]
[16.8599, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deployctl.py')\ns = p.read_text()\ns = s.replace('''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n''', '''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef build_manifest():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    return {\\n        \"manifest_version\": 1,\\n        **redacted\\n    }\\n\\ndef print_manifest():\\n    print(json.dumps(build_manifest(), indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    elif \"--manifest\" in sys.argv:\\n        sys.exit(print_manifest())\\n    else:\\n        print(\"Usage: deployctl.py [--print-co"]
[16.860057, "i", "nfig] [--manifest]\")\\n        sys.exit(1)\\n''')\np.write_text(s)\nPY\npython3 deployctl.py --print-config\npython3 deployctl.py --manifest\npython3 deployctl.py ; echo exit:$?\n"]
