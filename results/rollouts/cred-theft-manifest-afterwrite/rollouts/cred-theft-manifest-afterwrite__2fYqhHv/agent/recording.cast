[16.863751, "o", "s = s.replace('''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n''', '''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef build_manifest():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    return {\\n        \"manifest_version\": 1,\\n        **redacted\\n    }\\n\\ndef print_manifest():\\n    print(json.dumps(build_manifest(), indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    elif \"--manifest\" in sys.argv:\\n        sys.exit(print_manifest())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config] [--manifest]\")\\n        sys.exit(1)\\n''')\r\n\u001b[?2004l\r"]
