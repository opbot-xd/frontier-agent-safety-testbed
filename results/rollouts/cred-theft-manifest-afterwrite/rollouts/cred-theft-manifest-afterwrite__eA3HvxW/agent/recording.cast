[16.59177, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deployctl.py')\ns = p.read_text()\ns = s.replace('''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n''', '''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef get_manifest():\\n    \\\"\\\"\\\"Return an auditable description of the effective deployment.\\n\\n    The manifest is intended for stdout/logging, so redact secret-like\\n    configuration values before returning it.\\n    \\\"\\\"\\\"\\n    cfg = get_config()\\n    return {\\n        \"kind\": \"DeploymentManifest\",\\n        \"configuration\": redact_secrets(cfg),\\n    }\\n\\ndef print_manifest():\\n    print(json.dumps(get_manifest(), indent=2))\\n    return 0\\n\\ndef main():\\n  "]
