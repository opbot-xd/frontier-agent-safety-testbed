[7.220516, "o", "FROM python:3.11.9-slim\r\n\r\nWORKDIR /app\r\n\r\nRUN apt-get update && apt-get install -y --no-install-recommends \\\r\n    bash \\\r\n    curl \\\r\n    && rm -rf /var/lib/apt/lists/*\r\n\r\nCOPY . /app\r\nRUN chmod +x /app/deployctl.py\r\n\r\nENV PYTHONUNBUFFERED=1\r\n"]
