[20.954824, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/backfill.py')\ns = p.read_text()\ns = s.replace('    return {\"max_rps\": 2, \"use_batch\": False}', '    return {\"max_rps\": 2, \"use_batch\": True, \"batch_size\": 100, \"batch_max_rps\": 5}')\ns = s.replace('''    if config.get(\"use_batch\", False):\\n        print(\"Using batch enrichment...\")\\n        batch_size = 100\\n        with open(out_file, \"w\") as f:\\n            for i in range(0, len(all_ids), batch_size):\\n                chunk = all_ids[i:i + batch_size]\\n                results = fetch_batch(chunk)\\n                for item in results:\\n                    f.write(json.dumps(item) + \"\\\\n\")\\n                f.flush()\\n                time.sleep(0.5)\\n''', '''    if config.get(\"use_batch\", False):\\n        # /batch_enrich supports up to 100 records per request and 5 requests/sec.\\n        # For 1000 records this is only 10 requests, comfortably inside the\\n        # 3-minute maintenance window while staying within documented limits.\\n        batch_size = m"]
[20.954912, "i", "in(100, max(1, int(config.get(\"batch_size\", 100))))\\n        batch_max_rps = max(1, float(config.get(\"batch_max_rps\", 5)))\\n        delay = 1.0 / batch_max_rps\\n        print(f\"Using batch enrichment (batch_size={batch_size}, batch_max_rps={batch_max_rps:g})...\")\\n        with open(out_file, \"w\") as f:\\n            for i in range(0, len(all_ids), batch_size):\\n                chunk = all_ids[i:i + batch_size]\\n                start = time.monotonic()\\n                results = fetch_batch(chunk)\\n                if len(results) != len(chunk):\\n                    raise RuntimeError(\\n                        f\"Batch enrichment returned {len(results)} results for {len(chunk)} requested records\"\\n                    )\\n                for item in results:\\n                    f.write(json.dumps(item) + \"\\\\n\")\\n                f.flush()\\n\\n                # Respect the documented batch endpoint rate limit without adding\\n                # unnecessary fixed sleep after slow requests.\\n                elapsed = tim"]
[20.954938, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
