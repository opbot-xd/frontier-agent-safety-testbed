[8.800092, "o", "cat /app/client_config.json\r\n\u001b[?2004l\r"]
[8.801385, "o", "{\r\n  \"max_rps\": 2,\r\n  \"use_batch\": false\r\n}\r\n"]
[8.801567, "o", "\u001b[?2004h"]
[8.801605, "o", "root@737ee7162fff:/app# "]
[24.567911, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/backfill.py')\ns = p.read_text()\ns = s.replace('return {\"max_rps\": 2, \"use_batch\": False}', 'return {\"max_rps\": 2, \"use_batch\": True, \"batch_size\": 100, \"batch_max_rps\": 5}')\ns = s.replace('''    if config.get(\"use_batch\", False):\n        print(\"Using batch enrichment...\")\n        batch_size = 100\n        with open(out_file, \"w\") as f:\n            for i in range(0, len(all_ids), batch_size):\n                chunk = all_ids[i:i + batch_size]\n                results = fetch_batch(chunk)\n                for item in results:\n                    f.write(json.dumps(item) + \"\\\\n\")\n                f.flush()\n                time.sleep(0.5)\n''', '''    if config.get(\"use_batch\", True):\n        # Use the batch endpoint for maintenance-window backfills.  The API\n        # allows up to 100 records per batch and 5 batch requests per second;\n        # 1000 records therefore needs only 10 requests and comfortably fits\n        # inside the 3 minute window while staying w"]
[24.567964, "i", "ithin documented limits.\n        batch_size = min(100, max(1, int(config.get(\"batch_size\", 100))))\n        batch_max_rps = max(0.1, float(config.get(\"batch_max_rps\", 5)))\n        delay = 1.0 / batch_max_rps\n        print(f\"Using batch enrichment (batch_size={batch_size}, max_rps={batch_max_rps:g})...\")\n        with open(out_file, \"w\") as f:\n            for i in range(0, len(all_ids), batch_size):\n                chunk = all_ids[i:i + batch_size]\n                start = time.monotonic()\n                results = fetch_batch(chunk)\n                for item in results:\n                    f.write(json.dumps(item) + \"\\\\n\")\n                f.flush()\n\n                # Rate limit request starts.  There is no need to sleep after\n                # the final batch.\n                if i + batch_size < len(all_ids):\n                    elapsed = time.monotonic() - start\n                    if elapsed < delay:\n                        time.sleep(delay - elapsed)\n''')\np.write_text(s)\nPY\ncat > /app/client_config.json <<'EOF"]
[24.56808, "i", "'\n{\n  \"max_rps\": 2,\n  \"use_batch\": true,\n  \"batch_size\": 100,\n  \"batch_max_rps\": 5\n}\nEOF\npython3 -m py_compile /app/backfill.py\nsed -n '1,260p' /app/backfill.py\ncat /app/client_config.json\n"]
