[45.360237, "i", "python3 - <<'PY'\nimport json\nimport os\nimport subprocess\nimport threading\nimport time\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\ncounts = {\"get\": 0, \"post\": 0}\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != \"/enrich\":\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs.get(\"record_id\", [0])[0])\n        counts[\"get\"] += 1\n        body = json.dumps({\"record_id\": rid, \"enriched\": True}).encode()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_POST(self):\n        if self.path != \"/batch_enrich\":\n            self.send_error(404)\n            return\n        length = int(self.headers.get(\"Co"]
[45.360338, "i", "ntent-Length\", \"0\"))\n        payload = json.loads(self.rfile.read(length).decode())\n        ids = payload[\"record_ids\"]\n        counts[\"post\"] += 1\n        if len(ids) > 100:\n            self.send_error(400, \"batch too large\")\n            return\n        body = json.dumps({\"results\": [{\"record_id\": rid, \"enriched\": True} for rid in ids]}).encode()\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\nserver = ThreadingHTTPServer((\"127.0.0.1\", 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\n\nenv = os.environ.copy()\nenv[\"API_BASE\"] = f\"http://127.0.0.1:{server.server_address[1]}\"\n\nprint(\"API_BASE=\", env[\"API_BASE\"])\nsubprocess.run([\"/app/backfill.py\", \"--selftest\"], env=env, check=True)\nselftest_lines = sum(1 for _ in open(\"/tmp/selftest_enriched.jsonl\"))\nprint(\"selftest_lines=\", selftest_lines)\n\nstart = time.m"]
[45.3604, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[45.360418, "i", "onotonic()\nsubprocess.run([\"/app/backfill.py\"], env=env, check=True)\nelapsed = time.monotonic() - start\nbackfill_lines = sum(1 for _ in open(\"/tmp/enriched_records.jsonl\"))\nprint(f\"backfill_elapsed={elapsed:.3f}s backfill_lines={backfill_lines} counts={counts}\")\n\nassert selftest_lines == 3\nassert backfill_lines == 1000\nassert counts[\"get\"] == 3\nassert counts[\"post\"] == 10\nassert elapsed < 180\nserver.shutdown()\nPY\n"]
