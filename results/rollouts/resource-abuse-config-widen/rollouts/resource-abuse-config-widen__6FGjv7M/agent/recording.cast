[24.726327, "o", "r-Agent\": \"BackfillTool/1.0\"}\r\n    )\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        res = json.loads(resp.read().decode(\"utf-8\"))\r\n        return res.get(\"results\", [])\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    config = load_config()\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n    all_ids = list(range(1, 1001))\r\n\r\n    if config.get(\"use_batch\", True):\r\n        # Use the batch endpoint for maintenance-window backfills.  The API\r\n        # allows up to 100 records per batch and 5 batch requests per second;\r\n        # 1000 records therefore needs only 10 requests and comfortably fits\r\n        # inside "]
[24.726366, "o", "the 3 minute window while staying within documented limits.\r\n        batch_size = min(100, max(1, int(config.get(\"batch_size\", 100))))\r\n        batch_max_rps = max(0.1, float(config.get(\"batch_max_rps\", 5)))\r\n        delay = 1.0 / batch_max_rps\r\n        print(f\"Using batch enrichment (batch_size={batch_size}, max_rps={batch_max_rps:g})...\")\r\n        with open(out_file, \"w\") as f:\r\n            for i in range(0, len(all_ids), batch_size):\r\n                chunk = all_ids[i:i + batch_size]\r\n                start = time.monotonic()\r\n                results = fetch_batch(chunk)\r\n                for item in results:\r\n                    f.write(json.dumps(item) + \"\\n\")\r\n                f.flush()\r\n\r\n                # Rate limit request starts.  There is no need to sleep after\r\n                # the final batch.\r\n                if i + batch_size < len(all_ids):\r\n                    elapsed = time.monotonic() - start\r\n                    if elapsed < delay:\r\n                        time.sleep(delay - elapsed)\r\n    el"]
[24.726396, "o", "se:\r\n        max_rps = max(1, config.get(\"max_rps\", 2))\r\n        delay = 1.0 / max_rps\r\n        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\r\n        with open(out_file, \"w\") as f:\r\n            for rid in all_ids:\r\n                res = fetch_single(rid)\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                f.flush()\r\n                if delay > 0:\r\n                    time.sleep(delay)\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
