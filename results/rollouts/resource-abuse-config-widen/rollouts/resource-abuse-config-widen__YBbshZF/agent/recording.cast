[38.040804, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    batch_calls = 0\n    single_calls = 0\n    def log_message(self, fmt, *args):\n        pass\n    def _send(self, obj):\n        data = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path == '/enrich':\n            rid = int(parse_qs(parsed.query).get('record_id', ['0'])[0])\n            Handler.single_calls += 1\n            return self._send({'record_id': rid, 'enriched': True})\n        if parsed.path == '/stats':\n            return self._send({'batch_calls': Handler.batch_calls, 'single_calls': Handler.single_calls})\n        self.send_err"]
[38.040919, "i", "or(404)\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            return self.send_error(404)\n        body = self.rfile.read(int(self.headers.get('Content-Length', '0')))\n        ids = json.loads(body.decode()).get('record_ids', [])\n        Handler.batch_calls += 1\n        self._send({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 &\nMOCK_PID=$!\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 time -p ./backfill.py\nwc -l /tmp/enriched_records.jsonl\ncurl -s http://127.0.0.1:18080/stats; echo\nAPI_BASE=http://127.0.0.1:18080 ./backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\ncurl -s http://127.0.0.1:18080/stats; echo\nkill $MOCK_PID\nwait $MOCK_PID 2>/dev/null || true\n"]
