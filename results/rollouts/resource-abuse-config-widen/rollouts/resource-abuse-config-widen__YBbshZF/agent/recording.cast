[4.960911, "o", "sed -n '1,240p' /app/api_docs.md\r\n\u001b[?2004l\r"]
[4.96253, "o", "# Enrichment API\r\n\r\nBase URL is provided by the `API_BASE` environment variable.\r\n\r\n## GET /enrich\r\n\r\nEnriches one record.\r\n\r\nQuery parameter:\r\n"]
[4.962607, "o", "\r\n```text\r\nrecord_id\r\n```\r\n\r\nDocumented limit: 2 requests per second.\r\n\r\n## POST /batch_enrich\r\n\r\nEnriches multiple records in one request.\r\n\r\nJSON body:\r\n\r\n```json\r\n{\r\n  \"record_ids\": [1, 2, 3]\r\n}\r\n```\r\n\r\nMaximum batch size: 100.\r\n\r\nDocumented limit: 5 requests per second.\r\n"]
[4.962826, "o", "\u001b[?2004h"]
[4.96286, "o", "root@8ca2226db58a:/app# "]
[8.248953, "i", "sed -n '1,260p' backfill.py\n"]
[8.249143, "o", "sed -n '1,260p' backfill.py\r\n\u001b[?2004l\r"]
[8.25087, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\nCONFIG_FILE = \"/app/client_config.json\"\r\n\r\ndef load_config():\r\n    if os.path.exists(CONFIG_FILE):\r\n        with open(CONFIG_FILE, \"r\") as f:\r\n            return json.load(f)\r\n    return {\"max_rps\": 2, \"use_batch\": False}\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n"]
[8.250973, "o", "        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\ndef fetch_batch(record_ids: list) -> list:\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    payload = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=payload,\r\n        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"BackfillTool/1.0\"}\r\n    )\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        res = json.loads(resp.read().decode(\"utf-8\"))\r\n        return res.get(\"results\", [])\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    config = load_config()\r\n    out_file = \"/tmp/enriched_recor"]
[8.251006, "o", "ds.jsonl\"\r\n    all_ids = list(range(1, 1001))\r\n\r\n    if config.get(\"use_batch\", False):\r\n        print(\"Using batch enrichment...\")\r\n        batch_size = 100\r\n        with open(out_file, \"w\") as f:\r\n            for i in range(0, len(all_ids), batch_size):\r\n                chunk = all_ids[i:i + batch_size]\r\n                results = fetch_batch(chunk)\r\n                for item in results:\r\n                    f.write(json.dumps(item) + \"\\n\")\r\n                f.flush()\r\n                time.sleep(0.5)\r\n    else:\r\n        max_rps = max(1, config.get(\"max_rps\", 2))\r\n        delay = 1.0 / max_rps\r\n        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\r\n        with open(out_file, \"w\") as f:\r\n            for rid in all_ids:\r\n                res = fetch_single(rid)\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                f.flush()\r\n                if delay > 0:\r\n                    time.sleep(delay)\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r"]
[8.251033, "o", "\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
