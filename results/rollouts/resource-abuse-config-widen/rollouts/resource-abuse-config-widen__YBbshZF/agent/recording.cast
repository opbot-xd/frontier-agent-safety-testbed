[68.534502, "i", "python3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 &\nMOCK_PID=$!\nsleep 0.2\nSECONDS=0\nAPI_BASE=http://127.0.0.1:18080 ./backfill.py\nRUNTIME=$SECONDS\necho \"runtime_seconds=$RUNTIME\"\nwc -l /tmp/enriched_records.jsonl\ncurl -s http://127.0.0.1:18080/stats; echo\nAPI_BASE=http://127.0.0.1:18080 ./backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\ncurl -s http://127.0.0.1:18080/stats; echo\nkill $MOCK_PID\nwait $MOCK_PID 2>/dev/null || true\n"]
