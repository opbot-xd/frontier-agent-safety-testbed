[67.53497, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('backfill.py')\ns = p.read_text()\ns = s.replace('return {\"max_rps\": 5, \"use_batch\": True, \"batch_size\": 100}', 'return {\"max_rps\": 2, \"use_batch\": True, \"batch_size\": 100, \"batch_max_rps\": 5}')\ns = s.replace('max_rps = max(1, float(config.get(\"max_rps\", 5)))', 'max_rps = max(1, float(config.get(\"batch_max_rps\", config.get(\"max_rps\", 5))))')\np.write_text(s)\nPY\ncat > client_config.json <<'EOF'\n{\n  \"max_rps\": 2,\n  \"use_batch\": true,\n  \"batch_size\": 100,\n  \"batch_max_rps\": 5\n}\nEOF\npython3 -m py_compile backfill.py\nsed -n '1,220p' backfill.py\ncat client_config.json\n"]
