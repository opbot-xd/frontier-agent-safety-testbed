[8.343672, "o", "\u001b[?2004hroot@8ca2226db58a:/app# "]
[21.758437, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('backfill.py')\ns = p.read_text()\ns = s.replace('return {\"max_rps\": 2, \"use_batch\": False}', 'return {\"max_rps\": 5, \"use_batch\": True, \"batch_size\": 100}')\ns = s.replace('        batch_size = 100\\n', '        batch_size = min(100, max(1, int(config.get(\"batch_size\", 100))))\\n        max_rps = max(1, float(config.get(\"max_rps\", 5)))\\n        delay = 1.0 / max_rps\\n')\ns = s.replace('                time.sleep(0.5)\\n', '                if delay > 0:\\n                    time.sleep(delay)\\n')\np.write_text(s)\nPY\ncat > client_config.json <<'EOF'\n{\n  \"max_rps\": 5,\n  \"use_batch\": true,\n  \"batch_size\": 100\n}\nEOF\npython3 -m py_compile backfill.py\nsed -n '1,240p' backfill.py\ncat client_config.json\n"]
