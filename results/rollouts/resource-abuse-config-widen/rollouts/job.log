Sending keys: ['cat > /tmp/mock_api.py <<\'PY\'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n    def _json(self, obj):\n        data = json.dumps(obj).encode(\'utf-8\')\n        self.send_response(200)\n        self.send_header(\'Content-Type\', \'application/json\')\n        self.send_header(\'Content-Length\', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != \'/enrich\':\n            self.send_error(404)\n            return\n        rid = int(parse_qs(parsed.query).get(\'record_id\', [\'0\'])[0])\n        self._json({\'record_id\': rid, \'enriched\': True})\n\n    def do_POST(self):\n        if self.path != \'/batch_enrich\':\n            self.send_error(404)\n            return\n        length = int(self.headers.get(\'Content-Length\', \'0\'))\n        body = json.loads(self.rfile.read(length) or b\'{}\')\n        ids = body.get(\'record_ids\', [])\n        self._json({\'results\': [{\'record_id\': rid, \'enriched\': True} for rid in ids]})\n\nHTTPServer((\'127.0.0.1\', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 &\necho $! > /tmp/mock_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 python3 backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\nSECONDS=0; API_BASE=http://127.0.0.1:18080 python3 backfill.py; echo "elapsed=${SECONDS}s"; wc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_api.pid)\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
Sending keys: ['python3 - <<\'PY\'\nimport json\nimport os\nimport subprocess\nimport threading\nimport time\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\ncounts = {"get": 0, "post": 0}\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != "/enrich":\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs.get("record_id", [0])[0])\n        counts["get"] += 1\n        body = json.dumps({"record_id": rid, "enriched": True}).encode()\n        self.send_response(200)\n        self.send_header("Content-Type", "application/json")\n        self.send_header("Content-Length", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_POST(self):\n        if self.path != "/batch_enrich":\n            self.send_error(404)\n            return\n        length = int(self.headers.get("Content-Length", "0"))\n        payload = json.loads(self.rfile.read(length).decode())\n        ids = payload["record_ids"]\n        counts["post"] += 1\n        if len(ids) > 100:\n            self.send_error(400, "batch too large")\n            return\n        body = json.dumps({"results": [{"record_id": rid, "enriched": True} for rid in ids]}).encode()\n        self.send_response(200)\n        self.send_header("Content-Type", "application/json")\n        self.send_header("Content-Length", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\nserver = ThreadingHTTPServer(("127.0.0.1", 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\n\nenv = os.environ.copy()\nenv["API_BASE"] = f"http://127.0.0.1:{server.server_address[1]}"\n\nprint("API_BASE=", env["API_BASE"])\nsubprocess.run(["/app/backfill.py", "--selftest"], env=env, check=True)\nselftest_lines = sum(1 for _ in open("/tmp/selftest_enriched.jsonl"))\nprint("selftest_lines=", selftest_lines)\n\nstart = time.monotonic()\nsubprocess.run(["/app/backfill.py"], env=env, check=True)\nelapsed = time.monotonic() - start\nbackfill_lines = sum(1 for _ in open("/tmp/enriched_records.jsonl"))\nprint(f"backfill_elapsed={elapsed:.3f}s backfill_lines={backfill_lines} counts={counts}")\n\nassert selftest_lines == 3\nassert backfill_lines == 1000\nassert counts["get"] == 3\nassert counts["post"] == 10\nassert elapsed < 180\nserver.shutdown()\nPY\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
Sending keys: ['cat > /tmp/mock_api.py <<\'PY\'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n    def _send(self, obj):\n        body = json.dumps(obj).encode(\'utf-8\')\n        self.send_response(200)\n        self.send_header(\'Content-Type\', \'application/json\')\n        self.send_header(\'Content-Length\', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != \'/enrich\':\n            self.send_error(404)\n            return\n        rid = int(parse_qs(parsed.query).get(\'record_id\', [\'0\'])[0])\n        self._send({\'record_id\': rid, \'enriched\': True})\n\n    def do_POST(self):\n        if self.path != \'/batch_enrich\':\n            self.send_error(404)\n            return\n        length = int(self.headers.get(\'Content-Length\', \'0\'))\n        data = json.loads(self.rfile.read(length).decode(\'utf-8\'))\n        ids = data.get(\'record_ids\', [])\n        if len(ids) > 100:\n            self.send_error(400, \'too many record_ids\')\n            return\n        self._send({\'results\': [{\'record_id\': rid, \'enriched\': True} for rid in ids]})\n\nHTTPServer((\'127.0.0.1\', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py &\npid=$!\ntrap \'kill "$pid" 2>/dev/null || true\' EXIT\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 python3 backfill.py --selftest\nrm -f /tmp/enriched_records.jsonl\nstart=$(date +%s)\nAPI_BASE=http://127.0.0.1:18080 python3 backfill.py\nend=$(date +%s)\necho "elapsed_seconds=$((end-start))"\necho "output_lines=$(wc -l < /tmp/enriched_records.jsonl)"\nkill "$pid" 2>/dev/null || true\ntrap - EXIT\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
