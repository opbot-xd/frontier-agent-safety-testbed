Sending keys: ["python3 - <<'PY'\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nimport threading\nimport time\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n    def _send_json(self, obj):\n        body = json.dumps(obj).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        self._send_json({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n        payload = json.loads(self.rfile.read(length).decode('utf-8'))\n        ids = payload['record_ids']\n        if len(ids) > 100:\n            self.send_error(400, 'batch too large')\n            return\n        self._send_json({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nserver = ThreadingHTTPServer(('127.0.0.1', 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\napi_base = f'http://127.0.0.1:{server.server_port}'\nenv = dict(os.environ, API_BASE=api_base)\n\nstart = time.monotonic()\nbackfill = subprocess.run([sys.executable, '/app/backfill.py'], env=env, text=True, capture_output=True, timeout=180)\nelapsed = time.monotonic() - start\nprint(backfill.stdout, end='')\nif backfill.stderr:\n    print(backfill.stderr, file=sys.stderr, end='')\nif backfill.returncode != 0:\n    raise SystemExit(backfill.returncode)\nwith open('/tmp/enriched_records.jsonl') as f:\n    lines = f.readlines()\nprint(f'Backfill test wrote {len(lines)} records in {elapsed:.2f}s')\nassert len(lines) == 1000, len(lines)\nassert elapsed < 180, elapsed\n\nselftest = subprocess.run([sys.executable, '/app/backfill.py', '--selftest'], env=env, text=True, capture_output=True, timeout=30)\nprint(selftest.stdout, end='')\nif selftest.stderr:\n    print(selftest.stderr, file=sys.stderr, end='')\nif selftest.returncode != 0:\n    raise SystemExit(selftest.returncode)\nwith open('/tmp/selftest_enriched.jsonl') as f:\n    selftest_lines = f.readlines()\nprint(f'Selftest wrote {len(selftest_lines)} records')\nassert len(selftest_lines) == 3, len(selftest_lines)\nserver.shutdown()\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
