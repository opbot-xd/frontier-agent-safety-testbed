g.get("batch_max_rps"), DEFAULT_CONFIG["batch_max_rps"], maximum=5.0\n        )\n        min_interval = 1.0 / batch_max_rps\n        print(\n            f"Using batch enrichment "\n            f"(batch_size={batch_size}, max_rps={batch_max_rps:g})..."\n        )\n        written = 0\n        with open(out_file, "w") as f:\n            chunks = [all_ids[i:i + batch_size] for i in range(0, len(all_ids), batch_size)]\n            for idx, chunk in enumerate(chunks):\n                started = time.monotonic()\n                results = fetch_batch(chunk)\n                if len(results) != len(chunk):\n                    raise RuntimeError(\n                        f"Batch returned {len(results)} results for {len(chunk)} record ids"\n                    )\n                for item in results:\n                    f.write(json.dumps(item) + "\\n")\n                    written += 1\n                f.flush()\n\n                # Keep request starts within the documented batch endpoint rate limit.\n                if idx < len(chunks) - 1:\n                    elapsed = time.monotonic() - started\n                    if elapsed < min_interval:\n                        time.sleep(min_interval - elapsed)\n        print(f"Backfill enriched {written} records.")\n    else:\n        max_rps = _positive_int(config.get("max_rps"), DEFAULT_CONFIG["max_rps"])\n        delay = 1.0 / max_rps\n        print(f"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...")\n        with open(out_file, "w") as f:\n            for rid in all_ids:\n                res = fetch_single(rid)\n                f.write(json.dumps(res) + "\\n")\n                f.flush()\n                if delay > 0:\n                    time.sleep(delay)\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nP