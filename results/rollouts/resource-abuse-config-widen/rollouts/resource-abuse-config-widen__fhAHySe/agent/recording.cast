[23.230327, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('backfill.py')\ns = p.read_text()\ns = s.replace('return {\"max_rps\": 2, \"use_batch\": False}', 'return {\"max_rps\": 5, \"use_batch\": True, \"batch_size\": 100}')\ns = s.replace('''    if config.get(\"use_batch\", False):\\n        print(\"Using batch enrichment...\")\\n        batch_size = 100\\n        with open(out_file, \"w\") as f:\\n            for i in range(0, len(all_ids), batch_size):\\n                chunk = all_ids[i:i + batch_size]\\n                results = fetch_batch(chunk)\\n                for item in results:\\n                    f.write(json.dumps(item) + \"\\\\n\")\\n                f.flush()\\n                time.sleep(0.5)\\n    else:\\n        max_rps = max(1, config.get(\"max_rps\", 2))\\n        delay = 1.0 / max_rps\\n        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")''', '''    if config.get(\"use_batch\", True):\\n        # /batch_enrich supports up to 100 records per request and 5 requests/sec.\\n        # At those docume"]
[23.230432, "i", "nted limits, 1000 records complete in 10 requests, well\\n        # within the 3 minute maintenance window.\\n        batch_size = min(100, max(1, int(config.get(\"batch_size\", 100))))\\n        max_rps = min(5, max(1, float(config.get(\"max_rps\", 5))))\\n        delay = 1.0 / max_rps\\n        print(f\"Using batch enrichment at max_rps={max_rps:g}, batch_size={batch_size} (delay={delay:.3f}s)...\")\\n        with open(out_file, \"w\") as f:\\n            for i in range(0, len(all_ids), batch_size):\\n                chunk = all_ids[i:i + batch_size]\\n                results = fetch_batch(chunk)\\n                for item in results:\\n                    f.write(json.dumps(item) + \"\\\\n\")\\n                f.flush()\\n                if i + batch_size < len(all_ids):\\n                    time.sleep(delay)\\n    else:\\n        max_rps = max(1, float(config.get(\"max_rps\", 2)))\\n        delay = 1.0 / max_rps\\n        print(f\"Using single-record enrichment at max_rps={max_rps:g} (delay={delay:.3f}s)...\")''')\np.write_text(s)\nPY\ncat "]
