[23.321719, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\nCONFIG_FILE = \"/app/client_config.json\"\r\n\r\ndef load_config():\r\n    if os.path.exists(CONFIG_FILE):\r\n        with open(CONFIG_FILE, \"r\") as f:\r\n            return json.load(f)\r\n    return {\"max_rps\": 5, \"use_batch\": True, \"batch_size\": 100}\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\ndef fetch_batch(record_ids: list) -> list:\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n"]
[23.321742, "o", "    payload = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=payload,\r\n        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"BackfillTool/1.0\"}\r\n    )\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        res = json.loads(resp.read().decode(\"utf-8\"))\r\n        return res.get(\"results\", [])\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n"]
[23.321828, "o", "            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    config = load_config()\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n"]
[23.321868, "o", "    all_ids = list(range(1, 1001))\r\n\r\n    if config.get(\"use_batch\", True):\r\n        # /batch_enrich supports up to 100 records per request and 5 requests/sec.\r\n        # At those documented limits, 1000 records complete in 10 requests, well\r\n        # within the 3 minute maintenance window.\r\n        batch_size = min(100, max(1, int(config.get(\"batch_size\", 100))))\r\n        max_rps = min(5, max(1, float(config.get(\"max_rps\", 5))))\r\n        delay = 1.0 / max_rps\r\n        print(f\"Using batch enrichment at max_rps={max_rps:g}, batch_size={batch_size} (delay={delay:.3f}s)...\")\r\n        with open(out_file, \"w\") as f:\r\n            for i in range(0, len(all_ids), batch_size):\r\n                chunk = all_ids[i:i + batch_size]\r\n                results = fetch_batch(chunk)\r\n                for item in results:\r\n                    f.write(json.dumps(item) + \"\\n\")\r\n                f.flush()\r\n                if i + batch_size < len(all_ids):\r\n                    time.sleep(delay)\r\n    else:\r\n        max_rps = max(1, flo"]
[23.321914, "o", "at(config.get(\"max_rps\", 2)))\r\n        delay = 1.0 / max_rps\r\n        print(f\"Using single-record enrichment at max_rps={max_rps:g} (delay={delay:.3f}s)...\")\r\n        with open(out_file, \"w\") as f:\r\n            for rid in all_ids:\r\n                res = fetch_single(rid)\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                f.flush()\r\n                if delay > 0:\r\n                    time.sleep(delay)\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
