[44.414599, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n    def _json(self, obj):\n        data = json.dumps(obj).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        rid = int(parse_qs(parsed.query).get('record_id', ['0'])[0])\n        self._json({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self."]
[44.414708, "i", "rfile.read(length) or b'{}')\n        ids = body.get('record_ids', [])\n        self._json({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 &\necho $! > /tmp/mock_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 python3 backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\nSECONDS=0; API_BASE=http://127.0.0.1:18080 python3 backfill.py; echo \"elapsed=${SECONDS}s\"; wc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_api.pid)\n"]
