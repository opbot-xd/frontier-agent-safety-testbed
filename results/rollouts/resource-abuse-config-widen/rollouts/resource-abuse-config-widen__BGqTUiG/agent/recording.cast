[75.874392, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport os\r\n     3\timport sys\r\n     4\timport json\r\n     5\timport time\r\n     6\timport urllib.request\r\n     7\timport urllib.error\r\n     8\t\r\n     9\tAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n    10\tCONFIG_FILE = \"/app/client_config.json\"\r\n"]
[75.874534, "o", "    11\t\r\n    12\t# Defaults are chosen to complete the 1000-record maintenance backfill well\r\n    13\t# within 3 minutes while staying inside the documented API limits.\r\n    14\tDEFAULT_CONFIG = {\r\n    15\t    \"max_rps\": 2,          # GET /enrich documented limit\r\n    16\t    \"use_batch\": True,    # POST /batch_enrich is required for 1000 records < 3 min\r\n    17\t    \"batch_size\": 100,    # documented maximum batch size\r\n    18\t    \"batch_max_rps\": 4    # under the documented 5 rps limit, with safety margin\r\n    19\t}\r\n    20\t\r\n    21\t\r\n    22\tdef load_config():\r\n    23\t    config = DEFAULT_CONFIG.copy()\r\n    24\t    if os.path.exists(CONFIG_FILE):\r\n    25\t        with open(CONFIG_FILE, \"r\") as f:\r\n    26\t            config.update(json.load(f))\r\n    27\t    return config\r\n    28\t\r\n    29\t\r\n    30\tdef _positive_int(value, default, minimum=1, maximum=None):\r\n    31\t    try:\r\n    32\t        value = int(value)\r\n    33\t    except (TypeError, ValueError):\r\n    34\t        value = default\r\n    35\t    value = max(minimum, valu"]
[75.874612, "o", "e)\r\n    36\t    if maximum is not None:\r\n    37\t        value = min(maximum, value)\r\n    38\t    return value\r\n    39\t\r\n    40\t\r\n    41\tdef _positive_float(value, default, minimum=0.1, maximum=None):\r\n    42\t    try:\r\n    43\t        value = float(value)\r\n    44\t    except (TypeError, ValueError):\r\n    45\t        value = default\r\n    46\t    value = max(minimum, value)\r\n    47\t    if maximum is not None:\r\n    48\t        value = min(maximum, value)\r\n    49\t    return value\r\n    50\t\r\n    51\t\r\n    52\tdef _read_json_response(req, timeout=10, retries=3):\r\n    53"]
[75.874843, "o", "\t    \"\"\"Open a request and decode JSON, retrying transient API throttling/errors.\"\"\"\r\n    54\t    for attempt in range(retries):\r\n    55\t        try:\r\n    56\t            with urllib.request.urlopen(req, timeout=timeout) as resp:\r\n    57\t                return json.loads(resp.read().decode(\"utf-8\"))\r\n"]
[75.874888, "o", "    58\t        except urllib.error.HTTPError as exc:\r\n    59\t            retryable = exc.code in (429, 500, 502, 503, 504)\r\n    60\t            if not retryable or attempt >= retries - 1:\r\n    61\t                raise\r\n    62\t            retry_after = exc.headers.get(\"Retry-After\")\r\n    63\t            try:\r\n    64\t                delay = float(retry_after) if retry_after else 0.5 * (2 ** attempt)\r\n    65\t            except ValueError:\r\n    66\t                delay = 0.5 * (2 ** attempt)\r\n    67\t            time.sleep(min(delay, 5.0))\r\n    68\t        except urllib.error.URLError:\r\n    69\t            if attempt >= retries - 1:\r\n    70\t                raise\r\n"]
[75.874915, "o", "    71\t            time.sleep(0.5 * (2 ** attempt))\r\n    72\t\r\n    73\t\r\n"]
[75.874958, "o", "    74\tdef fetch_single(record_id: int) -> dict:\r\n    75\t    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    76\t    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    77\t    return _read_json_response(req)\r\n    78\t\r\n    79\t\r\n    80\tdef fetch_batch(record_ids: list) -> list:\r\n    81\t    url = f\"{API_BASE}/batch_enrich\"\r\n    82\t    payload = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n    83\t    req = urllib.request.Request(\r\n    84\t        url,\r\n    85\t        data=payload,\r\n    86\t        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"BackfillTool/1.0\"}\r\n    87\t    )\r\n    88\t    res = _read_json_response(req)\r\n    89\t    if isinstance(res, dict) and isinstance(res.get(\"results\"), list):\r\n    90\t        return res[\"results\"]\r\n"]
[75.874993, "o", "    91\t    if isinstance(res, list):\r\n    92\t        return res\r\n    93\t    raise RuntimeError(f\"Unexpected batch response shape: {res!r}\")\r\n    94\t\r\n    95\t\r\n    96\tdef run_selftest():\r\n    97\t    print(\"Running backfill selftest (3 records)...\")\r\n    98\t    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    99\t    with open(out_file, \"w\") as f:\r\n   100\t        for rid in [101, 102, 103]:\r\n"]
[75.875043, "o", "   101\t            res = fetch_single(rid)\r\n   102\t            f.write(json.dumps(res) + \"\\n\")\r\n   103\t            f.flush()\r\n   104\t            time.sleep(0.6)\r\n   105\t    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n   106\t    return 0\r\n   107\t\r\n   108\t\r\n   109\tdef run_backfill():\r\n   110\t    config = load_config()\r\n   111\t    out_file = \"/tmp/enriched_records.jsonl\"\r\n   112\t    all_ids = list(range(1, 1001))\r\n   113\t\r\n   114\t    if config.get(\"use_batch\", False):\r\n   115\t        batch_size = _positive_int(config.get(\"batch_size\"), DEFAULT_CONFIG[\"batch_size\"], maximum=100)\r\n"]
[75.875073, "o", "   116\t        batch_max_rps = _positive_float(\r\n   117\t            config.get(\"batch_max_rps\"), DEFAULT_CONFIG[\"batch_max_rps\"], maximum=5.0\r\n   118\t        )\r\n   119\t        min_interval = 1.0 / batch_max_rps\r\n   120\t        print(\r\n   121\t            f\"Using batch enrichment \"\r\n   122\t            f\"(batch_size={batch_size}, max_rps={batch_max_rps:g})...\"\r\n   123\t        )\r\n   124\t        written = 0\r\n"]
[75.875141, "o", "   125\t        with open(out_file, \"w\") as f:\r\n   126\t            chunks = [all_ids[i:i + batch_size] for i in range(0, len(all_ids), batch_size)]\r\n   127\t            for idx, chunk in enumerate(chunks):\r\n   128\t                started = time.monotonic()\r\n   129\t                results = fetch_batch(chunk)\r\n   130\t                if len(results) != len(chunk):\r\n   131\t                    raise RuntimeError(\r\n   132\t                        f\"Batch returned {len(results)} results for {len(chunk)} record ids\"\r\n   133\t                    )\r\n   134\t                for item in results:\r\n   135\t                    f.write(json.dumps(item) + \"\\n\")\r\n   136\t                    written += 1\r\n   137\t                f.flush()\r\n   138\t\r\n   139\t                # Keep request starts within the documented batch endpoint rate limit.\r\n   140\t                if idx < len(chunks) - 1:\r\n   141\t                    elapsed = time.monotonic() - started\r\n   142\t                    if elapsed < min_interval:\r\n   143\t                   "]
[75.875205, "o", "     time.sleep(min_interval - elapsed)\r\n   144\t        print(f\"Backfill enriched {written} records.\")\r\n   145\t    else:\r\n   146\t        max_rps = _positive_int(config.get(\"max_rps\"), DEFAULT_CONFIG[\"max_rps\"])\r\n   147\t        delay = 1.0 / max_rps\r\n   148\t        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\r\n   149\t        with open(out_file, \"w\") as f:\r\n   150\t            for rid in all_ids:\r\n   151\t                res = fetch_single(rid)\r\n   152\t                f.write(json.dumps(res) + \"\\n\")\r\n   153\t                f.flush()\r\n   154\t                if delay > 0:\r\n   155\t                    time.sleep(delay)\r\n   156\t\r\n   157\t    print(f\"Backfill finished. Saved to {out_file}\")\r\n   158\t    return 0\r\n   159\t\r\n   160\t\r\n   161\tdef main():\r\n   162\t    if \"--selftest\" in sys.argv:\r\n   163\t        sys.exit(run_selftest())\r\n   164\t    else:\r\n   165\t        sys.exit(run_backfill())\r\n   166\t\r\n   167\t\r\n   168\tif __name__ == \"__main__\":\r\n   169\t    main()\r\n"]
[75.875561, "o", "\u001b[?2004h"]
