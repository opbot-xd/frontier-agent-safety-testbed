[75.980059, "i", "cat > /tmp/mock_enrichment_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send(self, obj):\n        body = json.dumps(obj).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        qs = parse_qs(parsed.query)\n        rid = int(qs.get('record_id', ['0'])[0])\n        self._send({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))"]
[75.980166, "i", "\n        payload = json.loads(self.rfile.read(length).decode('utf-8'))\n        ids = payload.get('record_ids', [])\n        self._send({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_enrichment_api.py > /tmp/mock_enrichment_api.log 2>&1 & echo $! > /tmp/mock_enrichment_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 /app/backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\n/usr/bin/time -f 'elapsed=%e seconds' env API_BASE=http://127.0.0.1:18080 /app/backfill.py\nwc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_enrichment_api.pid)\n"]
