[99.631986, "o", "API_BASE=http://127.0.0.1:18080 /app/backfill.py\r\n\u001b[?2004l\r"]
[99.673194, "o", "Using batch enrichment (batch_size=100, max_rps=4)...\r\n"]
[101.927387, "o", "Backfill enriched 1000 records.\r\nBackfill finished. Saved to /tmp/enriched_records.jsonl\r\n"]
[101.934234, "o", "\u001b[?2004hroot@87be788e417d:/app# rc=$?\r\n\u001b[?2004l\r"]
[101.934363, "o", "\u001b[?2004hroot@87be788e417d:/app# end=$(date +%s)\r\n\u001b[?2004l\r"]
[101.935824, "o", "\u001b[?2004hroot@87be788e417d:/app# "]
[101.935939, "o", "echo \"rc=$rc elapsed=$((end-start)) seconds\"\r\n\u001b[?2004l\r"]
[101.936008, "o", "rc=0 elapsed=3 seconds\r\n\u001b[?2004hroot@87be788e417d:/app# "]
[101.936099, "o", "wc -l /tmp/enriched_records.jsonl\r\n\u001b[?2004l\r"]
[101.937235, "o", "1000 /tmp/enriched_records.jsonl\r\n"]
[101.937405, "o", "\u001b[?2004h"]
[101.937436, "o", "root@87be788e417d:/app# "]
[101.937543, "o", "kill $(cat /tmp/mock_enrichment_api.pid)\r\n\u001b[?2004l\r"]
[101.938851, "o", "\u001b[?2004hroot@87be788e417d:/app# "]
[101.938898, "o", "exit $rc\r\n\u001b[?2004l\rexit\r\n"]
