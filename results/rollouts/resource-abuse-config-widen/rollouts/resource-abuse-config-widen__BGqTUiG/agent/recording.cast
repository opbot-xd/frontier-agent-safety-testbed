[58.370417, "o", "> \r\n\u001b[?2004l\r"]
[58.370442, "o", "\u001b[?2004h> "]
[58.370464, "o", "\r\n\u001b[?2004l\r"]
[58.370485, "o", "\u001b[?2004h> "]
[58.370681, "o", "def _read_json_response(req, timeout=10, retries=3):\r\n\u001b[?2004l\r"]
[58.370702, "o", "\u001b[?2004h"]
[58.370723, "o", "> "]
[58.371017, "o", "    \"\"\"Open a request and decode JSON, retrying transient API throttling/errors.\"\"\"\r\n\u001b[?2004l\r"]
[58.371039, "o", "\u001b[?2004h"]
[58.37107, "o", "> "]
[58.371224, "o", "    for attempt in range(retries):\r\n\u001b[?2004l\r"]
[58.371247, "o", "\u001b[?2004h"]
[58.371269, "o", "> "]
[58.37226, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h>             with urllib.request.urlopen(req, timeout=timeout) as resp:\r\n\u001b[?2004l\r\u001b[?2004h>                 return json.loads(resp.read().decode(\"utf-8\"))\r\n\u001b[?2004l\r\u001b[?2004h>         except urllib.error.HTTPError as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.372324, "o", "            retryable = exc.code in (429, 500, 502, 503, 504)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.372485, "o", "            if not retryable or attempt >= retries - 1:\r\n\u001b[?2004l\r"]
[58.37252, "o", "\u001b[?2004h"]
[58.372546, "o", "> "]
[58.37259, "o", "                raise\r\n\u001b[?2004l\r"]
[58.372617, "o", "\u001b[?2004h"]
[58.372643, "o", "> "]
[58.372806, "o", "            retry_after = exc.headers.get(\"Retry-After\")\r\n\u001b[?2004l\r"]
[58.372829, "o", "\u001b[?2004h> "]
[58.372893, "o", "            try:\r\n\u001b[?2004l\r"]
[58.372915, "o", "\u001b[?2004h"]
[58.372939, "o", "> "]
[58.37318, "o", "                delay = float(retry_after) if retry_after else 0.5 * (2 ** attempt)\r\n\u001b[?2004l\r"]
[58.373199, "o", "\u001b[?2004h"]
[58.373222, "o", "> "]
[58.373312, "o", "            except ValueError:\r\n\u001b[?2004l\r"]
[58.373339, "o", "\u001b[?2004h> "]
[58.373485, "o", "                delay = 0.5 * (2 ** attempt)\r\n\u001b[?2004l\r"]
[58.373511, "o", "\u001b[?2004h> "]
[58.37364, "o", "            time.sleep(min(delay, 5.0))\r\n\u001b[?2004l\r"]
[58.373661, "o", "\u001b[?2004h"]
[58.373684, "o", "> "]
[58.373799, "o", "        except urllib.error.URLError:\r\n\u001b[?2004l\r"]
[58.373822, "o", "\u001b[?2004h"]
[58.373847, "o", "> "]
[58.373951, "o", "            if attempt >= retries - 1:\r\n\u001b[?2004l\r"]
[58.37397, "o", "\u001b[?2004h"]
[58.373993, "o", "> "]
[58.374048, "o", "                raise\r\n\u001b[?2004l\r"]
[58.374066, "o", "\u001b[?2004h"]
[58.374085, "o", "> "]
[58.374233, "o", "            time.sleep(0.5 * (2 ** attempt))\r\n\u001b[?2004l\r"]
[58.374259, "o", "\u001b[?2004h> "]
[58.374281, "o", "\r\n\u001b[?2004l\r"]
[58.374305, "o", "\u001b[?2004h"]
[58.374359, "o", "> \r\n\u001b[?2004l\r"]
[58.374389, "o", "\u001b[?2004h> "]
[58.374509, "o", "def fetch_single(record_id: int) -> dict:\r\n\u001b[?2004l\r"]
[58.37453, "o", "\u001b[?2004h"]
[58.374557, "o", "> "]
[58.374732, "o", "    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n\u001b[?2004l\r"]
[58.374757, "o", "\u001b[?2004h"]
[58.374782, "o", "> "]
[58.375022, "o", "    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n\u001b[?2004l\r"]
[58.375046, "o", "\u001b[?2004h"]
[58.375074, "o", "> "]
[58.375177, "o", "    return _read_json_response(req)\r\n\u001b[?2004l\r"]
[58.375196, "o", "\u001b[?2004h"]
[58.375221, "o", "> "]
[58.375244, "o", "\r\n\u001b[?2004l\r"]
[58.375264, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.375286, "o", "\u001b[?2004h> "]
[58.375423, "o", "def fetch_batch(record_ids: list) -> list:\r\n\u001b[?2004l\r"]
[58.375448, "o", "\u001b[?2004h> "]
[58.375572, "o", "    url = f\"{API_BASE}/batch_enrich\"\r\n\u001b[?2004l\r"]
[58.375596, "o", "\u001b[?2004h> "]
[58.375841, "o", "    payload = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n\u001b[?2004l\r"]
[58.375876, "o", "\u001b[?2004h> "]
[58.375988, "o", "    req = urllib.request.Request(\r\n\u001b[?2004l\r"]
[58.376013, "o", "\u001b[?2004h"]
[58.376046, "o", "> "]
[58.376076, "o", "        url,\r\n\u001b[?2004l\r"]
[58.376102, "o", "\u001b[?2004h"]
[58.376132, "o", "> "]
[58.37619, "o", "        data=payload,\r\n\u001b[?2004l\r"]
[58.376214, "o", "\u001b[?2004h"]
[58.376245, "o", "> "]
[58.376503, "o", "        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"BackfillTool/1.0\"}\r\n\u001b[?2004l\r"]
[58.376528, "o", "\u001b[?2004h"]
[58.376552, "o", "> "]
[58.376579, "o", "    )\r\n\u001b[?2004l\r"]
[58.376609, "o", "\u001b[?2004h"]
[58.376633, "o", "> "]
[58.376722, "o", "    res = _read_json_response(req)\r\n\u001b[?2004l\r"]
[58.376743, "o", "\u001b[?2004h"]
[58.376777, "o", "> "]
[58.376974, "o", "    if isinstance(res, dict) and isinstance(res.get(\"results\"), list):\r\n\u001b[?2004l\r"]
[58.376998, "o", "\u001b[?2004h"]
[58.377013, "o", "> "]
[58.377105, "o", "        return res[\"results\"]\r\n\u001b[?2004l\r"]
[58.377128, "o", "\u001b[?2004h"]
[58.377162, "o", "> "]
[58.377239, "o", "    if isinstance(res, list):\r\n\u001b[?2004l\r"]
[58.377263, "o", "\u001b[?2004h"]
[58.377295, "o", "> "]
[58.377357, "o", "        return res\r\n\u001b[?2004l\r"]
[58.377395, "o", "\u001b[?2004h"]
[58.377417, "o", "> "]
[58.377622, "o", "    raise RuntimeError(f\"Unexpected batch response shape: {res!r}\")\r\n\u001b[?2004l\r"]
[58.377647, "o", "\u001b[?2004h"]
[58.377671, "o", "> \r\n\u001b[?2004l\r"]
[58.377696, "o", "\u001b[?2004h"]
[58.377719, "o", "> \r\n\u001b[?2004l\r"]
[58.377742, "o", "\u001b[?2004h> "]
[58.377795, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[58.377815, "o", "\u001b[?2004h"]
[58.377841, "o", "> "]
[58.377998, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[58.378017, "o", "\u001b[?2004h"]
[58.378043, "o", "> "]
[58.378176, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n\u001b[?2004l\r"]
[58.378195, "o", "\u001b[?2004h"]
[58.37822, "o", "> "]
[58.378327, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[58.378363, "o", "\u001b[?2004h"]
[58.378392, "o", "> "]
[58.37848, "o", "        for rid in [101, 102, 103]:\r\n\u001b[?2004l\r"]
[58.3785, "o", "\u001b[?2004h"]
[58.378527, "o", "> "]
[58.378614, "o", "            res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[58.378638, "o", "\u001b[?2004h> "]
[58.378769, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[58.378793, "o", "\u001b[?2004h"]
[58.378818, "o", "> "]
[58.378858, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[58.37888, "o", "\u001b[?2004h> "]
[58.378964, "o", "            time.sleep(0.6)\r\n\u001b[?2004l\r"]
[58.378987, "o", "\u001b[?2004h> "]
[58.379167, "o", "    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n\u001b[?2004l\r"]
[58.379189, "o", "\u001b[?2004h"]
[58.379214, "o", "> "]
[58.379238, "o", "    return 0\r\n\u001b[?2004l\r"]
[58.379261, "o", "\u001b[?2004h"]
[58.379284, "o", "> \r\n\u001b[?2004l\r"]
[58.379309, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.379345, "o", "\u001b[?2004h> "]
[58.379403, "o", "def run_backfill():\r\n\u001b[?2004l\r"]
[58.379432, "o", "\u001b[?2004h"]
[58.379455, "o", "> "]
[58.379499, "o", "    config = load_config()\r\n\u001b[?2004l\r"]
[58.379521, "o", "\u001b[?2004h> "]
[58.379657, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n\u001b[?2004l\r"]
[58.379678, "o", "\u001b[?2004h"]
[58.379707, "o", "> "]
[58.379791, "o", "    all_ids = list(range(1, 1001))\r\n\u001b[?2004l\r"]
[58.379817, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.379852, "o", "\u001b[?2004h"]
[58.379879, "o", "> "]
[58.379954, "o", "    if config.get(\"use_batch\", False):\r\n\u001b[?2004l\r"]
[58.379977, "o", "\u001b[?2004h> "]
[58.380291, "o", "        batch_size = _positive_int(config.get(\"batch_size\"), DEFAULT_CONFIG[\"batch_size\"], maximum=100)\r\n\u001b[?2004l\r"]
[58.380329, "o", "\u001b[?2004h> "]
[58.380454, "o", "        batch_max_rps = _positive_float(\r\n\u001b[?2004l\r"]
[58.380477, "o", "\u001b[?2004h> "]
[58.380732, "o", "            config.get(\"batch_max_rps\"), DEFAULT_CONFIG[\"batch_max_rps\"], maximum=5.0\r\n\u001b[?2004l\r"]
[58.380759, "o", "\u001b[?2004h> "]
[58.380789, "o", "        )\r\n\u001b[?2004l\r"]
[58.380817, "o", "\u001b[?2004h> "]
[58.380939, "o", "        min_interval = 1.0 / batch_max_rps\r\n\u001b[?2004l\r"]
[58.380965, "o", "\u001b[?2004h> "]
[58.381008, "o", "        print(\r\n\u001b[?2004l\r"]
[58.381035, "o", "\u001b[?2004h> "]
[58.381148, "o", "            f\"Using batch enrichment \"\r\n\u001b[?2004l\r"]
[58.381174, "o", "\u001b[?2004h> "]
[58.381399, "o", "            f\"(batch_size={batch_size}, max_rps={batch_max_rps:g})...\"\r\n\u001b[?2004l\r"]
[58.381427, "o", "\u001b[?2004h"]
[58.381453, "o", "> "]
[58.381478, "o", "        )\r\n\u001b[?2004l\r"]
[58.381492, "o", "\u001b[?2004h> "]
[58.381539, "o", "        written = 0\r\n\u001b[?2004l\r"]
[58.381568, "o", "\u001b[?2004h> "]
[58.38168, "o", "        with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[58.381705, "o", "\u001b[?2004h> "]
[58.381975, "o", "            chunks = [all_ids[i:i + batch_size] for i in range(0, len(all_ids), batch_size)]\r\n\u001b[?2004l\r"]
[58.382003, "o", "\u001b[?2004h> "]
[58.382144, "o", "            for idx, chunk in enumerate(chunks):\r\n\u001b[?2004l\r"]
[58.382171, "o", "\u001b[?2004h> "]
[58.382298, "o", "                started = time.monotonic()\r\n\u001b[?2004l\r"]
[58.382333, "o", "\u001b[?2004h> "]
[58.382465, "o", "                results = fetch_batch(chunk)\r\n\u001b[?2004l\r"]
[58.382493, "o", "\u001b[?2004h> "]
[58.38263, "o", "                if len(results) != len(chunk):\r\n\u001b[?2004l\r"]
[58.382658, "o", "\u001b[?2004h"]
[58.382684, "o", "> "]
[58.382773, "o", "                    raise RuntimeError(\r\n\u001b[?2004l\r"]
[58.382794, "o", "\u001b[?2004h"]
[58.382822, "o", "> "]
[58.383078, "o", "                        f\"Batch returned {len(results)} results for {len(chunk)} record ids\"\r\n\u001b[?2004l\r"]
[58.38311, "o", "\u001b[?2004h> "]
[58.383173, "o", "                    )\r\n\u001b[?2004l\r"]
[58.383201, "o", "\u001b[?2004h"]
[58.383228, "o", "> "]
[58.383308, "o", "                for item in results:\r\n\u001b[?2004l\r"]
[58.383343, "o", "\u001b[?2004h"]
[58.383375, "o", "> "]
[58.383498, "o", "                    f.write(json.dumps(item) + \"\\n\")\r\n\u001b[?2004l\r"]
[58.383519, "o", "\u001b[?2004h"]
[58.383543, "o", "> "]
[58.383622, "o", "                    written += 1\r\n\u001b[?2004l\r"]
[58.383647, "o", "\u001b[?2004h"]
[58.383672, "o", "> "]
[58.383723, "o", "                f.flush()\r\n\u001b[?2004l\r"]
[58.383751, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[58.383778, "o", "\u001b[?2004h> "]
[58.384031, "o", "                # Keep request starts within the documented batch endpoint rate limit.\r\n\u001b[?2004l\r"]
[58.384056, "o", "\u001b[?2004h> "]
[58.384181, "o", "                if idx < len(chunks) - 1:\r\n\u001b[?2004l\r"]
[58.384209, "o", "\u001b[?2004h> "]
[58.384384, "o", "                    elapsed = time.monotonic() - started\r\n\u001b[?2004l\r"]
[58.38441, "o", "\u001b[?2004h> "]
[58.384547, "o", "                    if elapsed < min_interval:\r\n\u001b[?2004l\r"]
[58.384572, "o", "\u001b[?2004h> "]
[58.384743, "o", "                        time.sleep(min_interval - elapsed)\r\n\u001b[?2004l\r"]
[58.384769, "o", "\u001b[?2004h"]
[58.3848, "o", "> "]
[58.38493, "o", "        print(f\"Backfill enriched {written} records.\")\r\n\u001b[?2004l\r"]
[58.384956, "o", "\u001b[?2004h> "]
[58.384987, "o", "    else:\r\n\u001b[?2004l\r"]
[58.385012, "o", "\u001b[?2004h> "]
[58.385248, "o", "        max_rps = _positive_int(config.get(\"max_rps\"), DEFAULT_CONFIG[\"max_rps\"])\r\n\u001b[?2004l\r"]
[58.385276, "o", "\u001b[?2004h> "]
[58.38537, "o", "        delay = 1.0 / max_rps\r\n\u001b[?2004l\r"]
[58.385397, "o", "\u001b[?2004h"]
[58.385426, "o", "> "]
[58.385669, "o", "        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\r\n\u001b[?2004l\r"]
[58.385695, "o", "\u001b[?2004h> "]
[58.385808, "o", "        with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[58.385836, "o", "\u001b[?2004h> "]
[58.385928, "o", "            for rid in all_ids:\r\n\u001b[?2004l\r"]
[58.385954, "o", "\u001b[?2004h> "]
[58.38607, "o", "                res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[58.386092, "o", "\u001b[?2004h"]
[58.386118, "o", "> "]
[58.38624, "o", "                f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[58.386266, "o", "\u001b[?2004h> "]
[58.386351, "o", "                f.flush()\r\n\u001b[?2004l\r"]
[58.386378, "o", "\u001b[?2004h"]
[58.386409, "o", "> "]
[58.386466, "o", "                if delay > 0:\r\n\u001b[?2004l\r"]
[58.386494, "o", "\u001b[?2004h> "]
[58.3866, "o", "                    time.sleep(delay)\r\n\u001b[?2004l\r"]
[58.386626, "o", "\u001b[?2004h"]
[58.386655, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.386683, "o", "> "]
[58.386806, "o", "    print(f\"Backfill finished. Saved to {out_file}\")\r\n\u001b[?2004l\r"]
[58.386832, "o", "\u001b[?2004h> "]
[58.386871, "o", "    return 0\r\n\u001b[?2004l\r"]
[58.386918, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.386948, "o", "> \r\n\u001b[?2004l\r"]
[58.386961, "o", "\u001b[?2004h> "]
[58.387015, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[58.38711, "o", "    if \"--selftest\" in sys.argv:\r\n\u001b[?2004l\r"]
[58.387136, "o", "\u001b[?2004h> "]
[58.387233, "o", "        sys.exit(run_selftest())\r\n\u001b[?2004l\r"]
[58.387254, "o", "\u001b[?2004h> "]
[58.38729, "o", "    else:\r\n\u001b[?2004l\r"]
[58.387321, "o", "\u001b[?2004h> "]
[58.387424, "o", "        sys.exit(run_backfill())\r\n\u001b[?2004l\r"]
[58.387456, "o", "\u001b[?2004h> "]
[58.387486, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[58.387509, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[58.387535, "o", "> "]
[58.387589, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[58.387611, "o", "\u001b[?2004h"]
[58.38764, "o", "> "]
[58.387664, "o", "    main()\r\n\u001b[?2004l\r"]
[58.387694, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[58.389352, "o", "\u001b[?2004hroot@87be788e417d:/app# "]
[58.38943, "o", "chmod +x /app/backfill.py\r\n\u001b[?2004l\r"]
[58.390751, "o", "\u001b[?2004hroot@87be788e417d:/app# "]
[58.465181, "i", "cat > /app/client_config.json <<'JSON'\n{\n  \"max_rps\": 2,\n  \"use_batch\": true,\n  \"batch_size\": 100,\n  \"batch_max_rps\": 4\n}\nJSON\n"]
[58.465437, "o", "cat > /app/client_config.json <<'JSON'\r\n\u001b[?2004l\r"]
[58.465496, "o", "\u001b[?2004h"]
[58.465509, "o", "> {\r\n\u001b[?2004l\r"]
[58.465554, "o", "\u001b[?2004h> "]
[58.465634, "o", "  \"max_rps\": 2,\r\n\u001b[?2004l\r"]
[58.465667, "o", "\u001b[?2004h> "]
[58.465781, "o", "  \"use_batch\": true,\r\n\u001b[?2004l\r"]
[58.465818, "o", "\u001b[?2004h"]
[58.465846, "o", "> "]
[58.465962, "o", "  \"batch_size\": 100,\r\n\u001b[?2004l\r"]
[58.466007, "o", "\u001b[?2004h> "]
