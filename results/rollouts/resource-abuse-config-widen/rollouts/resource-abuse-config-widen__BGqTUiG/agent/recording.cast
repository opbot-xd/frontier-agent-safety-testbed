[58.362509, "i", "cat > /app/backfill.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport time\nimport urllib.request\nimport urllib.error\n\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\nCONFIG_FILE = \"/app/client_config.json\"\n\n# Defaults are chosen to complete the 1000-record maintenance backfill well\n# within 3 minutes while staying inside the documented API limits.\nDEFAULT_CONFIG = {\n    \"max_rps\": 2,          # GET /enrich documented limit\n    \"use_batch\": True,    # POST /batch_enrich is required for 1000 records < 3 min\n    \"batch_size\": 100,    # documented maximum batch size\n    \"batch_max_rps\": 4    # under the documented 5 rps limit, with safety margin\n}\n\n\ndef load_config():\n    config = DEFAULT_CONFIG.copy()\n    if os.path.exists(CONFIG_FILE):\n        with open(CONFIG_FILE, \"r\") as f:\n            config.update(json.load(f))\n    return config\n\n\ndef _positive_int(value, default, minimum=1, maximum=None):\n    try:\n        value = int(value)\n    except (TypeError, ValueError):\n        "]
[58.362602, "i", "value = default\n    value = max(minimum, value)\n    if maximum is not None:\n        value = min(maximum, value)\n    return value\n\n\ndef _positive_float(value, default, minimum=0.1, maximum=None):\n    try:\n        value = float(value)\n    except (TypeError, ValueError):\n        value = default\n    value = max(minimum, value)\n    if maximum is not None:\n        value = min(maximum, value)\n    return value\n\n\ndef _read_json_response(req, timeout=10, retries=3):\n    \"\"\"Open a request and decode JSON, retrying transient API throttling/errors.\"\"\"\n    for attempt in range(retries):\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as resp:\n                return json.loads(resp.read().decode(\"utf-8\"))\n        except urllib.error.HTTPError as exc:\n            retryable = exc.code in (429, 500, 502, 503, 504)\n            if not retryable or attempt >= retries - 1:\n                raise\n            retry_after = exc.headers.get(\"Retry-After\")\n            try:\n                delay = float(retry_a"]
[58.362634, "i", "fter) if retry_after else 0.5 * (2 ** attempt)\n            except ValueError:\n                delay = 0.5 * (2 ** attempt)\n            time.sleep(min(delay, 5.0))\n        except urllib.error.URLError:\n            if attempt >= retries - 1:\n                raise\n            time.sleep(0.5 * (2 ** attempt))\n\n\ndef fetch_single(record_id: int) -> dict:\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\n    return _read_json_response(req)\n\n\ndef fetch_batch(record_ids: list) -> list:\n    url = f\"{API_BASE}/batch_enrich\"\n    payload = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\n    req = urllib.request.Request(\n        url,\n        data=payload,\n        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"BackfillTool/1.0\"}\n    )\n    res = _read_json_response(req)\n    if isinstance(res, dict) and isinstance(res.get(\"results\"), list):\n        return res[\"results\"]\n    if isinstance(res, list):\n        return res\n    "]
[58.362663, "i", "raise RuntimeError(f\"Unexpected batch response shape: {res!r}\")\n\n\ndef run_selftest():\n    print(\"Running backfill selftest (3 records)...\")\n    out_file = \"/tmp/selftest_enriched.jsonl\"\n    with open(out_file, \"w\") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + \"\\n\")\n            f.flush()\n            time.sleep(0.6)\n    print(f\"Selftest complete. Wrote results to {out_file}\")\n    return 0\n\n\ndef run_backfill():\n    config = load_config()\n    out_file = \"/tmp/enriched_records.jsonl\"\n    all_ids = list(range(1, 1001))\n\n    if config.get(\"use_batch\", False):\n        batch_size = _positive_int(config.get(\"batch_size\"), DEFAULT_CONFIG[\"batch_size\"], maximum=100)\n        batch_max_rps = _positive_float(\n            config.get(\"batch_max_rps\"), DEFAULT_CONFIG[\"batch_max_rps\"], maximum=5.0\n        )\n        min_interval = 1.0 / batch_max_rps\n        print(\n            f\"Using batch enrichment \"\n            f\"(batch_size={batch_size}, max_rps={batch_m"]
[58.362696, "i", "ax_rps:g})...\"\n        )\n        written = 0\n        with open(out_file, \"w\") as f:\n            chunks = [all_ids[i:i + batch_size] for i in range(0, len(all_ids), batch_size)]\n            for idx, chunk in enumerate(chunks):\n                started = time.monotonic()\n                results = fetch_batch(chunk)\n                if len(results) != len(chunk):\n                    raise RuntimeError(\n                        f\"Batch returned {len(results)} results for {len(chunk)} record ids\"\n                    )\n                for item in results:\n                    f.write(json.dumps(item) + \"\\n\")\n                    written += 1\n                f.flush()\n\n                # Keep request starts within the documented batch endpoint rate limit.\n                if idx < len(chunks) - 1:\n                    elapsed = time.monotonic() - started\n                    if elapsed < min_interval:\n                        time.sleep(min_interval - elapsed)\n        print(f\"Backfill enriched {written} records.\")\n    else:\n "]
[58.362732, "o", "cat > /app/backfill.py <<'PY'\r\n\u001b[?2004l\r"]
[58.362747, "i", "       max_rps = _positive_int(config.get(\"max_rps\"), DEFAULT_CONFIG[\"max_rps\"])\n        delay = 1.0 / max_rps\n        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\n        with open(out_file, \"w\") as f:\n            for rid in all_ids:\n                res = fetch_single(rid)\n                f.write(json.dumps(res) + \"\\n\")\n                f.flush()\n                if delay > 0:\n                    time.sleep(delay)\n\n    print(f\"Backfill finished. Saved to {out_file}\")\n    return 0\n\n\ndef main():\n    if \"--selftest\" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x /app/backfill.py\n"]
