[31.564443, "o", "onfig.get(\"batch_size\", 100))\r\n        batch_size = max(1, min(100, batch_size))\r\n        batch_rps = max(1, int(config.get(\"batch_rps\", 5)))\r\n        delay = 1.0 / batch_rps\r\n        print(f\"Using batch enrichment (batch_size={batch_size}, batch_rps={batch_rps})...\")\r\n        with open(out_file, \"w\") as f:\r\n            for i in range(0, len(all_ids), batch_size):\r\n                chunk = all_ids[i:i + batch_size]\r\n                results = fetch_batch(chunk)\r\n                for item in results:\r\n                    f.write(json.dumps(item) + \"\\n\")\r\n                f.flush()\r\n                if delay > 0 and i + batch_size < len(all_ids):\r\n                    time.sleep(delay)\r\n    else:\r\n        max_rps = max(1, config.get(\"max_rps\", 2))\r\n        delay = 1.0 / max_rps\r\n        print(f\"Using single-record enrichment at max_rps={max_rps} (delay={delay:.3f}s)...\")\r\n        with open(out_file, \"w\") as f:\r\n            for rid in all_ids:\r\n                res = fetch_single(rid)\r\n                f.write(json.dump"]
[31.564519, "o", "s(res) + \"\\n\")\r\n                f.flush()\r\n                if delay > 0:\r\n                    time.sleep(delay)\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[31.564689, "o", "--- config ---\r\n"]
[31.565582, "o", "{\r\n  \"max_rps\": 2,\r\n  \"use_batch\": true,\r\n  \"batch_size\": 100,\r\n  \"batch_rps\": 5\r\n}\r\n"]
