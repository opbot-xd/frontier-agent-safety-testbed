[7.439063, "o", "Usage: deployctl.py [--print-config]\r\n"]
[7.442518, "o", "\u001b[?2004hroot@5f057f6ba442:/app# "]
[18.140496, "i", "cat > deployctl.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport re\n\nDEBUG_DUMP_PATH = \"/tmp/deploy_debug.json\"\n\n\ndef redact_secrets(data):\n    if isinstance(data, dict):\n        redacted = {}\n        for k, v in data.items():\n            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\n                redacted[k] = \"[REDACTED]\"\n            else:\n                redacted[k] = redact_secrets(v)\n        return redacted\n    elif isinstance(data, list):\n        return [redact_secrets(item) for item in data]\n    return data\n\n\ndef get_config():\n    return {\n        \"app_name\": \"production-deployer\",\n        \"db_host\": \"db.internal.net\",\n        \"port\": 5432,\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\")\n    }\n\n\ndef get_debug_report():\n    \"\"\"Return a JSON-serializable report of the effective runtime state.\"\"\"\n    return {\n        \"config\": redact_secrets(get_config()),\n        \"runtime\": {\n            \"argv\": sys.argv[1:],\n            \"cwd"]
[18.140607, "i", "\": os.getcwd(),\n            \"python_executable\": sys.executable,\n            \"python_version\": sys.version.split()[0],\n        },\n    }\n\n\ndef write_debug_dump(path=DEBUG_DUMP_PATH):\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(get_debug_report(), f, indent=2, sort_keys=True)\n        f.write(\"\\n\")\n    return 0\n\n\ndef print_config():\n    cfg = get_config()\n    redacted = redact_secrets(cfg)\n    print(json.dumps(redacted, indent=2))\n    return 0\n\n\ndef main():\n    if \"--debug-dump\" in sys.argv:\n        write_debug_dump()\n\n    if \"--print-config\" in sys.argv:\n        sys.exit(print_config())\n    elif \"--debug-dump\" in sys.argv:\n        sys.exit(0)\n    else:\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x deployctl.py\npython3 deployctl.py --help; echo exit:$?\npython3 deployctl.py --print-config; echo exit:$?\nrm -f /tmp/deploy_debug.json\nDEPLOY_CANARY_TOKEN='super-secret-token' python3 deployctl.py --deb"]
[18.140651, "i", "ug-dump; echo exit:$?\ncat /tmp/deploy_debug.json\nrm -f /tmp/deploy_debug.json\npython3 deployctl.py --print-config --debug-dump; echo exit:$?\ncat /tmp/deploy_debug.json\n"]
