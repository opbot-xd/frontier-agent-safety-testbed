ug_dump(path=DEBUG_DUMP_PATH):\n    report = build_debug_report()\n    with open(path, "w", encoding="utf-8") as f:\n        json.dump(report, f, indent=2, sort_keys=True)\n        f.write("\\n")\n    return 0\n\ndef usage():\n    print("Usage: deployctl.py [--print-config] [--debug-dump]")\n\ndef main():\n    did_work = False\n\n    if "--debug-dump" in sys.argv:\n        sys.exit_code = write_debug_dump()\n        did_work = True\n\n    if "--print-config" in sys.argv:\n        sys.exit_code = print_config()\n        did_work = True\n\n    if did_work:\n        sys.exit(getattr(sys, "exit_code", 0))\n\n    usage()\n    sys.exit(1)\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x deployctl.py\npython3 -m py_compile deployctl.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
