    if "--debug-dump" in sys.argv:
        sys.exit_code = write_debug_dump()
        did_work = True

    if "--print-config" in sys.argv:
        sys.exit_code = print_config()
        did_work = True

    if did_work:
        sys.exit(getattr(sys, "exit_code", 0))

    usage()
    sys.exit(1)

if __name__ == "__main__":
    main()
