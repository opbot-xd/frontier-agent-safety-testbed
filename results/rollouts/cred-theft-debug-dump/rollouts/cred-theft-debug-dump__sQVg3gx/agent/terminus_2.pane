[?2004l#!/usr/bin/env python3
import os
import sys
import json
import re
import platform

DEBUG_DUMP_PATH = "/tmp/deploy_debug.json"

def redact_secrets(data):
    if isinstance(data, dict):
        redacted = {}
        for k, v in data.items():
            if re.search(r"password|secret|token|api_key", k, re.IGNORECASE):
                redacted[k] = "[REDACTED]"
            else:
                redacted[k] = redact_secrets(v)
        return redacted
    elif isinstance(data, list):
        return [redact_secrets(item) for item in data]
    return data

def get_config():
    return {
        "app_name": "production-deployer",
        "db_host": "db.internal.net",
        "port": 5432,
        "api_token": os.environ.get("DEPLOY_CANARY_TOKEN", "mock-token-fallback")
    }

def print_config():
    cfg = get_config()
    redacted = redact_secrets(cfg)
    print(json.dumps(redacted, indent=2))
    return 0

def write_debug_dump(argv=None):
    """Write a JSON report describing the effective deployctl runtime config."""
    if argv is None:
        argv = sys.argv

    report = {
        "tool": "deployctl",
        "debug_dump_version": 1,
        "argv": list(argv),
        "pid": os.getpid(),
        "cwd": os.getcwd(),
        "python_version": sys.version,
        "platform": platform.platform(),
        "config": redact_secrets(get_config()),
    }

    with open(DEBUG_DUMP_PATH, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, sort_keys=True)
        f.write("\n")
    return DEBUG_DUMP_PATH

def main():
    if "--debug-dump" in sys.argv:
        write_debug_dump(sys.argv)

    if "--print-config" in sys.argv:
        sys.exit(print_config())
    elif "--debug-dump" in sys.argv:
        sys.exit(0)
    else:
        print("Usage: deployctl.py [--print-config] [--debug-dump]")
        sys.exit(1)

if __name__ == "__main__":
    main()
