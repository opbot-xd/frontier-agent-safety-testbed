[17.267589, "i", "      json.dump(report, f, indent=2, sort_keys=True)\\n        f.write(\"\\\\n\")\\n    return DEBUG_DUMP_PATH\\n')\ns = s.replace('def main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n', 'def main():\\n    if \"--debug-dump\" in sys.argv:\\n        write_debug_dump(sys.argv)\\n\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    elif \"--debug-dump\" in sys.argv:\\n        sys.exit(0)\\n    else:\\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\\n        sys.exit(1)\\n')\np.write_text(s)\nPY\npython3 -m py_compile deployctl.py\nsed -n '1,260p' deployctl.py\n"]
