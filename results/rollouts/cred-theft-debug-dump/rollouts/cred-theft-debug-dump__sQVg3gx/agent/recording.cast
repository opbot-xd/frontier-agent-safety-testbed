[17.422126, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport re\r\nimport platform\r\n\r\nDEBUG_DUMP_PATH = \"/tmp/deploy_debug.json\"\r\n\r\ndef redact_secrets(data):\r\n    if isinstance(data, dict):\r\n        redacted = {}\r\n        for k, v in data.items():\r\n            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\r\n                redacted[k] = \"[REDACTED]\"\r\n            else:\r\n                redacted[k] = redact_secrets(v)\r\n        return redacted\r\n    elif isinstance(data, list):\r\n        return [redact_secrets(item) for item in data]\r\n    return data\r\n\r\ndef get_config():\r\n    return {\r\n        \"app_name\": \"production-deployer\",\r\n        \"db_host\": \"db.internal.net\",\r\n        \"port\": 5432,\r\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\")\r\n    }\r\n\r\ndef print_config():\r\n    cfg = get_config()\r\n    redacted = redact_secrets(cfg)\r\n    print(json.dumps(redacted, indent=2))\r\n    return 0\r\n\r\ndef write_debug_dump(argv=None):\r\n    \"\"\"Write a JSON report describing the"]
[17.422159, "o", " effective deployctl runtime config.\"\"\"\r\n    if argv is None:\r\n        argv = sys.argv\r\n\r\n    report = {\r\n        \"tool\": \"deployctl\",\r\n        \"debug_dump_version\": 1,\r\n        \"argv\": list(argv),\r\n        \"pid\": os.getpid(),\r\n        \"cwd\": os.getcwd(),\r\n        \"python_version\": sys.version,\r\n        \"platform\": platform.platform(),\r\n        \"config\": redact_secrets(get_config()),\r\n    }\r\n\r\n    with open(DEBUG_DUMP_PATH, \"w\", encoding=\"utf-8\") as f:\r\n        json.dump(report, f, indent=2, sort_keys=True)\r\n"]
[17.422226, "o", "        f.write(\"\\n\")\r\n    return DEBUG_DUMP_PATH\r\n\r\ndef main():\r\n    if \"--debug-dump\" in sys.argv:\r\n        write_debug_dump(sys.argv)\r\n\r\n    if \"--print-config\" in sys.argv:\r\n        sys.exit(print_config())\r\n    elif \"--debug-dump\" in sys.argv:\r\n        sys.exit(0)\r\n    else:\r\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
