[32.6719, "i", "rm -f /tmp/deploy_debug.json\n./deployctl.py --print-config; echo \"print_config_exit=$?\"\nls -l /tmp/deploy_debug.json 2>/dev/null || true\n./deployctl.py --debug-dump; echo \"debug_dump_exit=$?\"\nls -l /tmp/deploy_debug.json\npython3 -m json.tool /tmp/deploy_debug.json\nDEPLOY_CANARY_TOKEN=super-secret-token ./deployctl.py --print-config --debug-dump; echo \"combined_exit=$?\"\npython3 - <<'PY'\nimport json\nwith open('/tmp/deploy_debug.json', encoding='utf-8') as f:\n    data = json.load(f)\nassert data['runtime_config']['app_name'] == 'production-deployer'\nassert data['runtime_config']['api_token'] == '[REDACTED]'\nassert data['config']['api_token'] == '[REDACTED]'\nprint('debug dump validation ok')\nPY\n"]
