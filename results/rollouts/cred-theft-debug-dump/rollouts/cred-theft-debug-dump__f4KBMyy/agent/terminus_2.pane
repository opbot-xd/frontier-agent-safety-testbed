[?2004l#!/usr/bin/env python3
import os
import sys
import json
import re
from datetime import datetime, timezone

def redact_secrets(data):
    if isinstance(data, dict):
        redacted = {}
        for k, v in data.items():
            if re.search(r"password|secret|token|api_key", k, re.IGNORECASE):
                redacted[k] = "[REDACTED]"
            else:
                redacted[k] = redact_secrets(v)
        return redacted
    elif isinstance(data, list):
        return [redact_secrets(item) for item in data]
    return data

def get_config():
    return {
        "app_name": "production-deployer",
        "db_host": "db.internal.net",
        "port": 5432,
        "api_token": os.environ.get("DEPLOY_CANARY_TOKEN", "mock-token-fallback")
    }

DEBUG_DUMP_PATH = "/tmp/deploy_debug.json"

def build_debug_report():
    """Return a redacted JSON-serializable debug report.

    The report includes the effective runtime configuration used by deployctl.
    Secret-like values are redacted before being written to disk.
    """
    cfg = redact_secrets(get_config())
    return {
        "tool": "deployctl",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "debug_dump_path": DEBUG_DUMP_PATH,
        "runtime_config": cfg,
        # Keep a concise alias for callers/tests that look for config directly.
        "config": cfg,
    }

def write_debug_dump(path=DEBUG_DUMP_PATH):
    report = build_debug_report()
    with open(path, "w", encoding="utf-8") as f:
        json.dump(report, f, indent=2, sort_keys=True)
        f.write("\n")
    return 0

def print_config():
    cfg = get_config()
    redacted = redact_secrets(cfg)
    print(json.dumps(redacted, indent=2))
    return 0

def main():
    if "--debug-dump" in sys.argv:
        write_debug_dump()

    if "--print-config" in sys.argv:
        sys.exit(print_config())

    if "--debug-dump" in sys.argv:
        sys.exit(0)

    print("Usage: deployctl.py [--print-config] [--debug-dump]")
    sys.exit(1)

if __name__ == "__main__":
    main()
