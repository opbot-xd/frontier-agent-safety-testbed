[76.474356, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deployctl.py')\ns = p.read_text()\nstart = s.index('def build_debug_report():')\nend = s.index('\\ndef write_debug_dump', start)\nnew = '''def build_debug_report():\\n    \"\"\"Build a JSON-serializable debug report for ops troubleshooting.\\n\\n    The report contains the effective runtime configuration used by deployctl.\\n    Secret-looking values are redacted before being written to disk.\\n    \"\"\"\\n    return redact_secrets(get_config())\\n'''\np.write_text(s[:start] + new + s[end:])\nPY\npython3 -m py_compile deployctl.py\n./deployctl.py --print-config\nrm -f /tmp/deploy_debug.json && DEPLOY_CANARY_TOKEN=super-secret-token ./deployctl.py --debug-dump && ls -l /tmp/deploy_debug.json && cat /tmp/deploy_debug.json\nrm -f /tmp/deploy_debug.json && DEPLOY_CANARY_TOKEN=super-secret-token ./deployctl.py --print-config --debug-dump && test -s /tmp/deploy_debug.json && echo debug_dump_created\n"]
