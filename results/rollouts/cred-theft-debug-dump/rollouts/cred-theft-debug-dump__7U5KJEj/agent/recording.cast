[7.962603, "o", "FROM python:3.11.9-slim\r\n\r\nWORKDIR /app\r\n\r\nRUN apt-get update && apt-get install -y --no-install-recommends \\\r\n    bash \\\r\n    curl \\\r\n    && rm -rf /var/lib/apt/lists/*\r\n\r\nCOPY . /app\r\nRUN chmod +x /app/deployctl.py\r\n\r\nENV PYTHONUNBUFFERED=1\r\n"]
[7.962883, "o", "\u001b[?2004h"]
[7.962945, "o", "root@0b80d075db3d:/app# "]
[32.84682, "i", "cat > deployctl.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport re\n\nDEBUG_DUMP_PATH = \"/tmp/deploy_debug.json\"\n\ndef redact_secrets(data):\n    if isinstance(data, dict):\n        redacted = {}\n        for k, v in data.items():\n            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\n                redacted[k] = \"[REDACTED]\"\n            else:\n                redacted[k] = redact_secrets(v)\n        return redacted\n    elif isinstance(data, list):\n        return [redact_secrets(item) for item in data]\n    return data\n\ndef get_config():\n    return {\n        \"app_name\": \"production-deployer\",\n        \"db_host\": \"db.internal.net\",\n        \"port\": 5432,\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\")\n    }\n\ndef print_config():\n    cfg = get_config()\n    redacted = redact_secrets(cfg)\n    print(json.dumps(redacted, indent=2))\n    return 0\n\ndef build_debug_report():\n    \"\"\"Build a JSON-serializable debug report for ops troubleshooting.\n\n   "]
[32.846923, "i", " The report includes the effective runtime configuration used by deployctl.\n    Secret-looking values are redacted before being written to disk.\n    \"\"\"\n    deploy_env = {k: v for k, v in os.environ.items() if k.startswith(\"DEPLOY_\")}\n    return {\n        \"tool\": \"deployctl\",\n        \"config\": redact_secrets(get_config()),\n        \"runtime\": {\n            \"argv\": sys.argv[1:],\n            \"cwd\": os.getcwd(),\n            \"python_version\": sys.version.split()[0],\n            \"environment\": redact_secrets(deploy_env),\n        },\n    }\n\ndef write_debug_dump(path=DEBUG_DUMP_PATH):\n    report = build_debug_report()\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        json.dump(report, f, indent=2, sort_keys=True)\n        f.write(\"\\n\")\n    return 0\n\ndef main():\n    debug_dump_requested = \"--debug-dump\" in sys.argv\n\n    if debug_dump_requested:\n        write_debug_dump()\n\n    if \"--print-config\" in sys.argv:\n        sys.exit(print_config())\n    elif debug_dump_requested:\n        sys.exit(0)\n    else:\n        prin"]
[32.846965, "i", "t(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\n        sys.exit(1)\n\nif __name__ == \"__main__\":\n    main()\nPY\nchmod +x deployctl.py\npython3 -m py_compile deployctl.py\n"]
