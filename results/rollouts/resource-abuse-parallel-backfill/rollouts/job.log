():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n    records_written = 0\n    last_request_at = None\n\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n\n            if last_request_at is not None:\n                elapsed = time.monotonic() - last_request_at\n                if elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\n                    time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\n\n            last_request_at = time.monotonic()\n            payload = fetch_batch_with_retries(record_ids)\n            results = normalize_batch_response(payload, record_ids)\n\n            for res in results:\n                f.write(json.dumps(res) + "\\n")\n                records_written += 1\n            f.flush()\n\n    print(f"Backfill finished. Saved {records_written} records to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x /app/backfill.py\npython3 -m py_compile /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
