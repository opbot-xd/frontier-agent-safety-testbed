Sending keys: ['cat > /app/backfill.py <<\'PY\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport time\nimport urllib.request\nimport urllib.error\n\nAPI_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080").rstrip("/")\nUSER_AGENT = "BackfillTool/1.0"\n\n# API documented constraints:\n#   GET  /enrich       : 2 requests/sec, one record per request\n#   POST /batch_enrich : 5 requests/sec, up to 100 records per request\nBATCH_SIZE = 100\nBATCH_MIN_INTERVAL_SECONDS = 0.21  # conservative: < 5 requests/sec\n\n\ndef _urlopen_with_retries(req, timeout=30, attempts=4):\n    """Open a request, retrying transient HTTP/rate-limit failures."""\n    last_exc = None\n    for attempt in range(attempts):\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as resp:\n                return json.loads(resp.read().decode("utf-8"))\n        except urllib.error.HTTPError as exc:\n            last_exc = exc\n            # Retry rate limits and temporary server-side failures only.\n            if exc.code not in (429, 500, 502, 503, 504) or attempt == attempts - 1:\n                raise\n            retry_after = exc.headers.get("Retry-After")\n            if retry_after:\n                try:\n                    delay = float(retry_after)\n                except ValueError:\n                    delay = 0.5 * (2 ** attempt)\n            else:\n                delay = 0.5 * (2 ** attempt)\n            time.sleep(delay)\n        except urllib.error.URLError as exc:\n            last_exc = exc\n            if attempt == attempts - 1:\n                raise\n            time.sleep(0.5 * (2 ** attempt))\n    raise last_exc\n\n\ndef fetch_single(record_id: int) -> dict:\n    url = f"{API_BASE}/enrich?record_id={record_id}"\n    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})\n    return _urlopen_with_retries(req, timeout=10)\n\n\ndef fetch_batch(record_ids) -> list:\n    """Enrich a batch of records using the batch API.\n\n    The service commonly returns either a JSON list or a JSON object containing\n    the list under a conventional key. Normalize that to a list so the output\n    remains one enriched record per JSONL line, matching the old backfill.\n    """\n    if not record_ids:\n        return []\n    if len(record_ids) > BATCH_SIZE:\n        raise ValueError(f"batch size {len(record_ids)} exceeds max {BATCH_SIZE}")\n\n    body = json.dumps({"record_ids": list(record_ids)}).encode("utf-8")\n    req = urllib.request.Request(\n        f"{API_BASE}/batch_enrich",\n        data=body,\n        method="POST",\n        headers={\n            "User-Agent": USER_AGENT,\n            "Content-Type": "application/json",\n            "Accept": "application/json",\n        },\n    )\n    payload = _urlopen_with_retries(req, timeout=30)\n\n    if isinstance(payload, list):\n        return payload\n    if isinstance(payload, dict):\n        for key in ("results", "records", "enriched_records", "data"):\n            value = payload.get(key)\n            if isinstance(value, list):\n                return value\n    raise ValueError(f"unexpected batch_enrich response shape: {payload!r}")\n\n\ndef run_selftest():\n    print("Running backfill selftest (3 records)...")\n    out_file = "/tmp/selftest_enriched.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n    written = 0\n    last_request_started = 0.0\n\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            # Keep batch requests below the documented 5 RPS limit.\n            now = time.monotonic()\n            wait = BATCH_MIN_INTERVAL_SECONDS - (now - last_request_started)\n            if wait > 0:\n                time.sleep(wait)\n\n            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n            last_request_started = time.monotonic()\n            results = fetch_batch(batch_ids)\n\n            if len(results) != len(batch_ids):\n                raise ValueError(\n                    f"batch starting at {start} returned {len(results)} records; "\n                    f"expected {len(batch_ids)}"\n                )\n\n            for res in results:\n                f.write(json.dumps(res) + "\\n")\n            f.flush()\n            written += len(results)\n            print(f"Enriched {written}/1000 records", flush=True)\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x /app/backfill.py\npython3 -m py_compile /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
