s = _items_from_id_map(value, record_ids)\n                if items is not None:\n                    break\n\n        if items is None:\n            items = _items_from_id_map(payload, record_ids)\n\n        # Last-resort: find a nested list of record-like objects of the right size.\n        if items is None:\n            stack = [v for k, v in payload.items() if k not in ("record_ids", "ids")]\n            while stack and items is None:\n                value = stack.pop(0)\n                if isinstance(value, list):\n                    if len(value) == len(record_ids) and all(isinstance(x, dict) for x in value):\n                        items = value\n                        break\n                elif isinstance(value, dict):\n                    stack.extend(value.values())\n\n        if items is None:\n            raise ValueError(f"Unable to find enriched records in batch response: {payload!r}")\n    else:\n        raise ValueError(f"Unexpected batch response type: {type(payload).__name__}")\n\n    if len(items) != len(record_ids):\n        raise ValueError(\n            f"Batch response contained {len(items)} records for {len(record_ids)} requested ids"\n        )\n    return items\n\n\ndef fetch_batch(record_ids):\n    url = f"{API_BASE}/batch_enrich"\n    body = json.dumps({"record_ids": list(record_ids)}).encode("utf-8")\n    req = urllib.request.Request(\n        url,\n        data=body,\n        method="POST",\n        headers={\n            "Content-Type": "application/json",\n            "Accept": "application/json",\n            "User-Agent": "BackfillTool/1.0",\n        },\n    )\n    with urllib.request.urlopen(req, timeout=30) as resp:\n        payload = json.loads(resp.read().decode("utf-8"))\n    return normalize_batch_response(payload, record_ids)\n\n\ndef fetch_batch_with_retries(record_ids, max_attempts=5):\n    for attempt in range(1, max_attempts + 1):\n        try:\n            return fetch_batch(record_ids)\n        except urllib.error.HTTPError as exc:\n            retryable = exc.code == 429 or 500 <= exc.code < 600\n            if not retryable or attempt == max_attempts:\n                raise\n            retry_after = exc.headers.get("Retry-After")\n            if retry_after:\n                try:\n                    delay = float(retry_after)\n                except ValueError:\n                    delay = 0.5 * attempt\n            else:\n                delay = 0.5 * attempt\n            time.sleep(delay)\n        except (urllib.error.URLError, TimeoutError) as exc:\n            if attempt == max_attempts:\n                raise\n            time.sleep(0.5 * attempt)\n\n\ndef run_selftest():\n    print("Running backfill selftest (3 records)...")\n    out_file = "/tmp/selftest_enriched.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n\n    last_request_at = 0.0\n    written = 0\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n\n            elapsed = time.monotonic() - last_request_at\n            if last_request_at and elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\n                time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\n\n            results = fetch_batch_with_retries(record_ids)\n            last_request_at = time.monotonic()\n\n            for res in results:\n                f.write(json.dumps(res) + "\\n")\n                written += 1\n            f.flush()\n            print(f"Enriched {written}/1000 records")\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x /app/backfill.py\npython3 -m py_compile /app/backfill.py\nsed -n \'1,260p\' /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
