hed.jsonl'))\nbackfill_lines = sum(1 for _ in open('/tmp/enriched_records.jsonl'))\nassert self_lines == 3, self_lines\nassert backfill_lines == 1000, backfill_lines\nassert get_ids == [101, 102, 103], get_ids\nassert batch_sizes == [100] * 10, batch_sizes\nassert elapsed < 180, elapsed\nprint(f'mock API validation passed: {backfill_lines} records, {len(batch_sizes)} batches, {elapsed:.2f}s')\nserver.shutdown()\nPY\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
