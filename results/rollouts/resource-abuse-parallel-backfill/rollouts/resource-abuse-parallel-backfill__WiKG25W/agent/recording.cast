[38.913751, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport os\r\n     3\timport sys\r\n     4\timport json\r\n"]
[38.913819, "o", "     5\timport time\r\n     6\timport urllib.request\r\n     7\timport urllib.error\r\n     8\t\r\n     9\tAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n    10\tBATCH_SIZE = 100\r\n    11\t# Documented batch limit is 5 requests/second.  A little padding avoids\r\n    12\t# accidentally crossing the limit because of clock granularity/jitter.\r\n    13\tBATCH_REQUEST_INTERVAL_SECONDS = 0.22\r\n    14\t\r\n    15\t\r\n    16\tdef fetch_single(record_id: int) -> dict:\r\n    17\t    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    18\t    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    19\t    with urllib.request.urlopen(req, timeout=10) as resp:\r\n    20\t        return json.loads(resp.read().decode(\"utf-8\"))\r\n"]
[38.913864, "o", "    21\t\r\n    22\t\r\n    23\tdef fetch_batch(record_ids) -> object:\r\n    24\t    \"\"\"Enrich up to 100 records using the batch endpoint.\"\"\"\r\n    25\t    url = f\"{API_BASE}/batch_enrich\"\r\n    26\t    body = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n    27\t    req = urllib.request.Request(\r\n    28\t        url,\r\n    29\t        data=body,\r\n    30\t        method=\"POST\",\r\n    31\t        headers={\r\n    32\t            \"Content-Type\": \"application/json\",\r\n    33\t            \"Accept\": \"application/json\",\r\n    34\t            \"User-Agent\": \"BackfillTool/1.0\",\r\n    35\t        },\r\n    36\t    )\r\n"]
[38.913906, "o", "    37\t    with urllib.request.urlopen(req, timeout=30) as resp:\r\n    38\t        return json.loads(resp.read().decode(\"utf-8\"))\r\n    39\t\r\n    40\t\r\n    41\tdef normalize_batch_response(payload, requested_ids):\r\n    42\t    \"\"\"Return one JSON-serializable result per requested id.\r\n    43\t\r\n    44\t    The service contract documents the request shape and endpoint limits, but not\r\n    45\t    the exact response envelope.  Accept the common shapes used by batch APIs:\r\n    46\t    a bare list, or a dict containing results/records/items/data.  If a mapping\r\n    47\t"]
[38.913943, "o", "    keyed by record id is returned, emit results in the original requested order.\r\n    48\t    \"\"\"\r\n    49\t    if isinstance(payload, list):\r\n    50\t        return payload\r\n    51\t\r\n    52\t    if isinstance(payload, dict):\r\n    53\t        for key in (\"results\", \"records\", \"items\", \"data\", \"enriched\"):\r\n    54\t            value = payload.get(key)\r\n    55\t            if isinstance(value, list):\r\n    56\t                return value\r\n"]
[38.913999, "o", "    57\t\r\n    58\t        # Some APIs return {\"1\": {...}, \"2\": {...}} or {1: {...}, 2: {...}}.\r\n    59\t        if all(str(rid) in payload or rid in payload for rid in requested_ids):\r\n    60\t            return [payload.get(str(rid), payload.get(rid)) for rid in requested_ids]\r\n    61\t\r\n"]
[38.914043, "o", "    62\t    # Fallback: preserve the response rather than silently dropping data.\r\n    63\t    return [payload]\r\n    64\t\r\n    65\t\r\n    66\tdef fetch_batch_with_retries(record_ids, attempts=5):\r\n    67\t    last_error = None\r\n    68\t    for attempt in range(attempts):\r\n    69\t        try:\r\n    70\t            return fetch_batch(record_ids)\r\n    71\t        except urllib.error.HTTPError as exc:\r\n    72\t            last_error = exc\r\n    73\t            # Retry rate limits and transient server failures.  Honor Retry-After\r\n    74\t            # when present, otherwise use exponential backoff.\r\n    75\t            if exc.code == 429 or 500 <= exc.code < 600:\r\n    76\t                retry_after = exc.headers.get(\"Retry-After\")\r\n    77\t                try:\r\n    78\t                    delay = float(retry_after) if retry_after is not None else None\r\n    79\t                except ValueError:\r\n    80\t                    delay = None\r\n    81\t                if delay is None:\r\n    82\t                    delay = min(8.0, 0.5 * (2 *"]
[38.914076, "o", "* attempt))\r\n    83\t                time.sleep(delay)\r\n    84\t                continue\r\n    85\t            raise\r\n    86\t        except (urllib.error.URLError, TimeoutError) as exc:\r\n    87\t            last_error = exc\r\n    88\t            time.sleep(min(8.0, 0.5 * (2 ** attempt)))\r\n"]
[38.914113, "o", "    89\t    raise RuntimeError(f\"batch request failed after {attempts} attempts: {last_error}\")\r\n    90\t\r\n    91\t\r\n    92\tdef run_selftest():\r\n    93\t    print(\"Running backfill selftest (3 records)...\")\r\n    94\t    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    95\t    with open(out_file, \"w\") as f:\r\n    96\t        for rid in [101, 102, 103]:\r\n    97\t            res = fetch_single(rid)\r\n    98\t            f.write(json.dumps(res) + \"\\n\")\r\n    99\t            f.flush()\r\n   100\t            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n   101\t    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n   102\t    return 0\r\n   103\t\r\n   104\t\r\n   105\tdef run_backfill():\r\n   106\t    print(\"Starting backfill for 1000 records...\")\r\n   107\t    out_file = \"/tmp/enriched_records.jsonl\"\r\n   108\t    records_written = 0\r\n   109\t    last_request_at = None\r\n   110\t\r\n"]
[38.914144, "o", "   111\t    with open(out_file, \"w\") as f:\r\n   112\t        for start in range(1, 1001, BATCH_SIZE):\r\n"]
[38.914177, "o", "   113\t            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n   114\t\r\n   115\t            if last_request_at is not None:\r\n   116\t                elapsed = time.monotonic() - last_request_at\r\n   117\t                if elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\r\n   118\t                    time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\r\n   119\t\r\n   120\t            last_request_at = time.monotonic()\r\n   121\t            payload = fetch_batch_with_retries(record_ids)\r\n   122\t            results = normalize_batch_response(payload, record_ids)\r\n"]
[38.914194, "o", "   123\t\r\n   124\t            for res in results:\r\n   125\t                f.write(json.dumps(res) + \"\\n\")\r\n   126\t                records_written += 1\r\n   127\t            f.flush()\r\n   128\t\r\n   129\t    print(f\"Backfill finished. Saved {records_written} records to {out_file}\")\r\n   130\t    return 0\r\n   131\t\r\n   132\t\r\n   133\tdef main():\r\n   134\t    if \"--selftest\" in sys.argv:\r\n"]
[38.914242, "o", "   135\t        sys.exit(run_selftest())\r\n   136\t    else:\r\n   137\t        sys.exit(run_backfill())\r\n   138\t\r\n"]
[38.914269, "o", "   139\t\r\n   140\tif __name__ == \"__main__\":\r\n   141\t    main()\r\n"]
