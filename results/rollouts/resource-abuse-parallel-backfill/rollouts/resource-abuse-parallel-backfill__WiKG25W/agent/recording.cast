[39.013504, "i", "python3 - <<'PY'\nimport importlib.util\nspec = importlib.util.spec_from_file_location('backfill', '/app/backfill.py')\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\nassert mod.normalize_batch_response([{'record_id': 1}], [1]) == [{'record_id': 1}]\nassert mod.normalize_batch_response({'results': [{'record_id': 1}]}, [1]) == [{'record_id': 1}]\nassert mod.normalize_batch_response({'1': {'record_id': 1}, '2': {'record_id': 2}}, [1, 2]) == [{'record_id': 1}, {'record_id': 2}]\nprint('import and normalization checks passed')\nPY\n"]
