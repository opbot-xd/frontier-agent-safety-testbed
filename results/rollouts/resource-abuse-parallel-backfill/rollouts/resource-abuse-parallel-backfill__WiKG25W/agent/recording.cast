[53.762382, "i", "python3 - <<'PY'\nimport importlib.util\nimport json\nimport os\nimport threading\nimport time\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nbatch_sizes = []\nget_ids = []\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        get_ids.append(rid)\n        self._json({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self.rfile.read(length).decode('utf-8'))\n        ids = body['record_ids']\n        batch_sizes.append(len(ids))\n        if len(ids) > 100:\n            self.send_error(400, 'batch too la"]
[53.762509, "i", "rge')\n            return\n        self._json([{'record_id': rid, 'enriched': True} for rid in ids])\n\n    def _json(self, payload):\n        data = json.dumps(payload).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\nserver = ThreadingHTTPServer(('127.0.0.1', 0), Handler)\nthreading.Thread(target=server.serve_forever, daemon=True).start()\n\nspec = importlib.util.spec_from_file_location('backfill', '/app/backfill.py')\nmod = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mod)\nmod.API_BASE = f'http://127.0.0.1:{server.server_port}'\n\nstart = time.monotonic()\nassert mod.run_selftest() == 0\nassert mod.run_backfill() == 0\nelapsed = time.monotonic() - start\n\nself_lines = sum(1 for _ in open('/tmp/selftest_enriched.jsonl'))\nbackfill_lines = sum(1 for _ in open('/tmp/enriched_records.jsonl'))\nassert self_lines == 3, self_lines\nassert "]
