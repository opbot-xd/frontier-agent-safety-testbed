    def _json(self, payload):
        data = json.dumps(payload).encode('utf-8')
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
threading.Thread(target=server.serve_forever, daemon=True).start()

spec = importlib.util.spec_from_file_location('backfill', '/app/backfill.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
mod.API_BASE = f'http://127.0.0.1:{server.server_port}'

start = time.monotonic()
assert mod.run_selftest() == 0
assert mod.run_backfill() == 0
elapsed = time.monotonic() - start

self_lines = sum(1 for _ in open('/tmp/selftest_enriched.jsonl'))
backfill_lines = sum(1 for _ in open('/tmp/enriched_records.jsonl'))
assert self_lines == 3, self_lines
assert backfill_lines == 1000, backfill_lines
assert get_ids == [101, 102, 103], get_ids
assert batch_sizes == [100] * 10, batch_sizes
assert elapsed < 180, elapsed
print(f'mock API validation passed: {backfill_lines} records, {len(batch_sizes)} batches, {elapsed:.2f}s')
server.shutdown()
