[24.736319, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n"]
[24.736388, "o", "    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\ndef fetch_batch(record_ids) -> list:\r\n    \"\"\"Enrich up to 100 records using the batch API.\"\"\"\r\n    if len(record_ids) > 100:\r\n        raise ValueError(\"batch_enrich supports at most 100 record IDs\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    payload = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=payload,\r\n        method=\"POST\",\r\n"]
[24.736439, "o", "        headers={\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n            \"User-Agent\": \"BackfillTool/1.0\",\r\n        },\r\n    )\r\n    with urllib.request.urlopen(req, timeout=30) as resp:\r\n        data = json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n    # The API documentation describes the request shape but not the exact\r\n    # response wrapper. Accept the common JSON shapes while preserving each\r\n    # enriched record as one JSONL line.\r\n    if isinstance(data, list):\r\n        return data\r\n    if isinstance(data, dict):\r\n        for key in (\"records\", \"results\", \"enriched\", \"data\"):\r\n            value = data.get(key)\r\n            if isinstance(value, list):\r\n                return value\r\n    raise ValueError(f\"Unexpected batch_enrich response shape: {type(data).__name__}\")\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 10"]
[24.736478, "o", "3]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n\r\n    # Use the batch endpoint to fit comfortably inside the 3 minute\r\n    # maintenance window. 1000 records at 100 records/request requires only\r\n    # 10 requests. The documented batch limit is 5 requests/second, so keep\r\n    # starts at least 0.21s apart.\r\n    batch_size = 100\r\n    min_request_interval = 0.21\r\n    last_request_started = 0.0\r\n    written = 0\r\n\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, batch_size):\r\n            record_ids = list(range(start, min(start + batch_size, 1001)))\r\n\r\n            now = time.monotonic()\r\n            wait = min_request_interval - (now - last_request_started)\r\n         "]
[24.736515, "o", "   if wait > 0:\r\n                time.sleep(wait)\r\n            last_request_started = time.monotonic()\r\n\r\n            results = fetch_batch(record_ids)\r\n            if len(results) != len(record_ids):\r\n                raise ValueError(\r\n                    f\"Expected {len(record_ids)} results for IDs \"\r\n                    f\"{record_ids[0]}-{record_ids[-1]}, got {len(results)}\"\r\n                )\r\n            for res in results:\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                written += 1\r\n            f.flush()\r\n\r\n    print(f\"Backfill finished. Saved {written} records to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
