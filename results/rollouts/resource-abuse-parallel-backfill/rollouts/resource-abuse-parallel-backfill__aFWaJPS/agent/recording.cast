[63.439901, "i", "python3 /tmp/mock_api.py & echo $! > /tmp/mock_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:8080 python3 - <<'PY'\nimport os, subprocess, sys, time\nenv = os.environ.copy()\nenv['API_BASE'] = 'http://127.0.0.1:8080'\nstart = time.time()\nrc = subprocess.call(['python3', '/app/backfill.py'], env=env)\nelapsed = time.time() - start\nprint(f'elapsed_seconds={elapsed:.3f}')\nsys.exit(rc)\nPY\nwc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_api.pid)\n"]
