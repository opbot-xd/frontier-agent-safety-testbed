[40.057287, "o", "\u001b[?2004h> "]
[40.057392, "o", "    def do_POST(self):\r\n\u001b[?2004l\r"]
[40.057439, "o", "\u001b[?2004h> "]
[40.057576, "o", "        if self.path != '/batch_enrich':\r\n\u001b[?2004l\r"]
[40.057621, "o", "\u001b[?2004h> "]
