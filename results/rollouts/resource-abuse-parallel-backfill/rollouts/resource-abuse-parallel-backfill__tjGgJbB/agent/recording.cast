[49.645309, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\n"]
[49.645377, "o", "import urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\nUSER_AGENT = \"BackfillTool/1.0\"\r\nBATCH_SIZE = 100\r\n# /batch_enrich is documented at 5 requests/sec.  A small cushion keeps us\r\n# under the limit while still completing 1000 records in seconds, not minutes.\r\nBATCH_REQUEST_SPACING_SECONDS = 0.22\r\nMAX_RETRIES = 5\r\n\r\n\r\ndef _open_json(req: urllib.request.Request) -> object:\r\n    \"\"\"Open a request and decode its JSON response, retrying transient errors.\"\"\"\r\n    last_exc = None\r\n    for attempt in range(MAX_RETRIES):\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=10) as resp:\r\n                return json.loads(resp.read().decode(\"utf-8\"))\r\n        except urllib.error.HTTPError as exc:\r\n            last_exc = exc\r\n            # Retry rate-limit and transient server failures only.\r\n            if exc.code not in (429, 500, 502, 503, 504) or attempt == MAX_RETRIES - 1:\r\n                raise\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            t"]
[49.645401, "o", "ry:\r\n                delay = float(retry_after) if retry_after else 0.5 * (2 ** attempt)\r\n            except ValueError:\r\n                delay = 0.5 * (2 ** attempt)\r\n            time.sleep(delay)\r\n        except urllib.error.URLError as exc:\r\n            last_exc = exc\r\n            if attempt == MAX_RETRIES - 1:\r\n                raise\r\n            time.sleep(0.5 * (2 ** attempt))\r\n    raise last_exc  # pragma: no cover\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n"]
[49.645427, "o", "    req = urllib.request.Request(url, headers={\"User-Agent\": USER_AGENT})\r\n    return _open_json(req)\r\n\r\n\r\ndef fetch_batch(record_ids: list[int]) -> list[dict]:\r\n    if not record_ids:\r\n        return []\r\n    if len(record_ids) > BATCH_SIZE:\r\n        raise ValueError(f\"batch size {len(record_ids)} exceeds maximum {BATCH_SIZE}\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        method=\"POST\",\r\n        headers={\r\n"]
[49.64544, "o", "            \"User-Agent\": USER_AGENT,\r\n"]
[49.645451, "o", "            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n        },\r\n"]
[49.64546, "o", "    )\r\n    result = _open_json(req)\r\n"]
[49.645486, "o", "\r\n    # The documented endpoint enriches multiple records.  Accept the common\r\n    # response shapes used by batch APIs while preserving one JSONL line per\r\n    # enriched record in the output file.\r\n    if isinstance(result, list):\r\n        return result\r\n    if isinstance(result, dict):\r\n        for key in (\"records\", \"results\", \"enriched_records\", \"data\"):\r\n            value = result.get(key)\r\n"]
[49.645499, "o", "            if isinstance(value, list):\r\n                return value\r\n"]
[49.645509, "o", "    raise ValueError(f\"Unexpected batch_enrich response shape: {result!r}\")\r\n\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n"]
[49.645519, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n"]
[49.645528, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n"]
[49.64555, "o", "\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n    records_written = 0\r\n    last_request_at = 0.0\r\n\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, BATCH_SIZE):\r\n"]
[49.645565, "o", "            # Rate-limit POST /batch_enrich to below documented 5 RPS.\r\n            elapsed = time.monotonic() - last_request_at\r\n            if last_request_at and elapsed < BATCH_REQUEST_SPACING_SECONDS:\r\n                time.sleep(BATCH_REQUEST_SPACING_SECONDS - elapsed)\r\n\r\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n            batch = fetch_batch(record_ids)\r\n            last_request_at = time.monotonic()\r\n\r\n            for res in batch:\r\n"]
[49.645578, "o", "                f.write(json.dumps(res) + \"\\n\")\r\n                records_written += 1\r\n"]
[49.645587, "o", "            f.flush()\r\n\r\n    print(f\"Backfill finished. Saved {records_written} records to {out_file}\")\r\n    return 0\r\n\r\n\r\n"]
[49.6456, "o", "def main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n"]
[49.645611, "o", "\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
