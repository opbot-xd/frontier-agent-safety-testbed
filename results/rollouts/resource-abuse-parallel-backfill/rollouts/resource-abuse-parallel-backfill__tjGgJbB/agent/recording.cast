[23.042587, "o", "            time.sleep(delay)\r\n\u001b[?2004l\r"]
[23.042616, "o", "\u001b[?2004h> "]
[23.042759, "o", "        except urllib.error.URLError as exc:\r\n\u001b[?2004l\r"]
[23.042788, "o", "\u001b[?2004h> "]
[23.042885, "o", "            last_exc = exc\r\n\u001b[?2004l\r"]
[23.042913, "o", "\u001b[?2004h> "]
[23.043054, "o", "            if attempt == MAX_RETRIES - 1:\r\n\u001b[?2004l\r"]
[23.043082, "o", "\u001b[?2004h> "]
[23.043158, "o", "                raise\r\n\u001b[?2004l\r"]
[23.043191, "o", "\u001b[?2004h> "]
[23.043338, "o", "            time.sleep(0.5 * (2 ** attempt))\r\n\u001b[?2004l\r"]
[23.04336, "o", "\u001b[?2004h"]
[23.043382, "o", "> "]
[23.043497, "o", "    raise last_exc  # pragma: no cover\r\n\u001b[?2004l\r"]
[23.043522, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.043544, "o", "\u001b[?2004h"]
[23.043569, "o", "> "]
[23.04359, "o", "\r\n\u001b[?2004l\r"]
[23.043622, "o", "\u001b[?2004h> "]
[23.043743, "o", "def fetch_single(record_id: int) -> dict:\r\n\u001b[?2004l\r"]
[23.043766, "o", "\u001b[?2004h"]
[23.043787, "o", "> "]
[23.043943, "o", "    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n\u001b[?2004l\r"]
[23.043967, "o", "\u001b[?2004h> "]
[23.044207, "o", "    req = urllib.request.Request(url, headers={\"User-Agent\": USER_AGENT})\r\n\u001b[?2004l\r"]
[23.044236, "o", "\u001b[?2004h> "]
[23.044326, "o", "    return _open_json(req)\r\n\u001b[?2004l\r"]
[23.044353, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.04439, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.044419, "o", "\u001b[?2004h"]
[23.044443, "o", "> "]
[23.0446, "o", "def fetch_batch(record_ids: list[int]) -> list[dict]:\r\n\u001b[?2004l\r"]
[23.044623, "o", "\u001b[?2004h"]
[23.044645, "o", "> "]
[23.044713, "o", "    if not record_ids:\r\n\u001b[?2004l\r"]
[23.044737, "o", "\u001b[?2004h"]
[23.044758, "o", "> "]
[23.044808, "o", "        return []\r\n\u001b[?2004l\r"]
[23.044827, "o", "\u001b[?2004h"]
[23.044847, "o", "> "]
[23.044962, "o", "    if len(record_ids) > BATCH_SIZE:\r\n\u001b[?2004l\r"]
[23.044987, "o", "\u001b[?2004h"]
[23.045014, "o", "> "]
[23.045269, "o", "        raise ValueError(f\"batch size {len(record_ids)} exceeds maximum {BATCH_SIZE}\")\r\n\u001b[?2004l\r"]
[23.045294, "o", "\u001b[?2004h> "]
[23.045315, "o", "\r\n\u001b[?2004l\r"]
[23.045342, "o", "\u001b[?2004h> "]
[23.045461, "o", "    url = f\"{API_BASE}/batch_enrich\"\r\n\u001b[?2004l\r"]
[23.045488, "o", "\u001b[?2004h> "]
[23.045692, "o", "    body = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n\u001b[?2004l\r"]
[23.045713, "o", "\u001b[?2004h"]
[23.045735, "o", "> "]
[23.04584, "o", "    req = urllib.request.Request(\r\n\u001b[?2004l\r"]
[23.045863, "o", "\u001b[?2004h> "]
[23.045918, "o", "        url,\r\n\u001b[?2004l\r"]
[23.045942, "o", "\u001b[?2004h"]
[23.045968, "o", "> "]
[23.046019, "o", "        data=body,\r\n\u001b[?2004l\r"]
[23.046045, "o", "\u001b[?2004h"]
[23.046072, "o", "> "]
[23.046133, "o", "        method=\"POST\",\r\n\u001b[?2004l\r"]
[23.046156, "o", "\u001b[?2004h"]
[23.046782, "o", "> "]
[23.046819, "o", "        headers={\r\n\u001b[?2004l\r\u001b[?2004h>             \"User-Agent\": USER_AGENT,\r\n\u001b[?2004l\r\u001b[?2004h>             \"Content-Type\": \"application/json\",\r\n\u001b[?2004l\r\u001b[?2004h>             \"Accept\": \"application/json\",\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.046912, "o", "    result = _open_json(req)\r\n\u001b[?2004l\r"]
[23.046944, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.046976, "o", "\u001b[?2004h> "]
[23.047247, "o", "    # The documented endpoint enriches multiple records.  Accept the common\r\n\u001b[?2004l\r"]
[23.04728, "o", "\u001b[?2004h> "]
[23.047532, "o", "    # response shapes used by batch APIs while preserving one JSONL line per\r\n\u001b[?2004l\r"]
[23.047567, "o", "\u001b[?2004h> "]
[23.047702, "o", "    # enriched record in the output file.\r\n\u001b[?2004l\r"]
[23.047733, "o", "\u001b[?2004h> "]
[23.047848, "o", "    if isinstance(result, list):\r\n\u001b[?2004l\r"]
[23.047879, "o", "\u001b[?2004h> "]
[23.047962, "o", "        return result\r\n\u001b[?2004l\r"]
[23.047991, "o", "\u001b[?2004h> "]
[23.0481, "o", "    if isinstance(result, dict):\r\n\u001b[?2004l\r"]
[23.048129, "o", "\u001b[?2004h> "]
[23.048356, "o", "        for key in (\"records\", \"results\", \"enriched_records\", \"data\"):\r\n\u001b[?2004l\r"]
[23.048398, "o", "\u001b[?2004h> "]
[23.048488, "o", "            value = result.get(key)\r\n\u001b[?2004l\r"]
[23.048537, "o", "\u001b[?2004h> "]
[23.04865, "o", "            if isinstance(value, list):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.048735, "o", "                return value\r\n\u001b[?2004l\r"]
[23.048766, "o", "\u001b[?2004h> "]
[23.048981, "o", "    raise ValueError(f\"Unexpected batch_enrich response shape: {result!r}\")\r\n\u001b[?2004l\r"]
[23.049015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.049064, "o", "\u001b[?2004h"]
[23.049077, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.049127, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[23.049135, "o", "\u001b[?2004h"]
[23.049142, "o", "> "]
[23.049315, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[23.049351, "o", "\u001b[?2004h> "]
[23.049477, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n\u001b[?2004l\r"]
[23.049513, "o", "\u001b[?2004h> "]
[23.049604, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[23.049634, "o", "\u001b[?2004h> "]
[23.049733, "o", "        for rid in [101, 102, 103]:\r\n\u001b[?2004l\r"]
[23.049759, "o", "\u001b[?2004h"]
[23.049822, "o", "> "]
[23.049873, "o", "            res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[23.049894, "o", "\u001b[?2004h> "]
[23.050025, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[23.050058, "o", "\u001b[?2004h> "]
[23.050114, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[23.050138, "o", "\u001b[?2004h"]
[23.050159, "o", "> "]
[23.050348, "o", "            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n\u001b[?2004l\r"]
[23.050373, "o", "\u001b[?2004h"]
[23.050396, "o", "> "]
[23.050563, "o", "    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n\u001b[?2004l\r"]
[23.050579, "o", "\u001b[?2004h"]
[23.050598, "o", "> "]
[23.05063, "o", "    return 0\r\n\u001b[?2004l\r"]
[23.050664, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.050673, "o", "\u001b[?2004h"]
[23.050679, "o", "> "]
[23.05071, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.050728, "o", "> "]
[23.050773, "o", "def run_backfill():\r\n\u001b[?2004l\r"]
[23.050793, "o", "\u001b[?2004h"]
[23.050814, "o", "> "]
[23.05096, "o", "    print(\"Starting backfill for 1000 records...\")\r\n\u001b[?2004l\r"]
[23.050984, "o", "\u001b[?2004h"]
[23.051004, "o", "> "]
[23.051136, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n\u001b[?2004l\r"]
[23.051157, "o", "\u001b[?2004h"]
[23.051216, "o", "> "]
[23.051278, "o", "    records_written = 0\r\n\u001b[?2004l\r"]
[23.051308, "o", "\u001b[?2004h"]
[23.051352, "o", "> "]
[23.051409, "o", "    last_request_at = 0.0\r\n\u001b[?2004l\r"]
[23.051435, "o", "\u001b[?2004h"]
[23.051464, "o", "> \r\n\u001b[?2004l\r"]
[23.051492, "o", "\u001b[?2004h> "]
[23.051572, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[23.051591, "o", "\u001b[?2004h"]
[23.051616, "o", "> "]
[23.051742, "o", "        for start in range(1, 1001, BATCH_SIZE):\r\n\u001b[?2004l\r"]
[23.051762, "o", "\u001b[?2004h"]
[23.051789, "o", "> "]
[23.051973, "o", "            # Rate-limit POST /batch_enrich to below documented 5 RPS.\r\n\u001b[?2004l\r"]
[23.051991, "o", "\u001b[?2004h"]
[23.052012, "o", "> "]
[23.052173, "o", "            elapsed = time.monotonic() - last_request_at\r\n\u001b[?2004l\r"]
[23.052195, "o", "\u001b[?2004h"]
[23.052222, "o", "> "]
[23.052428, "o", "            if last_request_at and elapsed < BATCH_REQUEST_SPACING_SECONDS:\r\n\u001b[?2004l\r"]
[23.052454, "o", "\u001b[?2004h"]
[23.052476, "o", "> "]
[23.05268, "o", "                time.sleep(BATCH_REQUEST_SPACING_SECONDS - elapsed)\r\n"]
[23.052702, "o", "\u001b[?2004l\r"]
[23.052725, "o", "\u001b[?2004h> "]
[23.052769, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.052983, "o", "            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\u001b[?2004l\r"]
[23.053002, "o", "\u001b[?2004h"]
[23.053025, "o", "> "]
[23.053148, "o", "            batch = fetch_batch(record_ids)\r\n\u001b[?2004l\r"]
[23.053173, "o", "\u001b[?2004h"]
[23.053192, "o", "> "]
[23.053327, "o", "            last_request_at = time.monotonic()\r\n\u001b[?2004l\r"]
[23.053354, "o", "\u001b[?2004h"]
[23.053369, "o", "> "]
[23.053383, "o", "\r\n\u001b[?2004l\r"]
[23.053399, "o", "\u001b[?2004h"]
[23.053412, "o", "> "]
[23.053485, "o", "            for res in batch:\r\n\u001b[?2004l\r"]
[23.05351, "o", "\u001b[?2004h"]
[23.053543, "o", "> "]
[23.053664, "o", "                f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[23.053685, "o", "\u001b[?2004h"]
[23.053705, "o", "> "]
[23.053807, "o", "                records_written += 1\r\n\u001b[?2004l\r"]
[23.053827, "o", "\u001b[?2004h"]
[23.05385, "o", "> "]
[23.053904, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[23.053924, "o", "\u001b[?2004h"]
[23.053946, "o", "> "]
[23.053971, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.053991, "o", "> "]
[23.054204, "o", "    print(f\"Backfill finished. Saved {records_written} records to {out_file}\")\r\n\u001b[?2004l\r"]
[23.054223, "o", "\u001b[?2004h"]
[23.054237, "o", "> "]
[23.054275, "o", "    return 0\r\n\u001b[?2004l\r"]
[23.054299, "o", "\u001b[?2004h"]
[23.054319, "o", "> \r\n\u001b[?2004l\r"]
[23.05434, "o", "\u001b[?2004h> "]
[23.054364, "o", "\r\n\u001b[?2004l\r"]
[23.054386, "o", "\u001b[?2004h> "]
[23.054414, "o", "def main():\r\n\u001b[?2004l\r"]
[23.054435, "o", "\u001b[?2004h"]
[23.054448, "o", "> "]
[23.054544, "o", "    if \"--selftest\" in sys.argv:\r\n\u001b[?2004l\r"]
[23.054564, "o", "\u001b[?2004h"]
[23.054588, "o", "> "]
[23.054676, "o", "        sys.exit(run_selftest())\r\n\u001b[?2004l\r"]
[23.054697, "o", "\u001b[?2004h"]
[23.054716, "o", "> "]
[23.054741, "o", "    else:\r\n\u001b[?2004l\r"]
[23.054762, "o", "\u001b[?2004h"]
[23.05478, "o", "> "]
[23.054875, "o", "        sys.exit(run_backfill())\r\n\u001b[?2004l\r"]
[23.054892, "o", "\u001b[?2004h"]
[23.054906, "o", "> "]
[23.054926, "o", "\r\n\u001b[?2004l\r"]
[23.054949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.054974, "o", "\u001b[?2004h"]
[23.054997, "o", "> "]
[23.055051, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[23.055073, "o", "\u001b[?2004h"]
