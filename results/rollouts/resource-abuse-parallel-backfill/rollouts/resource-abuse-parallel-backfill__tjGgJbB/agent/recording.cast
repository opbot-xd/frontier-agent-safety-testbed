[40.052972, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send_json(self, obj):\n        body = json.dumps(obj).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        self._send_json({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n        p"]
[40.05309, "i", "ayload = json.loads(self.rfile.read(length).decode('utf-8'))\n        ids = payload['record_ids']\n        if len(ids) > 100:\n            self.send_error(400, 'too many ids')\n            return\n        self._send_json([{'record_id': rid, 'enriched': True} for rid in ids])\n\nHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 & echo $! > /tmp/mock_api.pid\n"]
