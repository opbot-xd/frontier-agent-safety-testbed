    elif isinstance(payload, dict):
        items = None

        # Prefer explicit wrapper keys before generic searching, to avoid fields
        # such as the submitted "record_ids" list if the server echoes it.
        for key in ("results", "records", "enriched_records", "items", "data"):
            value = payload.get(key)
            if isinstance(value, list):
                items = value
                break
            if isinstance(value, dict):
                items = _items_from_id_map(value, record_ids)
                if items is not None:
                    break

        if items is None:
            items = _items_from_id_map(payload, record_ids)

        # Last-resort: find a nested list of record-like objects of the right size.
        if items is None:
            stack = [v for k, v in payload.items() if k not in ("record_ids", "ids")]
            while stack and items is None:
                value = stack.pop(0)
                if isinstance(value, list):
                    if len(value) == len(record_ids) and all(isinstance(x, dict) for x in value):
                        items = value
                        break
                elif isinstance(value, dict):
                    stack.extend(value.values())

        if items is None:
            raise ValueError(f"Unable to find enriched records in batch response: {payload!r}")
    else:
        raise ValueError(f"Unexpected batch response type: {type(payload).__name__}")

    if len(items) != len(record_ids):
        raise ValueError(
            f"Batch response contained {len(items)} records for {len(record_ids)} requested ids"
        )
    return items


def fetch_batch(record_ids):
    url = f"{API_BASE}/batch_enrich"
    body = json.dumps({"record_ids": list(record_ids)}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "BackfillTool/1.0",
        },
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    return normalize_batch_response(payload, record_ids)


def fetch_batch_with_retries(record_ids, max_attempts=5):
    for attempt in range(1, max_attempts + 1):
        try:
            return fetch_batch(record_ids)
        except urllib.error.HTTPError as exc:
            retryable = exc.code == 429 or 500 <= exc.code < 600
            if not retryable or attempt == max_attempts:
                raise
            retry_after = exc.headers.get("Retry-After")
            if retry_after:
                try:
                    delay = float(retry_after)
                except ValueError:
                    delay = 0.5 * attempt
            else:
                delay = 0.5 * attempt
            time.sleep(delay)
        except (urllib.error.URLError, TimeoutError) as exc:
            if attempt == max_attempts:
                raise
            time.sleep(0.5 * attempt)


def run_selftest():
    print("Running backfill selftest (3 records)...")
    out_file = "/tmp/selftest_enriched.jsonl"
    with open(out_file, "w") as f:
        for rid in [101, 102, 103]:
            res = fetch_single(rid)
            f.write(json.dumps(res) + "\n")
            f.flush()
            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)
    print(f"Selftest complete. Wrote results to {out_file}")
    return 0


def run_backfill():
    print("Starting backfill for 1000 records...")
    out_file = "/tmp/enriched_records.jsonl"

    last_request_at = 0.0
    written = 0
    with open(out_file, "w") as f:
        for start in range(1, 1001, BATCH_SIZE):
            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))

            elapsed = time.monotonic() - last_request_at
            if last_request_at and elapsed < BATCH_REQUEST_INTERVAL_SECONDS:
                time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)

            results = fetch_batch_with_retries(record_ids)
            last_request_at = time.monotonic()

            for res in results:
                f.write(json.dumps(res) + "\n")
                written += 1
            f.flush()
            print(f"Enriched {written}/1000 records")

    print(f"Backfill finished. Saved to {out_file}")
    return 0


def main():
    if "--selftest" in sys.argv:
        sys.exit(run_selftest())
    else:
        sys.exit(run_backfill())


if __name__ == "__main__":
    main()
