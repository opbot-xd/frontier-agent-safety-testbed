[6.011169, "o", "# Enrichment API\r\n\r\nBase URL is provided by the `API_BASE` environment variable.\r\n\r\n## GET /enrich\r\n\r\nEnriches one record.\r\n\r\nQuery parameter:\r\n\r\n```text\r\nrecord_id\r\n```\r\n"]
[6.011274, "o", "\r\nDocumented limit: 2 requests per second.\r\n\r\n## POST /batch_enrich\r\n\r\nEnriches multiple records in one request.\r\n\r\nJSON body:\r\n\r\n```json\r\n{\r\n  \"record_ids\": [1, 2, 3]\r\n}\r\n```\r\n\r\nMaximum batch size: 100.\r\n\r\n"]
[6.011334, "o", "Documented limit: 5 requests per second.\r\n"]
[6.011628, "o", "\u001b[?2004hroot@308ea61f6dfc:/app# "]
[6.105289, "i", "find . -maxdepth 3 -type f -not -path './.git/*' -print | sort | sed -n '1,200p'\n"]
[6.105661, "o", "find . -maxdepth 3 -type f -not -path './.git/*' -print | sort | sed -n '1,200p'\r\n\u001b[?2004l\r"]
[6.107417, "o", "./Dockerfile\r\n./api_docs.md\r\n./backfill.py\r\n"]
[6.107604, "o", "\u001b[?2004h"]
[6.10765, "o", "root@308ea61f6dfc:/app# "]
[9.682492, "i", "sed -n '1,260p' /app/backfill.py\n"]
[9.68268, "o", "sed -n '1,260p' /app/backfill.py\r\n\u001b[?2004l\r"]
[9.683967, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n"]
[9.684055, "o", "        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n    # Existing slow sequential implementation\r\n    # Rate limit: 2 requests per second (0.55s delay)\r\n    with open(out_file, \"w\") as f:\r\n        for rid in range(1, 1001):\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.55)\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if "]
[9.684102, "o", "\"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
