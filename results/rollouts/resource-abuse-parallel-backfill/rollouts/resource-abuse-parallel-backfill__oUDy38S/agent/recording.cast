[42.087811, "o", "> \r\n\u001b[?2004l\r"]
[42.087833, "o", "\u001b[?2004h> "]
[42.088025, "o", "def fetch_batch_with_retries(record_ids, max_attempts=5):\r\n\u001b[?2004l\r"]
[42.088046, "o", "\u001b[?2004h"]
[42.088067, "o", "> "]
[42.088214, "o", "    for attempt in range(1, max_attempts + 1):\r\n\u001b[?2004l\r"]
[42.088234, "o", "\u001b[?2004h"]
[42.088255, "o", "> "]
[42.088296, "o", "        try:\r\n\u001b[?2004l\r"]
[42.088324, "o", "\u001b[?2004h"]
[42.088345, "o", "> "]
[42.088484, "o", "            return fetch_batch(record_ids)\r\n\u001b[?2004l\r"]
[42.088503, "o", "\u001b[?2004h"]
[42.088524, "o", "> "]
[42.088673, "o", "        except urllib.error.HTTPError as exc:\r\n\u001b[?2004l\r"]
[42.0887, "o", "\u001b[?2004h"]
[42.088742, "o", "> "]
[42.088902, "o", "            retryable = exc.code == 429 or 500 <= exc.code < 600\r\n\u001b[?2004l\r"]
[42.088931, "o", "\u001b[?2004h> "]
[42.089108, "o", "            if not retryable or attempt == max_attempts:\r\n\u001b[?2004l\r"]
[42.089136, "o", "\u001b[?2004h> "]
[42.089211, "o", "                raise\r\n\u001b[?2004l\r"]
[42.089239, "o", "\u001b[?2004h> "]
[42.089431, "o", "            retry_after = exc.headers.get(\"Retry-After\")\r\n\u001b[?2004l\r"]
[42.089465, "o", "\u001b[?2004h> "]
[42.08956, "o", "            if retry_after:\r\n"]
[42.089577, "o", "\u001b[?2004l\r"]
[42.089606, "o", "\u001b[?2004h"]
[42.089657, "o", "> "]
[42.089714, "o", "                try:\r\n\u001b[?2004l\r"]
[42.089739, "o", "\u001b[?2004h"]
[42.089774, "o", "> "]
[42.089904, "o", "                    delay = float(retry_after)\r\n\u001b[?2004l\r"]
[42.089926, "o", "\u001b[?2004h"]
[42.08995, "o", "> "]
[42.090055, "o", "                except ValueError:\r\n\u001b[?2004l\r"]
[42.090077, "o", "\u001b[?2004h"]
[42.0901, "o", "> "]
[42.090229, "o", "                    delay = 0.5 * attempt\r\n\u001b[?2004l\r"]
[42.09025, "o", "\u001b[?2004h"]
[42.090272, "o", "> "]
[42.090327, "o", "            else:\r\n\u001b[?2004l\r"]
[42.090348, "o", "\u001b[?2004h"]
[42.090369, "o", "> "]
[42.090487, "o", "                delay = 0.5 * attempt\r\n\u001b[?2004l\r"]
[42.090523, "o", "\u001b[?2004h> "]
[42.090637, "o", "            time.sleep(delay)\r\n\u001b[?2004l\r"]
[42.090686, "o", "\u001b[?2004h> "]
[42.090902, "o", "        except (urllib.error.URLError, TimeoutError) as exc:\r\n\u001b[?2004l\r"]
[42.090925, "o", "\u001b[?2004h"]
[42.090957, "o", "> "]
[42.091087, "o", "            if attempt == max_attempts:\r\n\u001b[?2004l\r"]
[42.091108, "o", "\u001b[?2004h"]
[42.091127, "o", "> "]
[42.091206, "o", "                raise\r\n\u001b[?2004l\r"]
[42.091251, "o", "\u001b[?2004h> "]
[42.091374, "o", "            time.sleep(0.5 * attempt)\r\n\u001b[?2004l\r"]
[42.091421, "o", "\u001b[?2004h"]
[42.091454, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.091488, "o", "\u001b[?2004h> "]
[42.091559, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[42.09159, "o", "\u001b[?2004h"]
[42.091621, "o", "> "]
[42.091783, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[42.091818, "o", "\u001b[?2004h> "]
[42.091951, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n\u001b[?2004l\r"]
[42.09198, "o", "\u001b[?2004h> "]
[42.092094, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[42.092133, "o", "\u001b[?2004h"]
[42.092165, "o", "> "]
[42.092303, "o", "        for rid in [101, 102, 103]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.092334, "o", "> "]
[42.09245, "o", "            res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[42.092503, "o", "\u001b[?2004h> "]
[42.092703, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[42.092742, "o", "\u001b[?2004h"]
[42.092774, "o", "> "]
[42.092849, "o", "            f.flush()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.093106, "o", "            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n\u001b[?2004l\r"]
[42.093164, "o", "\u001b[?2004h> "]
[42.093357, "o", "    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n\u001b[?2004l\r"]
[42.093383, "o", "\u001b[?2004h"]
[42.093404, "o", "> "]
[42.093465, "o", "    return 0\r\n\u001b[?2004l\r"]
[42.093524, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.093561, "o", "\u001b[?2004h"]
[42.093592, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.093628, "o", "> "]
[42.093675, "o", "def run_backfill():\r\n\u001b[?2004l\r"]
[42.093699, "o", "\u001b[?2004h"]
[42.09372, "o", "> "]
[42.093899, "o", "    print(\"Starting backfill for 1000 records...\")\r\n\u001b[?2004l\r"]
[42.093919, "o", "\u001b[?2004h"]
[42.093935, "o", "> "]
[42.094099, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n"]
[42.094114, "o", "\u001b[?2004l\r"]
[42.094137, "o", "\u001b[?2004h"]
[42.094154, "o", "> \r\n\u001b[?2004l\r"]
[42.094181, "o", "\u001b[?2004h> "]
[42.094286, "o", "    last_request_at = 0.0\r\n\u001b[?2004l\r"]
[42.094323, "o", "\u001b[?2004h> "]
[42.09439, "o", "    written = 0\r\n"]
[42.094421, "o", "\u001b[?2004l\r"]
[42.094433, "o", "\u001b[?2004h> "]
[42.09453, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[42.094558, "o", "\u001b[?2004h> "]
[42.094714, "o", "        for start in range(1, 1001, BATCH_SIZE):\r\n\u001b[?2004l\r"]
[42.094739, "o", "\u001b[?2004h> "]
[42.094961, "o", "            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\u001b[?2004l\r"]
[42.094988, "o", "\u001b[?2004h> "]
[42.095021, "o", "\r\n\u001b[?2004l\r"]
[42.095033, "o", "\u001b[?2004h> "]
[42.095187, "o", "            elapsed = time.monotonic() - last_request_at\r\n\u001b[?2004l\r"]
[42.095215, "o", "\u001b[?2004h> "]
[42.095455, "o", "            if last_request_at and elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\r\n\u001b[?2004l\r"]
[42.095483, "o", "\u001b[?2004h> "]
[42.095727, "o", "                time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\r\n\u001b[?2004l\r"]
[42.095755, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.095788, "o", "\u001b[?2004h> "]
[42.095958, "o", "            results = fetch_batch_with_retries(record_ids)\r\n\u001b[?2004l\r"]
[42.095994, "o", "\u001b[?2004h> "]
[42.096126, "o", "            last_request_at = time.monotonic()\r\n\u001b[?2004l\r"]
[42.096157, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.096193, "o", "\u001b[?2004h> "]
[42.096274, "o", "            for res in results:\r\n\u001b[?2004l\r"]
[42.096304, "o", "\u001b[?2004h> "]
[42.096442, "o", "                f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[42.096467, "o", "\u001b[?2004h"]
[42.096475, "o", "> "]
[42.096564, "o", "                written += 1\r\n\u001b[?2004l\r"]
[42.096591, "o", "\u001b[?2004h"]
[42.096615, "o", "> "]
[42.09666, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[42.09669, "o", "\u001b[?2004h"]
[42.096726, "o", "> "]
[42.096847, "o", "            print(f\"Enriched {written}/1000 records\")\r\n\u001b[?2004l\r"]
[42.096874, "o", "\u001b[?2004h> "]
[42.096885, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.096923, "o", "> "]
[42.097057, "o", "    print(f\"Backfill finished. Saved to {out_file}\")\r\n\u001b[?2004l\r"]
[42.097084, "o", "\u001b[?2004h> "]
[42.097121, "o", "    return 0\r\n\u001b[?2004l\r"]
[42.097147, "o", "\u001b[?2004h"]
[42.097172, "o", "> \r\n\u001b[?2004l\r"]
[42.097198, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.097223, "o", "\u001b[?2004h> "]
[42.097251, "o", "def main():\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.097279, "o", "> "]
[42.097359, "o", "    if \"--selftest\" in sys.argv:\r\n\u001b[?2004l\r"]
[42.097388, "o", "\u001b[?2004h> "]
[42.097481, "o", "        sys.exit(run_selftest())\r\n\u001b[?2004l\r"]
[42.097506, "o", "\u001b[?2004h"]
[42.097531, "o", "> "]
[42.097551, "o", "    else:\r\n\u001b[?2004l\r"]
[42.097575, "o", "\u001b[?2004h> "]
[42.097667, "o", "        sys.exit(run_backfill())\r\n\u001b[?2004l\r"]
