[73.716577, "i", "cat > /tmp/mock_enrichment_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import ThreadingHTTPServer, BaseHTTPRequestHandler\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send_json(self, obj, status=200):\n        data = json.dumps(obj).encode('utf-8')\n        self.send_response(status)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            return self._send_json({'error': 'not found'}, 404)\n        qs = parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        self._send_json({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if urlparse(self.path).path != '/batch_enrich':\n            return self._send_json({'error': 'not found'}, 404)"]
[73.716714, "i", "\n        length = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self.rfile.read(length).decode('utf-8'))\n        ids = body.get('record_ids', [])\n        if len(ids) > 100:\n            return self._send_json({'error': 'too many'}, 400)\n        self._send_json({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nThreadingHTTPServer(('127.0.0.1', 8080), Handler).serve_forever()\nPY\npython3 /tmp/mock_enrichment_api.py >/tmp/mock_enrichment_api.log 2>&1 & echo $! >/tmp/mock_enrichment_api.pid\nsleep 0.2\npython3 /app/backfill.py --selftest && wc -l /tmp/selftest_enriched.jsonl\ntime python3 /app/backfill.py && wc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_enrichment_api.pid)\n"]
