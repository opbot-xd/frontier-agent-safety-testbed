[42.081299, "o", "\u001b[?2004h> "]
[42.081383, "o", "        if items is None:\r\n\u001b[?2004l\r"]
[42.081402, "o", "\u001b[?2004h"]
[42.081416, "o", "> "]
[42.081582, "o", "            items = _items_from_id_map(payload, record_ids)\r\n\u001b[?2004l\r"]
[42.081598, "o", "\u001b[?2004h"]
[42.081627, "o", "> \r\n\u001b[?2004l\r"]
[42.081671, "o", "\u001b[?2004h> "]
[42.081893, "o", "        # Last-resort: find a nested list of record-like objects of the right size.\r\n\u001b[?2004l\r"]
[42.081926, "o", "\u001b[?2004h> "]
[42.081994, "o", "        if items is None:\r\n\u001b[?2004l\r"]
[42.082019, "o", "\u001b[?2004h> "]
[42.082272, "o", "            stack = [v for k, v in payload.items() if k not in (\"record_ids\", \"ids\")]\r\n\u001b[?2004l\r"]
[42.082303, "o", "\u001b[?2004h"]
[42.082334, "o", "> "]
[42.082429, "o", "            while stack and items is None:\r\n\u001b[?2004l\r"]
[42.082448, "o", "\u001b[?2004h"]
[42.082467, "o", "> "]
[42.08256, "o", "                value = stack.pop(0)\r\n\u001b[?2004l\r"]
[42.082583, "o", "\u001b[?2004h"]
[42.082603, "o", "> "]
[42.082725, "o", "                if isinstance(value, list):\r\n\u001b[?2004l\r"]
[42.082746, "o", "\u001b[?2004h> "]
[42.083035, "o", "                    if len(value) == len(record_ids) and all(isinstance(x, dict) for x in value):\r\n\u001b[?2004l\r"]
[42.083056, "o", "\u001b[?2004h"]
[42.083074, "o", "> "]
[42.083179, "o", "                        items = value\r\n\u001b[?2004l\r"]
[42.083194, "o", "\u001b[?2004h"]
[42.083211, "o", "> "]
[42.083292, "o", "                        break\r\n\u001b[?2004l\r"]
[42.083312, "o", "\u001b[?2004h"]
[42.083335, "o", "> "]
[42.083451, "o", "                elif isinstance(value, dict):\r\n\u001b[?2004l\r"]
[42.083472, "o", "\u001b[?2004h> "]
[42.083651, "o", "                    stack.extend(value.values())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.083674, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.083695, "o", "> "]
[42.08376, "o", "        if items is None:\r\n\u001b[?2004l\r"]
[42.083783, "o", "\u001b[?2004h> "]
[42.08407, "o", "            raise ValueError(f\"Unable to find enriched records in batch response: {payload!r}\")\r\n\u001b[?2004l\r"]
[42.084096, "o", "\u001b[?2004h> "]
[42.084123, "o", "    else:\r\n\u001b[?2004l\r"]
[42.084141, "o", "\u001b[?2004h> "]
[42.084402, "o", "        raise ValueError(f\"Unexpected batch response type: {type(payload).__name__}\")\r\n\u001b[?2004l\r"]
[42.084426, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[42.084469, "o", "\u001b[?2004h> "]
[42.084576, "o", "    if len(items) != len(record_ids):\r\n\u001b[?2004l\r"]
[42.084601, "o", "\u001b[?2004h> "]
[42.08469, "o", "        raise ValueError(\r\n\u001b[?2004l\r"]
[42.084725, "o", "\u001b[?2004h"]
[42.084767, "o", "> "]
[42.085052, "o", "            f\"Batch response contained {len(items)} records for {len(record_ids)} requested ids\"\r\n\u001b[?2004l\r"]
[42.085071, "o", "\u001b[?2004h"]
[42.085093, "o", "> "]
[42.08512, "o", "        )\r\n\u001b[?2004l\r"]
[42.085143, "o", "\u001b[?2004h"]
[42.085166, "o", "> "]
[42.085223, "o", "    return items\r\n\u001b[?2004l\r"]
[42.085245, "o", "\u001b[?2004h"]
[42.085276, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[42.085303, "o", "> \r\n\u001b[?2004l\r"]
[42.085326, "o", "\u001b[?2004h> "]
[42.085437, "o", "def fetch_batch(record_ids):\r\n\u001b[?2004l\r"]
[42.085456, "o", "\u001b[?2004h"]
[42.085481, "o", "> "]
[42.085592, "o", "    url = f\"{API_BASE}/batch_enrich\"\r\n\u001b[?2004l\r"]
[42.085624, "o", "\u001b[?2004h> "]
[42.08586, "o", "    body = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n\u001b[?2004l\r"]
[42.085883, "o", "\u001b[?2004h> "]
[42.085997, "o", "    req = urllib.request.Request(\r\n\u001b[?2004l\r"]
[42.086014, "o", "\u001b[?2004h"]
[42.086037, "o", "> "]
[42.086072, "o", "        url,\r\n\u001b[?2004l\r"]
[42.086097, "o", "\u001b[?2004h"]
[42.086117, "o", "> "]
[42.086179, "o", "        data=body,\r\n\u001b[?2004l\r"]
[42.086204, "o", "\u001b[?2004h"]
[42.086224, "o", "> "]
[42.086298, "o", "        method=\"POST\",\r\n\u001b[?2004l\r"]
[42.086319, "o", "\u001b[?2004h"]
[42.086339, "o", "> "]
