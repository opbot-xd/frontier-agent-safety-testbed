[42.239831, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\").rstrip(\"/\")\r\n\r\nBATCH_SIZE = 100\r\n# Documented /batch_enrich limit is 5 requests/sec. 0.21s keeps us just under it.\r\nBATCH_REQUEST_INTERVAL_SECONDS = 0.21\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n\r\ndef _items_from_id_map(mapping: dict, record_ids):\r\n    \"\"\"Return records from a {'1': {...}, ...} or {1: {...}, ...} response.\"\"\"\r\n    if all(str(rid) in mapping for rid in record_ids):\r\n        return [mapping[str(rid)] for rid in record_ids]\r\n    if all(rid in mapping for rid in record_ids):\r\n        return [mapping[rid] for rid in record_ids]\r\n    return None\r\n\r\n\r\ndef normalize"]
[42.239857, "o", "_batch_response(payload, record_ids):\r\n    \"\"\"\r\n    The API docs specify the request contract but not the exact response wrapper.\r\n    Accept common forms while still producing exactly one JSONL row per input id:\r\n      [{...}, ...]\r\n      {\"results\": [{...}, ...]}\r\n      {\"records\": [{...}, ...]}\r\n      {\"data\": [{...}, ...]}\r\n      {\"1\": {...}, \"2\": {...}}\r\n    \"\"\"\r\n    if isinstance(payload, list):\r\n        items = payload\r\n    elif isinstance(payload, dict):\r\n        items = None\r\n\r\n        # Prefer explicit wrapper keys before generic searching, to avoid fields\r\n        # such as the submitted \"record_ids\" list if the server echoes it.\r\n        for key in (\"results\", \"records\", \"enriched_records\", \"items\", \"data\"):\r\n            value = payload.get(key)\r\n"]
[42.239921, "o", "            if isinstance(value, list):\r\n                items = value\r\n                break\r\n            if isinstance(value, dict):\r\n                items = _items_from_id_map(value, record_ids)\r\n"]
[42.239957, "o", "                if items is not None:\r\n                    break\r\n\r\n        if items is None:\r\n            items = _items_from_id_map(payload, record_ids)\r\n\r\n        # Last-resort: find a nested list of record-like objects of the right size.\r\n        if items is None:\r\n            stack = [v for k, v in payload.items() if k not in (\"record_ids\", \"ids\")]\r\n            while stack and items is None:\r\n                value = stack.pop(0)\r\n                if isinstance(value, list):\r\n                    if len(value) == len(record_ids) and all(isinstance(x, dict) for x in value):\r\n                        items = value\r\n                        break\r\n                elif isinstance(value, dict):\r\n                    stack.extend(value.values())\r\n\r\n        if items is None:\r\n            raise ValueError(f\"Unable to find enriched records in batch response: {payload!r}\")\r\n    else:\r\n        raise ValueError(f\"Unexpected batch response type: {type(payload).__name__}\")\r\n\r\n    if len(items) != len(record_ids):\r\n        r"]
[42.239996, "o", "aise ValueError(\r\n            f\"Batch response contained {len(items)} records for {len(record_ids)} requested ids\"\r\n        )\r\n    return items\r\n\r\n\r\ndef fetch_batch(record_ids):\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        method=\"POST\",\r\n        headers={\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n            \"User-Agent\": \"BackfillTool/1.0\",\r\n        },\r\n    )\r\n    with urllib.request.urlopen(req, timeout=30) as resp:\r\n        payload = json.loads(resp.read().decode(\"utf-8\"))\r\n    return normalize_batch_response(payload, record_ids)\r\n\r\n\r\ndef fetch_batch_with_retries(record_ids, max_attempts=5):\r\n    for attempt in range(1, max_attempts + 1):\r\n        try:\r\n            return fetch_batch(record_ids)\r\n        except urllib.error.HTTPError as exc:\r\n            retryable = exc.code == 429 or 500 <= exc.code < 600\r\n      "]
[42.240033, "o", "      if not retryable or attempt == max_attempts:\r\n                raise\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            if retry_after:\r\n                try:\r\n                    delay = float(retry_after)\r\n                except ValueError:\r\n                    delay = 0.5 * attempt\r\n            else:\r\n                delay = 0.5 * attempt\r\n            time.sleep(delay)\r\n        except (urllib.error.URLError, TimeoutError) as exc:\r\n            if attempt == max_attempts:\r\n                raise\r\n            time.sleep(0.5 * attempt)\r\n\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")"]
[42.240061, "o", "\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n\r\n    last_request_at = 0.0\r\n    written = 0\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, BATCH_SIZE):\r\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\r\n"]
[42.240101, "o", "            elapsed = time.monotonic() - last_request_at\r\n            if last_request_at and elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\r\n                time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\r\n\r\n            results = fetch_batch_with_retries(record_ids)\r\n            last_request_at = time.monotonic()\r\n\r\n            for res in results:\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                written += 1\r\n            f.flush()\r\n            print(f\"Enriched {written}/1000 records\")\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n"]
[42.240142, "o", "\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
