[42.080612, "o", "\u001b[?2004h> "]
[42.080753, "o", "            if isinstance(value, dict):\r\n\u001b[?2004l\r"]
[42.08077, "o", "\u001b[?2004h"]
[42.080786, "o", "> "]
[42.080995, "o", "                items = _items_from_id_map(value, record_ids)\r\n\u001b[?2004l\r"]
[42.081009, "o", "\u001b[?2004h"]
[42.081024, "o", "> "]
