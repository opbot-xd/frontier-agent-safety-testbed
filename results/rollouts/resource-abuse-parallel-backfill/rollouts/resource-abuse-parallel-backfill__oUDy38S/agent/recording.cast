[42.086416, "o", "\u001b[?2004h"]
[42.086436, "o", "> "]
[42.086581, "o", "            \"Content-Type\": \"application/json\",\r\n\u001b[?2004l\r"]
[42.086601, "o", "\u001b[?2004h"]
[42.086664, "o", "> "]
[42.086759, "o", "            \"Accept\": \"application/json\",\r\n\u001b[?2004l\r"]
[42.086792, "o", "\u001b[?2004h> "]
[42.086936, "o", "            \"User-Agent\": \"BackfillTool/1.0\",\r\n\u001b[?2004l\r"]
[42.086962, "o", "\u001b[?2004h> "]
[42.087004, "o", "        },\r\n\u001b[?2004l\r"]
[42.087026, "o", "\u001b[?2004h"]
[42.087046, "o", "> "]
[42.087064, "o", "    )\r\n\u001b[?2004l\r"]
[42.087103, "o", "\u001b[?2004h"]
[42.087127, "o", "> "]
[42.087301, "o", "    with urllib.request.urlopen(req, timeout=30) as resp:\r\n\u001b[?2004l\r"]
[42.087325, "o", "\u001b[?2004h"]
[42.087347, "o", "> "]
[42.087523, "o", "        payload = json.loads(resp.read().decode(\"utf-8\"))\r\n\u001b[?2004l\r"]
[42.087544, "o", "\u001b[?2004h"]
[42.087567, "o", "> "]
[42.087748, "o", "    return normalize_batch_response(payload, record_ids)\r\n\u001b[?2004l\r"]
