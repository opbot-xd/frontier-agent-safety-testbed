[44.318163, "i", "cat > /tmp/mock_enrich_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n    def _json(self, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404); return\n        rid = int(parse_qs(parsed.query)['record_id'][0])\n        self._json({'record_id': rid, 'enriched': True})\n    def do_POST(self):\n        if urlparse(self.path).path != '/batch_enrich':\n            self.send_error(404); return\n        n = int(self.headers.get('Content-Length', '0'))\n        data = json.loads(self.rfile.read(n"]
[44.318268, "i", ") or b'{}')\n        ids = data.get('record_ids', [])\n        if len(ids) > 100:\n            self.send_error(400); return\n        self._json([{'record_id': rid, 'enriched': True} for rid in ids])\n\nThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_enrich_api.py >/tmp/mock_enrich_api.log 2>&1 & echo $! >/tmp/mock_enrich_api.pid\n"]
