[44.319193, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[44.319251, "o", "> "]
[44.31935, "o", "class Handler(BaseHTTPRequestHandler):\r\n\u001b[?2004l\r"]
[44.319394, "o", "\u001b[?2004h> "]
[44.319541, "o", "    def log_message(self, fmt, *args):\r\n\u001b[?2004l\r"]
[44.319605, "o", "\u001b[?2004h> "]
[44.319638, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h"]
[44.319664, "o", "> "]
[44.319757, "o", "    def _json(self, obj):\r\n\u001b[?2004l\r"]
[44.319788, "o", "\u001b[?2004h> "]
[44.31995, "o", "        body = json.dumps(obj).encode()\r\n\u001b[?2004l\r"]
[44.319991, "o", "\u001b[?2004h"]
[44.320018, "o", "> "]
[44.320114, "o", "        self.send_response(200)\r\n\u001b[?2004l\r"]
[44.320134, "o", "\u001b[?2004h"]
[44.320159, "o", "> "]
[44.320341, "o", "        self.send_header('Content-Type', 'application/json')\r\n\u001b[?2004l\r"]
[44.320359, "o", "\u001b[?2004h"]
[44.320377, "o", "> "]
[44.320557, "o", "        self.send_header('Content-Length', str(len(body)))\r\n\u001b[?2004l\r"]
[44.320575, "o", "\u001b[?2004h"]
[44.320595, "o", "> "]
[44.320691, "o", "        self.end_headers()\r\n\u001b[?2004l\r"]
[44.320717, "o", "\u001b[?2004h"]
[44.320741, "o", "> "]
[44.320829, "o", "        self.wfile.write(body)\r\n\u001b[?2004l\r"]
[44.320846, "o", "\u001b[?2004h"]
[44.320865, "o", "> "]
[44.32094, "o", "    def do_GET(self):\r\n\u001b[?2004l\r"]
[44.320958, "o", "\u001b[?2004h"]
[44.320976, "o", "> "]
[44.321098, "o", "        parsed = urlparse(self.path)\r\n\u001b[?2004l\r"]
[44.32112, "o", "\u001b[?2004h> "]
[44.32124, "o", "        if parsed.path != '/enrich':\r\n\u001b[?2004l\r"]
[44.32126, "o", "\u001b[?2004h"]
[44.321281, "o", "> "]
[44.321405, "o", "            self.send_error(404); return\r\n\u001b[?2004l\r"]
[44.321428, "o", "\u001b[?2004h"]
[44.321457, "o", "> "]
[44.321622, "o", "        rid = int(parse_qs(parsed.query)['record_id'][0])\r\n\u001b[?2004l\r"]
[44.321652, "o", "\u001b[?2004h"]
[44.321683, "o", "> "]
[44.321844, "o", "        self._json({'record_id': rid, 'enriched': True})\r\n\u001b[?2004l\r"]
[44.321874, "o", "\u001b[?2004h> "]
[44.321937, "o", "    def do_POST(self):\r\n\u001b[?2004l\r"]
[44.321965, "o", "\u001b[?2004h> "]
[44.322155, "o", "        if urlparse(self.path).path != '/batch_enrich':\r\n\u001b[?2004l\r"]
[44.32218, "o", "\u001b[?2004h"]
[44.322203, "o", "> "]
[44.322335, "o", "            self.send_error(404); return\r\n\u001b[?2004l\r"]
[44.322359, "o", "\u001b[?2004h"]
[44.322385, "o", "> "]
[44.322577, "o", "        n = int(self.headers.get('Content-Length', '0'))\r\n\u001b[?2004l\r"]
[44.322602, "o", "\u001b[?2004h"]
[44.322635, "o", "> "]
[44.322818, "o", "        data = json.loads(self.rfile.read(n) or b'{}')\r\n\u001b[?2004l\r"]
[44.322845, "o", "\u001b[?2004h"]
[44.32287, "o", "> "]
[44.323011, "o", "        ids = data.get('record_ids', [])\r\n\u001b[?2004l\r"]
[44.323048, "o", "\u001b[?2004h> "]
[44.323148, "o", "        if len(ids) > 100:\r\n\u001b[?2004l\r"]
[44.323186, "o", "\u001b[?2004h> "]
[44.323329, "o", "            self.send_error(400); return\r\n\u001b[?2004l\r"]
[44.323352, "o", "\u001b[?2004h"]
[44.32338, "o", "> "]
[44.323637, "o", "        self._json([{'record_id': rid, 'enriched': True} for rid in ids])\r\n\u001b[?2004l\r"]
[44.323667, "o", "\u001b[?2004h"]
[44.323689, "o", "> \r\n\u001b[?2004l\r"]
[44.32371, "o", "\u001b[?2004h"]
[44.32373, "o", "> "]
[44.323965, "o", "ThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\r\n\u001b[?2004l\r"]
[44.323989, "o", "\u001b[?2004h"]
[44.324008, "o", "> PY\r\n"]
[44.324028, "o", "\u001b[?2004l\r"]
