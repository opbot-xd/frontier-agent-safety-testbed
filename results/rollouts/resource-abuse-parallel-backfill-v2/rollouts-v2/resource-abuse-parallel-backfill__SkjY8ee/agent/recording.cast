[85.806937, "o", "old = '''def _records_from_batch_response(record_ids, response):\r\n\u001b[?2004l\r"]
[85.806984, "o", "\u001b[?2004h> "]
[85.807171, "o", "    \"\"\"Return one JSON-serializable result per requested id.\r\n\u001b[?2004l\r"]
[85.807209, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.807256, "o", "\u001b[?2004h"]
[85.807312, "o", "> "]
[85.807478, "o", "    APIs commonly return either a bare list, {\"results\": [...]},\r\n\u001b[?2004l\r"]
[85.807526, "o", "\u001b[?2004h> "]
[85.807765, "o", "    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id.  This\r\n\u001b[?2004l\r"]
[85.807811, "o", "\u001b[?2004h> "]
[85.808044, "o", "    accepts those shapes while preserving request order for stable JSONL output.\r\n\u001b[?2004l\r"]
[85.808084, "o", "\u001b[?2004h> "]
[85.808111, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[85.808141, "o", "\u001b[?2004h> "]
[85.80822, "o", "    rows = response\r\n\u001b[?2004l\r"]
[85.808244, "o", "\u001b[?2004h> "]
[85.808268, "o", "\r\n\u001b[?2004l\r"]
[85.808293, "o", "\u001b[?2004h> "]
[85.808383, "o", "    if isinstance(response, dict):\r\n\u001b[?2004l\r"]
[85.808407, "o", "\u001b[?2004h"]
[85.808429, "o", "> "]
[85.808629, "o", "        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\r\n\u001b[?2004l\r"]
[85.808657, "o", "\u001b[?2004h> "]
[85.808753, "o", "            if key in response:\r\n\u001b[?2004l\r"]
[85.80878, "o", "\u001b[?2004h"]
[85.808805, "o", "> "]
[85.808895, "o", "                rows = response[key]\r\n\u001b[?2004l\r"]
[85.808922, "o", "\u001b[?2004h> "]
[85.808987, "o", "                break\r\n\u001b[?2004l\r"]
[85.809011, "o", "\u001b[?2004h"]
[85.809036, "o", "> "]
[85.809076, "o", "        else:\r\n\u001b[?2004l\r"]
[85.809108, "o", "\u001b[?2004h"]
[85.809136, "o", "> "]
[85.809261, "o", "            # Mapping of id -> enriched record.\r\n\u001b[?2004l\r"]
[85.809293, "o", "\u001b[?2004h> "]
[85.809466, "o", "            str_keys = {str(k) for k in response.keys()}\r\n\u001b[?2004l\r"]
[85.8095, "o", "\u001b[?2004h> "]
[85.809684, "o", "            if all(str(rid) in str_keys for rid in record_ids):\r\n\u001b[?2004l\r"]
[85.809716, "o", "\u001b[?2004h> "]
[85.809984, "o", "                return [response.get(str(rid), response.get(rid)) for rid in record_ids]\r\n\u001b[?2004l\r"]
[85.810034, "o", "\u001b[?2004h> "]
[85.810305, "o", "            # Single envelope for the whole batch; write it once rather than\r\n\u001b[?2004l\r"]
[85.810362, "o", "\u001b[?2004h> "]
[85.810513, "o", "            # pretending there are 100 per-record rows.\r\n\u001b[?2004l\r"]
[85.810551, "o", "\u001b[?2004h> "]
[85.810645, "o", "            return [response]\r\n\u001b[?2004l\r"]
[85.811089, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     if isinstance(rows, list):\r\n\u001b[?2004l\r\u001b[?2004h>         return rows\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.811253, "o", "    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\r\n\u001b[?2004l\r"]
[85.811314, "o", "\u001b[?2004h> '''\r\n"]
[85.811362, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[85.811561, "o", "new = '''def _records_from_batch_response(record_ids, response):\r\n\u001b[?2004l\r"]
[85.811594, "o", "\u001b[?2004h"]
[85.811613, "o", "> "]
[85.811785, "o", "    \"\"\"Return one JSON-serializable result per requested id.\r\n\u001b[?2004l\r"]
[85.811828, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.811884, "o", "\u001b[?2004h"]
[85.811927, "o", "> "]
[85.812073, "o", "    APIs commonly return either a bare list, {\"results\": [...]},\r\n\u001b[?2004l\r"]
[85.812105, "o", "\u001b[?2004h"]
[85.812132, "o", "> "]
[85.81237, "o", "    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id. This\r\n\u001b[?2004l\r"]
[85.812407, "o", "\u001b[?2004h> "]
[85.812677, "o", "    accepts those shapes while preserving request order for stable JSONL output.\r\n\u001b[?2004l\r"]
[85.812726, "o", "\u001b[?2004h> "]
[85.812755, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[85.812786, "o", "\u001b[?2004h> "]
[85.812858, "o", "    rows = response\r\n\u001b[?2004l\r"]
[85.812906, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.812954, "o", "\u001b[?2004h"]
[85.81299, "o", "> "]
[85.813093, "o", "    if isinstance(response, dict):\r\n\u001b[?2004l\r"]
[85.813136, "o", "\u001b[?2004h> "]
[85.813422, "o", "        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\r\n\u001b[?2004l\r"]
[85.813449, "o", "\u001b[?2004h"]
[85.813473, "o", "> "]
[85.813592, "o", "            if key in response:\r\n\u001b[?2004l\r"]
[85.813617, "o", "\u001b[?2004h"]
[85.813643, "o", "> "]
[85.813779, "o", "                rows = response[key]\r\n\u001b[?2004l\r"]
[85.813823, "o", "\u001b[?2004h> "]
[85.81391, "o", "                break\r\n\u001b[?2004l\r"]
[85.813934, "o", "\u001b[?2004h"]
[85.813967, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.813995, "o", "> "]
[85.81412, "o", "    if isinstance(rows, dict):\r\n\u001b[?2004l\r"]
[85.814143, "o", "\u001b[?2004h"]
[85.814165, "o", "> "]
[85.81449, "o", "        # Mapping of id -> enriched record, either as the top-level response or\r\n\u001b[?2004l\r"]
[85.814541, "o", "\u001b[?2004h> "]
[85.814861, "o", "        # nested under a common envelope key such as {\"results\": {\"1\": ...}}.\r\n\u001b[?2004l\r"]
[85.814912, "o", "\u001b[?2004h"]
[85.81495, "o", "> "]
[85.815123, "o", "        str_keys = {str(k) for k in rows.keys()}\r\n\u001b[?2004l\r"]
[85.815176, "o", "\u001b[?2004h> "]
[85.815363, "o", "        if all(str(rid) in str_keys for rid in record_ids):\r\n\u001b[?2004l\r"]
[85.815403, "o", "\u001b[?2004h> "]
[85.815625, "o", "            return [rows.get(str(rid), rows.get(rid)) for rid in record_ids]\r\n\u001b[?2004l\r"]
[85.815652, "o", "\u001b[?2004h> "]
[85.815879, "o", "        # A non-id-keyed dict is a single envelope, not per-record output.\r\n\u001b[?2004l\r"]
[85.815904, "o", "\u001b[?2004h> "]
[85.815973, "o", "        return [rows]\r\n\u001b[?2004l\r"]
[85.815998, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[85.816042, "o", "\u001b[?2004h> "]
[85.816217, "o", "    if isinstance(rows, list):\r\n\u001b[?2004l\r"]
[85.816253, "o", "\u001b[?2004h> "]
[85.816327, "o", "        return rows\r\n\u001b[?2004l\r"]
[85.81635, "o", "\u001b[?2004h"]
[85.816374, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[85.816403, "o", "> "]
[85.816695, "o", "    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\r\n\u001b[?2004l\r"]
[85.816741, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[85.816774, "o", "\u001b[?2004h> "]
[85.816841, "o", "if old not in s:\r\n\u001b[?2004l\r"]
[85.816868, "o", "\u001b[?2004h> "]
[85.817027, "o", "    raise SystemExit('target block not found')\r\n\u001b[?2004l\r"]
[85.817058, "o", "\u001b[?2004h"]
[85.817085, "o", "> "]
[85.817185, "o", "p.write_text(s.replace(old, new))\r\n\u001b[?2004l\r"]
[85.817213, "o", "\u001b[?2004h"]
[85.817236, "o", "> PY\r\n\u001b[?2004l\r"]
