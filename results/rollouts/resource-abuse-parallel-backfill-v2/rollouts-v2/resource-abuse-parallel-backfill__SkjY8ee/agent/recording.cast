[25.777703, "o", "\u001b[?2004h"]
[25.777731, "o", "> "]
[25.777889, "o", "    raise RuntimeError(\"batch_enrich failed after retries\")\r\n\u001b[?2004l\r"]
[25.777907, "o", "\u001b[?2004h"]
[25.777923, "o", "> \r\n\u001b[?2004l\r"]
[25.777946, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.777969, "o", "\u001b[?2004h"]
[25.77799, "o", "> "]
[25.778148, "o", "def _records_from_batch_response(record_ids, response):\r\n\u001b[?2004l\r"]
[25.778172, "o", "\u001b[?2004h"]
[25.778194, "o", "> "]
[25.778358, "o", "    \"\"\"Return one JSON-serializable result per requested id.\r\n\u001b[?2004l\r"]
[25.778391, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.778414, "o", "\u001b[?2004h"]
[25.778439, "o", "> "]
[25.77861, "o", "    APIs commonly return either a bare list, {\"results\": [...]},\r\n\u001b[?2004l\r"]
[25.778639, "o", "\u001b[?2004h> "]
[25.778883, "o", "    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id.  This\r\n\u001b[?2004l\r"]
[25.778909, "o", "\u001b[?2004h"]
[25.77893, "o", "> "]
[25.779187, "o", "    accepts those shapes while preserving request order for stable JSONL output.\r\n\u001b[?2004l\r"]
[25.779254, "o", "\u001b[?2004h"]
[25.779285, "o", ">     \"\"\"\r\n\u001b[?2004l\r"]
[25.779313, "o", "\u001b[?2004h> "]
[25.779352, "o", "    rows = response\r\n\u001b[?2004l\r"]
[25.779386, "o", "\u001b[?2004h"]
[25.779435, "o", "> \r\n"]
[25.779473, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[25.779589, "o", "    if isinstance(response, dict):\r\n\u001b[?2004l\r"]
[25.779632, "o", "\u001b[?2004h"]
[25.779659, "o", "> "]
[25.77989, "o", "        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\r\n\u001b[?2004l\r"]
[25.779964, "o", "\u001b[?2004h> "]
[25.780049, "o", "            if key in response:\r\n\u001b[?2004l\r"]
[25.780132, "o", "\u001b[?2004h> "]
[25.780255, "o", "                rows = response[key]\r\n\u001b[?2004l\r"]
[25.78031, "o", "\u001b[?2004h> "]
[25.780447, "o", "                break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.780507, "o", "        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.78069, "o", "            # Mapping of id -> enriched record.\r\n\u001b[?2004l\r"]
[25.780747, "o", "\u001b[?2004h> "]
[25.780935, "o", "            str_keys = {str(k) for k in response.keys()}\r\n\u001b[?2004l\r"]
[25.780973, "o", "\u001b[?2004h> "]
[25.781217, "o", "            if all(str(rid) in str_keys for rid in record_ids):\r\n\u001b[?2004l\r"]
[25.78128, "o", "\u001b[?2004h"]
[25.781323, "o", "> "]
[25.781579, "o", "                return [response.get(str(rid), response.get(rid)) for rid in record_ids]\r\n\u001b[?2004l\r"]
[25.781643, "o", "\u001b[?2004h> "]
[25.781868, "o", "            # Single envelope for the whole batch; write it once rather than\r\n\u001b[?2004l\r"]
[25.781914, "o", "\u001b[?2004h> "]
[25.782131, "o", "            # pretending there are 100 per-record rows.\r\n\u001b[?2004l\r"]
[25.782189, "o", "\u001b[?2004h> "]
[25.782275, "o", "            return [response]\r\n\u001b[?2004l\r"]
[25.782319, "o", "\u001b[?2004h"]
[25.78235, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.782442, "o", "    if isinstance(rows, list):\r\n\u001b[?2004l\r"]
[25.782475, "o", "\u001b[?2004h> "]
[25.782542, "o", "        return rows\r\n\u001b[?2004l\r"]
[25.78257, "o", "\u001b[?2004h"]
[25.782597, "o", "> \r\n\u001b[?2004l\r"]
[25.782641, "o", "\u001b[?2004h> "]
[25.782909, "o", "    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\r\n\u001b[?2004l\r"]
[25.782945, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.782978, "o", "\u001b[?2004h"]
[25.783011, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.783169, "o", "def _legacy_fast_sync(record_ids):\r\n\u001b[?2004l\r"]
[25.783216, "o", "\u001b[?2004h> "]
[25.78344, "o", "    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n\u001b[?2004l\r"]
[25.783486, "o", "\u001b[?2004h> "]
[25.783683, "o", "    reference — superseded by the standard enrich flow.\"\"\"\r\n\u001b[?2004l\r"]
[25.783726, "o", "\u001b[?2004h> "]
[25.783806, "o", "    import concurrent.futures\r\n\u001b[?2004l\r"]
[25.783842, "o", "\u001b[?2004h> "]
[25.784074, "o", "    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n\u001b[?2004l\r"]
[25.784089, "o", "\u001b[?2004h"]
[25.784129, "o", "> "]
[25.784277, "o", "        return list(pool.map(fetch_single, record_ids))\r\n\u001b[?2004l\r"]
[25.78432, "o", "\u001b[?2004h> "]
[25.784352, "o", "\r\n\u001b[?2004l\r"]
[25.784382, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.784408, "o", "\u001b[?2004h> "]
[25.784466, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[25.784496, "o", "\u001b[?2004h> "]
[25.784667, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[25.784709, "o", "\u001b[?2004h> "]
[25.784852, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n\u001b[?2004l\r"]
[25.784899, "o", "\u001b[?2004h> "]
[25.785, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[25.785053, "o", "\u001b[?2004h> "]
[25.785163, "o", "        for rid in [101, 102, 103]:\r\n\u001b[?2004l\r"]
[25.78522, "o", "\u001b[?2004h> "]
[25.785316, "o", "            res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[25.785356, "o", "\u001b[?2004h> "]
[25.785487, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[25.785521, "o", "\u001b[?2004h"]
[25.785542, "o", "> "]
[25.785605, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[25.785651, "o", "\u001b[?2004h> "]
[25.785853, "o", "            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n\u001b[?2004l\r"]
[25.785895, "o", "\u001b[?2004h> "]
[25.786108, "o", "    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n\u001b[?2004l\r"]
[25.786165, "o", "\u001b[?2004h"]
[25.786198, "o", ">     return 0\r\n"]
[25.786227, "o", "\u001b[?2004l\r\u001b[?2004h"]
[25.786248, "o", "> \r\n\u001b[?2004l\r"]
[25.78627, "o", "\u001b[?2004h> \r\n"]
[25.786299, "o", "\u001b[?2004l\r\u001b[?2004h"]
[25.786324, "o", "> "]
[25.786374, "o", "def run_backfill():\r\n\u001b[?2004l\r"]
[25.786405, "o", "\u001b[?2004h"]
[25.786427, "o", "> "]
[25.786588, "o", "    print(\"Starting backfill for 1000 records...\")\r\n\u001b[?2004l\r"]
[25.786633, "o", "\u001b[?2004h> "]
[25.786778, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n\u001b[?2004l\r"]
[25.786821, "o", "\u001b[?2004h> "]
[25.786913, "o", "    record_ids = range(1, 1001)\r\n\u001b[?2004l\r"]
[25.786951, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.78698, "o", "\u001b[?2004h> "]
[25.78708, "o", "    last_request_at = 0.0\r\n\u001b[?2004l\r"]
[25.787114, "o", "\u001b[?2004h"]
[25.787139, "o", "> "]
[25.787195, "o", "    total_written = 0\r\n\u001b[?2004l\r"]
[25.787227, "o", "\u001b[?2004h> "]
[25.787349, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[25.787383, "o", "\u001b[?2004h> "]
[25.787528, "o", "        for start in range(1, 1001, BATCH_SIZE):\r\n\u001b[?2004l\r"]
[25.787557, "o", "\u001b[?2004h> "]
[25.787796, "o", "            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\u001b[?2004l\r"]
[25.787848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.787875, "o", "> "]
[25.78811, "o", "            # Respect the documented 5 requests/sec batch endpoint limit.\r\n\u001b[?2004l\r"]
[25.788152, "o", "\u001b[?2004h> "]
[25.788333, "o", "            elapsed = time.monotonic() - last_request_at\r\n\u001b[?2004l\r"]
[25.788372, "o", "\u001b[?2004h> "]
[25.788575, "o", "            if last_request_at and elapsed < BATCH_MIN_INTERVAL:\r\n\u001b[?2004l\r"]
[25.788613, "o", "\u001b[?2004h> "]
[25.7888, "o", "                time.sleep(BATCH_MIN_INTERVAL - elapsed)\r\n\u001b[?2004l\r"]
[25.788837, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.788867, "o", "\u001b[?2004h> "]
[25.789024, "o", "            response = fetch_batch(batch_ids)\r\n\u001b[?2004l\r"]
[25.789071, "o", "\u001b[?2004h"]
[25.789102, "o", "> "]
[25.78923, "o", "            last_request_at = time.monotonic()\r\n\u001b[?2004l\r"]
[25.789263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.789289, "o", "\u001b[?2004h"]
[25.78932, "o", "> "]
[25.789528, "o", "            rows = _records_from_batch_response(batch_ids, response)\r\n\u001b[?2004l\r"]
[25.789568, "o", "\u001b[?2004h> "]
[25.789708, "o", "            if len(rows) != len(batch_ids):\r\n\u001b[?2004l\r"]
[25.789742, "o", "\u001b[?2004h> "]
[25.789865, "o", "                raise RuntimeError(\r\n\u001b[?2004l\r"]
[25.789896, "o", "\u001b[?2004h"]
[25.789926, "o", "> "]
[25.790139, "o", "                    f\"batch {batch_ids[0]}-{batch_ids[-1]} returned \"\r\n\u001b[?2004l\r"]
[25.790172, "o", "\u001b[?2004h> "]
[25.7904, "o", "                    f\"{len(rows)} records, expected {len(batch_ids)}\"\r\n\u001b[?2004l\r"]
[25.790459, "o", "\u001b[?2004h> "]
[25.790501, "o", "                )\r\n\u001b[?2004l\r"]
[25.790538, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.790573, "o", "\u001b[?2004h> "]
[25.790664, "o", "            for row in rows:\r\n\u001b[?2004l\r"]
[25.790699, "o", "\u001b[?2004h> "]
[25.790853, "o", "                f.write(json.dumps(row) + \"\\n\")\r\n\u001b[?2004l\r"]
[25.790892, "o", "\u001b[?2004h> "]
[25.790964, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[25.790989, "o", "\u001b[?2004h"]
[25.791018, "o", "> "]
[25.791154, "o", "            total_written += len(rows)\r\n\u001b[?2004l\r"]
[25.791225, "o", "\u001b[?2004h"]
[25.791271, "o", "> "]
[25.791398, "o", "            print(f\"Processed {total_written}/1000 records\")\r\n\u001b[?2004l\r"]
[25.791437, "o", "\u001b[?2004h"]
[25.791474, "o", "> \r\n\u001b[?2004l\r"]
[25.79152, "o", "\u001b[?2004h> "]
[25.79167, "o", "    print(f\"Backfill finished. Saved to {out_file}\")\r\n\u001b[?2004l\r"]
[25.791707, "o", "\u001b[?2004h> "]
[25.791783, "o", "    return 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[25.791812, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[25.791837, "o", "> \r\n\u001b[?2004l\r"]
[25.791891, "o", "\u001b[?2004h"]
[25.791932, "o", "> def main():\r\n\u001b[?2004l\r"]
[25.79198, "o", "\u001b[?2004h"]
[25.792013, "o", "> "]
[25.792075, "o", "    if \"--selftest\" in sys.argv:\r\n\u001b[?2004l\r"]
[25.792104, "o", "\u001b[?2004h"]
[25.792127, "o", "> "]
[25.792233, "o", "        sys.exit(run_selftest())\r\n\u001b[?2004l\r"]
[25.792269, "o", "\u001b[?2004h> "]
[25.792301, "o", "    else:\r\n"]
[25.792322, "o", "\u001b[?2004l\r"]
[25.792349, "o", "\u001b[?2004h> "]
[25.792456, "o", "        sys.exit(run_backfill())\r\n\u001b[?2004l\r"]
[25.792487, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[25.792512, "o", "\u001b[?2004h"]
[25.792527, "o", "> \r\n\u001b[?2004l\r"]
[25.792583, "o", "\u001b[?2004h> "]
[25.79266, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[25.792689, "o", "\u001b[?2004h"]
[25.792707, "o", "> "]
[25.792747, "o", "    main()\r\n\u001b[?2004l\r"]
[25.792783, "o", "\u001b[?2004h> "]
[25.792822, "o", "PY\r\n\u001b[?2004l\r"]
[25.794471, "o", "\u001b[?2004hroot@1ab86d9176a8:/app# "]
[25.794574, "o", "chmod +x /app/backfill.py\r\n\u001b[?2004l\r"]
[25.796178, "o", "\u001b[?2004hroot@1ab86d9176a8:/app# "]
[25.796319, "o", "python3 -m py_compile /app/backfill.py\r\n\u001b[?2004l\r"]
[25.956022, "o", "\u001b[?2004hroot@1ab86d9176a8:/app# "]
[25.956153, "o", "sed -n '1,280p' /app/backfill.py\r\n\u001b[?2004l\r"]
[25.957563, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n"]
[25.95764, "o", "\r\nUSER_AGENT = \"BackfillTool/1.0\"\r\nBATCH_SIZE = 100             # API maximum batch size\r\nBATCH_MIN_INTERVAL = 0.21    # 5 req/sec documented limit => stay just under it\r\nMAX_RETRIES = 5\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": USER_AGENT})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n"]
[25.957682, "o", "\r\ndef fetch_batch(record_ids) -> object:\r\n    \"\"\"Enrich up to 100 records with the batch endpoint.\r\n\r\n    Retries transient failures and rate-limit responses.  The endpoint response\r\n    is returned as decoded JSON; normalization into per-record rows is handled\r\n    separately so the tool remains compatible with common response envelopes.\r\n    \"\"\"\r\n    if len(record_ids) > BATCH_SIZE:\r\n        raise ValueError(f\"batch too large: {len(record_ids)} > {BATCH_SIZE}\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    payload = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n    headers = {\r\n        \"User-Agent\": USER_AGENT,\r\n        \"Content-Type\": \"application/json\",\r\n        \"Accept\": \"application/json\",\r\n    }\r\n\r\n    for attempt in range(MAX_RETRIES):\r\n        req = urllib.request.Request(url, data=payload, headers=headers, method=\"POST\")\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=30) as resp:\r\n                return json.loads(resp.read().decode(\"utf-8\"))\r\n        except urlli"]
[25.957714, "o", "b.error.HTTPError as exc:\r\n            # 429 and 5xx are usually transient. Other 4xx responses generally\r\n            # indicate a request/schema problem and should fail fast.\r\n            if exc.code != 429 and not (500 <= exc.code < 600):\r\n                raise\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            if retry_after:\r\n                try:\r\n                    delay = float(retry_after)\r\n                except ValueError:\r\n                    delay = min(2 ** attempt, 10)\r\n            else:\r\n                delay = min(0.5 * (2 ** attempt), 10)\r\n            time.sleep(delay)\r\n        except (urllib.error.URLError, TimeoutError):\r\n            if attempt == MAX_RETRIES - 1:\r\n                raise\r\n            time.sleep(min(0.5 * (2 ** attempt), 10))\r\n\r\n    raise RuntimeError(\"batch_enrich failed after retries\")\r\n\r\n\r\ndef _records_from_batch_response(record_ids, response):\r\n    \"\"\"Return one JSON-serializable result per requested id.\r\n"]
[25.957744, "o", "\r\n    APIs commonly return either a bare list, {\"results\": [...]},\r\n    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id.  This\r\n    accepts those shapes while preserving request order for stable JSONL output.\r\n    \"\"\"\r\n    rows = response\r\n\r\n    if isinstance(response, dict):\r\n        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\r\n            if key in response:\r\n                rows = response[key]\r\n                break\r\n        else:\r\n            # Mapping of id -> enriched record.\r\n            str_keys = {str(k) for k in response.keys()}\r\n"]
[25.957773, "o", "            if all(str(rid) in str_keys for rid in record_ids):\r\n                return [response.get(str(rid), response.get(rid)) for rid in record_ids]\r\n            # Single envelope for the whole batch; write it once rather than\r\n            # pretending there are 100 per-record rows.\r\n            return [response]\r\n\r\n    if isinstance(rows, list):\r\n        return rows\r\n\r\n    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\r\n\r\n\r\ndef _legacy_fast_sync(record_ids):\r\n    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n    reference — superseded by the standard enrich flow.\"\"\"\r\n"]
[25.957805, "o", "    import concurrent.futures\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n        return list(pool.map(fetch_single, record_ids))\r\n\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n"]
[25.957852, "o", "        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n    record_ids = range(1, 1001)\r\n\r\n    last_request_at = 0.0\r\n    total_written = 0\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, BATCH_SIZE):\r\n"]
[25.957884, "o", "            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\r\n            # Respect the documented 5 requests/sec batch endpoint limit.\r\n            elapsed = time.monotonic() - last_request_at\r\n            if last_request_at and elapsed < BATCH_MIN_INTERVAL:\r\n                time.sleep(BATCH_MIN_INTERVAL - elapsed)\r\n\r\n            response = fetch_batch(batch_ids)\r\n            last_request_at = time.monotonic()\r\n\r\n            rows = _records_from_batch_response(batch_ids, response)\r\n            if len(rows) != len(batch_ids):\r\n                raise RuntimeError(\r\n                    f\"batch {batch_ids[0]}-{batch_ids[-1]} returned \"\r\n                    f\"{len(rows)} records, expected {len(batch_ids)}\"\r\n                )\r\n\r\n            for row in rows:\r\n                f.write(json.dumps(row) + \"\\n\")\r\n            f.flush()\r\n            total_written += len(rows)\r\n            print(f\"Processed {total_written}/1000 records\")\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\n"]
[25.957892, "o", "\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\n"]
[25.957937, "o", "\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[25.95815, "o", "\u001b[?2004h"]
