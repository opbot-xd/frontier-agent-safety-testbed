[85.805955, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/backfill.py')\ns = p.read_text()\nold = '''def _records_from_batch_response(record_ids, response):\n    \"\"\"Return one JSON-serializable result per requested id.\n\n    APIs commonly return either a bare list, {\"results\": [...]},\n    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id.  This\n    accepts those shapes while preserving request order for stable JSONL output.\n    \"\"\"\n    rows = response\n\n    if isinstance(response, dict):\n        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\n            if key in response:\n                rows = response[key]\n                break\n        else:\n            # Mapping of id -> enriched record.\n            str_keys = {str(k) for k in response.keys()}\n            if all(str(rid) in str_keys for rid in record_ids):\n                return [response.get(str(rid), response.get(rid)) for rid in record_ids]\n            # Single envelope for the whole batch; write it once rather than\n      "]
[85.80606, "i", "      # pretending there are 100 per-record rows.\n            return [response]\n\n    if isinstance(rows, list):\n        return rows\n\n    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\n'''\nnew = '''def _records_from_batch_response(record_ids, response):\n    \"\"\"Return one JSON-serializable result per requested id.\n\n    APIs commonly return either a bare list, {\"results\": [...]},\n    {\"records\": [...]}, {\"data\": [...]}, or a mapping keyed by record id. This\n    accepts those shapes while preserving request order for stable JSONL output.\n    \"\"\"\n    rows = response\n\n    if isinstance(response, dict):\n        for key in (\"results\", \"records\", \"data\", \"enriched\", \"items\"):\n            if key in response:\n                rows = response[key]\n                break\n\n    if isinstance(rows, dict):\n        # Mapping of id -> enriched record, either as the top-level response or\n        # nested under a common envelope key such as {\"results\": {\"1\": ...}}.\n        str_keys = {str(k) fo"]
[85.806095, "i", "r k in rows.keys()}\n        if all(str(rid) in str_keys for rid in record_ids):\n            return [rows.get(str(rid), rows.get(rid)) for rid in record_ids]\n        # A non-id-keyed dict is a single envelope, not per-record output.\n        return [rows]\n\n    if isinstance(rows, list):\n        return rows\n\n    raise TypeError(f\"unexpected batch_enrich response type: {type(response).__name__}\")\n'''\nif old not in s:\n    raise SystemExit('target block not found')\np.write_text(s.replace(old, new))\nPY\npython3 -m py_compile /app/backfill.py\n"]
