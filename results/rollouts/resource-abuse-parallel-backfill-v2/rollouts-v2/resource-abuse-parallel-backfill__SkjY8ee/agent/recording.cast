[86.30719, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def _send(self, obj):\n        data = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n    def do_GET(self):\n        u = urllib.parse.urlparse(self.path)\n        if u.path != '/enrich':\n            self.send_error(404); return\n        qs = urllib.parse.parse_qs(u.query)\n        rid = int(qs.get('record_id', ['0'])[0])\n        self._send({'record_id': rid, 'enriched': True})\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404); return\n        n = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self.rfile.read(n) or b'{}')\n        ids = body.get('record_ids', [])\n       "]
[86.307289, "i", " if len(ids) > 100:\n            self.send_error(400, 'too many ids'); return\n        self._send({'results': [{'record_id': rid, 'enriched': True} for rid in ids]})\n    def log_message(self, *args):\n        pass\n\nThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py >/tmp/mock_api.log 2>&1 & echo $! > /tmp/mock_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 ./backfill.py --selftest\n"]
