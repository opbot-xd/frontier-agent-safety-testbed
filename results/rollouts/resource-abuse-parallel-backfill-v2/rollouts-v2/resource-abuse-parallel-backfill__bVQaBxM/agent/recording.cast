[68.999159, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nimport urllib.parse\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send(self, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urllib.parse.urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        qs = urllib.parse.parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        self._send({'record_id': rid, 'enriched': True, 'source': 'single'})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n      "]
[68.999283, "i", "  payload = json.loads(self.rfile.read(length) or b'{}')\n        ids = payload.get('record_ids', [])\n        if len(ids) > 100:\n            self.send_error(400, 'too many record_ids')\n            return\n        self._send({'results': [{'record_id': rid, 'enriched': True, 'source': 'batch'} for rid in ids]})\n\nHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py & mock_pid=$!\nsleep 0.2\nrm -f /tmp/enriched_records.jsonl /tmp/selftest_enriched.jsonl\nstart=$(python3 - <<'PY'\nimport time\nprint(time.time())\nPY\n)\nAPI_BASE=http://127.0.0.1:18080 /app/backfill.py\nend=$(python3 - <<'PY'\nimport time\nprint(time.time())\nPY\n)\npython3 - <<PY\nstart = float('$start')\nend = float('$end')\nprint(f'backfill_duration_seconds={end-start:.3f}')\nPY\nwc -l /tmp/enriched_records.jsonl\nhead -n 2 /tmp/enriched_records.jsonl\ntail -n 2 /tmp/enriched_records.jsonl\nAPI_BASE=http://127.0.0.1:18080 /app/backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\ncat /tmp/selftest_enriched.jsonl\nkill $mock_pid\nwait "]
[68.999327, "i", "$mock_pid 2>/dev/null || true\n"]
