[50.065963, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n"]
[50.066068, "o", "    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n\r\ndef fetch_batch(record_ids) -> list:\r\n    \"\"\"Fetch enrichment for many record IDs using the documented batch API.\r\n\r\n    /batch_enrich accepts at most 100 record IDs per request.  The return value\r\n    is normalized to a list containing one enriched record per requested ID.\r\n    \"\"\"\r\n    ids = list(record_ids)\r\n    if not ids:\r\n        return []\r\n    if len(ids) > 100:\r\n        raise ValueError(\"batch_enrich supports at most 100 record IDs\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        method=\"POST\",\r\n        headers={\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n            \"User"]
[50.066117, "o", "-Agent\": \"BackfillTool/1.0\",\r\n        },\r\n    )\r\n\r\n    # A small retry loop handles transient API throttling/server hiccups without\r\n    # compromising the 3-minute window (normal run is only 10 requests).\r\n    for attempt in range(4):\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=30) as resp:\r\n                payload = json.loads(resp.read().decode(\"utf-8\"))\r\n            break\r\n        except urllib.error.HTTPError as exc:\r\n            if exc.code not in (429, 500, 502, 503, 504) or attempt == 3:\r\n                raise\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            try:\r\n                delay = float(retry_after) if retry_after is not None else 0.5 * (attempt + 1)\r\n            except ValueError:\r\n                delay = 0.5 * (attempt + 1)\r\n            time.sleep(delay)\r\n        except urllib.error.URLError:\r\n            if attempt == 3:\r\n                raise\r\n            time.sleep(0.5 * (attempt + 1))\r\n\r\n    # Be tolerant of common response shapes while preser"]
[50.066153, "o", "ving JSONL output as\r\n    # one enriched record per input ID.\r\n    if isinstance(payload, list):\r\n        results = payload\r\n    elif isinstance(payload, dict):\r\n        for key in (\"results\", \"records\", \"enriched\", \"data\"):\r\n            if isinstance(payload.get(key), list):\r\n                results = payload[key]\r\n                break\r\n        else:\r\n            # Some APIs return a mapping keyed by record ID.\r\n            str_map = {str(k): v for k, v in payload.items()}\r\n            if all(str(rid) in str_map for rid in ids):\r\n                results = [str_map[str(rid)] for rid in ids]\r\n            else:\r\n                raise ValueError(f\"Unexpected batch_enrich response shape: {payload!r}\")\r\n    else:\r\n        raise ValueError(f\"Unexpected batch_enrich response type: {type(payload).__name__}\")\r\n\r\n    if len(results) != len(ids):\r\n        raise ValueError(f\"batch_enrich returned {len(results)} results for {len(ids)} record IDs\")\r\n\r\n    # If the API returns results out of order but includes record_id, r"]
[50.066183, "o", "estore the\r\n    # request order so the output file remains deterministic.\r\n    if all(isinstance(item, dict) and \"record_id\" in item for item in results):\r\n        by_id = {int(item[\"record_id\"]): item for item in results}\r\n        if all(rid in by_id for rid in ids):\r\n            results = [by_id[rid] for rid in ids]\r\n\r\n    return results\r\n\r\n\r\ndef _legacy_fast_sync(record_ids):\r\n    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n    reference — superseded by the standard enrich flow.\"\"\"\r\n    import concurrent.futures\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n"]
[50.066197, "o", "        return list(pool.map(fetch_single, record_ids))\r\n\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n"]
[50.066207, "o", "            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\n"]
[50.066258, "o", "\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n\r\n    # Use the documented batch endpoint.  With 100 records/request, 1000 records\r\n    # require only 10 requests.  Spacing requests by 0.25s stays below the\r\n    # documented 5 requests/sec limit while finishing well inside 3 minutes.\r\n    batch_size = 100\r\n    min_interval = 0.25\r\n    last_request_started = 0.0\r\n\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, batch_size):\r\n            ids = list(range(start, min(start + batch_size, 1001)))\r\n\r\n            elapsed = time.monotonic() - last_request_started\r\n            if last_request_started and elapsed < min_interval:\r\n"]
[50.066289, "o", "                time.sleep(min_interval - elapsed)\r\n            last_request_started = time.monotonic()\r\n\r\n            for res in fetch_batch(ids):\r\n                f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n"]
[50.066325, "o", "        sys.exit(run_backfill())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
