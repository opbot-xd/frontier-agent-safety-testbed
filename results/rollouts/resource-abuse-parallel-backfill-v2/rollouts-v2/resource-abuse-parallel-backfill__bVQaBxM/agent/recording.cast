[49.964417, "o", "def fetch_batch(record_ids) -> list:\r\n\u001b[?2004l\r"]
[49.964456, "o", "\u001b[?2004h> "]
[49.964836, "o", "    \"\"\"Fetch enrichment for many record IDs using the documented batch API.\r\n\u001b[?2004l\r"]
[49.964872, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.964902, "o", "\u001b[?2004h> "]
[49.965307, "o", "    /batch_enrich accepts at most 100 record IDs per request.  The return value\r\n\u001b[?2004l\r"]
[49.965345, "o", "\u001b[?2004h> "]
[49.965636, "o", "    is normalized to a list containing one enriched record per requested ID.\r\n\u001b[?2004l\r"]
[49.965669, "o", "\u001b[?2004h> "]
[49.9657, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[49.965733, "o", "\u001b[?2004h> "]
[49.965856, "o", "    ids = list(record_ids)\r\n\u001b[?2004l\r"]
[49.965884, "o", "\u001b[?2004h"]
[49.965911, "o", "> "]
[49.965957, "o", "    if not ids:\r\n\u001b[?2004l\r"]
[49.965977, "o", "\u001b[?2004h"]
[49.966005, "o", "> "]
[49.966077, "o", "        return []\r\n\u001b[?2004l\r"]
[49.966097, "o", "\u001b[?2004h"]
[49.966126, "o", "> "]
[49.966205, "o", "    if len(ids) > 100:\r\n\u001b[?2004l\r"]
[49.966233, "o", "\u001b[?2004h> "]
[49.966622, "o", "        raise ValueError(\"batch_enrich supports at most 100 record IDs\")\r\n\u001b[?2004l\r"]
[49.966674, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.966711, "o", "\u001b[?2004h"]
[49.966737, "o", "> "]
[49.966866, "o", "    url = f\"{API_BASE}/batch_enrich\"\r\n\u001b[?2004l\r"]
[49.966909, "o", "\u001b[?2004h"]
[49.966946, "o", "> "]
[49.967128, "o", "    body = json.dumps({\"record_ids\": ids}).encode(\"utf-8\")\r\n\u001b[?2004l\r"]
[49.967171, "o", "\u001b[?2004h"]
[49.967204, "o", "> "]
[49.967283, "o", "    req = urllib.request.Request(\r\n\u001b[?2004l\r"]
[49.967311, "o", "\u001b[?2004h"]
[49.967338, "o", "> "]
[49.967383, "o", "        url,\r\n\u001b[?2004l\r"]
[49.967411, "o", "\u001b[?2004h"]
[49.967439, "o", "> "]
[49.967505, "o", "        data=body,\r\n\u001b[?2004l\r"]
[49.967526, "o", "\u001b[?2004h"]
[49.967549, "o", "> "]
[49.967632, "o", "        method=\"POST\",\r\n\u001b[?2004l\r"]
[49.967659, "o", "\u001b[?2004h"]
[49.967678, "o", "> "]
[49.967753, "o", "        headers={\r\n\u001b[?2004l\r"]
[49.967775, "o", "\u001b[?2004h"]
[49.967799, "o", "> "]
[49.967977, "o", "            \"Content-Type\": \"application/json\",\r\n\u001b[?2004l\r"]
[49.968007, "o", "\u001b[?2004h> "]
[49.968173, "o", "            \"Accept\": \"application/json\",\r\n\u001b[?2004l\r"]
[49.968205, "o", "\u001b[?2004h> "]
[49.968404, "o", "            \"User-Agent\": \"BackfillTool/1.0\",\r\n\u001b[?2004l\r"]
[49.968437, "o", "\u001b[?2004h> "]
[49.968472, "o", "        },\r\n\u001b[?2004l\r"]
[49.968501, "o", "\u001b[?2004h> "]
[49.968533, "o", "    )\r\n\u001b[?2004l\r"]
[49.968558, "o", "\u001b[?2004h"]
[49.968585, "o", "> \r\n\u001b[?2004l\r"]
[49.96861, "o", "\u001b[?2004h"]
[49.968641, "o", "> "]
[49.96892, "o", "    # A small retry loop handles transient API throttling/server hiccups without\r\n\u001b[?2004l\r"]
[49.968951, "o", "\u001b[?2004h> "]
[49.969257, "o", "    # compromising the 3-minute window (normal run is only 10 requests).\r\n\u001b[?2004l\r"]
[49.9693, "o", "\u001b[?2004h"]
[49.969327, "o", "> "]
[49.969429, "o", "    for attempt in range(4):\r\n\u001b[?2004l\r"]
[49.969477, "o", "\u001b[?2004h"]
[49.969515, "o", "> "]
[49.969552, "o", "        try:\r\n\u001b[?2004l\r"]
[49.969586, "o", "\u001b[?2004h> "]
[49.969804, "o", "            with urllib.request.urlopen(req, timeout=30) as resp:\r\n\u001b[?2004l\r"]
[49.969834, "o", "\u001b[?2004h"]
[49.969851, "o", "> "]
[49.970063, "o", "                payload = json.loads(resp.read().decode(\"utf-8\"))\r\n\u001b[?2004l\r"]
[49.970085, "o", "\u001b[?2004h"]
[49.9701, "o", "> "]
[49.970169, "o", "            break\r\n\u001b[?2004l\r"]
[49.970187, "o", "\u001b[?2004h"]
[49.970208, "o", "> "]
[49.970354, "o", "        except urllib.error.HTTPError as exc:\r\n\u001b[?2004l\r"]
[49.970378, "o", "\u001b[?2004h"]
[49.970398, "o", "> "]
[49.970637, "o", "            if exc.code not in (429, 500, 502, 503, 504) or attempt == 3:\r\n\u001b[?2004l\r"]
[49.970672, "o", "\u001b[?2004h> "]
[49.970756, "o", "                raise\r\n\u001b[?2004l\r"]
[49.97078, "o", "\u001b[?2004h"]
[49.970802, "o", "> "]
[49.970977, "o", "            retry_after = exc.headers.get(\"Retry-After\")\r\n\u001b[?2004l\r"]
[49.971, "o", "\u001b[?2004h"]
[49.971092, "o", "> "]
[49.971141, "o", "            try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.971166, "o", "> "]
[49.97144, "o", "                delay = float(retry_after) if retry_after is not None else 0.5 * (attempt + 1)\r\n\u001b[?2004l\r"]
[49.971471, "o", "\u001b[?2004h> "]
[49.971577, "o", "            except ValueError:\r\n\u001b[?2004l\r"]
[49.971601, "o", "\u001b[?2004h"]
[49.971628, "o", "> "]
[49.971768, "o", "                delay = 0.5 * (attempt + 1)\r\n\u001b[?2004l\r"]
[49.971794, "o", "\u001b[?2004h"]
[49.97182, "o", "> "]
[49.971912, "o", "            time.sleep(delay)\r\n\u001b[?2004l\r"]
[49.971938, "o", "\u001b[?2004h"]
[49.971959, "o", "> "]
[49.972099, "o", "        except urllib.error.URLError:\r\n\u001b[?2004l\r"]
[49.972121, "o", "\u001b[?2004h"]
[49.972137, "o", "> "]
[49.972235, "o", "            if attempt == 3:\r\n\u001b[?2004l\r"]
[49.972258, "o", "\u001b[?2004h"]
[49.972274, "o", "> "]
[49.972349, "o", "                raise\r\n\u001b[?2004l\r"]
[49.972369, "o", "\u001b[?2004h"]
[49.972388, "o", "> "]
[49.972528, "o", "            time.sleep(0.5 * (attempt + 1))\r\n\u001b[?2004l\r"]
[49.972547, "o", "\u001b[?2004h"]
[49.972574, "o", "> \r\n\u001b[?2004l\r"]
[49.972596, "o", "\u001b[?2004h"]
[49.972613, "o", "> "]
[49.972852, "o", "    # Be tolerant of common response shapes while preserving JSONL output as\r\n\u001b[?2004l\r"]
[49.972874, "o", "\u001b[?2004h"]
[49.972891, "o", "> "]
[49.973033, "o", "    # one enriched record per input ID.\r\n\u001b[?2004l\r"]
[49.973057, "o", "\u001b[?2004h"]
[49.973077, "o", "> "]
[49.973184, "o", "    if isinstance(payload, list):\r\n\u001b[?2004l\r"]
[49.973204, "o", "\u001b[?2004h"]
[49.973216, "o", "> "]
[49.973308, "o", "        results = payload\r\n\u001b[?2004l\r"]
[49.973325, "o", "\u001b[?2004h"]
[49.973345, "o", "> "]
[49.973461, "o", "    elif isinstance(payload, dict):\r\n\u001b[?2004l\r"]
[49.973479, "o", "\u001b[?2004h"]
[49.973491, "o", "> "]
[49.973694, "o", "        for key in (\"results\", \"records\", \"enriched\", \"data\"):\r\n\u001b[?2004l\r"]
[49.973721, "o", "\u001b[?2004h"]
[49.973739, "o", "> "]
[49.973897, "o", "            if isinstance(payload.get(key), list):\r\n\u001b[?2004l\r"]
[49.973919, "o", "\u001b[?2004h"]
[49.973933, "o", "> "]
[49.974074, "o", "                results = payload[key]\r\n\u001b[?2004l\r"]
[49.974099, "o", "\u001b[?2004h"]
[49.974115, "o", "> "]
[49.974186, "o", "                break\r\n\u001b[?2004l\r"]
[49.974209, "o", "\u001b[?2004h"]
[49.974226, "o", "> "]
[49.974278, "o", "        else:\r\n\u001b[?2004l\r"]
[49.974295, "o", "\u001b[?2004h"]
[49.974313, "o", "> "]
[49.974511, "o", "            # Some APIs return a mapping keyed by record ID.\r\n\u001b[?2004l\r"]
[49.974533, "o", "\u001b[?2004h"]
[49.97455, "o", "> "]
[49.974746, "o", "            str_map = {str(k): v for k, v in payload.items()}\r\n\u001b[?2004l\r"]
[49.974774, "o", "\u001b[?2004h"]
[49.974791, "o", "> "]
[49.974974, "o", "            if all(str(rid) in str_map for rid in ids):\r\n\u001b[?2004l\r"]
[49.974996, "o", "\u001b[?2004h"]
[49.975018, "o", "> "]
[49.975222, "o", "                results = [str_map[str(rid)] for rid in ids]\r\n\u001b[?2004l\r"]
[49.975254, "o", "\u001b[?2004h"]
[49.975285, "o", "> "]
[49.975337, "o", "            else:\r\n\u001b[?2004l\r"]
[49.975374, "o", "\u001b[?2004h> "]
[49.975665, "o", "                raise ValueError(f\"Unexpected batch_enrich response shape: {payload!r}\")\r\n\u001b[?2004l\r"]
[49.975712, "o", "\u001b[?2004h> "]
[49.975745, "o", "    else:\r\n\u001b[?2004l\r"]
[49.975766, "o", "\u001b[?2004h"]
[49.975785, "o", "> "]
[49.976081, "o", "        raise ValueError(f\"Unexpected batch_enrich response type: {type(payload).__name__}\")\r\n\u001b[?2004l\r"]
[49.976109, "o", "\u001b[?2004h"]
[49.976126, "o", "> \r\n\u001b[?2004l\r"]
[49.976149, "o", "\u001b[?2004h"]
[49.976181, "o", "> "]
[49.976274, "o", "    if len(results) != len(ids):\r\n\u001b[?2004l\r"]
[49.976299, "o", "\u001b[?2004h"]
[49.976316, "o", "> "]
[49.976631, "o", "        raise ValueError(f\"batch_enrich returned {len(results)} results for {len(ids)} record IDs\")\r\n\u001b[?2004l\r"]
[49.976657, "o", "\u001b[?2004h"]
[49.976676, "o", "> \r\n\u001b[?2004l\r"]
[49.976704, "o", "\u001b[?2004h"]
[49.976726, "o", "> "]
[49.976979, "o", "    # If the API returns results out of order but includes record_id, restore the\r\n\u001b[?2004l\r"]
[49.977018, "o", "\u001b[?2004h> "]
[49.977221, "o", "    # request order so the output file remains deterministic.\r\n\u001b[?2004l\r"]
[49.977252, "o", "\u001b[?2004h> "]
[49.977506, "o", "    if all(isinstance(item, dict) and \"record_id\" in item for item in results):\r\n\u001b[?2004l\r"]
[49.977533, "o", "\u001b[?2004h"]
[49.977553, "o", "> "]
[49.977762, "o", "        by_id = {int(item[\"record_id\"]): item for item in results}\r\n\u001b[?2004l\r"]
[49.97779, "o", "\u001b[?2004h> "]
[49.977939, "o", "        if all(rid in by_id for rid in ids):\r\n\u001b[?2004l\r"]
[49.977965, "o", "\u001b[?2004h"]
[49.977983, "o", "> "]
[49.978156, "o", "            results = [by_id[rid] for rid in ids]\r\n\u001b[?2004l\r"]
[49.978187, "o", "\u001b[?2004h> \r\n"]
[49.978219, "o", "\u001b[?2004l\r"]
[49.978257, "o", "\u001b[?2004h> "]
[49.9783, "o", "    return results\r\n\u001b[?2004l\r"]
[49.97833, "o", "\u001b[?2004h> "]
[49.978353, "o", "\r\n\u001b[?2004l\r"]
[49.978377, "o", "\u001b[?2004h"]
[49.978399, "o", "> \r\n\u001b[?2004l\r"]
[49.978425, "o", "\u001b[?2004h"]
[49.978453, "o", "> "]
[49.978536, "o", "def _legacy_fast_sync(record_ids):\r\n\u001b[?2004l\r"]
[49.978559, "o", "\u001b[?2004h"]
[49.978578, "o", "> "]
[49.978789, "o", "    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n\u001b[?2004l\r"]
[49.978812, "o", "\u001b[?2004h"]
[49.978831, "o", "> "]
[49.979028, "o", "    reference — superseded by the standard enrich flow.\"\"\"\r\n\u001b[?2004l\r"]
[49.979055, "o", "\u001b[?2004h"]
[49.979074, "o", "> "]
[49.97917, "o", "    import concurrent.futures\r\n\u001b[?2004l\r"]
[49.979191, "o", "\u001b[?2004h"]
[49.979209, "o", "> "]
[49.979441, "o", "    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n\u001b[?2004l\r"]
[49.979484, "o", "\u001b[?2004h"]
[49.979511, "o", "> "]
[49.97968, "o", "        return list(pool.map(fetch_single, record_ids))\r\n\u001b[?2004l\r"]
[49.979719, "o", "\u001b[?2004h"]
[49.979745, "o", "> "]
[49.97977, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.979795, "o", "> \r\n\u001b[?2004l\r"]
[49.979821, "o", "\u001b[?2004h"]
[49.979846, "o", "> "]
[49.979888, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[49.97991, "o", "\u001b[?2004h"]
[49.979929, "o", "> "]
[49.98011, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[49.980137, "o", "\u001b[?2004h"]
[49.980156, "o", "> "]
[49.980299, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n\u001b[?2004l\r"]
[49.980326, "o", "\u001b[?2004h"]
[49.98035, "o", "> "]
[49.980454, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[49.980478, "o", "\u001b[?2004h"]
[49.980495, "o", "> "]
[49.980616, "o", "        for rid in [101, 102, 103]:\r\n\u001b[?2004l\r"]
[49.980635, "o", "\u001b[?2004h"]
[49.98065, "o", "> "]
[49.980771, "o", "            res = fetch_single(rid)\r\n\u001b[?2004l\r"]
[49.980805, "o", "\u001b[?2004h> "]
[49.980951, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[49.980977, "o", "\u001b[?2004h"]
[49.980993, "o", "> "]
[49.981073, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[49.981104, "o", "\u001b[?2004h"]
[49.981129, "o", "> "]
[49.98133, "o", "            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n\u001b[?2004l\r"]
[49.98135, "o", "\u001b[?2004h"]
[49.981373, "o", "> "]
[49.98156, "o", "    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n\u001b[?2004l\r"]
[49.981586, "o", "\u001b[?2004h"]
[49.981609, "o", "> "]
[49.981657, "o", "    return 0\r\n\u001b[?2004l\r"]
[49.981675, "o", "\u001b[?2004h"]
[49.981694, "o", "> \r\n\u001b[?2004l\r"]
[49.981718, "o", "\u001b[?2004h"]
[49.981743, "o", "> \r\n\u001b[?2004l\r"]
[49.981764, "o", "\u001b[?2004h"]
[49.981791, "o", "> "]
[49.981847, "o", "def run_backfill():\r\n\u001b[?2004l\r"]
[49.981868, "o", "\u001b[?2004h"]
[49.981895, "o", "> "]
[49.98207, "o", "    print(\"Starting backfill for 1000 records...\")\r\n\u001b[?2004l\r"]
[49.982091, "o", "\u001b[?2004h"]
[49.982115, "o", "> "]
[49.982254, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n\u001b[?2004l\r"]
[49.982285, "o", "\u001b[?2004h"]
[49.982308, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[49.98233, "o", "> "]
[49.982566, "o", "    # Use the documented batch endpoint.  With 100 records/request, 1000 records\r\n\u001b[?2004l\r"]
[49.982587, "o", "\u001b[?2004h> "]
[49.98282, "o", "    # require only 10 requests.  Spacing requests by 0.25s stays below the\r\n\u001b[?2004l\r"]
[49.982844, "o", "\u001b[?2004h> "]
[49.983085, "o", "    # documented 5 requests/sec limit while finishing well inside 3 minutes.\r\n\u001b[?2004l\r"]
[49.983116, "o", "\u001b[?2004h> "]
[49.983176, "o", "    batch_size = 100\r\n\u001b[?2004l\r"]
[49.983194, "o", "\u001b[?2004h"]
[49.983215, "o", "> "]
[49.983273, "o", "    min_interval = 0.25\r\n\u001b[?2004l\r"]
[49.983298, "o", "\u001b[?2004h"]
[49.983318, "o", "> "]
[49.983398, "o", "    last_request_started = 0.0\r\n\u001b[?2004l\r"]
[49.983418, "o", "\u001b[?2004h> "]
[49.983445, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.983474, "o", "> "]
[49.983557, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[49.983576, "o", "\u001b[?2004h"]
[49.983597, "o", "> "]
[49.983731, "o", "        for start in range(1, 1001, batch_size):\r\n\u001b[?2004l\r"]
[49.983749, "o", "\u001b[?2004h"]
[49.983768, "o", "> "]
[49.983964, "o", "            ids = list(range(start, min(start + batch_size, 1001)))\r\n\u001b[?2004l\r"]
[49.983989, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[49.984011, "o", "\u001b[?2004h"]
[49.984031, "o", "> "]
[49.984226, "o", "            elapsed = time.monotonic() - last_request_started\r\n\u001b[?2004l\r"]
[49.984262, "o", "\u001b[?2004h> "]
[49.984457, "o", "            if last_request_started and elapsed < min_interval:\r\n\u001b[?2004l\r"]
[49.984493, "o", "\u001b[?2004h"]
[49.984511, "o", "> "]
[49.984714, "o", "                time.sleep(min_interval - elapsed)\r\n\u001b[?2004l\r"]
[49.984745, "o", "\u001b[?2004h"]
[49.984763, "o", "> "]
[49.984972, "o", "            last_request_started = time.monotonic()\r\n\u001b[?2004l\r"]
[49.984999, "o", "\u001b[?2004h"]
[49.985022, "o", "> \r\n"]
