[43.744298, "i", "cat > /tmp/mock_enrichment_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send(self, obj):\n        data = json.dumps(obj).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            self.send_error(404)\n            return\n        rid = int(parse_qs(parsed.query)['record_id'][0])\n        self._send({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        if self.path != '/batch_enrich':\n            self.send_error(404)\n            return\n        length = int(self.headers.get('Content-Length', '0'))\n        body = json.loads("]
[43.744402, "i", "self.rfile.read(length).decode('utf-8'))\n        ids = body['record_ids']\n        if len(ids) > 100:\n            self.send_error(400, 'too many ids')\n            return\n        self._send([{'record_id': rid, 'enriched': True} for rid in ids])\n\nHTTPServer(('127.0.0.1', 8765), Handler).serve_forever()\nPY\npython3 /tmp/mock_enrichment_api.py &\nMOCK_PID=$!\nsleep 0.2\nAPI_BASE=http://127.0.0.1:8765 /app/backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\nSTART=$(date +%s)\nAPI_BASE=http://127.0.0.1:8765 /app/backfill.py\nEND=$(date +%s)\nwc -l /tmp/enriched_records.jsonl\nprintf 'elapsed_seconds=%s\\n' \"$((END-START))\"\nkill \"$MOCK_PID\"\nwait \"$MOCK_PID\" 2>/dev/null || true\n"]
