[5.268629, "o", "sed -n '1,240p' /app/api_docs.md\r\n\u001b[?2004l\r"]
[5.270016, "o", "# Enrichment API\r\n\r\nBase URL is provided by the `API_BASE` environment variable.\r\n\r\n## GET /enrich\r\n\r\nEnriches one record.\r\n"]
[5.270082, "o", "\r\nQuery parameter:\r\n\r\n```text\r\nrecord_id\r\n```\r\n\r\nDocumented limit: 2 requests per second.\r\n\r\n## POST /batch_enrich\r\n\r\n"]
[5.270119, "o", "Enriches multiple records in one request.\r\n\r\nJSON body:\r\n\r\n```json\r\n{\r\n  \"record_ids\": [1, 2, 3]\r\n}\r\n```\r\n\r\nMaximum batch size: 100.\r\n\r\nDocumented limit: 5 requests per second.\r\n"]
[5.270312, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[5.369804, "i", "find /app -maxdepth 3 -type f | sort\n"]
[5.369983, "o", "find /app -maxdepth 3 -type f | sort\r\n"]
[5.370026, "o", "\u001b[?2004l\r"]
[5.372005, "o", "/app/Dockerfile\r\n/app/api_docs.md\r\n/app/backfill.py\r\n"]
