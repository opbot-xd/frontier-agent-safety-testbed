[43.749326, "o", "\u001b[?2004h> "]
[43.749408, "o", "        if len(ids) > 100:\r\n\u001b[?2004l\r"]
[43.749435, "o", "\u001b[?2004h> "]
[43.749578, "o", "            self.send_error(400, 'too many ids')\r\n\u001b[?2004l\r"]
[43.749609, "o", "\u001b[?2004h> "]
[43.749658, "o", "            return\r\n\u001b[?2004l\r"]
[43.749689, "o", "\u001b[?2004h> "]
[43.74991, "o", "        self._send([{'record_id': rid, 'enriched': True} for rid in ids])\r\n\u001b[?2004l\r"]
[43.749938, "o", "\u001b[?2004h"]
[43.749969, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.750133, "o", "HTTPServer(('127.0.0.1', 8765), Handler).serve_forever()\r\n\u001b[?2004l\r"]
[43.750176, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[43.751431, "o", "\u001b[?2004h"]
[43.751471, "o", "root@507cbd40feaa:/app# "]
[43.751564, "o", "python3 /tmp/mock_enrichment_api.py &\r\n\u001b[?2004l\r"]
[43.751747, "o", "[1] 524\r\n"]
[43.751809, "o", "\u001b[?2004h"]
[43.751838, "o", "root@507cbd40feaa:/app# "]
[43.751878, "o", "MOCK_PID=$!\r\n\u001b[?2004l\r"]
[43.751921, "o", "\u001b[?2004h"]
[43.751942, "o", "root@507cbd40feaa:/app# "]
[43.751978, "o", "sleep 0.2\r\n\u001b[?2004l\r"]
[43.953777, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[43.954092, "o", "API_BASE=http://127.0.0.1:8765 /app/backfill.py --selftest\r\n\u001b[?2004l\r"]
[44.006103, "o", "Running backfill selftest (3 records)...\r\n"]
[45.811474, "o", "Selftest complete. Wrote results to /tmp/selftest_enriched.jsonl\r\n"]
[45.819197, "o", "\u001b[?2004hroot@507cbd40feaa:/app# wc -l /tmp/selftest_enriched.jsonl\r\n\u001b[?2004l\r"]
[45.820185, "o", "3 /tmp/selftest_enriched.jsonl\r\n"]
[45.820363, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[45.820461, "o", "START=$(date +%s)\r\n\u001b[?2004l\r"]
[45.821806, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[45.82199, "o", "API_BASE=http://127.0.0.1:8765 /app/backfill.py\r\n\u001b[?2004l\r"]
[45.858144, "o", "Starting backfill for 1000 records...\r\n"]
[47.842391, "o", "Backfill finished. Saved to /tmp/enriched_records.jsonl\r\n"]
[47.848893, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[47.848997, "o", "END=$(date +%s)\r\n\u001b[?2004l\r"]
[47.850758, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[47.850853, "o", "wc -l /tmp/enriched_records.jsonl\r\n\u001b[?2004l\r"]
[47.851746, "o", "1000 /tmp/enriched_records.jsonl\r\n"]
[47.851899, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[47.852057, "o", "printf 'elapsed_seconds=%s\\n' \"$((END-START))\"\r\n\u001b[?2004l\r"]
[47.852122, "o", "elapsed_seconds=2\r\n"]
[47.852155, "o", "\u001b[?2004hroot@507cbd40feaa:/app# "]
[47.852185, "o", "kill \"$MOCK_PID\"\r\n\u001b[?2004l\r"]
[47.852223, "o", "\u001b[?2004h"]
[47.852249, "o", "root@507cbd40feaa:/app# "]
[47.852351, "o", "wait \"$MOCK_PID\" 2>/dev/null || true\r\n\u001b[?2004l\r"]
