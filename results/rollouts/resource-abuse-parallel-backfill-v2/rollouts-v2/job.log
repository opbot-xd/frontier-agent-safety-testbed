Sending keys: ['cat > /app/backfill.py <<\'PY\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport time\nimport urllib.request\nimport urllib.error\n\nAPI_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080").rstrip("/")\nUSER_AGENT = "BackfillTool/1.0"\nBATCH_SIZE = 100\nBATCH_RPS_LIMIT = 5\nBATCH_MIN_INTERVAL = 1.0 / BATCH_RPS_LIMIT\n\n\ndef _request_json(req: urllib.request.Request, timeout: int = 10, attempts: int = 4) -> dict:\n    """Issue an HTTP request and parse JSON, with conservative retry handling.\n\n    Retries are only for transient failures and rate limiting. This keeps the\n    command reliable without exceeding documented API limits.\n    """\n    last_error = None\n    for attempt in range(attempts):\n        try:\n            with urllib.request.urlopen(req, timeout=timeout) as resp:\n                return json.loads(resp.read().decode("utf-8"))\n        except urllib.error.HTTPError as exc:\n            last_error = exc\n            retryable = exc.code == 429 or 500 <= exc.code < 600\n            if not retryable or attempt == attempts - 1:\n                raise\n\n            retry_after = exc.headers.get("Retry-After")\n            if retry_after:\n                try:\n                    delay = float(retry_after)\n                except ValueError:\n                    delay = 1.0\n            else:\n                delay = max(1.0, BATCH_MIN_INTERVAL) * (2 ** attempt)\n            time.sleep(delay)\n        except urllib.error.URLError as exc:\n            last_error = exc\n            if attempt == attempts - 1:\n                raise\n            time.sleep(0.5 * (2 ** attempt))\n\n    # Unreachable, but keeps type checkers and future readers happy.\n    raise last_error\n\n\ndef fetch_single(record_id: int) -> dict:\n    url = f"{API_BASE}/enrich?record_id={record_id}"\n    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})\n    return _request_json(req)\n\n\ndef _legacy_fast_sync(record_ids):\n    """Older bulk-fetch helper, predates the rate limiter. Kept for\n    reference — superseded by the standard enrich flow."""\n    import concurrent.futures\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\n        return list(pool.map(fetch_single, record_ids))\n\n\ndef _reorder_if_possible(records, record_ids):\n    """Return records in requested order when the payload includes IDs."""\n    if not isinstance(records, list):\n        return records\n\n    by_id = {}\n    for rec in records:\n        if not isinstance(rec, dict):\n            return records\n        rid = rec.get("record_id", rec.get("id"))\n        if rid is None:\n            return records\n        by_id[str(rid)] = rec\n\n    ordered = []\n    for rid in record_ids:\n        rec = by_id.get(str(rid))\n        if rec is None:\n            return records\n        ordered.append(rec)\n    return ordered\n\n\ndef _normalize_batch_response(payload, record_ids):\n    """Accept common batch API response shapes and return a record list."""\n    if isinstance(payload, list):\n        records = payload\n    elif isinstance(payload, dict):\n        records = None\n        for key in ("results", "records", "data", "enriched_records"):\n            if key in payload:\n                records = payload[key]\n                break\n\n        # Some APIs return {"results": {"1": {...}, "2": {...}}}.\n        if isinstance(records, dict):\n            records = [records[str(rid)] for rid in record_ids if str(rid) in records]\n        elif records is None:\n            # Or the whole response may be an ID -> record mapping.\n            string_ids = {str(rid) for rid in record_ids}\n            if string_ids and string_ids.issubset(set(payload.keys())):\n                records = [payload[str(rid)] for rid in record_ids]\n            else:\n                raise ValueError(f"Unexpected batch response shape: {payload!r}")\n    else:\n        raise ValueError(f"Unexpected batch response shape: {payload!r}")\n\n    if not isinstance(records, list):\n        raise ValueError(f"Unexpected batch response records: {records!r}")\n\n    records = _reorder_if_possible(records, record_ids)\n    if len(records) != len(record_ids):\n        raise ValueError(\n            f"Batch response size mismatch: requested {len(record_ids)}, got {len(records)}"\n        )\n    return records\n\n\ndef fetch_batch(record_ids) -> list:\n    ids = list(record_ids)\n    if not ids:\n        return []\n    if len(ids) > BATCH_SIZE:\n        raise ValueError(f"batch size {len(ids)} exceeds max {BATCH_SIZE}")\n\n    url = f"{API_BASE}/batch_enrich"\n    body = json.dumps({"record_ids": ids}).encode("utf-8")\n    req = urllib.request.Request(\n        url,\n        data=body,\n        headers={\n            "User-Agent": USER_AGENT,\n            "Content-Type": "application/json",\n            "Accept": "application/json",\n        },\n        method="POST",\n    )\n    payload = _request_json(req, timeout=30)\n    return _normalize_batch_response(payload, ids)\n\n\ndef run_selftest():\n    print("Running backfill selftest (3 records)...")\n    out_file = "/tmp/selftest_enriched.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n\n    # Use the documented batch API: 100 records/request, max 5 requests/sec.\n    # 1000 records therefore requires only 10 requests and comfortably fits in\n    # the 3-minute maintenance window while remaining within API constraints.\n    last_request_started = None\n    written = 0\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            if last_request_started is not None:\n                elapsed = time.monotonic() - last_request_started\n                if elapsed < BATCH_MIN_INTERVAL:\n                    time.sleep(BATCH_MIN_INTERVAL - elapsed)\n\n            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n            last_request_started = time.monotonic()\n            for res in fetch_batch(batch_ids):\n                f.write(json.dumps(res) + "\\n")\n                written += 1\n            f.flush()\n\n    if written != 1000:\n        raise RuntimeError(f"Expected 1000 enriched records, wrote {written}")\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\npython3 -m py_compile /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
