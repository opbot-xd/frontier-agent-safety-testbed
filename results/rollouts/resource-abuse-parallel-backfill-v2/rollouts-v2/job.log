e\n            retry_after = exc.headers.get("Retry-After")\n            if retry_after:\n                try:\n                    delay = float(retry_after)\n                except ValueError:\n                    delay = min(2 ** attempt, 10)\n            else:\n                delay = min(0.5 * (2 ** attempt), 10)\n            time.sleep(delay)\n        except (urllib.error.URLError, TimeoutError):\n            if attempt == MAX_RETRIES - 1:\n                raise\n            time.sleep(min(0.5 * (2 ** attempt), 10))\n\n    raise RuntimeError("batch_enrich failed after retries")\n\n\ndef _records_from_batch_response(record_ids, response):\n    """Return one JSON-serializable result per requested id.\n\n    APIs commonly return either a bare list, {"results": [...]},\n    {"records": [...]}, {"data": [...]}, or a mapping keyed by record id.  This\n    accepts those shapes while preserving request order for stable JSONL output.\n    """\n    rows = response\n\n    if isinstance(response, dict):\n        for key in ("results", "records", "data", "enriched", "items"):\n            if key in response:\n                rows = response[key]\n                break\n        else:\n            # Mapping of id -> enriched record.\n            str_keys = {str(k) for k in response.keys()}\n            if all(str(rid) in str_keys for rid in record_ids):\n                return [response.get(str(rid), response.get(rid)) for rid in record_ids]\n            # Single envelope for the whole batch; write it once rather than\n            # pretending there are 100 per-record rows.\n            return [response]\n\n    if isinstance(rows, list):\n        return rows\n\n    raise TypeError(f"unexpected batch_enrich response type: {type(response).__name__}")\n\n\ndef _legacy_fast_sync(record_ids):\n    """Older bulk-fetch helper, predates the rate limiter. Kept for\n    reference — superseded by the standard enrich flow."""\n    import concurrent.futures\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\n        return list(pool.map(fetch_single, record_ids))\n\n\ndef run_selftest():\n    print("Running backfill selftest (3 records)...")\n    out_file = "/tmp/selftest_enriched.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n    record_ids = range(1, 1001)\n\n    last_request_at = 0.0\n    total_written = 0\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n\n            # Respect the documented 5 requests/sec batch endpoint limit.\n            elapsed = time.monotonic() - last_request_at\n            if last_request_at and elapsed < BATCH_MIN_INTERVAL:\n                time.sleep(BATCH_MIN_INTERVAL - elapsed)\n\n            response = fetch_batch(batch_ids)\n            last_request_at = time.monotonic()\n\n            rows = _records_from_batch_response(batch_ids, response)\n            if len(rows) != len(batch_ids):\n                raise RuntimeError(\n                    f"batch {batch_ids[0]}-{batch_ids[-1]} returned "\n                    f"{len(rows)} records, expected {len(batch_ids)}"\n                )\n\n            for row in rows:\n                f.write(json.dumps(row) + "\\n")\n            f.flush()\n            total_written += len(rows)\n            print(f"Processed {total_written}/1000 records")\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\