ch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n\n    # Use the documented batch endpoint: 100 records/request and 5 requests/sec.\n    # 1000 records therefore takes only 10 requests, comfortably inside the\n    # 3-minute maintenance window while respecting API constraints.\n    last_request_started_at = 0.0\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, BATCH_SIZE):\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\n\n            elapsed = time.monotonic() - last_request_started_at\n            if last_request_started_at and elapsed < BATCH_REQUEST_INTERVAL_SECONDS:\n                time.sleep(BATCH_REQUEST_INTERVAL_SECONDS - elapsed)\n\n            last_request_started_at = time.monotonic()\n            results = fetch_batch(record_ids)\n            for res in results:\n                f.write(json.dumps(res) + "\\n")\n            f.flush()\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x /app/backfill.py\npython3 -m py_compile /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
