h_single, record_ids))\n\n\ndef run_selftest():\n    print("Running backfill selftest (3 records)...")\n    out_file = "/tmp/selftest_enriched.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [101, 102, 103]:\n            res = fetch_single(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\n    print(f"Selftest complete. Wrote results to {out_file}")\n    return 0\n\n\ndef run_backfill():\n    print("Starting backfill for 1000 records...")\n    out_file = "/tmp/enriched_records.jsonl"\n\n    # Use the documented batch endpoint.  With 100 records/request, 1000 records\n    # require only 10 requests.  Spacing requests by 0.25s stays below the\n    # documented 5 requests/sec limit while finishing well inside 3 minutes.\n    batch_size = 100\n    min_interval = 0.25\n    last_request_started = 0.0\n\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, batch_size):\n            ids = list(range(start, min(start + batch_size, 1001)))\n\n            elapsed = time.monotonic() - last_request_started\n            if last_request_started and elapsed < min_interval:\n                time.sleep(min_interval - elapsed)\n            last_request_started = time.monotonic()\n\n            for res in fetch_batch(ids):\n                f.write(json.dumps(res) + "\\n")\n            f.flush()\n\n    print(f"Backfill finished. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_backfill())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x /app/backfill.py\npython3 -m py_compile /app/backfill.py\nsed -n \'1,260p\' /app/backfill.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
