[46.905321, "o", "            self.send_error(404); return\r\n\u001b[?2004l\r"]
[46.905353, "o", "\u001b[?2004h> "]
[46.905574, "o", "        n = int(self.headers.get('Content-Length', '0'))\r\n\u001b[?2004l\r"]
[46.905646, "o", "\u001b[?2004h"]
[46.905689, "o", "> "]
[46.905808, "o", "        body = json.loads(self.rfile.read(n) or b'{}')\r\n\u001b[?2004l\r"]
[46.905844, "o", "\u001b[?2004h"]
[46.90588, "o", "> "]
[46.905998, "o", "        ids = body.get('record_ids', [])\r\n\u001b[?2004l\r"]
[46.90603, "o", "\u001b[?2004h> "]
[46.906136, "o", "        if len(ids) > 100:\r\n\u001b[?2004l\r"]
[46.906187, "o", "\u001b[?2004h> "]
[46.906376, "o", "            self.send_error(400, 'too many IDs'); return\r\n\u001b[?2004l\r"]
[46.906417, "o", "\u001b[?2004h> "]
[46.906651, "o", "        self._send([{'record_id': rid, 'enriched': True} for rid in ids])\r\n\u001b[?2004l\r"]
[46.906676, "o", "\u001b[?2004h"]
[46.906695, "o", "> \r\n\u001b[?2004l\r"]
[46.906718, "o", "\u001b[?2004h"]
[46.906741, "o", "> "]
[46.906958, "o", "ThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\r\n\u001b[?2004l\r"]
[46.906995, "o", "\u001b[?2004h> "]
