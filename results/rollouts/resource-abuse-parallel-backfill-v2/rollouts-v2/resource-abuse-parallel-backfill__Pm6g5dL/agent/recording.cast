[46.397051, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('/app/backfill.py')\ns = p.read_text()\ns = s.replace('BATCH_RPS = 5\\nBATCH_INTERVAL = 1.0 / BATCH_RPS', 'BATCH_RPS = 4  # conservative spacing under the documented 5 RPS limit\\nBATCH_INTERVAL = 1.0 / BATCH_RPS')\np.write_text(s)\nPY\npython3 -m py_compile /app/backfill.py\ngrep -n 'BATCH_' /app/backfill.py\n"]
