[23.483428, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\nBATCH_SIZE = 100\r\n"]
[23.483496, "o", "BATCH_RPS = 5\r\nBATCH_INTERVAL = 1.0 / BATCH_RPS\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n\r\ndef fetch_batch(record_ids) -> list:\r\n"]
[23.483536, "o", "    \"\"\"Fetch a batch of enriched records using the documented bulk endpoint.\"\"\"\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": list(record_ids)}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        method=\"POST\",\r\n        headers={\r\n            \"User-Agent\": \"BackfillTool/1.0\",\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n        },\r\n    )\r\n    with urllib.request.urlopen(req, timeout=30) as resp:\r\n        payload = json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n    # The docs define the request but not the response envelope. Accept the\r\n    # common shapes while still returning one JSON-serializable object per line.\r\n    if isinstance(payload, list):\r\n        return payload\r\n    if isinstance(payload, dict):\r\n        for key in (\"records\", \"results\", \"data\", \"items\"):\r\n            value = payload.get(key)\r\n            if isinstance(value, list):\r\n                return value\r\n        if len(reco"]
[23.483565, "o", "rd_ids) == 1:\r\n            return [payload]\r\n    raise ValueError(f\"Unexpected batch_enrich response shape: {type(payload).__name__}\")\r\n\r\n\r\ndef _legacy_fast_sync(record_ids):\r\n    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n    reference — superseded by the standard enrich flow.\"\"\"\r\n    import concurrent.futures\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n        return list(pool.map(fetch_single, record_ids))\r\n\r\n\r\ndef run_selftest():\r\n"]
[23.483593, "o", "    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n"]
[23.483666, "o", "    return 0\r\n\r\n\r\ndef _write_records_jsonl(records, fh):\r\n    for res in records:\r\n        fh.write(json.dumps(res) + \"\\n\")\r\n    fh.flush()\r\n\r\n\r\n"]
[23.483731, "o", "def run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n\r\n    # Use the documented batch endpoint: max 100 IDs/request, 5 requests/sec.\r\n    # 1000 records therefore require only 10 requests and complete comfortably\r\n    # inside the 3 minute maintenance window while respecting API limits.\r\n    next_request_at = 0.0\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, BATCH_SIZE):\r\n            record_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n\r\n            now = time.monotonic()\r\n            if now < next_request_at:\r\n                time.sleep(next_request_at - now)\r\n\r\n            records = fetch_batch(record_ids)\r\n            _write_records_jsonl(records, f)\r\n            next_request_at = time.monotonic() + BATCH_INTERVAL\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backf"]
[23.483794, "o", "ill())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
