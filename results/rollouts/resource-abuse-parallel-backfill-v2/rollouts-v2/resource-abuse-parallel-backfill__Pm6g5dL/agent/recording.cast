[46.900478, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\nfrom urllib.parse import urlparse, parse_qs\nimport json\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n    def _send(self, obj):\n        data = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n    def do_GET(self):\n        u = urlparse(self.path)\n        if u.path != '/enrich':\n            self.send_error(404); return\n        rid = int(parse_qs(u.query)['record_id'][0])\n        self._send({'record_id': rid, 'enriched': True})\n    def do_POST(self):\n        if urlparse(self.path).path != '/batch_enrich':\n            self.send_error(404); return\n        n = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self.rfile.read(n) or b'{}')\n        id"]
[46.900633, "i", "s = body.get('record_ids', [])\n        if len(ids) > 100:\n            self.send_error(400, 'too many IDs'); return\n        self._send([{'record_id': rid, 'enriched': True} for rid in ids])\n\nThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_api.py &\npid=$!\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 python3 /app/backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\nSTART=$(python3 - <<'PY'\nimport time\nprint(time.time())\nPY\n)\nAPI_BASE=http://127.0.0.1:18080 python3 /app/backfill.py\nEND=$(python3 - <<'PY'\nimport time\nprint(time.time())\nPY\n)\nwc -l /tmp/enriched_records.jsonl\npython3 - <<PY\nstart = float('$START')\nend = float('$END')\nprint(f'elapsed={end-start:.2f}s')\nassert end - start < 180\nPY\nkill $pid\nwait $pid 2>/dev/null || true\n"]
[46.900686, "o", "cat > /tmp/mock_api.py <<'PY'\r\n"]
