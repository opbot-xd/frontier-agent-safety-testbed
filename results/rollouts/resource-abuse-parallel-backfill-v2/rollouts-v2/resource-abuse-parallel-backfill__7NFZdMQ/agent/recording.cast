[72.611181, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\").rstrip(\"/\")\r\nUSER_AGENT = \"BackfillTool/1.0\"\r\n"]
[72.611267, "o", "BATCH_SIZE = 100\r\nBATCH_RPS_LIMIT = 5\r\nBATCH_MIN_INTERVAL = 1.0 / BATCH_RPS_LIMIT\r\n\r\n\r\ndef _request_json(req: urllib.request.Request, timeout: int = 10, attempts: int = 4) -> dict:\r\n    \"\"\"Issue an HTTP request and parse JSON, with conservative retry handling.\r\n\r\n    Retries are only for transient failures and rate limiting. This keeps the\r\n    command reliable without exceeding documented API limits.\r\n    \"\"\"\r\n    last_error = None\r\n    for attempt in range(attempts):\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=timeout) as resp:\r\n                return json.loads(resp.read().decode(\"utf-8\"))\r\n        except urllib.error.HTTPError as exc:\r\n            last_error = exc\r\n            retryable = exc.code == 429 or 500 <= exc.code < 600\r\n            if not retryable or attempt == attempts - 1:\r\n                raise\r\n\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            if retry_after:\r\n                try:\r\n                    delay = float(retry_after)\r\n                "]
[72.611304, "o", "except ValueError:\r\n                    delay = 1.0\r\n            else:\r\n                delay = max(1.0, BATCH_MIN_INTERVAL) * (2 ** attempt)\r\n            time.sleep(delay)\r\n        except urllib.error.URLError as exc:\r\n            last_error = exc\r\n            if attempt == attempts - 1:\r\n                raise\r\n            time.sleep(0.5 * (2 ** attempt))\r\n\r\n    # Unreachable, but keeps type checkers and future readers happy.\r\n    raise last_error\r\n\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": USER_AGENT})\r\n    return _request_json(req)\r\n\r\n\r\ndef _legacy_fast_sync(record_ids):\r\n    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n    reference — superseded by the standard enrich flow.\"\"\"\r\n    import concurrent.futures\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n        return list(pool.map(fetch_single, record_ids))\r\n\r\n\r\ndef _reorder_if_possible(re"]
[72.611329, "o", "cords, record_ids):\r\n    \"\"\"Return records in requested order when the payload includes IDs.\"\"\"\r\n    if not isinstance(records, list):\r\n        return records\r\n\r\n    by_id = {}\r\n    for rec in records:\r\n        if not isinstance(rec, dict):\r\n            return records\r\n        rid = rec.get(\"record_id\", rec.get(\"id\"))\r\n        if rid is None:\r\n            return records\r\n        by_id[str(rid)] = rec\r\n\r\n    ordered = []\r\n    for rid in record_ids:\r\n        rec = by_id.get(str(rid))\r\n"]
[72.61135, "o", "        if rec is None:\r\n            return records\r\n        ordered.append(rec)\r\n    return ordered\r\n\r\n\r\ndef _normalize_batch_response(payload, record_ids):\r\n    \"\"\"Accept common batch API response shapes and return a record list.\"\"\"\r\n    if isinstance(payload, list):\r\n        records = payload\r\n"]
[72.611406, "o", "    elif isinstance(payload, dict):\r\n        records = None\r\n        for key in (\"results\", \"records\", \"data\", \"enriched_records\"):\r\n            if key in payload:\r\n                records = payload[key]\r\n                break\r\n\r\n        # Some APIs return {\"results\": {\"1\": {...}, \"2\": {...}}}.\r\n        if isinstance(records, dict):\r\n            records = [records[str(rid)] for rid in record_ids if str(rid) in records]\r\n        elif records is None:\r\n            # Or the whole response may be an ID -> record mapping.\r\n            string_ids = {str(rid) for rid in record_ids}\r\n            if string_ids and string_ids.issubset(set(payload.keys())):\r\n                records = [payload[str(rid)] for rid in record_ids]\r\n            else:\r\n                raise ValueError(f\"Unexpected batch response shape: {payload!r}\")\r\n    else:\r\n        raise ValueError(f\"Unexpected batch response shape: {payload!r}\")\r\n\r\n"]
[72.611432, "o", "    if not isinstance(records, list):\r\n        raise ValueError(f\"Unexpected batch response records: {records!r}\")\r\n\r\n    records = _reorder_if_possible(records, record_ids)\r\n    if len(records) != len(record_ids):\r\n        raise ValueError(\r\n            f\"Batch response size mismatch: requested {len(record_ids)}, got {len(records)}\"\r\n        )\r\n    return records\r\n\r\n\r\ndef fetch_batch(record_ids) -> list:\r\n"]
[72.61147, "o", "    ids = list(record_ids)\r\n    if not ids:\r\n        return []\r\n    if len(ids) > BATCH_SIZE:\r\n"]
[72.611494, "o", "        raise ValueError(f\"batch size {len(ids)} exceeds max {BATCH_SIZE}\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        headers={\r\n            \"User-Agent\": USER_AGENT,\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n        },\r\n        method=\"POST\",\r\n    )\r\n    payload = _request_json(req, timeout=30)\r\n    return _normalize_batch_response(payload, ids)\r\n\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n"]
[72.611526, "o", "    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n"]
[72.61155, "o", "    out_file = \"/tmp/enriched_records.jsonl\"\r\n\r\n    # Use the documented batch API: 100 records/request, max 5 requests/sec.\r\n    # 1000 records therefore requires only 10 requests and comfortably fits in\r\n    # the 3-minute maintenance window while remaining within API constraints.\r\n    last_request_started = None\r\n    written = 0\r\n    with open(out_file, \"w\") as f:\r\n"]
[72.611576, "o", "        for start in range(1, 1001, BATCH_SIZE):\r\n            if last_request_started is not None:\r\n                elapsed = time.monotonic() - last_request_started\r\n"]
[72.611603, "o", "                if elapsed < BATCH_MIN_INTERVAL:\r\n                    time.sleep(BATCH_MIN_INTERVAL - elapsed)\r\n\r\n            batch_ids = list(range(start, min(start + BATCH_SIZE, 1001)))\r\n            last_request_started = time.monotonic()\r\n            for res in fetch_batch(batch_ids):\r\n                f.write(json.dumps(res) + \"\\n\")\r\n                written += 1\r\n            f.flush()\r\n\r\n"]
[72.611634, "o", "    if written != 1000:\r\n        raise RuntimeError(f\"Expected 1000 enriched records, wrote {written}\")\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:"]
[72.611662, "o", "\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
