[72.810395, "i", "python3 - <<'PY'\nimport json, os, subprocess, sys, tempfile, threading\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\nfrom urllib.parse import urlparse, parse_qs\n\nclass H(BaseHTTPRequestHandler):\n    get_count = 0\n    post_count = 0\n    def log_message(self, *args):\n        pass\n    def _send(self, obj):\n        body = json.dumps(obj).encode()\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n    def do_GET(self):\n        H.get_count += 1\n        qs = parse_qs(urlparse(self.path).query)\n        rid = int(qs['record_id'][0])\n        self._send({'record_id': rid, 'enriched': True})\n    def do_POST(self):\n        H.post_count += 1\n        assert self.path == '/batch_enrich', self.path\n        n = int(self.headers.get('Content-Length', '0'))\n        data = json.loads(self.rfile.read(n))\n        ids = data['record_ids']\n        assert 1 <= len(i"]
[72.810497, "i", "ds) <= 100, len(ids)\n        self._send({'records': [{'record_id': rid, 'enriched': True} for rid in ids]})\n\nsrv = HTTPServer(('127.0.0.1', 0), H)\nthreading.Thread(target=srv.serve_forever, daemon=True).start()\nbase = f'http://127.0.0.1:{srv.server_port}'\nenv = dict(os.environ, API_BASE=base)\nsubprocess.check_call([sys.executable, '/app/backfill.py', '--selftest'], env=env)\nassert H.get_count == 3 and H.post_count == 0, (H.get_count, H.post_count)\nsubprocess.check_call([sys.executable, '/app/backfill.py'], env=env)\nassert H.post_count == 10, H.post_count\nwith open('/tmp/enriched_records.jsonl') as f:\n    lines = f.readlines()\nassert len(lines) == 1000, len(lines)\nprint('mock validation passed: selftest GETs=3, backfill batch POSTs=10, output lines=1000')\nsrv.shutdown()\nPY\n"]
