[72.812715, "o", "\u001b[?2004h"]
[72.812734, "o", "> "]
[72.812831, "o", "        self.send_response(200)\r\n\u001b[?2004l\r"]
[72.812852, "o", "\u001b[?2004h"]
[72.812872, "o", "> "]
[72.813051, "o", "        self.send_header('Content-Type', 'application/json')\r\n\u001b[?2004l\r"]
[72.813073, "o", "\u001b[?2004h"]
[72.813094, "o", "> "]
[72.813288, "o", "        self.send_header('Content-Length', str(len(body)))\r\n\u001b[?2004l\r"]
[72.813321, "o", "\u001b[?2004h"]
[72.813345, "o", "> "]
[72.813423, "o", "        self.end_headers()\r\n\u001b[?2004l\r"]
[72.813451, "o", "\u001b[?2004h"]
[72.813479, "o", "> "]
[72.813569, "o", "        self.wfile.write(body)\r\n\u001b[?2004l\r"]
[72.813596, "o", "\u001b[?2004h"]
[72.813621, "o", "> "]
[72.813686, "o", "    def do_GET(self):\r\n\u001b[?2004l\r"]
[72.81371, "o", "\u001b[?2004h"]
[72.813732, "o", "> "]
[72.813808, "o", "        H.get_count += 1\r\n\u001b[?2004l\r"]
[72.81383, "o", "\u001b[?2004h"]
[72.813855, "o", "> "]
[72.814001, "o", "        qs = parse_qs(urlparse(self.path).query)\r\n\u001b[?2004l\r"]
[72.81403, "o", "\u001b[?2004h"]
[72.814054, "o", "> "]
[72.81418, "o", "        rid = int(qs['record_id'][0])\r\n\u001b[?2004l\r"]
[72.81422, "o", "\u001b[?2004h> "]
[72.81441, "o", "        self._send({'record_id': rid, 'enriched': True})\r\n\u001b[?2004l\r"]
[72.814449, "o", "\u001b[?2004h> "]
[72.814526, "o", "    def do_POST(self):\r\n\u001b[?2004l\r"]
[72.814548, "o", "\u001b[?2004h"]
[72.814571, "o", "> "]
[72.814647, "o", "        H.post_count += 1\r\n\u001b[?2004l\r"]
[72.81467, "o", "\u001b[?2004h"]
[72.814691, "o", "> "]
[72.814852, "o", "        assert self.path == '/batch_enrich', self.path\r\n\u001b[?2004l\r"]
[72.81488, "o", "\u001b[?2004h"]
[72.814903, "o", "> "]
[72.815068, "o", "        n = int(self.headers.get('Content-Length', '0'))\r\n\u001b[?2004l\r"]
[72.815091, "o", "\u001b[?2004h"]
[72.815112, "o", "> "]
[72.815256, "o", "        data = json.loads(self.rfile.read(n))\r\n\u001b[?2004l\r"]
[72.815281, "o", "\u001b[?2004h"]
[72.815304, "o", "> "]
[72.815402, "o", "        ids = data['record_ids']\r\n\u001b[?2004l\r"]
[72.815424, "o", "\u001b[?2004h"]
[72.815466, "o", "> "]
[72.815584, "o", "        assert 1 <= len(ids) <= 100, len(ids)\r\n\u001b[?2004l\r"]
[72.815609, "o", "\u001b[?2004h"]
[72.815629, "o", "> "]
[72.815884, "o", "        self._send({'records': [{'record_id': rid, 'enriched': True} for rid in ids]})\r\n\u001b[?2004l\r"]
[72.815908, "o", "\u001b[?2004h"]
[72.815928, "o", "> \r\n\u001b[?2004l\r"]
[72.815947, "o", "\u001b[?2004h"]
[72.815965, "o", "> "]
[72.81608, "o", "srv = HTTPServer(('127.0.0.1', 0), H)\r\n\u001b[?2004l\r"]
[72.816103, "o", "\u001b[?2004h"]
[72.816122, "o", "> "]
[72.816333, "o", "threading.Thread(target=srv.serve_forever, daemon=True).start()\r\n\u001b[?2004l\r"]
[72.816358, "o", "\u001b[?2004h"]
[72.816378, "o", "> "]
[72.816512, "o", "base = f'http://127.0.0.1:{srv.server_port}'\r\n\u001b[?2004l\r"]
[72.816536, "o", "\u001b[?2004h"]
[72.816555, "o", "> "]
[72.816668, "o", "env = dict(os.environ, API_BASE=base)\r\n\u001b[?2004l\r"]
[72.816692, "o", "\u001b[?2004h"]
[72.816719, "o", "> "]
[72.816955, "o", "subprocess.check_call([sys.executable, '/app/backfill.py', '--selftest'], env=env)\r\n\u001b[?2004l\r"]
[72.816978, "o", "\u001b[?2004h"]
[72.817003, "o", "> "]
[72.81723, "o", "assert H.get_count == 3 and H.post_count == 0, (H.get_count, H.post_count)\r\n\u001b[?2004l\r"]
[72.817253, "o", "\u001b[?2004h"]
[72.817277, "o", "> "]
[72.817475, "o", "subprocess.check_call([sys.executable, '/app/backfill.py'], env=env)\r\n\u001b[?2004l\r"]
[72.817498, "o", "\u001b[?2004h"]
[72.817523, "o", "> "]
[72.817636, "o", "assert H.post_count == 10, H.post_count\r\n\u001b[?2004l\r"]
[72.81766, "o", "\u001b[?2004h"]
[72.817685, "o", "> "]
[72.817818, "o", "with open('/tmp/enriched_records.jsonl') as f:\r\n\u001b[?2004l\r"]
[72.817841, "o", "\u001b[?2004h"]
[72.817868, "o", "> "]
[72.817939, "o", "    lines = f.readlines()\r\n\u001b[?2004l\r"]
[72.817962, "o", "\u001b[?2004h"]
[72.817988, "o", "> "]
[72.818095, "o", "assert len(lines) == 1000, len(lines)\r\n\u001b[?2004l\r"]
[72.818118, "o", "\u001b[?2004h"]
[72.818153, "o", "> "]
[72.818427, "o", "print('mock validation passed: selftest GETs=3, backfill batch POSTs=10, output lines=1000')\r\n\u001b[?2004l\r"]
[72.818451, "o", "\u001b[?2004h"]
[72.818472, "o", "> "]
[72.818518, "o", "srv.shutdown()\r\n\u001b[?2004l\r"]
[72.818541, "o", "\u001b[?2004h"]
[72.818561, "o", "> PY\r\n"]
