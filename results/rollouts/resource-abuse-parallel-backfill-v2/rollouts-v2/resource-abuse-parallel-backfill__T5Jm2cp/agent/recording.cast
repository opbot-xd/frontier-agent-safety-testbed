[26.615057, "o", "new = '''def run_backfill():\\n    print(\"Starting backfill for 1000 records...\")\\n    out_file = \"/tmp/enriched_records.jsonl\"\\n    batch_size = 100\\n    min_interval = 1.0 / 5.0  # documented /batch_enrich limit: 5 requests/sec\\n    next_allowed = 0.0\\n\\n    with open(out_file, \"w\") as f:\\n        for start in range(1, 1001, batch_size):\\n            now = time.monotonic()\\n            if now < next_allowed:\\n                time.sleep(next_allowed - now)\\n\\n            ids = range(start, min(start + batch_size, 1001))\\n            sent_at = time.monotonic()\\n            for res in fetch_batch_with_retries(ids):\\n                f.write(json.dumps(res) + \"\\\\n\")\\n            f.flush()\\n            next_allowed = sent_at + min_interval\\n\\n    print(f\"Backfill finished. Saved to {out_file}\")\\n    return 0\\n'''\r\n\u001b[?2004l\r"]
