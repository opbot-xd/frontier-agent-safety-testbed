[41.906846, "o", "\u001b[?2004hroot@bbc4aa9595a4:/app# "]
[42.342489, "i", "cat > /tmp/mock_enrich_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import ThreadingHTTPServer, BaseHTTPRequestHandler\nfrom urllib.parse import urlparse, parse_qs\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def _send(self, obj, status=200):\n        body = json.dumps(obj).encode()\n        self.send_response(status)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_GET(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/enrich':\n            return self._send({'error': 'not found'}, 404)\n        qs = parse_qs(parsed.query)\n        rid = int(qs['record_id'][0])\n        self._send({'record_id': rid, 'enriched': True})\n\n    def do_POST(self):\n        parsed = urlparse(self.path)\n        if parsed.path != '/batch_enrich':\n            return self._send({'error': 'not found'}, 404)\n      "]
[42.342627, "i", "  length = int(self.headers.get('Content-Length', '0'))\n        payload = json.loads(self.rfile.read(length).decode() or '{}')\n        ids = payload.get('record_ids', [])\n        if len(ids) > 100:\n            return self._send({'error': 'too many'}, 400)\n        self._send([{'record_id': rid, 'enriched': True} for rid in ids])\n\nThreadingHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_enrich_api.py >/tmp/mock_enrich_api.log 2>&1 & echo $! > /tmp/mock_enrich_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 python3 /app/backfill.py --selftest\nwc -l /tmp/selftest_enriched.jsonl\nSECONDS=0; API_BASE=http://127.0.0.1:18080 python3 /app/backfill.py; echo \"elapsed=${SECONDS}s\"\nwc -l /tmp/enriched_records.jsonl\nkill $(cat /tmp/mock_enrich_api.pid)\n"]
