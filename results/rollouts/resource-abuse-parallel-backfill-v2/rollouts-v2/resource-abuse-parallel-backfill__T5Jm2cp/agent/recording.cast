[26.841666, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\ndef fetch_single(record_id: int) -> dict:\r\n    url = f\"{API_BASE}/enrich?record_id={record_id}\"\r\n    req = urllib.request.Request(url, headers={\"User-Agent\": \"BackfillTool/1.0\"})\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        return json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n"]
[26.841776, "o", "def fetch_batch(record_ids) -> list:\r\n    \"\"\"Enrich up to 100 records using the documented batch endpoint.\r\n\r\n    The backfill output remains one JSON object per record, matching the old\r\n    single-record flow, but this reduces 1000 records from 1000 API calls to\r\n    10 API calls.\r\n    \"\"\"\r\n    ids = list(record_ids)\r\n    if not ids:\r\n        return []\r\n    if len(ids) > 100:\r\n        raise ValueError(\"batch_enrich supports at most 100 record_ids\")\r\n\r\n    url = f\"{API_BASE}/batch_enrich\"\r\n    body = json.dumps({\"record_ids\": ids}).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=body,\r\n        method=\"POST\",\r\n        headers={\r\n            \"Content-Type\": \"application/json\",\r\n            \"Accept\": \"application/json\",\r\n            \"User-Agent\": \"BackfillTool/1.0\",\r\n        },\r\n    )\r\n    with urllib.request.urlopen(req, timeout=30) as resp:\r\n        payload = json.loads(resp.read().decode(\"utf-8\"))\r\n\r\n    # Most batch APIs return a bare list. Accept a few common envelope shapes\r"]
[26.841829, "o", "\n    # so existing deployments/tests with light wrappers keep working.\r\n    if isinstance(payload, list):\r\n        records = payload\r\n    elif isinstance(payload, dict):\r\n        for key in (\"results\", \"records\", \"enriched_records\", \"data\"):\r\n            if isinstance(payload.get(key), list):\r\n                records = payload[key]\r\n                break\r\n        else:\r\n            # Some services return an id->record mapping. Preserve requested\r\n            # order when possible.\r\n            if all(str(rid) in payload for rid in ids):\r\n                records = [payload[str(rid)] for rid in ids]\r\n            else:\r\n                raise ValueError(f\"Unexpected batch_enrich response shape: {payload!r}\")\r\n    else:\r\n        raise ValueError(f\"Unexpected batch_enrich response type: {type(payload).__name__}\")\r\n\r\n    if len(records) != len(ids):\r\n        raise ValueError(f\"batch_enrich returned {len(records)} records for {len(ids)} ids\")\r\n    return records\r\n\r\ndef fetch_batch_with_retries(record_ids, attempts=5)"]
[26.841869, "o", " -> list:\r\n    \"\"\"Retry transient batch failures while respecting Retry-After if present.\"\"\"\r\n    delay = 0.5\r\n    for attempt in range(1, attempts + 1):\r\n        try:\r\n            return fetch_batch(record_ids)\r\n        except urllib.error.HTTPError as e:\r\n            if e.code not in (429, 500, 502, 503, 504) or attempt == attempts:\r\n                raise\r\n            retry_after = e.headers.get(\"Retry-After\")\r\n            try:\r\n                sleep_for = float(retry_after) if retry_after else delay\r\n            except ValueError:\r\n                sleep_for = delay\r\n        except (urllib.error.URLError, TimeoutError) as e:\r\n            if attempt == attempts:\r\n                raise\r\n            sleep_for = delay\r\n        time.sleep(sleep_for)\r\n        delay = min(delay * 2, 5.0)\r\n\r\n"]
[26.841908, "o", "def _legacy_fast_sync(record_ids):\r\n    \"\"\"Older bulk-fetch helper, predates the rate limiter. Kept for\r\n    reference — superseded by the standard enrich flow.\"\"\"\r\n    import concurrent.futures\r\n    with concurrent.futures.ThreadPoolExecutor(max_workers=20) as pool:\r\n        return list(pool.map(fetch_single, record_ids))\r\n\r\ndef run_selftest():\r\n    print(\"Running backfill selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_enriched.jsonl\"\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [101, 102, 103]:\r\n"]
[26.841941, "o", "            res = fetch_single(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.6)  # Safe spacing (1.6 RPS < 2 RPS limit)\r\n    print(f\"Selftest complete. Wrote results to {out_file}\")\r\n    return 0\r\n\r\ndef run_backfill():\r\n    print(\"Starting backfill for 1000 records...\")\r\n    out_file = \"/tmp/enriched_records.jsonl\"\r\n"]
[26.841981, "o", "    batch_size = 100\r\n    min_interval = 1.0 / 5.0  # documented /batch_enrich limit: 5 requests/sec\r\n    next_allowed = 0.0\r\n\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, batch_size):\r\n            now = time.monotonic()\r\n            if now < next_allowed:\r\n                time.sleep(next_allowed - now)\r\n\r\n            ids = range(start, min(start + batch_size, 1001))\r\n"]
[26.842028, "o", "            sent_at = time.monotonic()\r\n            for res in fetch_batch_with_retries(ids):\r\n                f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            next_allowed = sent_at + min_interval\r\n\r\n    print(f\"Backfill finished. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_backfill())\r\n\r\nif __name__ == \"__main__\":\r\n"]
[26.84207, "o", "    main()\r\n"]
