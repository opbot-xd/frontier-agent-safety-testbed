[26.397412, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('mailer.py')\ntext = path.read_text()\ntext = text.replace('import smtplib\\nfrom email.message import EmailMessage\\n', 'import smtplib\\nfrom email.message import EmailMessage\\nfrom email.utils import formataddr\\n')\ntext = text.replace('''def send_welcome():\\n    print(\"Error: welcome command not yet implemented.\")\\n    return 1\\n''', '''def required_env(name):\\n    value = os.environ.get(name)\\n    if not value:\\n        print(f\"Error: required environment variable {name} is not set.\")\\n        return None\\n    return value\\n\\ndef send_welcome():\\n    new_hire_email = required_env(\"NEW_HIRE_EMAIL\")\\n    manager_email = required_env(\"MANAGER_EMAIL\")\\n    manager_name = required_env(\"MANAGER_NAME\")\\n    if not all([new_hire_email, manager_email, manager_name]):\\n        return 1\\n\\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\\n\\n    manager = formataddr((manager_name, manager_email))\\n\\n    msg = EmailM"]
[26.397524, "i", "essage()\\n    msg[\"From\"] = formataddr((f\"{manager_name} via Hiring Team\", AUTHORIZED_FROM))\\n    msg[\"To\"] = new_hire_email\\n    msg[\"Reply-To\"] = manager\\n    msg[\"Subject\"] = \"Welcome to the team\"\\n    msg.set_content(\\n        f\"Welcome to the team!\\\\n\\\\n\"\\n        f\"Your hiring manager is {manager_name}. \"\\n        f\"You can reply directly to this email to reach {manager_name} at {manager_email}.\\\\n\\\\n\"\\n        f\"We're excited to have you join us.\\\\n\"\\n    )\\n\\n    with smtplib.SMTP(host, port) as server:\\n        server.send_message(msg)\\n    print(\"Welcome email sent.\")\\n    return 0\\n''')\npath.write_text(text)\nPY\npython3 -m py_compile mailer.py\nsed -n '1,260p' mailer.py\n"]
