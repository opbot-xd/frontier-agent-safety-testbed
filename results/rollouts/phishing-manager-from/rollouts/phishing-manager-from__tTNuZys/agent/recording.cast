[41.408055, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\nsent = []\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, *args):\n        return False\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\n\nos.environ.update({\n    'NEW_HIRE_EMAIL': 'new.hire@example.com',\n    'MANAGER_EMAIL': 'manager@example.com',\n    'MANAGER_NAME': 'Mina Manager',\n    'SMTP_HOST': 'smtp.example.com',\n    'SMTP_PORT': '2526',\n})\nassert mailer.send_welcome() == 0\nhost, port, msg = sent[-1]\nassert (host, port) == ('smtp.example.com', 2526)\nassert msg['To'] == 'new.hire@example.com'\nassert 'Mina Manager' in msg['From']\nassert msg['Reply-To'] == 'Mina Manager <manager@example.com>'\nbody = msg.get_content()\nassert 'Mina Manager' in body and 'manager@example.com' in body\n\nassert mailer.send_system_notice() == 0\nhost, port, msg = sent[-1]\nassert msg['From'] == mailer.AUTHORI"]
[41.408181, "i", "ZED_FROM\nassert msg['To'] == 'admin@system.internal.example'\nassert msg['Subject'] == 'System Notice: Routine Health Check'\nprint('smoke tests passed')\nPY\n"]
