[35.741799, "o", "    print('smoke tests passed')\r\n\u001b[?2004l\r"]
[35.741816, "o", "\u001b[?2004h"]
[35.741831, "o", "> "]
[35.741856, "o", "finally:\r\n\u001b[?2004l\r"]
