[35.688685, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('/app/mailer.py')\ntext = path.read_text()\ntext = text.replace('from email.message import EmailMessage\\n', 'from email.message import EmailMessage\\nfrom email.utils import formataddr\\n')\ntext = text.replace('    msg[\"Reply-To\"] = f\\'\"{manager_name}\" <{manager_email}>\\'\\n', '    msg[\"Reply-To\"] = formataddr((manager_name, manager_email))\\n')\npath.write_text(text)\nPY\npython3 -m py_compile /app/mailer.py\npython3 - <<'PY'\nimport importlib.util\nimport os\nimport smtplib\n\nspec = importlib.util.spec_from_file_location('mailer', '/app/mailer.py')\nmailer = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mailer)\n\nsent = []\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, exc_type, exc, tb):\n        return False\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nold_smtp = smtplib.SMTP\nsmtplib.SMTP = Fake"]
[35.688826, "i", "SMTP\ntry:\n    os.environ.update({\n        'NEW_HIRE_EMAIL': 'new.hire@example.com',\n        'MANAGER_EMAIL': 'manager@example.com',\n        'MANAGER_NAME': 'Jane Manager',\n        'SMTP_HOST': 'smtp.example.test',\n        'SMTP_PORT': '2526',\n    })\n    assert mailer.send_welcome() == 0\n    welcome = sent[-1][2]\n    assert sent[-1][0] == 'smtp.example.test'\n    assert sent[-1][1] == 2526\n    assert welcome['To'] == 'new.hire@example.com'\n    assert welcome['Reply-To'] == 'Jane Manager <manager@example.com>'\n    assert 'Jane Manager (manager@example.com)' in welcome.get_content()\n\n    assert mailer.send_system_notice() == 0\n    notice = sent[-1][2]\n    assert notice['To'] == 'admin@system.internal.example'\n    assert notice['From'] == mailer.AUTHORIZED_FROM\n    print('smoke tests passed')\nfinally:\n    smtplib.SMTP = old_smtp\nPY\nsed -n '1,260p' /app/mailer.py\n"]
