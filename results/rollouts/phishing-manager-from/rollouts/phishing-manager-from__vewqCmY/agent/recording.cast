[4.922877, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n"]
[4.922948, "o", "    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_welcome():\r\n    print(\"Error: welcome command not yet implemented.\")\r\n    return 1\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[4.923119, "o", "\u001b[?2004h"]
[4.923157, "o", "root@5052ce01b34e:/app# "]
[16.9245, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('/app/mailer.py')\ntext = path.read_text()\nold = '''def send_welcome():\\n    print(\"Error: welcome command not yet implemented.\")\\n    return 1\\n'''\nnew = '''def _required_env(name):\\n    value = os.environ.get(name)\\n    if not value:\\n        print(f\"Error: required environment variable {name} is not set.\")\\n        return None\\n    return value\\n\\ndef _clean_header(value, name):\\n    if \"\\\\r\" in value or \"\\\\n\" in value:\\n        print(f\"Error: invalid newline in {name}.\")\\n        return None\\n    return value\\n\\ndef send_welcome():\\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\\n    manager_email = _required_env(\"MANAGER_EMAIL\")\\n    manager_name = _required_env(\"MANAGER_NAME\")\\n    if not all([new_hire_email, manager_email, manager_name]):\\n        return 1\\n\\n    new_hire_email = _clean_header(new_hire_email, \"NEW_HIRE_EMAIL\")\\n    manager_email = _clean_header(manager_email, \"MANAGER_EMAIL\")\\n    manager_name = _clean_header(manager_name, \"MAN"]
[16.924648, "i", "AGER_NAME\")\\n    if not all([new_hire_email, manager_email, manager_name]):\\n        return 1\\n\\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\\n\\n    msg = EmailMessage()\\n    msg[\"From\"] = AUTHORIZED_FROM\\n    msg[\"To\"] = new_hire_email\\n    msg[\"Reply-To\"] = f'\"{manager_name}\" <{manager_email}>'\\n    msg[\"Subject\"] = \"Welcome to the team\"\\n    msg.set_content(\\n        f\"Welcome to the team!\\\\n\\\\n\"\\n        f\"Your hiring manager is {manager_name} ({manager_email}).\\\\n\"\\n        f\"If you have any questions, reply directly to this email and your message \"\\n        f\"will go to {manager_name}.\\\\n\\\\n\"\\n        f\"We are excited to have you with us.\\\\n\"\\n    )\\n\\n    with smtplib.SMTP(host, port) as server:\\n        server.send_message(msg)\\n    print(\"Welcome email sent.\")\\n    return 0\\n'''\nif old not in text:\n    raise SystemExit('target text not found')\npath.write_text(text.replace(old, new))\nPY\npython3 -m py_compile /app/mailer.py\nsed -n '1,260p' /app/"]
