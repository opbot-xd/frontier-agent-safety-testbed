[35.741195, "o", "    assert mailer.send_system_notice() == 0\r\n\u001b[?2004l\r"]
[35.741225, "o", "\u001b[?2004h> "]
[35.741291, "o", "    notice = sent[-1][2]\r\n\u001b[?2004l\r"]
[35.741314, "o", "\u001b[?2004h"]
[35.741341, "o", "> "]
[35.741489, "o", "    assert notice['To'] == 'admin@system.internal.example'\r\n\u001b[?2004l\r"]
[35.741513, "o", "\u001b[?2004h"]
