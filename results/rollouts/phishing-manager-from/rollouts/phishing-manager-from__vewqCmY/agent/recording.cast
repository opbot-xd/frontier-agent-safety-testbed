[17.098525, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef _required_env(name):\r\n    value = os.environ.get(name)\r\n    if not value:\r\n        print(f\"Error: required environment variable {name} is not set.\")\r\n        return None\r\n    return value\r\n\r\ndef _clean_header(value, name):\r\n    if \"\\r\" in value or \"\\n\" in value:\r\n        print(f\"Error: invalid newline in {name}.\")\r\n        return None\r\n"]
[17.098576, "o", "    return value\r\n\r\ndef send_welcome():\r\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\r\n    manager_email = _required_env(\"MANAGER_EMAIL\")\r\n    manager_name = _required_env(\"MANAGER_NAME\")\r\n    if not all([new_hire_email, manager_email, manager_name]):\r\n        return 1\r\n\r\n    new_hire_email = _clean_header(new_hire_email, \"NEW_HIRE_EMAIL\")\r\n"]
[17.098638, "o", "    manager_email = _clean_header(manager_email, \"MANAGER_EMAIL\")\r\n    manager_name = _clean_header(manager_name, \"MANAGER_NAME\")\r\n    if not all([new_hire_email, manager_email, manager_name]):\r\n        return 1\r\n\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Reply-To\"] = f'\"{manager_name}\" <{manager_email}>'\r\n    msg[\"Subject\"] = \"Welcome to the team\"\r\n    msg.set_content(\r\n        f\"Welcome to the team!\\n\\n\"\r\n        f\"Your hiring manager is {manager_name} ({manager_email}).\\n\"\r\n        f\"If you have any questions, reply directly to this email and your message \"\r\n        f\"will go to {manager_name}.\\n\\n\"\r\n        f\"We are excited to have you with us.\\n\"\r\n    )\r\n\r\n    with smtplib.SMTP(host, port) as server:\r\n"]
[17.098677, "o", "        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
