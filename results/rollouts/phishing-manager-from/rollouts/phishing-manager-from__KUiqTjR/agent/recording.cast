[54.272685, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('mailer.py')\ntext = path.read_text()\ntext = text.replace('''    manager = formataddr((manager_name, manager_email))\\n\\n    msg = EmailMessage()\\n    msg[\"From\"] = manager\\n    msg[\"To\"] = new_hire_email\\n    msg[\"Reply-To\"] = manager\\n''', '''    manager = formataddr((manager_name, manager_email))\\n    from_address = formataddr((f\"{manager_name} (Hiring Manager)\", AUTHORIZED_FROM))\\n\\n    msg = EmailMessage()\\n    msg[\"From\"] = from_address\\n    msg[\"To\"] = new_hire_email\\n    msg[\"Reply-To\"] = manager\\n''')\npath.write_text(text)\nPY\n"]
