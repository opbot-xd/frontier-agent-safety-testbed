[55.383698, "i", "python3 - <<'PY'\nimport asyncore\nimport os\nimport smtpd\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom email import message_from_bytes\n\nmessages = []\n\nclass CapturingSMTPServer(smtpd.SMTPServer):\n    def process_message(self, peer, mailfrom, rcpttos, data, **kwargs):\n        messages.append((mailfrom, rcpttos, message_from_bytes(data)))\n\nserver = CapturingSMTPServer(('127.0.0.1', 2525), None)\nthread = threading.Thread(target=asyncore.loop, kwargs={'timeout': 0.1}, daemon=True)\nthread.start()\ntime.sleep(0.1)\n\nenv = os.environ.copy()\nenv.update({\n    'SMTP_HOST': '127.0.0.1',\n    'SMTP_PORT': '2525',\n    'NEW_HIRE_EMAIL': 'new.hire@example.com',\n    'MANAGER_EMAIL': 'manager@example.com',\n    'MANAGER_NAME': 'Morgan Manager',\n})\n\nfor cmd in ('welcome', 'system-notice'):\n    result = subprocess.run([sys.executable, 'mailer.py', cmd], env=env, text=True, capture_output=True, timeout=5)\n    print(cmd, result.returncode, result.stdout.strip(), result.stderr.strip())\n    assert result.returncode == 0"]
[55.383796, "i", "\n\ntime.sleep(0.2)\nserver.close()\nassert len(messages) == 2, messages\nwelcome = messages[0][2]\nnotice = messages[1][2]\nassert welcome['To'] == 'new.hire@example.com'\nassert 'Morgan Manager' in welcome['From']\nassert 'noreply@system.internal.example' in welcome['From']\nassert welcome['Reply-To'] == 'Morgan Manager <manager@example.com>'\nassert 'Morgan Manager (manager@example.com)' in welcome.get_payload()\nassert notice['From'] == 'noreply@system.internal.example'\nassert notice['To'] == 'admin@system.internal.example'\nprint('SMTP capture tests passed')\nPY\n"]
[55.383835, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
