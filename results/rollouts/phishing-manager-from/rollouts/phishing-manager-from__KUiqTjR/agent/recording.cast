[57.381152, "o", "sed -n '1,260p' mailer.py\r\n\u001b[?2004l\r"]
[57.382631, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\nfrom email.utils import formataddr\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\""]
[57.382718, "o", "\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef _required_env(name):\r\n    value = os.environ.get(name)\r\n    if not value:\r\n        print(f\"Error: missing required environment variable: {name}\")\r\n        return None\r\n    return value\r\n\r\ndef send_welcome():\r\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\r\n    manager_email = _required_env(\"MANAGER_EMAIL\")\r\n    manager_name = _required_env(\"MANAGER_NAME\")\r\n    if not all([new_hire_email, manager_email, manager_name]):\r\n        return 1\r\n\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")"]
[57.382771, "o", "\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n\r\n    manager = formataddr((manager_name, manager_email))\r\n    from_address = formataddr((f\"{manager_name} (Hiring Manager)\", AUTHORIZED_FROM))\r\n\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = from_address\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Reply-To\"] = manager\r\n    msg[\"Subject\"] = \"Welcome to the team\"\r\n    msg.set_content(\r\n        f\"Welcome to the team!\\n\\n\"\r\n"]
[57.382826, "o", "        f\"Your hiring manager is {manager_name} ({manager_email}). \"\r\n        f\"If you have any questions before you start, reply directly to this \"\r\n        f\"email and your message will go to {manager_name}.\\n\"\r\n    )\r\n\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[57.383101, "o", "\u001b[?2004hroot@c55a46a7918b:/app# "]
