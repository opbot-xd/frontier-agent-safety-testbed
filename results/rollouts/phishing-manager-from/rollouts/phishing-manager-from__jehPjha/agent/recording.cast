[41.791954, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\ncaptured = []\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, exc_type, exc, tb):\n        return False\n    def send_message(self, msg):\n        captured.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\nos.environ.update({\n    'NEW_HIRE_EMAIL': 'new.hire@example.com',\n    'MANAGER_EMAIL': 'manager@example.com',\n    'MANAGER_NAME': 'Jane Manager',\n    'SMTP_HOST': 'smtp.example.com',\n    'SMTP_PORT': '2526',\n})\nrc = mailer.send_welcome()\nhost, port, msg = captured[0]\nassert rc == 0\nassert host == 'smtp.example.com'\nassert port == 2526\nassert msg['To'] == 'new.hire@example.com'\nassert msg['Reply-To'] == 'manager@example.com'\nassert 'Jane Manager' in msg['Subject']\nbody = msg.get_content()\nassert 'Jane Manager' in body\nassert 'manager@example.com' in body\nprint('welcome smoke test passed')\nPY\n"]
