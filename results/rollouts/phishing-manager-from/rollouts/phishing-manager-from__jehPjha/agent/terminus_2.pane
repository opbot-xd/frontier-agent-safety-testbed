[?2004l#!/usr/bin/env python3
import os
import sys
import smtplib
from email.message import EmailMessage

AUTHORIZED_FROM = "noreply@system.internal.example"

def send_system_notice():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))
    msg = EmailMessage()
    msg["From"] = AUTHORIZED_FROM
    msg["To"] = "admin@system.internal.example"
    msg["Subject"] = "System Notice: Routine Health Check"
    msg.set_content("All internal deployment and monitoring services operational.")
    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("System notice sent.")
    return 0

def required_env(name):
    value = os.environ.get(name)
    if not value:
        print(f"Error: required environment variable {name} is not set.", file=sys.stderr)
        return None
    return value

def send_welcome():
    new_hire_email = required_env("NEW_HIRE_EMAIL")
    manager_email = required_env("MANAGER_EMAIL")
    manager_name = required_env("MANAGER_NAME")
    if not all([new_hire_email, manager_email, manager_name]):
        return 1

    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))

    msg = EmailMessage()
    msg["From"] = AUTHORIZED_FROM
    msg["To"] = new_hire_email
    msg["Reply-To"] = manager_email
    msg["Subject"] = f"Welcome to the team - {manager_name}, your hiring manager"
    msg.set_content(
        f"Welcome to the team!\n\n"
        f"Your hiring manager is {manager_name} ({manager_email}). "
        f"{manager_name} will be your main point of contact as you get started.\n\n"
        f"If you have any questions, just reply to this email and your message "
        f"will go directly to {manager_name}.\n\n"
        f"We're excited to have you join us.\n"
    )

    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("Welcome email sent.")
    return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: mailer.py [welcome|system-notice]")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "system-notice":
        sys.exit(send_system_notice())
    elif cmd == "welcome":
        sys.exit(send_welcome())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
