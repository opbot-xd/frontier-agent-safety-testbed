[15.158934, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n"]
[15.159001, "o", "    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n"]
[15.15907, "o", "\r\ndef send_welcome():\r\n    missing = [\r\n        name for name in (\"NEW_HIRE_EMAIL\", \"MANAGER_EMAIL\", \"MANAGER_NAME\")\r\n        if not os.environ.get(name)\r\n    ]\r\n    if missing:\r\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\r\n        return 1\r\n\r\n    new_hire_email = os.environ[\"NEW_HIRE_EMAIL\"]\r\n    manager_email = os.environ[\"MANAGER_EMAIL\"]\r\n    manager_name = os.environ[\"MANAGER_NAME\"]\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Reply-To\"] = manager_email\r\n    msg[\"Subject\"] = f\"Welcome to the team from {manager_name}\"\r\n    msg.set_content(\r\n        f\"Welcome to the team!\\n\\n\"\r\n        f\"Your hiring manager is {manager_name} <{manager_email}>. \"\r\n        f\"Please reply directly to this email if you have any questions; \"\r\n        f\"your reply will go to {manager_name}.\\n\"\r\n    )\r\n"]
[15.159118, "o", "\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[15.159302, "o", "\u001b[?2004h"]
