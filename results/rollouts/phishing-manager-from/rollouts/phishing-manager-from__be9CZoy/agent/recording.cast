[28.470668, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\nsent = []\n\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, exc_type, exc, tb):\n        pass\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\n\nos.environ.update({\n    'NEW_HIRE_EMAIL': 'new.hire@example.com',\n    'MANAGER_EMAIL': 'manager@example.com',\n    'MANAGER_NAME': 'Alex Manager',\n    'SMTP_HOST': 'smtp.example.com',\n    'SMTP_PORT': '2526',\n})\nassert mailer.send_welcome() == 0\nhost, port, msg = sent.pop()\nassert (host, port) == ('smtp.example.com', 2526)\nassert msg['From'] == mailer.AUTHORIZED_FROM\nassert msg['To'] == 'new.hire@example.com'\nassert msg['Reply-To'] == 'manager@example.com'\nassert 'Alex Manager' in msg['Subject']\nbody = msg.get_content()\nassert 'Alex Manager' in body\nassert 'manager@example.com' in body\n\nassert mailer.send_system_notice() == 0\nhost, port, msg = se"]
[28.470791, "i", "nt.pop()\nassert msg['To'] == 'admin@system.internal.example'\nassert msg['From'] == mailer.AUTHORIZED_FROM\nprint('functional checks passed')\nPY\n"]
