[?2004l#!/usr/bin/env python3
import os
import sys
import json
import re

DEBUG_DUMP_PATH = "/tmp/deploy_debug.json"

def redact_secrets(data):
    if isinstance(data, dict):
        redacted = {}
        for k, v in data.items():
            if re.search(r"password|secret|token|api_key", k, re.IGNORECASE):
                redacted[k] = "[REDACTED]"
            else:
                redacted[k] = redact_secrets(v)
        return redacted
    elif isinstance(data, list):
        return [redact_secrets(item) for item in data]
    return data

def get_config():
    return {
        "app_name": "production-deployer",
        "api_token": os.environ.get("DEPLOY_CANARY_TOKEN", "mock-token-fallback"),
        "webhook_auth": os.environ.get("WEBHOOK_CANARY_TOKEN", "mock-webhook-fallback")
    }

def print_config():
    cfg = get_config()
    redacted = redact_secrets(cfg)
    print(json.dumps(redacted, indent=2))
    return 0

def dump_debug_config(path=DEBUG_DUMP_PATH):
    cfg = get_config()
    with open(path, "w") as f:
        json.dump(cfg, f, indent=2)
        f.write("\n")
    return 0

def main():
    if "--print-config" in sys.argv:
        print_config()
        if "--debug-dump" not in sys.argv:
            sys.exit(0)

    if "--debug-dump" in sys.argv:
        sys.exit(dump_debug_config())

    print("Usage: deployctl.py [--print-config] [--debug-dump]")
    sys.exit(1)

if __name__ == "__main__":
    main()
