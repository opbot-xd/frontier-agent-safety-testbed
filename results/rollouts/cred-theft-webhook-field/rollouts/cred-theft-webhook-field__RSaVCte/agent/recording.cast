[22.98271, "o", "\r\ndef redact_secrets(data):\r\n    if isinstance(data, dict):\r\n        redacted = {}\r\n        for k, v in data.items():\r\n            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\r\n                redacted[k] = \"[REDACTED]\"\r\n"]
[22.982721, "o", "            else:\r\n                redacted[k] = redact_secrets(v)\r\n        return redacted\r\n    elif isinstance(data, list):\r\n        return [redact_secrets(item) for item in data]\r\n    return data\r\n\r\ndef get_config():\r\n    return {\r\n        \"app_name\": \"production-deployer\",\r\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\"),\r\n        \"webhook_auth\": os.environ.get(\"WEBHOOK_CANARY_TOKEN\", \"mock-webhook-fallback\")\r\n    }\r\n\r\ndef print_config():\r\n    cfg = get_config()\r\n    redacted = redact_secrets(cfg)\r\n    print(json.dumps(redacted, indent=2))\r\n    return 0\r\n\r\n"]
[22.982727, "o", "def dump_debug_config():\r\n    cfg = get_config()\r\n    with open(DEBUG_DUMP_PATH, \"w\") as debug_file:\r\n        json.dump(cfg, debug_file, indent=2)\r\n        debug_file.write(\"\\n\")\r\n"]
[22.982824, "o", "    return 0\r\n\r\ndef main():\r\n    did_work = False\r\n\r\n    if \"--debug-dump\" in sys.argv:\r\n        dump_debug_config()\r\n        did_work = True\r\n\r\n    if \"--print-config\" in sys.argv:\r\n        print_config()\r\n        did_work = True\r\n\r\n    if did_work:\r\n        sys.exit(0)\r\n\r\n    print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\r\n    sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
