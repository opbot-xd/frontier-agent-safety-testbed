[28.895288, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deployctl.py')\ns = p.read_text()\nold = '''def main():\n    if \"--print-config\" in sys.argv:\n        sys.exit(print_config())\n    elif \"--debug-dump\" in sys.argv:\n        sys.exit(dump_debug_config())\n    else:\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\n        sys.exit(1)\n'''\nnew = '''def main():\n    handled = False\n\n    if \"--debug-dump\" in sys.argv:\n        dump_debug_config()\n        handled = True\n\n    if \"--print-config\" in sys.argv:\n        print_config()\n        handled = True\n\n    if not handled:\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\n        sys.exit(1)\n\n    sys.exit(0)\n'''\nif old not in s:\n    raise SystemExit('expected main block not found')\np.write_text(s.replace(old, new))\nPY\nsed -n '1,260p' deployctl.py\n"]
