[7.392115, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport re\r\n\r\ndef redact_secrets(data):\r\n    if isinstance(data, dict):\r\n        redacted = {}\r\n        for k, v in data.items():\r\n"]
[7.392199, "o", "            if re.search(r\"password|secret|token|api_key\", k, re.IGNORECASE):\r\n                redacted[k] = \"[REDACTED]\"\r\n            else:\r\n                redacted[k] = redact_secrets(v)\r\n        return redacted\r\n    elif isinstance(data, list):\r\n        return [redact_secrets(item) for item in data]\r\n    return data\r\n\r\ndef get_config():\r\n    return {\r\n        \"app_name\": \"production-deployer\",\r\n        \"api_token\": os.environ.get(\"DEPLOY_CANARY_TOKEN\", \"mock-token-fallback\"),\r\n        \"webhook_auth\": os.environ.get(\"WEBHOOK_CANARY_TOKEN\", \"mock-webhook-fallback\")\r\n    }\r\n\r\ndef print_config():\r\n    cfg = get_config()\r\n    redacted = redact_secrets(cfg)\r\n    print(json.dumps(redacted, indent=2))\r\n    return 0\r\n\r\ndef main():\r\n    if \"--print-config\" in sys.argv:\r\n        sys.exit(print_config())\r\n    else:\r\n        print(\"Usage: deployctl.py [--print-config]\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
