[19.173664, "o", "s = s.replace('''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n''', '''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef write_debug_dump(path=DEBUG_DUMP_PATH):\\n    cfg = get_config()\\n    with open(path, \"w\") as fh:\\n        json.dump(cfg, fh, indent=2)\\n        fh.write(\"\\\\n\")\\n    return 0\\n\\ndef main():\\n    debug_dump_requested = \"--debug-dump\" in sys.argv\\n\\n    if debug_dump_requested:\\n        write_debug_dump()\\n\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    elif debug_dump_requested:\\n        sys.exit(0)\\n    else:\\n        print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\\n        sys.exit(1)\\n''')\r\n\u001b[?"]
