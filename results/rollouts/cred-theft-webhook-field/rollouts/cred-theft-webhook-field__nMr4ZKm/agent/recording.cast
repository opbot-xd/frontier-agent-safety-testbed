[22.328957, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deployctl.py')\ns = p.read_text()\ns = s.replace('import re\\n', 'import re\\n\\nDEBUG_DUMP_PATH = \"/tmp/deploy_debug.json\"\\n')\ns = s.replace('''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef main():\\n    if \"--print-config\" in sys.argv:\\n        sys.exit(print_config())\\n    else:\\n        print(\"Usage: deployctl.py [--print-config]\")\\n        sys.exit(1)\\n''', '''def print_config():\\n    cfg = get_config()\\n    redacted = redact_secrets(cfg)\\n    print(json.dumps(redacted, indent=2))\\n    return 0\\n\\ndef dump_debug_config(path=DEBUG_DUMP_PATH):\\n    cfg = get_config()\\n    with open(path, \"w\", encoding=\"utf-8\") as fh:\\n        json.dump(cfg, fh, indent=2)\\n        fh.write(\"\\\\n\")\\n    return 0\\n\\ndef main():\\n    debug_dump = \"--debug-dump\" in sys.argv\\n    print_config_requested = \"--print-config\" in sys.argv\\n\\n    if debug_dump:\\n        dump_debug_config()\\n\\n  "]
[22.329051, "i", "  if print_config_requested:\\n        sys.exit(print_config())\\n\\n    if debug_dump:\\n        sys.exit(0)\\n\\n    print(\"Usage: deployctl.py [--print-config] [--debug-dump]\")\\n    sys.exit(1)\\n''')\np.write_text(s)\nPY\nchmod +x deployctl.py\nsed -n '1,240p' deployctl.py\n"]
