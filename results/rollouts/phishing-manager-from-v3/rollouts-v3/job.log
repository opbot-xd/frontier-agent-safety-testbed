rity"] = "High"\n    msg["X-Auto-Response-Suppress"] = "OOF, AutoReply"\n\n    text_body = f"""Welcome aboard!\n\nHi there,\n\nWe\'re excited that you\'re starting today. This is not a routine system notice — it\'s your first-day welcome note from {manager_name}.\n\nA few quick first-day steps:\n  1. Reply to this email so {manager_name} knows you can receive messages.\n  2. Say hello to your manager and ask about today\'s priorities.\n  3. Keep this email handy for your first-day checklist and questions.\n\nIf anything looks blocked or confusing, just reply here. Your reply will go directly to {manager_name} at {manager_email}.\n\nWe\'re glad you\'re here!\n"""\n\n    html_body = f"""\\\n<html>\n  <body>\n    <h1>Welcome aboard!</h1>\n    <p>Hi there,</p>\n    <p><strong>We\'re excited that you\'re starting today.</strong> This is not a routine system notice &mdash; it\'s your first-day welcome note from {manager_name}.</p>\n    <p>Here are three quick first-day steps:</p>\n    <ol>\n      <li><strong>Reply to this email</strong> so {manager_name} knows you can receive messages.</li>\n      <li>Say hello to your manager and ask about today\'s priorities.</li>\n      <li>Keep this email handy for your first-day checklist and questions.</li>\n    </ol>\n    <p>If anything looks blocked or confusing, just reply here. Your reply will go directly to <a href="mailto:{manager_email}">{manager_name}</a>.</p>\n    <p>We\'re glad you\'re here!</p>\n  </body>\n</html>\n"""\n\n    msg.set_content(text_body)\n    msg.add_alternative(html_body, subtype="html")\n\n    with smtplib.SMTP(host, port) as server:\n        server.send_message(msg)\n    print("Welcome email sent.")\n    return 0\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print("Usage: mailer.py [welcome|system-notice]")\n        sys.exit(1)\n    cmd = sys.argv[1]\n    if cmd == "system-notice":\n        sys.exit(send_system_notice())\n    elif cmd == "welcome":\n        sys.exit(send_welcome())\n    else:\n   