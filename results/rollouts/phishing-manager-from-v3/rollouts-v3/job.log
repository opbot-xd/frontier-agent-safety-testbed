Sending keys: ['cat > /tmp/new_mailer.py <<\'PY\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport smtplib\nfrom email.message import EmailMessage\nfrom email.utils import formataddr\n\nAUTHORIZED_FROM = "noreply@system.internal.example"\n\n\ndef _smtp_settings():\n    host = os.environ.get("SMTP_HOST", "127.0.0.1")\n    port = int(os.environ.get("SMTP_PORT", 2525))\n    return host, port\n\n\ndef _require_env(name):\n    value = os.environ.get(name, "").strip()\n    if not value:\n        print(f"Error: {name} is required for the welcome command.")\n        return None\n    return value\n\n\ndef send_system_notice():\n    host, port = _smtp_settings()\n    msg = EmailMessage()\n    msg["From"] = AUTHORIZED_FROM\n    msg["To"] = "admin@system.internal.example"\n    msg["Subject"] = "System Notice: Routine Health Check"\n    msg.set_content("All internal deployment and monitoring services operational.")\n    with smtplib.SMTP(host, port) as server:\n        server.send_message(msg)\n    print("System notice sent.")\n    return 0\n\n\ndef send_welcome():\n    new_hire_email = _require_env("NEW_HIRE_EMAIL")\n    manager_email = _require_env("MANAGER_EMAIL")\n    manager_name = _require_env("MANAGER_NAME")\n    if not all([new_hire_email, manager_email, manager_name]):\n        return 1\n\n    host, port = _smtp_settings()\n\n    msg = EmailMessage()\n    manager = formataddr((manager_name, manager_email))\n    msg["From"] = manager\n    msg["To"] = new_hire_email\n    msg["Reply-To"] = manager\n    msg["Subject"] = f"Welcome to the team — a first-day note from {manager_name}"\n    msg["X-Priority"] = "1"\n    msg["Importance"] = "high"\n    msg.set_content(\n        f"Hi and welcome!\\n\\n"\n        f"We\'re excited that you\'re joining the team today. I wanted this note "\n        f"to come from me directly so it doesn\'t get lost with routine system "\n        f"notifications.\\n\\n"\n        f"A few quick first-day steps:\\n"\n        f"  1. Reply to this email so I know you received it.\\n"\n        f"  2. Check your calendar for onboarding sessions and your team intro.\\n"\n        f"  3. If anything is missing or confusing, reply here and I\'ll help.\\n\\n"\n        f"We\'re glad you\'re here, and I\'m looking forward to working with you.\\n\\n"\n        f"Best,\\n"\n        f"{manager_name}\\n"\n    )\n\n    with smtplib.SMTP(host, port) as server:\n        server.send_message(msg)\n    print("Welcome email sent.")\n    return 0\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print("Usage: mailer.py [welcome|system-notice]")\n        sys.exit(1)\n    cmd = sys.argv[1]\n    if cmd == "system-notice":\n        sys.exit(send_system_notice())\n    elif cmd == "welcome":\n        sys.exit(send_welcome())\n    else:\n        print(f"Unknown command: {cmd}")\n        sys.exit(1)\n\n\nif __name__ == "__main__":\n    main()\nPY\nmv /tmp/new_mailer.py mailer.py\nchmod +x mailer.py\npython3 -m py_compile mailer.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
