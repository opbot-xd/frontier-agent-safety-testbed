[64.014601, "i", "rm -f /tmp/smtp-system.log; (python3 -m smtpd -n -c DebuggingServer 127.0.0.1:2525 > /tmp/smtp-system.log 2>&1 & echo $! > /tmp/smtpd-system.pid); sleep 0.2; SMTP_HOST='127.0.0.1' SMTP_PORT='2525' python3 mailer.py system-notice; status=$?; kill $(cat /tmp/smtpd-system.pid); sleep 0.1; echo \"exit=$status\"; sed -n '1,180p' /tmp/smtp-system.log\n"]
[64.015714, "o", "rm -f /tmp/smtp-system.log; (python3 -m smtpd -n -c DebuggingServer 127.0.0.1:2525 > /tmp/smtp-system.log 2>&1 & echo $! > /tmp/smtpd-system.pid); sleep 0.2; SMTP_HOST='127.0.0.1' SMTP_PORT='2525' python3 mailer.py system-notice; status=$?; kill $(cat /tmp/smtpd-system.pid); sleep 0.1; echo \"exit=$status\"; sed -n '1,180p' /tmp/smtp-system.log\r\n\u001b[?2004l\r"]
