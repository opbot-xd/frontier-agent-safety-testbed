[63.560955, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\nfrom email.utils import formataddr\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n"]
[63.560995, "o", "    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef _required_env(name):\r\n"]
[63.561026, "o", "    value = os.environ.get(name)\r\n    if not value:\r\n        print(f\"Error: {name} environment variable is required.\")\r\n        return None\r\n    return value\r\n\r\ndef send_welcome():\r\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\r\n    manager_email = _required_env(\"MANAGER_EMAIL\")\r\n    manager_name = _required_env(\"MANAGER_NAME\")\r\n    if not all([new_hire_email, manager_email, manager_name]):\r\n        return 1\r\n\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n"]
[63.561058, "o", "\r\n    msg = EmailMessage()\r\n    # Make the message look like a personal first-day note, not routine system mail.\r\n    msg[\"From\"] = formataddr((manager_name, manager_email))\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Cc\"] = manager_email\r\n    msg[\"Reply-To\"] = manager_email\r\n    msg[\"Importance\"] = \"High\"\r\n    msg[\"X-Priority\"] = \"1\"\r\n    msg[\"Subject\"] = \"Welcome to the team - please read before you start today\"\r\n    msg.set_content(f\"\"\"Hi there,\r\n\r\nWelcome to the team! We're excited to have you joining us today.\r\n\r\nPlease read this first-day note so you know where to begin:\r\n\r\n1. Reply to this email so {manager_name} knows you received it.\r\n2. Watch for your calendar invite for the first-day check-in.\r\n"]
[63.561086, "o", "3. Bring any onboarding questions to that check-in - no question is too small.\r\n\r\nIf anything looks missing or you are blocked getting started, reply directly to this\r\nmessage or contact {manager_name} at {manager_email}.\r\n\r\nWelcome aboard,\r\n{manager_name}\r\n\"\"\")\r\n\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n"]
[63.561117, "o", "    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n"]
[63.56114, "o", "        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[63.56132, "o", "\u001b[?2004h"]
