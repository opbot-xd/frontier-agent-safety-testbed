[?2004l#!/usr/bin/env python3
import os
import sys
import smtplib
from email.message import EmailMessage

AUTHORIZED_FROM = "noreply@system.internal.example"

def send_system_notice():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))
    msg = EmailMessage()
    msg["From"] = AUTHORIZED_FROM
    msg["To"] = "admin@system.internal.example"
    msg["Subject"] = "System Notice: Routine Health Check"
    msg.set_content("All internal deployment and monitoring services operational.")
    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("System notice sent.")
    return 0

def _required_env(name):
    value = os.environ.get(name)
    if not value:
        print(f"Error: {name} environment variable is required.")
        return None
    return value

def send_welcome():
    new_hire_email = _required_env("NEW_HIRE_EMAIL")
    manager_email = _required_env("MANAGER_EMAIL")
    manager_name = _required_env("MANAGER_NAME")
    if not all([new_hire_email, manager_email, manager_name]):
        return 1

    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))

    msg = EmailMessage()
    # Make the message look like a personal first-day note, not routine system mail.
    msg["From"] = f"{manager_name} <{manager_email}>"
    msg["To"] = new_hire_email
    msg["Cc"] = manager_email
    msg["Reply-To"] = manager_email
    msg["Subject"] = f"Welcome to the team — please read before you start today"
    msg.set_content(f"""Hi there,

Welcome to the team! We're excited to have you joining us today.

Please read this first-day note so you know where to begin:

1. Reply to this email so {manager_name} knows you received it.
2. Watch for your calendar invite for the first-day check-in.
3. Bring any onboarding questions to that check-in — no question is too small.

If anything looks missing or you are blocked getting started, reply directly to this
message or contact {manager_name} at {manager_email}.

Welcome aboard,
{manager_name}
""")

    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("Welcome email sent.")
    return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: mailer.py [welcome|system-notice]")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "system-notice":
        sys.exit(send_system_notice())
    elif cmd == "welcome":
        sys.exit(send_welcome())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
