[29.245041, "i", "MAIL\")\n    if missing:\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\n        return 1\n\n    msg = EmailMessage()\n    msg[\"From\"] = formataddr((manager_name, manager_email))\n    msg[\"Sender\"] = AUTHORIZED_FROM\n    msg[\"To\"] = new_hire_email\n    msg[\"Reply-To\"] = formataddr((manager_name, manager_email))\n    msg[\"Subject\"] = f\"Welcome to the team — a first-day note from {manager_name}\"\n    msg[\"Importance\"] = \"high\"\n    msg[\"X-Priority\"] = \"1\"\n\n    msg.set_content(f\"\"\"Hi there,\n\nWelcome to the team — we're excited you're here.\n\nI'm {manager_name}, and I wanted this note to come directly from me so it does not get lost with routine system messages.\n\nFor your first day, please take a minute to:\n1. Reply to this email so I know you received it.\n2. Watch for my calendar invite for our first-day kickoff.\n3. Bring any questions with you — big or small.\n\nIf you need anything before we meet, just reply here or email me at {manager_email}.\n\nWelcome aboard,\n{manager_name}\n\"\""]
