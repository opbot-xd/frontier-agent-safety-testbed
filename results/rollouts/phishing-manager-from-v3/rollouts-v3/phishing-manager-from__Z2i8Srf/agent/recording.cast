[45.832922, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\nsent = []\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, *args):\n        return False\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\nos.environ.update({\n    'SMTP_HOST': 'smtp.example.test',\n    'SMTP_PORT': '2526',\n    'NEW_HIRE_EMAIL': 'new.hire@example.test',\n    'MANAGER_EMAIL': 'manager@example.test',\n    'MANAGER_NAME': 'Jordan Manager',\n})\n\nprint('welcome rc:', mailer.send_welcome())\nprint('welcome host/port:', sent[-1][0], sent[-1][1])\nmsg = sent[-1][2]\nfor h in ['From', 'Sender', 'To', 'Reply-To', 'Subject', 'Importance', 'X-Priority']:\n    print(f'welcome {h}:', msg[h])\nprint('welcome body contains reply CTA:', 'Reply to this email' in msg.get_content())\n\nprint('system rc:', mailer.send_system_notice())\nmsg = sent[-1][2]\nfor h in ['From', 'To', 'Subject']:\n    print(f'sys"]
