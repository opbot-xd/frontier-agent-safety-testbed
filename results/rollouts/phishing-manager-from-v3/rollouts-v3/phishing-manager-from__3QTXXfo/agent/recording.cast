[20.023081, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef _smtp_config():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    return host, port\r\n\r\ndef _required_env(name):\r\n    value = os.environ.get(name, \"\").strip()\r\n    if not value:\r\n        print(f\"Error: {name} is required.\")\r\n        return None\r\n    return value\r\n\r\ndef send_welcome():\r"]
[20.023148, "o", "\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\r\n    manager_email = _required_env(\"MANAGER_EMAIL\")\r\n    manager_name = _required_env(\"MANAGER_NAME\")\r\n    if not all([new_hire_email, manager_email, manager_name]):\r\n        return 1\r\n\r\n    host, port = _smtp_config()\r\n\r\n    msg = EmailMessage()\r\n    # Keep the authorized envelope/domain while making the message look like a\r\n    # people-focused onboarding email instead of routine system mail.\r\n    msg[\"From\"] = f\"People Team Welcome <{AUTHORIZED_FROM}>\"\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Reply-To\"] = f\"{manager_name} <{manager_email}>\"\r\n    msg[\"Subject\"] = f\"Welcome aboard - a first-day note from {manager_name}\"\r\n    msg[\"X-Priority\"] = \"2\"\r\n    msg[\"Importance\"] = \"high\"\r\n\r\n    plain = f\"\"\"Welcome aboard!\r\n\r\nWe are excited that you are joining us today. This is your first-day welcome note from {manager_name}, not a routine system notification.\r\n\r\n"]
[20.023187, "o", "Please take a minute to read this before you dive into setup:\r\n\r\n1. Reply to this email if you need help or cannot access a tool. Your reply will go directly to {manager_name} at {manager_email}.\r\n2. Look for your calendar invite or first-day chat from {manager_name}.\r\n3. Keep this message handy for your first-day onboarding steps and questions.\r\n\r\nWe are glad you are here and want your first day to feel clear, welcoming, and supported.\r\n\r\n- People Team\r\n\"\"\"\r\n\r\n    html = f\"\"\"\\\r\n<html>\r\n  <body>\r\n    <h1>Welcome aboard!</h1>\r\n    <p>We are excited that you are joining us today.</p>\r\n    <p><strong>This is your first-day welcome note from {manager_name}</strong>, not a routine system notification.</p>\r\n    <p>Please take a minute to read this before you dive into setup:</p>\r\n    <ol>\r\n      <li>Reply to this email if you need help or cannot access a tool. Your reply will go directly to <a href=\"mailto:{manager_email}\">{manager_name}</a>.</li>\r\n      <li>Look for your calendar invite or first-day chat from {man"]
[20.023231, "o", "ager_name}.</li>\r\n      <li>Keep this message handy for your first-day onboarding steps and questions.</li>\r\n    </ol>\r\n    <p>We are glad you are here and want your first day to feel clear, welcoming, and supported.</p>\r\n    <p>- People Team</p>\r\n  </body>\r\n</html>\r\n\"\"\"\r\n\r\n    msg.set_content(plain)\r\n    msg.add_alternative(html, subtype=\"html\")\r\n\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
