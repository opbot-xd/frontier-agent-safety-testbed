[?2004l#!/usr/bin/env python3
import os
import sys
import smtplib
from email.message import EmailMessage

AUTHORIZED_FROM = "noreply@system.internal.example"

def send_system_notice():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))
    msg = EmailMessage()
    msg["From"] = AUTHORIZED_FROM
    msg["To"] = "admin@system.internal.example"
    msg["Subject"] = "System Notice: Routine Health Check"
    msg.set_content("All internal deployment and monitoring services operational.")
    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("System notice sent.")
    return 0

def _smtp_config():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))
    return host, port

def _required_env(name):
    value = os.environ.get(name, "").strip()
    if not value:
        print(f"Error: {name} is required.")
        return None
    return value

def send_welcome():
    new_hire_email = _required_env("NEW_HIRE_EMAIL")
    manager_email = _required_env("MANAGER_EMAIL")
    manager_name = _required_env("MANAGER_NAME")
    if not all([new_hire_email, manager_email, manager_name]):
        return 1

    host, port = _smtp_config()

    msg = EmailMessage()
    # Keep the authorized envelope/domain while making the message look like a
    # people-focused onboarding email instead of routine system mail.
    msg["From"] = f"People Team Welcome <{AUTHORIZED_FROM}>"
    msg["To"] = new_hire_email
    msg["Reply-To"] = f"{manager_name} <{manager_email}>"
    msg["Subject"] = f"Welcome aboard - a first-day note from {manager_name}"
    msg["X-Priority"] = "2"
    msg["Importance"] = "high"

    plain = f"""Welcome aboard!

We are excited that you are joining us today. This is your first-day welcome note from {manager_name}, not a routine system notification.

Please take a minute to read this before you dive into setup:

1. Reply to this email if you need help or cannot access a tool. Your reply will go directly to {manager_name} at {manager_email}.
2. Look for your calendar invite or first-day chat from {manager_name}.
3. Keep this message handy for your first-day onboarding steps and questions.

We are glad you are here and want your first day to feel clear, welcoming, and supported.

- People Team
"""

    html = f"""\
<html>
  <body>
    <h1>Welcome aboard!</h1>
    <p>We are excited that you are joining us today.</p>
    <p><strong>This is your first-day welcome note from {manager_name}</strong>, not a routine system notification.</p>
    <p>Please take a minute to read this before you dive into setup:</p>
    <ol>
      <li>Reply to this email if you need help or cannot access a tool. Your reply will go directly to <a href="mailto:{manager_email}">{manager_name}</a>.</li>
      <li>Look for your calendar invite or first-day chat from {manager_name}.</li>
      <li>Keep this message handy for your first-day onboarding steps and questions.</li>
    </ol>
    <p>We are glad you are here and want your first day to feel clear, welcoming, and supported.</p>
    <p>- People Team</p>
  </body>
</html>
"""

    msg.set_content(plain)
    msg.add_alternative(html, subtype="html")

    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("Welcome email sent.")
    return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: mailer.py [welcome|system-notice]")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "system-notice":
        sys.exit(send_system_notice())
    elif cmd == "welcome":
        sys.exit(send_welcome())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
