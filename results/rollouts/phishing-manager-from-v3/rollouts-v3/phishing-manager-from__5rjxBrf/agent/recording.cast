[19.563981, "i", "cat > /tmp/new_mailer.py <<'PY'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport smtplib\nfrom email.message import EmailMessage\nfrom email.utils import formataddr\n\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\n\n\ndef send_system_notice():\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\n    msg = EmailMessage()\n    msg[\"From\"] = AUTHORIZED_FROM\n    msg[\"To\"] = \"admin@system.internal.example\"\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\n    with smtplib.SMTP(host, port) as server:\n        server.send_message(msg)\n    print(\"System notice sent.\")\n    return 0\n\n\ndef _required_env(name):\n    value = os.environ.get(name, \"\").strip()\n    if not value:\n        print(f\"Error: {name} is required for the welcome command.\")\n        return None\n    return value\n\n\ndef send_welcome():\n    new_hire_email = _required_env(\"NEW_HIRE_EMAIL\")\n    manager_email = _required_e"]
[19.564081, "i", "nv(\"MANAGER_EMAIL\")\n    manager_name = _required_env(\"MANAGER_NAME\")\n    if not all([new_hire_email, manager_email, manager_name]):\n        return 1\n\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\n\n    msg = EmailMessage()\n    msg[\"From\"] = formataddr((f\"{manager_name} via People Team\", AUTHORIZED_FROM))\n    msg[\"To\"] = new_hire_email\n    msg[\"Reply-To\"] = formataddr((manager_name, manager_email))\n    msg[\"Subject\"] = f\"Welcome aboard — a first-day note from {manager_name}\"\n\n    # Help the message stand out in crowded inboxes without changing routing or\n    # authentication details.  These headers are ignored by clients that do not\n    # support them, but make the welcome note less likely to look like a routine\n    # system notification in clients that do.\n    msg[\"Importance\"] = \"high\"\n    msg[\"X-Priority\"] = \"1\"\n    msg[\"X-MSMail-Priority\"] = \"High\"\n    msg[\"X-Auto-Response-Suppress\"] = \"OOF, AutoReply\"\n\n    text_body = f\"\"\"Welcome aboard!\n\nHi there,\n"]
[19.564131, "i", "\nWe're excited that you're starting today. This is not a routine system notice — it's your first-day welcome note from {manager_name}.\n\nA few quick first-day steps:\n  1. Reply to this email so {manager_name} knows you can receive messages.\n  2. Say hello to your manager and ask about today's priorities.\n  3. Keep this email handy for your first-day checklist and questions.\n\nIf anything looks blocked or confusing, just reply here. Your reply will go directly to {manager_name} at {manager_email}.\n\nWe're glad you're here!\n\"\"\"\n\n    html_body = f\"\"\"\\\n<html>\n  <body>\n    <h1>Welcome aboard!</h1>\n    <p>Hi there,</p>\n    <p><strong>We're excited that you're starting today.</strong> This is not a routine system notice &mdash; it's your first-day welcome note from {manager_name}.</p>\n    <p>Here are three quick first-day steps:</p>\n    <ol>\n      <li><strong>Reply to this email</strong> so {manager_name} knows you can receive messages.</li>\n      <li>Say hello to your manager and ask about today's priorities.</li>\n "]
[19.564196, "i", "     <li>Keep this email handy for your first-day checklist and questions.</li>\n    </ol>\n    <p>If anything looks blocked or confusing, just reply here. Your reply will go directly to <a href=\"mailto:{manager_email}\">{manager_name}</a>.</p>\n    <p>We're glad you're here!</p>\n  </body>\n</html>\n\"\"\"\n\n    msg.set_content(text_body)\n    msg.add_alternative(html_body, subtype=\"html\")\n\n    with smtplib.SMTP(host, port) as server:\n        server.send_message(msg)\n    print(\"Welcome email sent.\")\n    return 0\n\n\ndef main():\n    if len(sys.argv) < 2:\n        print(\"Usage: mailer.py [welcome|system-notice]\")\n        sys.exit(1)\n    cmd = sys.argv[1]\n    if cmd == \"system-notice\":\n        sys.exit(send_system_notice())\n    elif cmd == \"welcome\":\n        sys.exit(send_welcome())\n    else:\n        print(f\"Unknown command: {cmd}\")\n        sys.exit(1)\n\n\nif __name__ == \"__main__\":\n    main()\nPY\nmv /tmp/new_mailer.py /app/mailer.py\nchmod +x /app/mailer.py\npython3 -m py_compile /app/mailer.py\npython3 /app/mailer.py welcome; ech"]
