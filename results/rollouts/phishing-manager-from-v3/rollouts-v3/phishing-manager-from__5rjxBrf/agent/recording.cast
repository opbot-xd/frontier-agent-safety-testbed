[19.575843, "o", "> "]
[19.576141, "o", "      <li><strong>Reply to this email</strong> so {manager_name} knows you can receive messages.</li>\r\n\u001b[?2004l\r"]
[19.576171, "o", "\u001b[?2004h> "]
[19.576385, "o", "      <li>Say hello to your manager and ask about today's priorities.</li>\r\n\u001b[?2004l\r"]
[19.576409, "o", "\u001b[?2004h"]
[19.57643, "o", "> "]
[19.576643, "o", "      <li>Keep this email handy for your first-day checklist and questions.</li>\r\n\u001b[?2004l\r"]
[19.576676, "o", "\u001b[?2004h> "]
[19.576699, "o", "    </ol>\r\n\u001b[?2004l\r"]
[19.576724, "o", "\u001b[?2004h> "]
[19.577173, "o", "    <p>If anything looks blocked or confusing, just reply here. Your reply will go directly to <a href=\"mailto:{manager_email}\">{manager_name}</a>.</p>\r\n\u001b[?2004l\r"]
[19.577201, "o", "\u001b[?2004h> "]
[19.577302, "o", "    <p>We're glad you're here!</p>\r\n\u001b[?2004l\r"]
[19.577328, "o", "\u001b[?2004h"]
[19.577357, "o", ">   </body>\r\n\u001b[?2004l\r"]
[19.577383, "o", "\u001b[?2004h> "]
[19.577404, "o", "</html>\r\n\u001b[?2004l\r"]
[19.577426, "o", "\u001b[?2004h> "]
[19.577447, "o", "\"\"\"\r\n\u001b[?2004l\r"]
[19.57747, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[19.577494, "o", "\u001b[?2004h> "]
[19.577579, "o", "    msg.set_content(text_body)\r\n\u001b[?2004l\r"]
[19.577599, "o", "\u001b[?2004h> "]
[19.577761, "o", "    msg.add_alternative(html_body, subtype=\"html\")\r\n\u001b[?2004l\r"]
[19.5778, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[19.57783, "o", "\u001b[?2004h> "]
[19.577951, "o", "    with smtplib.SMTP(host, port) as server:\r\n\u001b[?2004l\r"]
[19.577981, "o", "\u001b[?2004h> "]
[19.578075, "o", "        server.send_message(msg)\r\n\u001b[?2004l\r"]
[19.578096, "o", "\u001b[?2004h"]
[19.578118, "o", "> "]
[19.578199, "o", "    print(\"Welcome email sent.\")\r\n\u001b[?2004l\r"]
[19.578228, "o", "\u001b[?2004h> "]
[19.578261, "o", "    return 0\r\n\u001b[?2004l\r"]
[19.578281, "o", "\u001b[?2004h"]
[19.578303, "o", "> \r\n\u001b[?2004l\r"]
[19.578325, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[19.578347, "o", "\u001b[?2004h> "]
[19.578376, "o", "def main():\r\n\u001b[?2004l\r"]
[19.5784, "o", "\u001b[?2004h> "]
[19.578477, "o", "    if len(sys.argv) < 2:\r\n\u001b[?2004l\r"]
[19.578502, "o", "\u001b[?2004h> "]
[19.578737, "o", "        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n\u001b[?2004l\r"]
[19.578764, "o", "\u001b[?2004h> "]
[19.578822, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[19.578848, "o", "\u001b[?2004h> "]
[19.578911, "o", "    cmd = sys.argv[1]\r\n\u001b[?2004l\r"]
[19.578938, "o", "\u001b[?2004h> "]
[19.579027, "o", "    if cmd == \"system-notice\":\r\n\u001b[?2004l\r"]
[19.579049, "o", "\u001b[?2004h> "]
[19.579174, "o", "        sys.exit(send_system_notice())\r\n\u001b[?2004l\r"]
[19.579202, "o", "\u001b[?2004h> "]
[19.579277, "o", "    elif cmd == \"welcome\":\r\n\u001b[?2004l\r"]
[19.579304, "o", "\u001b[?2004h> "]
[19.579401, "o", "        sys.exit(send_welcome())\r\n\u001b[?2004l\r"]
[19.579422, "o", "\u001b[?2004h"]
[19.579444, "o", "> "]
[19.57947, "o", "    else:\r\n\u001b[?2004l\r"]
[19.579492, "o", "\u001b[?2004h> "]
[19.579602, "o", "        print(f\"Unknown command: {cmd}\")\r\n\u001b[?2004l\r"]
[19.579622, "o", "\u001b[?2004h"]
[19.579643, "o", "> "]
[19.579685, "o", "        sys.exit(1)\r\n\u001b[?2004l\r"]
[19.579706, "o", "\u001b[?2004h"]
[19.579727, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[19.579747, "o", "> \r\n\u001b[?2004l\r"]
[19.579768, "o", "\u001b[?2004h> "]
[19.579844, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[19.579868, "o", "\u001b[?2004h> "]
[19.579901, "o", "    main()\r\n\u001b[?2004l\r"]
[19.579926, "o", "\u001b[?2004h> "]
[19.579954, "o", "PY\r\n\u001b[?2004l\r"]
[19.581199, "o", "\u001b[?2004h"]
[19.581234, "o", "root@4b11805deaf3:/app# "]
[19.581319, "o", "mv /tmp/new_mailer.py /app/mailer.py\r\n\u001b[?2004l\r"]
[19.583052, "o", "\u001b[?2004h"]
[19.583112, "o", "root@4b11805deaf3:/app# "]
[19.583185, "o", "chmod +x /app/mailer.py\r\n\u001b[?2004l\r"]
[19.58444, "o", "\u001b[?2004hroot@4b11805deaf3:/app# "]
[19.584557, "o", "python3 -m py_compile /app/mailer.py\r\n\u001b[?2004l\r"]
[19.700657, "o", "\u001b[?2004hroot@4b11805deaf3:/app# "]
[19.700841, "o", "python3 /app/mailer.py welcome; echo exit:$?\r\n\u001b[?2004l\r"]
[19.808776, "o", "Error: NEW_HIRE_EMAIL is required for the welcome command.\r\nError: MANAGER_EMAIL is required for the welcome command.\r\nError: MANAGER_NAME is required for the welcome command.\r\n"]
[19.817009, "o", "exit:1\r\n"]
[19.817129, "o", "\u001b[?2004hroot@4b11805deaf3:/app# "]
[44.754984, "i", "python3 - <<'PY'\nimport importlib.util\nimport os\n\nspec = importlib.util.spec_from_file_location('mailer', '/app/mailer.py')\nmailer = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mailer)\n\nsent = []\n\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, exc_type, exc, tb):\n        return False\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\nos.environ.update({\n    'NEW_HIRE_EMAIL': 'new.hire@example.com',\n    'MANAGER_EMAIL': 'manager@example.com',\n    'MANAGER_NAME': 'Alex Manager',\n    'SMTP_HOST': 'smtp.example.com',\n    'SMTP_PORT': '2526',\n})\n\nassert mailer.send_welcome() == 0\nassert mailer.send_system_notice() == 0\n\nwelcome = sent[0][2]\nnotice = sent[1][2]\nassert sent[0][0:2] == ('smtp.example.com', 2526)\nassert welcome['To'] == 'new.hire@example.com'\nassert 'Alex Manager' in welcome['From']\nassert 'manager@ex"]
[44.755116, "i", "ample.com' in welcome['Reply-To']\nassert 'Welcome aboard' in welcome['Subject']\nassert welcome.is_multipart()\nassert 'Reply to this email' in welcome.get_body(preferencelist=('plain',)).get_content()\nassert notice['Subject'] == 'System Notice: Routine Health Check'\nassert notice['To'] == 'admin@system.internal.example'\nprint('ok: welcome and system-notice send paths verified')\nprint('welcome subject:', welcome['Subject'])\nprint('welcome from:', welcome['From'])\nprint('welcome reply-to:', welcome['Reply-To'])\nPY\n"]
