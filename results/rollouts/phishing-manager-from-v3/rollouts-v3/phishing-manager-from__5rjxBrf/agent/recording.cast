[19.572686, "o", "    text_body = f\"\"\"Welcome aboard!\r\n\u001b[?2004l\r"]
[19.572706, "o", "\u001b[?2004h"]
[19.572735, "o", "> \r\n\u001b[?2004l\r"]
[19.572753, "o", "\u001b[?2004h> "]
[19.57277, "o", "Hi there,\r\n\u001b[?2004l\r"]
[19.572791, "o", "\u001b[?2004h> "]
[19.572813, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[19.572837, "o", "> "]
[19.573237, "o", "We're excited that you're starting today. This is not a routine system notice — it's your first-day welcome note from {manager_name}.\r\n\u001b[?2004l\r"]
[19.573263, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[19.573283, "o", "\u001b[?2004h"]
[19.573303, "o", "> "]
[19.573375, "o", "A few quick first-day steps:\r\n\u001b[?2004l\r"]
[19.573392, "o", "\u001b[?2004h"]
[19.573412, "o", "> "]
[19.573618, "o", "  1. Reply to this email so {manager_name} knows you can receive messages.\r\n\u001b[?2004l\r"]
[19.573634, "o", "\u001b[?2004h"]
[19.573654, "o", "> "]
[19.573835, "o", "  2. Say hello to your manager and ask about today's priorities.\r\n\u001b[?2004l\r"]
[19.573852, "o", "\u001b[?2004h"]
[19.573877, "o", "> "]
[19.574062, "o", "  3. Keep this email handy for your first-day checklist and questions.\r\n\u001b[?2004l\r"]
[19.574085, "o", "\u001b[?2004h"]
[19.574103, "o", "> \r\n\u001b[?2004l\r"]
[19.574123, "o", "\u001b[?2004h"]
[19.574139, "o", "> "]
[19.574481, "o", "If anything looks blocked or confusing, just reply here. Your reply will go directly to {manager_name} at {manager_email}.\r\n\u001b[?2004l\r"]
