[19.575059, "o", "    <p>Hi there,</p>\r\n\u001b[?2004l\r"]
[19.575082, "o", "\u001b[?2004h"]
[19.575106, "o", "> "]
[19.575578, "o", "    <p><strong>We're excited that you're starting today.</strong> This is not a routine system notice &mdash; it's your first-day welcome note from {manager_name}.</p>\r\n\u001b[?2004l\r"]
[19.575606, "o", "\u001b[?2004h> "]
[19.575749, "o", "    <p>Here are three quick first-day steps:</p>\r\n\u001b[?2004l\r"]
[19.575778, "o", "\u001b[?2004h"]
[19.5758, "o", ">     <ol>\r\n"]
