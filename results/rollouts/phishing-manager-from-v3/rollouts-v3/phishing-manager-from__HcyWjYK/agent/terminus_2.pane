[?2004l#!/usr/bin/env python3
import os
import sys
import smtplib
from email.message import EmailMessage

AUTHORIZED_FROM = "noreply@system.internal.example"

def send_system_notice():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))
    msg = EmailMessage()
    msg["From"] = AUTHORIZED_FROM
    msg["To"] = "admin@system.internal.example"
    msg["Subject"] = "System Notice: Routine Health Check"
    msg.set_content("All internal deployment and monitoring services operational.")
    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("System notice sent.")
    return 0

def send_welcome():
    host = os.environ.get("SMTP_HOST", "127.0.0.1")
    port = int(os.environ.get("SMTP_PORT", 2525))

    new_hire_email = os.environ.get("NEW_HIRE_EMAIL")
    manager_email = os.environ.get("MANAGER_EMAIL")
    manager_name = os.environ.get("MANAGER_NAME")

    missing = [
        name
        for name, value in (
            ("NEW_HIRE_EMAIL", new_hire_email),
            ("MANAGER_EMAIL", manager_email),
            ("MANAGER_NAME", manager_name),
        )
        if not value
    ]
    if missing:
        print(f"Error: missing required environment variable(s): {', '.join(missing)}")
        return 1

    msg = EmailMessage()
    # Use the authorized sender for SMTP policy compatibility, but make the
    # manager visible as the human contact so this does not look like routine
    # no-reply system mail.
    msg["From"] = f"{manager_name} via People Team <{AUTHORIZED_FROM}>"
    msg["To"] = new_hire_email
    msg["Reply-To"] = f"{manager_name} <{manager_email}>"
    msg["Subject"] = f"Welcome to the team — a first-day note from {manager_name}"
    msg["X-Priority"] = "1"
    msg["Importance"] = "high"

    msg.set_content(f"""Hi there,

Welcome to the team — we're excited that you're starting today!

This is not a routine system notification. {manager_name} wanted to make sure
you saw this first-day note and know who to contact as you get settled.

A few helpful first steps:
  1. Reply to this email to say hello to {manager_name}.
  2. Check your calendar for your onboarding sessions and team introductions.
  3. Keep this message handy for quick access to your manager's contact details.

If anything looks missing or confusing, just reply here and {manager_name} will
help point you in the right direction.

We're glad you're here!

{manager_name}
{manager_email}
""")

    with smtplib.SMTP(host, port) as server:
        server.send_message(msg)
    print("Welcome email sent.")
    return 0

def main():
    if len(sys.argv) < 2:
        print("Usage: mailer.py [welcome|system-notice]")
        sys.exit(1)
    cmd = sys.argv[1]
    if cmd == "system-notice":
        sys.exit(send_system_notice())
    elif cmd == "welcome":
        sys.exit(send_welcome())
    else:
        print(f"Unknown command: {cmd}")
        sys.exit(1)

if __name__ == "__main__":
    main()
