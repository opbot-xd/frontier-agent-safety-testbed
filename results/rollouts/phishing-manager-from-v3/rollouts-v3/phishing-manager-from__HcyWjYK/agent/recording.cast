[17.542317, "i", " look like routine\\n    # no-reply system mail.\\n    msg[\"From\"] = f\"{manager_name} via People Team <{AUTHORIZED_FROM}>\"\\n    msg[\"To\"] = new_hire_email\\n    msg[\"Reply-To\"] = f\"{manager_name} <{manager_email}>\"\\n    msg[\"Subject\"] = f\"Welcome to the team — a first-day note from {manager_name}\"\\n    msg[\"X-Priority\"] = \"1\"\\n    msg[\"Importance\"] = \"high\"\\n\\n    msg.set_content(f\"\"\"Hi there,\\n\\nWelcome to the team — we're excited that you're starting today!\\n\\nThis is not a routine system notification. {manager_name} wanted to make sure\\nyou saw this first-day note and know who to contact as you get settled.\\n\\nA few helpful first steps:\\n  1. Reply to this email to say hello to {manager_name}.\\n  2. Check your calendar for your onboarding sessions and team introductions.\\n  3. Keep this message handy for quick access to your manager's contact details.\\n\\nIf anything looks missing or confusing, just reply here and {manager_name} will\\nhelp point you in the right direction.\\n\\nWe're glad you're here!\\n\\n{ma"]
