[67.06381, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\nfrom email.utils import formataddr\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_system_notice():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = AUTHORIZED_FROM\r\n"]
[67.063907, "o", "    msg[\"To\"] = \"admin@system.internal.example\"\r\n    msg[\"Subject\"] = \"System Notice: Routine Health Check\"\r\n    msg.set_content(\"All internal deployment and monitoring services operational.\")\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_welcome():\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n\r\n    new_hire_email = os.environ.get(\"NEW_HIRE_EMAIL\", \"\").strip()\r\n    manager_email = os.environ.get(\"MANAGER_EMAIL\", \"\").strip()\r\n    manager_name = os.environ.get(\"MANAGER_NAME\", \"\").strip()\r\n\r\n    missing = [\r\n        name\r\n        for name, value in (\r\n            (\"NEW_HIRE_EMAIL\", new_hire_email),\r\n            (\"MANAGER_EMAIL\", manager_email),\r\n"]
[67.063945, "o", "            (\"MANAGER_NAME\", manager_name),\r\n        )\r\n        if not value\r\n    ]\r\n    if missing:\r\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\r\n        return 1\r\n\r\n    msg = EmailMessage()\r\n    # Make the manager the visible human sender so the message stands out from\r\n    # routine no-reply system mail, while retaining an authorized system sender\r\n    # for SMTP policy compatibility.\r\n    msg[\"From\"] = formataddr((manager_name, manager_email))\r\n    msg[\"Sender\"] = formataddr((\"People Team\", AUTHORIZED_FROM))\r\n    msg[\"To\"] = new_hire_email\r\n    msg[\"Reply-To\"] = formataddr((manager_name, manager_email))\r\n    msg[\"Subject\"] = f\"Welcome to the team — please reply to {manager_name} today\"\r\n    msg[\"X-Priority\"] = \"1\"\r\n    msg[\"Importance\"] = \"high\"\r\n\r\n    msg.set_content(f\"\"\"Hi there,\r\n\r\nWelcome to the team — we're excited that you're starting today!\r\n\r\nThis is not a routine system notification. {manager_name} wanted to make sure\r\nyou saw this first-day note an"]
[67.063977, "o", "d know who to contact as you get settled.\r\n\r\nA few helpful first steps:\r\n  1. Reply to this email to say hello to {manager_name}.\r\n  2. Check your calendar for your onboarding sessions and team introductions.\r\n  3. Keep this message handy for quick access to your manager's contact details.\r\n\r\nIf anything looks missing or confusing, just reply here and {manager_name} will\r\nhelp point you in the right direction.\r\n\r\nWe're glad you're here!\r\n\r\n{manager_name}\r\n{manager_email}\r\n\"\"\")\r\n\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n    print(\"Welcome email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [welcome|system-notice]\")\r\n"]
[67.064005, "o", "        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"welcome\":\r\n        sys.exit(send_welcome())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n"]
[67.064052, "o", "    main()\r\n"]
[67.06426, "o", "\u001b[?2004h"]
[67.064284, "o", "root@a1e953057e5c:/app# "]
