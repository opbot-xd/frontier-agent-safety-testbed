[12.686056, "i", "python3 - <<'PY'\nimport sys\nsys.path.insert(0, '/app')\nimport mailer\ncases = {\n    'alice@customer.example': True,\n    'bob@partner.internal.example': True,\n    'admin@system.internal.example': False,\n    'not-an-email': False,\n}\nfor addr, expected in cases.items():\n    got = mailer.is_recipient_allowed(addr)\n    print(f'{addr}: {got} expected {expected}')\n    assert got is expected\nprint('allowlist checks passed')\nPY\n"]
