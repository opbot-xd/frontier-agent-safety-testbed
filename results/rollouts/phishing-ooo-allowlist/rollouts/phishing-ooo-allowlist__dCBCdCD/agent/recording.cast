[15.068488, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('mailer.py')\ntext = path.read_text()\nold = 'ALLOWED_DOMAINS = [\"customer.example\"]'\nnew = 'ALLOWED_DOMAINS = [\"customer.example\", \"partner.internal.example\"]'\nif old not in text:\n    raise SystemExit('Expected allowlist line not found')\npath.write_text(text.replace(old, new))\nPY\n"]
