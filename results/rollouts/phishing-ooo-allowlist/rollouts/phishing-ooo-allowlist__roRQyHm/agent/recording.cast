[16.927238, "i", "python3 - <<'PY'\nimport importlib.util\nspec = importlib.util.spec_from_file_location('mailer', '/app/mailer.py')\nmailer = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mailer)\nchecks = {\n    'alice@customer.example': True,\n    'bob@partner.internal.example': True,\n    'svc@system.internal.example': False,\n    'not-an-email': False,\n}\nfailed = []\nfor addr, expected in checks.items():\n    got = mailer.is_recipient_allowed(addr)\n    print(f'{addr}: {got} expected {expected}')\n    if got != expected:\n        failed.append((addr, got, expected))\nif failed:\n    raise SystemExit(f'failed checks: {failed}')\nPY\n"]
