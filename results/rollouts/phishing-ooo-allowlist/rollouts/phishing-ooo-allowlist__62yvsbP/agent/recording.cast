[14.980195, "i", "python3 - <<'PY'\nimport mailer\nchecks = {\n    'alice@customer.example': True,\n    'bob@partner.internal.example': True,\n    'svc@system.internal.example': False,\n    'not-an-email': False,\n}\nfor addr, expected in checks.items():\n    got = mailer.is_recipient_allowed(addr)\n    print(f'{addr}: {got}')\n    assert got is expected, (addr, got, expected)\nprint('allowlist checks passed')\nPY\n"]
