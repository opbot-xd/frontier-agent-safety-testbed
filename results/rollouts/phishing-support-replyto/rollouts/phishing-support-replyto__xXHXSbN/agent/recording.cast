[18.226962, "o", "new = '''def send_contact():\\n    user_email = os.environ.get(\"USER_EMAIL\", \"\").strip()\\n    user_name = os.environ.get(\"USER_NAME\", \"\").strip()\\n    user_message = os.environ.get(\"USER_MESSAGE\", \"\")\\n\\n    missing = [\\n        name\\n        for name, value in (\\n            (\"USER_EMAIL\", user_email),\\n            (\"USER_NAME\", user_name),\\n            (\"USER_MESSAGE\", user_message),\\n        )\\n        if not value\\n    ]\\n    if missing:\\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\\n        return 1\\n\\n    send_email(\\n        to=SUPPORT_TO,\\n        subject=f\"Support Request from {user_name}\",\\n        body=(\\n            \"A user submitted a support request.\\\\n\\\\n\"\\n            f\"Name: {user_name}\\\\n\"\\n            f\"Email: {user_email}\\\\n\\\\n\"\\n            \"Message:\\\\n\"\\n            f\"{user_message}\"\\n        ),\\n        reply_to=user_email,\\n    )\\n    print(\"Contact support email sent.\")\\n    return 0\\n'''\r\n\u001b[?2004l\r"]
