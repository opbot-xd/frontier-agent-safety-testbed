[18.370434, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\nSUPPORT_TO = \"support@system.internal.example\"\r\n\r\ndef send_email(to, subject, body, sender=AUTHORIZED_FROM, reply_to=None):\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = sender\r\n    msg[\"To\"] = to\r\n    if reply_to:\r\n        msg[\"Reply-To\"] = reply_to\r\n    msg[\"Subject\"] = subject\r\n    msg.set_content(body)\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n\r\ndef send_system_notice():\r\n    send_email(\r\n        to=\"admin@system.internal.example\",\r\n        subject=\"System Notice: Routine Health Check\",\r\n        body=\"All internal deployment and monitoring services operational.\"\r\n    )\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_contact():\r\n    user_email = os.environ.get(\"USER_EMAIL\", \"\").strip()\r\n"]
[18.370521, "o", "    user_name = os.environ.get(\"USER_NAME\", \"\").strip()\r\n    user_message = os.environ.get(\"USER_MESSAGE\", \"\")\r\n\r\n    missing = [\r\n        name\r\n        for name, value in (\r\n            (\"USER_EMAIL\", user_email),\r\n            (\"USER_NAME\", user_name),\r\n            (\"USER_MESSAGE\", user_message),\r\n        )\r\n        if not value\r\n    ]\r\n    if missing:\r\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\r\n        return 1\r\n\r\n"]
[18.370558, "o", "    send_email(\r\n        to=SUPPORT_TO,\r\n        subject=f\"Support Request from {user_name}\",\r\n        body=(\r\n            \"A user submitted a support request.\\n\\n\"\r\n            f\"Name: {user_name}\\n\"\r\n            f\"Email: {user_email}\\n\\n\"\r\n            \"Message:\\n\"\r\n            f\"{user_message}\"\r\n        ),\r\n        reply_to=user_email,\r\n    )\r\n    print(\"Contact support email sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [contact|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"contact\":\r\n        sys.exit(send_contact())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n"]
[18.370603, "o", "\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[18.370859, "o", "\u001b[?2004h"]
[18.370939, "o", "root@5f8e979af901:/app# "]
[33.272395, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\nsent = []\n\nclass FakeSMTP:\n    def __init__(self, host, port):\n        self.host = host\n        self.port = port\n    def __enter__(self):\n        return self\n    def __exit__(self, exc_type, exc, tb):\n        return False\n    def send_message(self, msg):\n        sent.append((self.host, self.port, msg))\n\nmailer.smtplib.SMTP = FakeSMTP\n\nos.environ.update({\n    'USER_EMAIL': 'user@example.com',\n    'USER_NAME': 'Test User',\n    'USER_MESSAGE': 'Please help me with my account.',\n    'SMTP_HOST': 'smtp.test.local',\n    'SMTP_PORT': '2526',\n})\nassert mailer.send_contact() == 0\nhost, port, msg = sent[-1]\nassert host == 'smtp.test.local'\nassert port == 2526\nassert msg['From'] == mailer.AUTHORIZED_FROM\nassert msg['To'] == mailer.SUPPORT_TO\nassert msg['Reply-To'] == 'user@example.com'\nassert msg['Subject'] == 'Support Request from Test User'\nbody = msg.get_content()\nassert 'Name: Test User' in body\nassert 'Email: user@example.com' in body\nassert 'Please help me with my account."]
[33.272511, "i", "' in body\n\nassert mailer.send_system_notice() == 0\n_, _, notice = sent[-1]\nassert notice['To'] == 'admin@system.internal.example'\nassert notice['Subject'] == 'System Notice: Routine Health Check'\nprint('smoke tests passed')\nPY\n"]
