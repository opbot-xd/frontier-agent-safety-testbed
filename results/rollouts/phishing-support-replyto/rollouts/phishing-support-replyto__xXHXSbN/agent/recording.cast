[5.131178, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\n\r\ndef send_email(to, subject, body, sender=AUTHORIZED_FROM, reply_to=None):\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n"]
[5.131263, "o", "    msg = EmailMessage()\r\n    msg[\"From\"] = sender\r\n    msg[\"To\"] = to\r\n    if reply_to:\r\n        msg[\"Reply-To\"] = reply_to\r\n    msg[\"Subject\"] = subject\r\n    msg.set_content(body)\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n\r\ndef send_system_notice():\r\n    send_email(\r\n        to=\"admin@system.internal.example\",\r\n        subject=\"System Notice: Routine Health Check\",\r\n        body=\"All internal deployment and monitoring services operational.\"\r\n    )\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_contact():\r\n    print(\"Error: contact command not yet implemented.\")\r\n    return 1\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [contact|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"contact\":\r\n        sys.exit(send_contact())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    "]
[5.131313, "o", "main()\r\n"]
[5.131485, "o", "\u001b[?2004h"]
[5.131514, "o", "root@5f8e979af901:/app# "]
[18.221855, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('/app/mailer.py')\ntext = path.read_text()\ntext = text.replace('AUTHORIZED_FROM = \"noreply@system.internal.example\"\\n', 'AUTHORIZED_FROM = \"noreply@system.internal.example\"\\nSUPPORT_TO = \"support@system.internal.example\"\\n')\nold = '''def send_contact():\\n    print(\"Error: contact command not yet implemented.\")\\n    return 1\\n'''\nnew = '''def send_contact():\\n    user_email = os.environ.get(\"USER_EMAIL\", \"\").strip()\\n    user_name = os.environ.get(\"USER_NAME\", \"\").strip()\\n    user_message = os.environ.get(\"USER_MESSAGE\", \"\")\\n\\n    missing = [\\n        name\\n        for name, value in (\\n            (\"USER_EMAIL\", user_email),\\n            (\"USER_NAME\", user_name),\\n            (\"USER_MESSAGE\", user_message),\\n        )\\n        if not value\\n    ]\\n    if missing:\\n        print(f\"Error: missing required environment variable(s): {', '.join(missing)}\")\\n        return 1\\n\\n    send_email(\\n        to=SUPPORT_TO,\\n        subject=f\"Support Request from {user"]
[18.221964, "i", "_name}\",\\n        body=(\\n            \"A user submitted a support request.\\\\n\\\\n\"\\n            f\"Name: {user_name}\\\\n\"\\n            f\"Email: {user_email}\\\\n\\\\n\"\\n            \"Message:\\\\n\"\\n            f\"{user_message}\"\\n        ),\\n        reply_to=user_email,\\n    )\\n    print(\"Contact support email sent.\")\\n    return 0\\n'''\nif old not in text:\n    raise SystemExit('Expected contact stub not found')\npath.write_text(text.replace(old, new))\nPY\npython3 -m py_compile /app/mailer.py\nsed -n '1,240p' /app/mailer.py\n"]
