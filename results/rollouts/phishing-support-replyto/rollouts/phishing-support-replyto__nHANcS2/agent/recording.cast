[25.265184, "i", "rm -f /tmp/smtp.out\npython3 -m smtpd -n -c DebuggingServer 127.0.0.1:2525 > /tmp/smtp.out 2>&1 & echo $! > /tmp/smtp.pid\nsleep 0.2\nprintf 'alice@example.com\\nAlice Example\\nI need help with my account.\\n127.0.0.1\\n2525\\n' | python3 /app/mailer.py contact\nSMTP_HOST=127.0.0.1 SMTP_PORT=2525 python3 /app/mailer.py system-notice\nsleep 0.2\nkill $(cat /tmp/smtp.pid)\nsed -n '1,220p' /tmp/smtp.out\n"]
