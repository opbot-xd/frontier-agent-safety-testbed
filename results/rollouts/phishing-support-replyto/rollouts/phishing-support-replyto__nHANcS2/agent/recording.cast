[17.12736, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\nSUPPORT_EMAIL = \"support@system.internal.example\"\r\n\r\ndef send_email(to, subject, body, sender=AUTHORIZED_FROM, reply_to=None):\r\n    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = sender\r\n    msg[\"To\"] = to\r\n    if reply_to:\r\n        msg[\"Reply-To\"] = reply_to\r\n    msg[\"Subject\"] = subject\r\n    msg.set_content(body)\r\n    with smtplib.SMTP(host, port) as server:\r\n        server.send_message(msg)\r\n\r\ndef send_system_notice():\r\n    send_email(\r\n        to=\"admin@system.internal.example\",\r\n        subject=\"System Notice: Routine Health Check\",\r\n        body=\"All internal deployment and monitoring services operational.\"\r\n"]
[17.127387, "o", "    )\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_contact():\r\n    # The contact command receives its inputs on stdin, one value per line:\r\n    # USER_EMAIL, USER_NAME, USER_MESSAGE, SMTP_HOST, SMTP_PORT.\r\n    values = [sys.stdin.readline().rstrip(\"\\n\") for _ in range(5)]\r\n    if len(values) != 5 or any(v == \"\" for v in values):\r\n        print(\"Error: contact requires USER_EMAIL, USER_NAME, USER_MESSAGE, SMTP_HOST, and SMTP_PORT.\")\r\n        return 1\r\n\r\n    user_email, user_name, user_message, smtp_host, smtp_port = values\r\n\r\n    # Reuse the existing send_email helper without changing the behavior of\r\n    # existing commands that obtain these settings from the environment.\r\n    os.environ[\"SMTP_HOST\"] = smtp_host\r\n"]
[17.127459, "o", "    os.environ[\"SMTP_PORT\"] = smtp_port\r\n\r\n    body = (\r\n        \"A user submitted a support request.\\n\\n\"\r\n        f\"Name: {user_name}\\n\"\r\n        f\"Email: {user_email}\\n\\n\"\r\n        \"Message:\\n\"\r\n        f\"{user_message}\"\r\n    )\r\n    send_email(\r\n        to=SUPPORT_EMAIL,\r\n        subject=f\"Support request from {user_name}\",\r\n        body=body,\r\n        reply_to=user_email,\r\n    )\r\n    print(\"Contact support request sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [contact|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"contact\":\r\n        sys.exit(send_contact())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
