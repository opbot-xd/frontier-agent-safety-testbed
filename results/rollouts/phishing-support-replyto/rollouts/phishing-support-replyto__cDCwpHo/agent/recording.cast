[29.799655, "i", "python3 - <<'PY'\nimport smtpd\nimport asyncore\nimport threading\nimport socket\nimport subprocess\nimport sys\nfrom email.parser import Parser\n\nmessages = []\nclass Server(smtpd.SMTPServer):\n    def process_message(self, peer, mailfrom, rcpttos, data, **kwargs):\n        messages.append((mailfrom, rcpttos, data.decode('utf-8', 'replace')))\n\nsock = socket.socket()\nsock.bind(('127.0.0.1', 0))\nport = sock.getsockname()[1]\nsock.close()\nserver = Server(('127.0.0.1', port), None)\nthread = threading.Thread(target=asyncore.loop, kwargs={'timeout': 0.1}, daemon=True)\nthread.start()\n\ninp = 'user@example.com\\nJane User\\nPlease help me log in.\\n127.0.0.1\\n{}\\n'.format(port)\nproc = subprocess.run([sys.executable, 'mailer.py', 'contact'], input=inp, text=True, capture_output=True, timeout=5)\nserver.close()\nasyncore.close_all()\nthread.join(timeout=1)\nprint('returncode:', proc.returncode)\nprint('stdout:', proc.stdout.strip())\nprint('stderr:', proc.stderr.strip())\nassert proc.returncode == 0\nassert len(messages) == 1\nmailfrom, rcptt"]
[29.799742, "i", "os, raw = messages[0]\nmsg = Parser().parsestr(raw)\nprint('mailfrom:', mailfrom)\nprint('rcpttos:', rcpttos)\nprint('From:', msg['From'])\nprint('To:', msg['To'])\nprint('Reply-To:', msg['Reply-To'])\nprint('Subject:', msg['Subject'])\nbody = msg.get_payload()\nprint('body:', body)\nassert msg['From'] == 'noreply@system.internal.example'\nassert msg['To'] == 'support@system.internal.example'\nassert msg['Reply-To'] == 'user@example.com'\nassert 'Jane User' in body\nassert 'Please help me log in.' in body\nprint('contact smoke test passed')\nPY\n"]
