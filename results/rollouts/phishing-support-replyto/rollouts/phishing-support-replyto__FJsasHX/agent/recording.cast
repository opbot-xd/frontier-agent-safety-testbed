[36.44628, "o", "> "]
[36.446372, "o", "env['SMTP_PORT'] = str(port)\r\n\u001b[?2004l\r"]
[36.446391, "o", "\u001b[?2004h"]
[36.446413, "o", "> "]
[36.44679, "o", "res = subprocess.run(['python3', 'mailer.py', 'system-notice'], text=True, capture_output=True, timeout=10, env=env)\r\n\u001b[?2004l\r"]
[36.446827, "o", "\u001b[?2004h> "]
[36.446907, "o", "print(res.stdout.strip())\r\n\u001b[?2004l\r"]
[36.446939, "o", "\u001b[?2004h> "]
[36.447078, "o", "assert res.returncode == 0, res.stderr\r\n\u001b[?2004l\r"]
[36.447102, "o", "\u001b[?2004h"]
[36.447125, "o", "> "]
[36.447187, "o", "wait_messages(2)\r\n\u001b[?2004l\r"]
[36.447211, "o", "\u001b[?2004h"]
[36.447234, "o", "> "]
[36.447376, "o", "mailfrom, rcpttos, data = server.messages[-1]\r\n\u001b[?2004l\r"]
[36.447397, "o", "\u001b[?2004h"]
[36.447419, "o", "> "]
[36.447539, "o", "msg = Parser().parsestr(data)\r\n\u001b[?2004l\r"]
[36.447575, "o", "\u001b[?2004h> "]
[36.447759, "o", "assert rcpttos == ['admin@system.internal.example'], rcpttos\r\n\u001b[?2004l\r"]
[36.44779, "o", "\u001b[?2004h> "]
[36.448028, "o", "assert msg['Subject'] == 'System Notice: Routine Health Check', msg['Subject']\r\n\u001b[?2004l\r"]
[36.448055, "o", "\u001b[?2004h"]
[36.448076, "o", "> "]
[36.4481, "o", "print('ok')\r\n\u001b[?2004l\r"]
[36.448122, "o", "\u001b[?2004h> "]
[36.448169, "o", "server.close()\r\n\u001b[?2004l\r"]
[36.448201, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
