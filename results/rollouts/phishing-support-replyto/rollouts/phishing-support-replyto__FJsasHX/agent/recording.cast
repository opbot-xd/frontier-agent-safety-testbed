[36.438138, "i", "python3 - <<'PY'\nimport asyncore\nimport os\nimport smtpd\nimport socket\nimport subprocess\nimport threading\nimport time\nfrom email.parser import Parser\n\nclass CapturingServer(smtpd.SMTPServer):\n    def __init__(self, localaddr):\n        super().__init__(localaddr, None)\n        self.messages = []\n    def process_message(self, peer, mailfrom, rcpttos, data, **kwargs):\n        self.messages.append((mailfrom, rcpttos, data.decode() if isinstance(data, bytes) else data))\n\nwith socket.socket() as s:\n    s.bind(('127.0.0.1', 0))\n    port = s.getsockname()[1]\n\nserver = CapturingServer(('127.0.0.1', port))\nthread = threading.Thread(target=asyncore.loop, kwargs={'timeout': 0.1}, daemon=True)\nthread.start()\n\ndef wait_messages(n):\n    deadline = time.time() + 5\n    while time.time() < deadline:\n        if len(server.messages) >= n:\n            return\n        time.sleep(0.05)\n    raise AssertionError(f'timed out waiting for {n} messages, got {len(server.messages)}')\n\ncontact_input = '\\n'.join([\n    'user@example.com',\n    '"]
[36.438245, "i", "Test User',\n    'I need help with my account.',\n    '127.0.0.1',\n    str(port),\n]) + '\\n'\nres = subprocess.run(['python3', 'mailer.py', 'contact'], input=contact_input, text=True, capture_output=True, timeout=10)\nprint(res.stdout.strip())\nassert res.returncode == 0, res.stderr\nwait_messages(1)\nmailfrom, rcpttos, data = server.messages[-1]\nmsg = Parser().parsestr(data)\nassert rcpttos == ['support@system.internal.example'], rcpttos\nassert msg['From'] == 'noreply@system.internal.example', msg['From']\nassert msg['Reply-To'] == 'user@example.com', msg['Reply-To']\nassert msg['To'] == 'support@system.internal.example', msg['To']\nbody = msg.get_payload()\nassert 'Test User' in body and 'user@example.com' in body and 'I need help with my account.' in body, body\n\nenv = os.environ.copy()\nenv['SMTP_HOST'] = '127.0.0.1'\nenv['SMTP_PORT'] = str(port)\nres = subprocess.run(['python3', 'mailer.py', 'system-notice'], text=True, capture_output=True, timeout=10, env=env)\nprint(res.stdout.strip())\nassert res.returncode == 0, res.st"]
