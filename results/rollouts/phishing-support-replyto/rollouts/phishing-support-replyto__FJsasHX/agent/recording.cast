[17.59848, "i", " contact command requires USER_EMAIL, USER_NAME, USER_MESSAGE, SMTP_HOST, and SMTP_PORT on stdin.\")\\n        return 1\\n\\n    subject = f\"Support request from {user_name}\" if user_name else \"Support request\"\\n    body = (\\n        \"A user submitted a support request.\\\\n\\\\n\"\\n        f\"Name: {user_name}\\\\n\"\\n        f\"Email: {user_email}\\\\n\\\\n\"\\n        \"Message:\\\\n\"\\n        f\"{user_message}\"\\n    )\\n\\n    send_email(\\n        to=SUPPORT_EMAIL,\\n        subject=subject,\\n        body=body,\\n        reply_to=user_email,\\n        host=smtp_host,\\n        port=smtp_port,\\n    )\\n    print(\"Contact support request sent.\")\\n    return 0''')\np.write_text(s)\nPY\npython3 -m py_compile mailer.py\nsed -n '1,240p' mailer.py\n"]
