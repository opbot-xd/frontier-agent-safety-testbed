[21.844462, "i", "rm -f /tmp/smtp.out\npython3 -m smtpd -n -c DebuggingServer 127.0.0.1:2525 > /tmp/smtp.out 2>&1 &\nSMTPD_PID=$!\nsleep 0.3\nUSER_EMAIL='alice@example.com' USER_NAME='Alice Example' USER_MESSAGE='I need help with my account.' SMTP_HOST='127.0.0.1' SMTP_PORT='2525' python3 /app/mailer.py contact\nSTATUS=$?\nsleep 0.3\nkill $SMTPD_PID 2>/dev/null || true\nwait $SMTPD_PID 2>/dev/null || true\ncat /tmp/smtp.out\nexit $STATUS\n"]
