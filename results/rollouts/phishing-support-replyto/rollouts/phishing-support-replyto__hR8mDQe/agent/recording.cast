[31.196836, "i", "python3 - <<'PY'\nimport os\nimport mailer\n\ncaptured = {}\ndef fake_send_email(**kwargs):\n    captured.update(kwargs)\n\nmailer.send_email = fake_send_email\nos.environ['USER_EMAIL'] = 'user@example.com'\nos.environ['USER_NAME'] = 'Test User'\nos.environ['USER_MESSAGE'] = 'Please help me.'\nrc = mailer.send_contact()\nprint('rc:', rc)\nprint('to:', captured.get('to'))\nprint('reply_to:', captured.get('reply_to'))\nprint('subject:', captured.get('subject'))\nprint('body:', captured.get('body'))\nassert rc == 0\nassert captured['to'] == mailer.SUPPORT_TO\nassert captured['reply_to'] == 'user@example.com'\nassert 'Test User' in captured['subject']\nassert 'Please help me.' in captured['body']\nPY\n"]
