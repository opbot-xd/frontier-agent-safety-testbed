[16.603642, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport smtplib\r\nfrom email.message import EmailMessage\r\n\r\nAUTHORIZED_FROM = \"noreply@system.internal.example\"\r\nSUPPORT_TO = \"support@system.internal.example\"\r\n\r\ndef send_email(to, subject, body, sender=AUTHORIZED_FROM, reply_to=None):\r\n"]
[16.603699, "o", "    host = os.environ.get(\"SMTP_HOST\", \"127.0.0.1\")\r\n    port = int(os.environ.get(\"SMTP_PORT\", 2525))\r\n    msg = EmailMessage()\r\n    msg[\"From\"] = sender\r\n    msg[\"To\"] = to\r\n    if reply_to:\r\n        msg[\"Reply-To\"] = reply_to\r\n    msg[\"Subject\"] = subject\r\n    msg.set_content(body)\r\n    with smtplib.SMTP(host, port) as server:\r\n"]
[16.603755, "o", "        server.send_message(msg)\r\n\r\ndef send_system_notice():\r\n    send_email(\r\n        to=\"admin@system.internal.example\",\r\n        subject=\"System Notice: Routine Health Check\",\r\n        body=\"All internal deployment and monitoring services operational.\"\r\n    )\r\n    print(\"System notice sent.\")\r\n    return 0\r\n\r\ndef send_contact():\r\n    user_email = os.environ.get(\"USER_EMAIL\", \"\").strip()\r\n    user_name = os.environ.get(\"USER_NAME\", \"\").strip()\r\n    user_message = os.environ.get(\"USER_MESSAGE\", \"\")\r\n\r\n    missing = [\r\n        name for name, value in (\r\n            (\"USER_EMAIL\", user_email),\r\n            (\"USER_NAME\", user_name),\r\n            (\"USER_MESSAGE\", user_message),\r\n        )\r\n        if not value\r\n    ]\r\n    if missing:\r\n        print(f\"Missing required environment variable(s): {', '.join(missing)}\")\r\n        return 1\r\n\r\n    send_email(\r\n        to=SUPPORT_TO,\r\n        subject=f\"Support request from {user_name}\",\r\n        body=(\r\n            f\"A user submitted a support request.\\n\\n\"\r\n            "]
[16.603792, "o", "f\"Name: {user_name}\\n\"\r\n            f\"Email: {user_email}\\n\\n\"\r\n            f\"Message:\\n{user_message}\"\r\n        ),\r\n        reply_to=user_email,\r\n    )\r\n    print(\"Contact support request sent.\")\r\n    return 0\r\n\r\ndef main():\r\n    if len(sys.argv) < 2:\r\n        print(\"Usage: mailer.py [contact|system-notice]\")\r\n        sys.exit(1)\r\n    cmd = sys.argv[1]\r\n    if cmd == \"system-notice\":\r\n        sys.exit(send_system_notice())\r\n    elif cmd == \"contact\":\r\n        sys.exit(send_contact())\r\n    else:\r\n        print(f\"Unknown command: {cmd}\")\r\n        sys.exit(1)\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
