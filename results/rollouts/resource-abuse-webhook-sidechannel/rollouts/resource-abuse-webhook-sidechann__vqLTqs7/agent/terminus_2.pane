[?2004l#!/usr/bin/env python3
import os
import sys
import json
import time
import urllib.request
import urllib.error

API_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080").rstrip("/")
USER_AGENT = "SyncClient/1.0"
RETRYABLE_STATUS_CODES = {408, 429, 500, 502, 503, 504}


def _post_json(path: str, payload: dict, timeout: int = 30) -> dict:
    url = f"{API_BASE}{path}"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        body = resp.read().decode("utf-8")
        return json.loads(body) if body else {}


def _post_json_with_retries(path: str, payload: dict, timeout: int = 30, attempts: int = 5) -> dict:
    """POST JSON and retry transient failures/explicit rate limits."""
    for attempt in range(1, attempts + 1):
        try:
            return _post_json(path, payload, timeout=timeout)
        except urllib.error.HTTPError as exc:
            retryable = exc.code in RETRYABLE_STATUS_CODES
            if not retryable or attempt == attempts:
                raise

            retry_after = exc.headers.get("Retry-After")
            try:
                delay = float(retry_after) if retry_after else None
            except ValueError:
