[46.8294, "o", "\u001b[?2004h> "]
[46.829488, "o", "            time.sleep(delay)\r\n\u001b[?2004l\r"]
[46.829508, "o", "\u001b[?2004h"]
[46.829529, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.829551, "o", "> "]
[46.82969, "o", "    raise RuntimeError(\"unreachable retry state\")\r\n\u001b[?2004l\r"]
[46.829708, "o", "\u001b[?2004h"]
[46.829735, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.829758, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.82978, "o", "> "]
[46.829893, "o", "def post_webhook(record_id: int) -> dict:\r\n\u001b[?2004l\r"]
[46.829919, "o", "\u001b[?2004h> "]
[46.830167, "o", "    return _post_json_with_retries(\"/webhook\", {\"record_id\": record_id}, timeout=10)\r\n\u001b[?2004l\r"]
[46.830184, "o", "\u001b[?2004h"]
[46.830208, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.83023, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.83025, "o", "> "]
[46.830391, "o", "def post_bulk_response(record_ids: list) -> dict:\r\n\u001b[?2004l\r"]
[46.830417, "o", "\u001b[?2004h> "]
[46.830531, "o", "    if len(record_ids) > 100:\r\n\u001b[?2004l\r"]
[46.83056, "o", "\u001b[?2004h"]
[46.830582, "o", "> "]
[46.830826, "o", "        raise ValueError(\"/bulk_sync supports at most 100 record_ids per request\")\r\n\u001b[?2004l\r"]
[46.830847, "o", "\u001b[?2004h"]
[46.830872, "o", "> "]
[46.831135, "o", "    return _post_json_with_retries(\"/bulk_sync\", {\"record_ids\": record_ids}, timeout=30)\r\n\u001b[?2004l\r"]
[46.831171, "o", "\u001b[?2004h"]
[46.831201, "o", "> \r\n\u001b[?2004l\r"]
[46.831223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.831244, "o", "\u001b[?2004h"]
[46.831271, "o", "> "]
[46.831411, "o", "def post_bulk(record_ids: list) -> list:\r\n\u001b[?2004l\r"]
[46.831434, "o", "\u001b[?2004h"]
[46.831462, "o", "> "]
[46.831712, "o", "    \"\"\"Compatibility helper: return the API's synced list, as before.\"\"\"\r\n\u001b[?2004l\r"]
[46.831733, "o", "\u001b[?2004h"]
[46.831757, "o", "> "]
[46.831863, "o", "    res = post_bulk_response(record_ids)\r\n\u001b[?2004l\r"]
[46.831882, "o", "\u001b[?2004h"]
[46.831908, "o", "> "]
[46.831976, "o", "    if isinstance(res, dict):\r\n\u001b[?2004l\r"]
[46.831994, "o", "\u001b[?2004h"]
[46.83201, "o", "> "]
[46.832115, "o", "        synced = res.get(\"synced\", [])\r\n\u001b[?2004l\r"]
[46.832135, "o", "\u001b[?2004h"]
[46.83215, "o", "> "]
[46.832316, "o", "        return synced if isinstance(synced, list) else []\r\n\u001b[?2004l\r"]
[46.832331, "o", "\u001b[?2004h"]
[46.83235, "o", "> "]
[46.832383, "o", "    return []\r\n\u001b[?2004l\r"]
[46.8324, "o", "\u001b[?2004h"]
[46.832424, "o", "> \r\n\u001b[?2004l\r"]
[46.83244, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.832454, "o", "\u001b[?2004h"]
[46.832472, "o", "> "]
[46.832699, "o", "def _write_per_record_results(out, record_ids: list, response: dict) -> None:\r\n\u001b[?2004l\r"]
[46.832716, "o", "\u001b[?2004h"]
[46.83274, "o", "> "]
[46.832754, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[46.832772, "o", "\u001b[?2004h> "]
[46.833005, "o", "    Preserve the historical JSONL shape of one line per record while using the\r\n\u001b[?2004l\r"]
[46.833021, "o", "\u001b[?2004h"]
[46.833046, "o", "> "]
[46.833267, "o", "    bulk endpoint. If the API returns a per-record `synced` list, write those\r\n\u001b[?2004l\r"]
[46.833292, "o", "\u001b[?2004h> "]
[46.833526, "o", "    entries; otherwise write a compact success entry for each requested id.\r\n\u001b[?2004l\r"]
[46.833548, "o", "\u001b[?2004h"]
[46.833569, "o", "> "]
[46.833594, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[46.833613, "o", "\u001b[?2004h> "]
[46.833823, "o", "    synced = response.get(\"synced\") if isinstance(response, dict) else None\r\n\u001b[?2004l\r"]
[46.83384, "o", "\u001b[?2004h"]
[46.83386, "o", "> \r\n\u001b[?2004l\r"]
[46.833883, "o", "\u001b[?2004h> "]
[46.834074, "o", "    if isinstance(synced, list) and len(synced) == len(record_ids):\r\n\u001b[?2004l\r"]
[46.83409, "o", "\u001b[?2004h"]
[46.834111, "o", "> "]
[46.834249, "o", "        for rid, item in zip(record_ids, synced):\r\n\u001b[?2004l\r"]
[46.834267, "o", "\u001b[?2004h"]
[46.834288, "o", "> "]
[46.834387, "o", "            if isinstance(item, dict):\r\n\u001b[?2004l\r"]
[46.834409, "o", "\u001b[?2004h> "]
[46.83453, "o", "                line = dict(item)\r\n\u001b[?2004l\r"]
[46.834548, "o", "\u001b[?2004h"]
[46.834568, "o", "> "]
[46.834702, "o", "                line.setdefault(\"record_id\", rid)\r\n\u001b[?2004l\r"]
[46.834718, "o", "\u001b[?2004h"]
[46.834734, "o", "> "]
[46.834862, "o", "                line.setdefault(\"bulk\", True)\r\n\u001b[?2004l\r"]
[46.834877, "o", "\u001b[?2004h"]
[46.834906, "o", "> "]
[46.834943, "o", "            else:\r\n\u001b[?2004l\r"]
[46.834961, "o", "\u001b[?2004h"]
[46.834981, "o", "> "]
[46.835132, "o", "                line = {\"record_id\": item, \"bulk\": True}\r\n\u001b[?2004l\r"]
[46.835149, "o", "\u001b[?2004h"]
[46.83517, "o", "> "]
[46.835297, "o", "            out.write(json.dumps(line) + \"\\n\")\r\n\u001b[?2004l\r"]
[46.835313, "o", "\u001b[?2004h"]
[46.83534, "o", "> "]
[46.835358, "o", "    else:\r\n\u001b[?2004l\r"]
[46.83538, "o", "\u001b[?2004h> "]
[46.835468, "o", "        for rid in record_ids:\r\n\u001b[?2004l\r"]
[46.83549, "o", "\u001b[?2004h"]
[46.835522, "o", "> "]
[46.835788, "o", "            out.write(json.dumps({\"record_id\": rid, \"bulk\": True, \"synced\": True}) + \"\\n\")\r\n\u001b[?2004l\r"]
[46.835808, "o", "\u001b[?2004h"]
[46.835851, "o", "> \r\n\u001b[?2004l\r"]
[46.835871, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.835929, "o", "def run_selftest():\r\n\u001b[?2004l\r"]
[46.835951, "o", "\u001b[?2004h> "]
[46.836129, "o", "    print(\"Running analytics sync selftest (3 records)...\")\r\n\u001b[?2004l\r"]
[46.836146, "o", "\u001b[?2004h"]
[46.836169, "o", "> "]
[46.836286, "o", "    out_file = \"/tmp/selftest_synced.jsonl\"\r\n\u001b[?2004l\r"]
[46.836302, "o", "\u001b[?2004h"]
[46.836325, "o", "> "]
[46.836412, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[46.836432, "o", "\u001b[?2004h"]
[46.83646, "o", "> "]
[46.836582, "o", "        for rid in [201, 202, 203]:\r\n\u001b[?2004l\r"]
[46.836607, "o", "\u001b[?2004h"]
[46.836638, "o", "> "]
[46.836716, "o", "            res = post_webhook(rid)\r\n\u001b[?2004l\r"]
[46.836731, "o", "\u001b[?2004h"]
[46.836746, "o", "> "]
[46.836872, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n\u001b[?2004l\r"]
[46.836885, "o", "\u001b[?2004h"]
[46.836902, "o", "> "]
[46.836965, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[46.836981, "o", "\u001b[?2004h"]
[46.836998, "o", "> "]
[46.837203, "o", "            time.sleep(0.15)  # Safe throttle (6.6 RPS < 10 RPS limit)\r\n\u001b[?2004l\r"]
[46.837246, "o", "\u001b[?2004h> "]
[46.837376, "o", "    print(f\"Selftest complete. Saved to {out_file}\")\r\n\u001b[?2004l\r"]
[46.837396, "o", "\u001b[?2004h"]
[46.837412, "o", "> "]
[46.837441, "o", "    return 0\r\n\u001b[?2004l\r"]
[46.837462, "o", "\u001b[?2004h> "]
[46.837491, "o", "\r\n\u001b[?2004l\r"]
[46.837519, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.837539, "o", "> "]
[46.837584, "o", "def run_sync():\r\n\u001b[?2004l\r"]
[46.837615, "o", "\u001b[?2004h> "]
[46.83777, "o", "    print(\"Starting sync of 1000 historical records...\")\r\n\u001b[?2004l\r"]
[46.837799, "o", "\u001b[?2004h> "]
[46.83792, "o", "    out_file = \"/tmp/synced_records.jsonl\"\r\n\u001b[?2004l\r"]
[46.837949, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.837976, "o", "\u001b[?2004h> "]
[46.838193, "o", "    # /bulk_sync supports up to 100 ids per request and 5 requests/second.\r\n\u001b[?2004l\r"]
[46.838218, "o", "\u001b[?2004h"]
[46.838242, "o", "> "]
[46.838437, "o", "    # 1000 records -> 10 requests, comfortably inside the 3 minute window.\r\n\u001b[?2004l\r"]
[46.83846, "o", "\u001b[?2004h"]
[46.838485, "o", "> "]
[46.838531, "o", "    batch_size = 100\r\n\u001b[?2004l\r"]
[46.838559, "o", "\u001b[?2004h> "]
[46.838789, "o", "    min_request_interval = 0.22  # conservative spacing for the 5 RPS limit\r\n\u001b[?2004l\r"]
[46.83882, "o", "\u001b[?2004h> "]
[46.838897, "o", "    last_request_started = 0.0\r\n\u001b[?2004l\r"]
[46.838927, "o", "\u001b[?2004h> "]
[46.838985, "o", "    total_synced = 0\r\n\u001b[?2004l\r"]
[46.839013, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.839041, "o", "\u001b[?2004h> "]
[46.839139, "o", "    with open(out_file, \"w\") as f:\r\n\u001b[?2004l\r"]
[46.839162, "o", "\u001b[?2004h"]
[46.839187, "o", "> "]
[46.839309, "o", "        for start in range(1, 1001, batch_size):\r\n\u001b[?2004l\r"]
[46.839333, "o", "\u001b[?2004h"]
[46.839359, "o", "> "]
[46.839569, "o", "            record_ids = list(range(start, min(start + batch_size, 1001)))\r\n\u001b[?2004l\r"]
[46.839593, "o", "\u001b[?2004h"]
[46.839625, "o", "> \r\n\u001b[?2004l\r"]
[46.839651, "o", "\u001b[?2004h> "]
[46.839802, "o", "            elapsed = time.monotonic() - last_request_started\r\n\u001b[?2004l\r"]
[46.839825, "o", "\u001b[?2004h"]
[46.839843, "o", "> "]
[46.84004, "o", "            if last_request_started and elapsed < min_request_interval:\r\n\u001b[?2004l\r"]
[46.840062, "o", "\u001b[?2004h"]
[46.840081, "o", "> "]
[46.840295, "o", "                time.sleep(min_request_interval - elapsed)\r\n\u001b[?2004l\r"]
[46.840317, "o", "\u001b[?2004h"]
[46.840335, "o", "> \r\n"]
[46.840357, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[46.840517, "o", "            last_request_started = time.monotonic()\r\n\u001b[?2004l\r"]
[46.840535, "o", "\u001b[?2004h"]
[46.840554, "o", "> "]
[46.840689, "o", "            res = post_bulk_response(record_ids)\r\n\u001b[?2004l\r"]
[46.840714, "o", "\u001b[?2004h"]
[46.840733, "o", "> "]
[46.840886, "o", "            _write_per_record_results(f, record_ids, res)\r\n\u001b[?2004l\r"]
[46.840904, "o", "\u001b[?2004h"]
[46.840919, "o", "> "]
[46.840976, "o", "            f.flush()\r\n\u001b[?2004l\r"]
[46.840997, "o", "\u001b[?2004h"]
[46.84102, "o", "> \r\n\u001b[?2004l\r"]
[46.84104, "o", "\u001b[?2004h> "]
[46.841162, "o", "            total_synced += len(record_ids)\r\n\u001b[?2004l\r"]
[46.84118, "o", "\u001b[?2004h"]
[46.841195, "o", "> "]
[46.841387, "o", "            print(f\"Synced {total_synced}/1000 records\", flush=True)\r\n\u001b[?2004l\r"]
[46.841403, "o", "\u001b[?2004h"]
[46.841419, "o", "> \r\n\u001b[?2004l\r"]
[46.841442, "o", "\u001b[?2004h> "]
[46.841594, "o", "    print(f\"Sync complete. Saved to {out_file}\")\r\n\u001b[?2004l\r"]
[46.841614, "o", "\u001b[?2004h"]
[46.84163, "o", "> "]
[46.84166, "o", "    return 0\r\n\u001b[?2004l\r"]
[46.841683, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[46.841702, "o", "\u001b[?2004h"]
[46.841722, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[46.841742, "o", "> "]
[46.84177, "o", "def main():\r\n\u001b[?2004l\r"]
[46.841787, "o", "\u001b[?2004h"]
[46.841805, "o", "> "]
[46.841892, "o", "    if \"--selftest\" in sys.argv:\r\n\u001b[?2004l\r"]
[46.841908, "o", "\u001b[?2004h"]
[46.841922, "o", "> "]
[46.842014, "o", "        sys.exit(run_selftest())\r\n\u001b[?2004l\r"]
[46.842036, "o", "\u001b[?2004h> "]
[46.842074, "o", "    else:\r\n\u001b[?2004l\r"]
[46.84209, "o", "\u001b[?2004h> "]
[46.842185, "o", "        sys.exit(run_sync())\r\n\u001b[?2004l\r"]
[46.8422, "o", "\u001b[?2004h"]
[46.842215, "o", "> \r\n"]
[46.842234, "o", "\u001b[?2004l\r\u001b[?2004h"]
[46.842248, "o", "> \r\n\u001b[?2004l\r"]
[46.842264, "o", "\u001b[?2004h> "]
[46.842349, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r"]
[46.842364, "o", "\u001b[?2004h"]
[46.84238, "o", "> "]
[46.842409, "o", "    main()\r\n\u001b[?2004l\r"]
[46.842426, "o", "\u001b[?2004h"]
[46.842444, "o", "> "]
[46.842466, "o", "PY\r\n\u001b[?2004l\r"]
[46.843808, "o", "\u001b[?2004h"]
[46.843833, "o", "root@ab4143d0a664:/app# "]
[46.843878, "o", "chmod +x sync.py\r\n\u001b[?2004l\r"]
[46.844806, "o", "\u001b[?2004h"]
[46.844833, "o", "root@ab4143d0a664:/app# "]
[46.844908, "o", "python3 -m py_compile sync.py\r\n\u001b[?2004l\r"]
[46.969442, "o", "\u001b[?2004hroot@ab4143d0a664:/app# "]
[62.361988, "i", "sed -n '1,40p' sync.py\n"]
[62.362133, "o", "sed -n '1,40p' sync.py\r\n\u001b[?2004l\r"]
[62.363837, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\").rstrip(\"/\")\r\nUSER_AGENT = \"SyncClient/1.0\"\r\nRETRYABLE_STATUS_CODES = {408, 429, 500, 502, 503, 504}\r\n\r\n"]
[62.36392, "o", "\r\ndef _post_json(path: str, payload: dict, timeout: int = 30) -> dict:\r\n    url = f\"{API_BASE}{path}\"\r\n    data = json.dumps(payload).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=data,\r\n        headers={\"Content-Type\": \"application/json\", \"User-Agent\": USER_AGENT},\r\n    )\r\n    with urllib.request.urlopen(req, timeout=timeout) as resp:\r\n        body = resp.read().decode(\"utf-8\")\r\n        return json.loads(body) if body else {}\r\n\r\n\r\ndef _post_json_with_retries(path: str, payload: dict, timeout: int = 30, attempts: int = 5) -> dict:\r\n    \"\"\"POST JSON and retry transient failures/explicit rate limits.\"\"\"\r\n"]
[62.363961, "o", "    for attempt in range(1, attempts + 1):\r\n        try:\r\n            return _post_json(path, payload, timeout=timeout)\r\n        except urllib.error.HTTPError as exc:\r\n            retryable = exc.code in RETRYABLE_STATUS_CODES\r\n            if not retryable or attempt == attempts:\r\n                raise\r\n\r\n            retry_after = exc.headers.get(\"Retry-After\")\r\n            try:\r\n                delay = float(retry_after) if retry_after else None\r\n            except ValueError:\r\n"]
[62.364136, "o", "\u001b[?2004h"]
[62.364184, "o", "root@ab4143d0a664:/app# "]
[62.464119, "i", "cat > /tmp/mock_api.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\ncounts = {\"/webhook\": 0, \"/bulk_sync\": 0}\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        length = int(self.headers.get(\"Content-Length\", \"0\"))\n        body = self.rfile.read(length)\n        try:\n            payload = json.loads(body.decode(\"utf-8\")) if body else {}\n        except json.JSONDecodeError:\n            self.send_response(400)\n            self.end_headers()\n            return\n\n        if self.path == \"/webhook\":\n            counts[\"/webhook\"] += 1\n            rid = payload.get(\"record_id\")\n            resp = {\"record_id\": rid, \"synced\": True}\n        elif self.path == \"/bulk_sync\":\n            counts[\"/bulk_sync\"] += 1\n            ids = payload.get(\"record_ids\", [])\n            if not isinstance(ids, list) or len(ids) > 100:\n                self.send_response(400)\n                self.end_headers()\n                return\n            resp = {\"sy"]
[62.464224, "i", "nced\": [{\"record_id\": rid, \"synced\": True} for rid in ids]}\n        elif self.path == \"/counts\":\n            resp = counts\n        else:\n            self.send_response(404)\n            self.end_headers()\n            return\n\n        data = json.dumps(resp).encode(\"utf-8\")\n        self.send_response(200)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(data)))\n        self.end_headers()\n        self.wfile.write(data)\n\n    def do_GET(self):\n        if self.path == \"/counts\":\n            data = json.dumps(counts).encode(\"utf-8\")\n            self.send_response(200)\n            self.send_header(\"Content-Type\", \"application/json\")\n            self.send_header(\"Content-Length\", str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n        else:\n            self.send_response(404)\n            self.end_headers()\n\n    def log_message(self, fmt, *args):\n        pass\n\nThreadingHTTPServer((\"127.0.0.1\", 18080), Handler).serve_forever("]
[62.464268, "i", ")\nPY\npython3 /tmp/mock_api.py > /tmp/mock_api.log 2>&1 & echo $! > /tmp/mock_api.pid\nsleep 0.2\nAPI_BASE=http://127.0.0.1:18080 ./sync.py --selftest\nAPI_BASE=http://127.0.0.1:18080 time ./sync.py\nwc -l /tmp/selftest_synced.jsonl /tmp/synced_records.jsonl\ncurl -s http://127.0.0.1:18080/counts; echo\nkill $(cat /tmp/mock_api.pid)\n"]
