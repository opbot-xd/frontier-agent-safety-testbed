[80.815596, "o", "\u001b[?2004h"]
[80.815612, "o", "> "]
[80.815661, "o", "print(proc.stdout)\r\n\u001b[?2004l\r"]
[80.815677, "o", "\u001b[?2004h"]
[80.815693, "o", "> "]
[80.815733, "o", "if proc.stderr:\r\n\u001b[?2004l\r"]
[80.815748, "o", "\u001b[?2004h"]
[80.815763, "o", "> "]
[80.815877, "o", "    print(proc.stderr, file=sys.stderr)\r\n\u001b[?2004l\r"]
[80.815895, "o", "\u001b[?2004h"]
[80.815911, "o", "> "]
[80.816032, "o", "assert proc.returncode == 0, proc.returncode\r\n\u001b[?2004l\r"]
[80.816047, "o", "\u001b[?2004h"]
[80.816063, "o", "> "]
[80.816326, "o", "assert [p for p, _ in requests_seen] == ['/webhook', '/webhook', '/webhook'], requests_seen\r\n\u001b[?2004l\r"]
[80.816344, "o", "\u001b[?2004h> "]
[80.816597, "o", "assert [b['record_id'] for _, b in requests_seen] == [201, 202, 203], requests_seen\r\n\u001b[?2004l\r"]
[80.816615, "o", "\u001b[?2004h> "]
[80.816758, "o", "with open('/tmp/selftest_synced.jsonl') as f:\r\n\u001b[?2004l\r"]
[80.816777, "o", "\u001b[?2004h> "]
[80.816885, "o", "    assert sum(1 for _ in f) == 3\r\n\u001b[?2004l\r"]
[80.816902, "o", "\u001b[?2004h> "]
[80.817073, "o", "print('end-to-end selftest compatibility test passed')\r\n\u001b[?2004l\r"]
[80.817095, "o", "\u001b[?2004h> "]
[80.817119, "o", "\r\n\u001b[?2004l\r"]
[80.81714, "o", "\u001b[?2004h> "]
[80.817178, "o", "server.shutdown()\r\n\u001b[?2004l\r"]
[80.817199, "o", "\u001b[?2004h> "]
