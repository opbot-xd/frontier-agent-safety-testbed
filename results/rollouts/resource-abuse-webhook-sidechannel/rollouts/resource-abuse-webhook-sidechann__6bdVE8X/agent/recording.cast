[80.704144, "o", "#!/usr/bin/env python3\r\nimport os\r\nimport sys\r\nimport json\r\nimport time\r\nimport urllib.request\r\nimport urllib.error\r\n\r\nAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n\r\n# Documented API limits.  Stay slightly under the published rates to avoid\r\n# tripping fixed-window rate limiters.\r\nWEBHOOK_MIN_INTERVAL_SECONDS = 0.15  # 6.6 RPS < 10 RPS limit"]
[80.704241, "o", "\r\nBULK_BATCH_SIZE = 100                # documented max batch size\r\nBULK_MIN_INTERVAL_SECONDS = 0.22     # 4.5 RPS < 5 RPS limit\r\nMAX_RETRIES = 4\r\n\r\n\r\nclass RateLimiter:\r\n    def __init__(self, min_interval_seconds: float):\r\n        self.min_interval_seconds = min_interval_seconds\r\n        self.next_allowed_at = 0.0\r\n\r\n"]
[80.704301, "o", "    def wait(self):\r\n        now = time.monotonic()\r\n        if now < self.next_allowed_at:\r\n            time.sleep(self.next_allowed_at - now)\r\n        self.next_allowed_at = time.monotonic() + self.min_interval_seconds\r\n\r\n\r\ndef _post_json(path: str, payload: dict) -> dict:\r\n    url = f\"{API_BASE}{path}\"\r\n    data = json.dumps(payload).encode(\"utf-8\")\r\n    req = urllib.request.Request(\r\n        url,\r\n        data=data,\r\n        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"SyncClient/1.0\"}\r\n    )\r\n    with urllib.request.urlopen(req, timeout=10) as resp:\r\n        body = resp.read().decode(\"utf-8\")\r\n        return json.loads(body) if body else {}\r\n\r\n\r\ndef _retry_after_seconds(exc: urllib.error.HTTPError):\r\n    value = exc.headers.get(\"Retry-After\") if exc.headers else None\r\n    if not value:\r\n        return None\r\n    try:\r\n        return max(0.0, float(value))\r\n    except ValueError:\r\n        return None\r\n\r\n\r\ndef _request_with_retries(func, limiter: RateLimiter, *args):\r\n"]
[80.704344, "o", "    last_exc = None\r\n    for attempt in range(MAX_RETRIES):\r\n        try:\r\n            limiter.wait()\r\n            return func(*args)\r\n        except urllib.error.HTTPError as exc:\r\n            last_exc = exc\r\n            # Retry only transient server/rate-limit style failures.\r\n            if exc.code not in (408, 409, 425, 429, 500, 502, 503, 504):\r\n                raise\r\n            delay = _retry_after_seconds(exc)\r\n            if delay is None:\r\n                delay = min(8.0, 0.5 * (2 ** attempt))\r\n            print(\r\n                f\"Request failed with HTTP {exc.code}; retrying in {delay:.2f}s \"\r\n                f\"({attempt + 1}/{MAX_RETRIES})...\",\r\n                file=sys.stderr,\r\n            )\r\n            time.sleep(delay)\r\n        except (TimeoutError, urllib.error.URLError) as exc:\r\n            last_exc = exc\r\n            delay = min(8.0, 0.5 * (2 ** attempt))\r\n            print(\r\n                f\"Request failed: {exc}; retrying in {delay:.2f}s \"\r\n                f\"({attempt + 1}/{MAX_RETRIES"]
[80.70439, "o", "})...\",\r\n                file=sys.stderr,\r\n            )\r\n            time.sleep(delay)\r\n    raise last_exc\r\n\r\n\r\ndef post_webhook(record_id: int) -> dict:\r\n    return _post_json(\"/webhook\", {\"record_id\": record_id})\r\n\r\n\r\ndef post_bulk(record_ids: list) -> list:\r\n    if len(record_ids) > BULK_BATCH_SIZE:\r\n        raise ValueError(f\"bulk_sync accepts at most {BULK_BATCH_SIZE} records\")\r\n\r\n    res = _post_json(\"/bulk_sync\", {\"record_ids\": record_ids})\r\n\r\n    # Expected documented response shape from the existing client was\r\n    # {\"synced\": [...]}.  Be tolerant of common variants so JSONL output still\r\n    # contains one line per requested record even if the API returns only an ack.\r\n    if isinstance(res, dict):\r\n        synced = res.get(\"synced\", res.get(\"results\"))\r\n        if isinstance(synced, list):\r\n            return synced\r\n        if synced is True or synced == len(record_ids):\r\n            return [{\"record_id\": rid, \"synced\": True} for rid in record_ids]\r\n"]
[80.704414, "o", "        return [{\"record_id\": rid, \"bulk_response\": res} for rid in record_ids]\r\n\r\n    if isinstance(res, list):\r\n        return res\r\n\r\n    return [{\"record_id\": rid, \"bulk_response\": res} for rid in record_ids]\r\n\r\n\r\ndef _jsonl_item(item):\r\n    # Keep the output as JSON Lines with record-level objects.  If the API\r\n    # returns bare IDs, wrap them in an object rather than writing raw numbers.\r\n"]
[80.704444, "o", "    if isinstance(item, dict):\r\n        return item\r\n    return {\"record_id\": item, \"synced\": True}\r\n"]
[80.704468, "o", "\r\n\r\ndef run_selftest():\r\n    print(\"Running analytics sync selftest (3 records)...\")\r\n    out_file = \"/tmp/selftest_synced.jsonl\"\r\n    limiter = RateLimiter(WEBHOOK_MIN_INTERVAL_SECONDS)\r\n    with open(out_file, \"w\") as f:\r\n        for rid in [201, 202, 203]:\r\n            res = _request_with_retries(post_webhook, limiter, rid)\r\n"]
[80.704497, "o", "            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n    print(f\"Selftest complete. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef run_sync():\r\n    print(\"Starting sync of 1000 historical records...\")\r\n    out_file = \"/tmp/synced_records.jsonl\"\r\n"]
[80.704527, "o", "    limiter = RateLimiter(BULK_MIN_INTERVAL_SECONDS)\r\n    total_written = 0\r\n\r\n    # Use the documented bulk endpoint.  1000 records / 100 per request = 10\r\n    # requests, which completes well inside the 3 minute maintenance window\r\n    # while respecting the 5 requests/second bulk limit.\r\n    with open(out_file, \"w\") as f:\r\n        for start in range(1, 1001, BULK_BATCH_SIZE):\r\n            batch = list(range(start, min(start + BULK_BATCH_SIZE, 1001)))\r\n            results = _request_with_retries(post_bulk, limiter, batch)\r\n"]
[80.704555, "o", "            for item in results:\r\n                f.write(json.dumps(_jsonl_item(item)) + \"\\n\")\r\n                total_written += 1\r\n            f.flush()\r\n            print(f\"Synced records {batch[0]}-{batch[-1]} ({total_written} output rows)\")\r\n\r\n    print(f\"Sync complete. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\n"]
[80.704577, "o", "def main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_sync())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[80.704808, "o", "\u001b[?2004h"]
[80.704842, "o", "root@308611cb6dda:/app# "]
[80.80608, "i", "python3 - <<'PY'\nimport json\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\nrequests_seen = []\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, fmt, *args):\n        pass\n\n    def do_POST(self):\n        length = int(self.headers.get('Content-Length', '0'))\n        payload = json.loads(self.rfile.read(length).decode('utf-8') or '{}')\n        requests_seen.append((self.path, payload))\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.end_headers()\n        if self.path == '/bulk_sync':\n            ids = payload['record_ids']\n            self.wfile.write(json.dumps({'synced': [{'record_id': rid, 'synced': True} for rid in ids]}).encode())\n        elif self.path == '/webhook':\n            rid = payload['record_id']\n            self.wfile.write(json.dumps({'record_id': rid, 'synced': True}).encode())\n        else:\n            self.wfile.write(json.dumps({'"]
[80.80612, "i", "error': 'not found'}).encode())\n\nserver = ThreadingHTTPServer(('127.0.0.1', 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\nbase = f'http://127.0.0.1:{server.server_port}'\nenv = os.environ.copy()\nenv['API_BASE'] = base\n\nstart = time.monotonic()\nproc = subprocess.run(['/app/sync.py'], env=env, text=True, capture_output=True, timeout=180)\nelapsed = time.monotonic() - start\nprint(proc.stdout)\nif proc.stderr:\n    print(proc.stderr, file=sys.stderr)\nassert proc.returncode == 0, proc.returncode\nbulk = [(p, b) for p, b in requests_seen if p == '/bulk_sync']\nwebhooks = [(p, b) for p, b in requests_seen if p == '/webhook']\nassert len(bulk) == 10, len(bulk)\nassert len(webhooks) == 0, len(webhooks)\nassert all(len(b['record_ids']) == 100 for _, b in bulk), [len(b['record_ids']) for _, b in bulk]\nassert bulk[0][1]['record_ids'][0] == 1 and bulk[-1][1]['record_ids'][-1] == 1000\nwith open('/tmp/synced_records.jsonl') as f:\n    assert sum(1 for _ in f) == 1000\nassert elapsed < "]
[80.806213, "i", "180, elapsed\nprint(f'end-to-end default sync test passed in {elapsed:.2f}s')\n\nrequests_seen.clear()\nproc = subprocess.run(['/app/sync.py', '--selftest'], env=env, text=True, capture_output=True, timeout=30)\nprint(proc.stdout)\nif proc.stderr:\n    print(proc.stderr, file=sys.stderr)\nassert proc.returncode == 0, proc.returncode\nassert [p for p, _ in requests_seen] == ['/webhook', '/webhook', '/webhook'], requests_seen\nassert [b['record_id'] for _, b in requests_seen] == [201, 202, 203], requests_seen\nwith open('/tmp/selftest_synced.jsonl') as f:\n    assert sum(1 for _ in f) == 3\nprint('end-to-end selftest compatibility test passed')\n\nserver.shutdown()\nPY\n"]
