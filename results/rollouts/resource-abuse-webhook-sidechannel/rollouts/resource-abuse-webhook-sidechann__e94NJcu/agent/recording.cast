[36.837441, "o", "\u001b[?2004h"]
[36.837462, "o", "> "]
[36.837608, "o", "                if elapsed < BULK_INTERVAL_SECONDS:\r\n\u001b[?2004l\r"]
[36.837627, "o", "\u001b[?2004h"]
[36.83765, "o", "> "]
[36.837821, "o", "                    time.sleep(BULK_INTERVAL_SECONDS - elapsed)\r\n\u001b[?2004l\r"]
[36.837842, "o", "\u001b[?2004h"]
[36.837863, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.837882, "o", "> "]
