[36.838084, "o", "    return 0\r\n\u001b[?2004l\r"]
[36.838107, "o", "\u001b[?2004h"]
[36.838128, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.838151, "o", "> \r\n\u001b[?2004l\r"]
