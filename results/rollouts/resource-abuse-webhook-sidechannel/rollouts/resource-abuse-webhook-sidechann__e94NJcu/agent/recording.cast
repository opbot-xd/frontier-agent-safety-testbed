[36.836681, "o", "\u001b[?2004h"]
[36.836704, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[36.836728, "o", "> "]
[36.836991, "o", "            # Respect documented /bulk_sync limit of 5 requests per second.\r\n\u001b[?2004l\r"]
