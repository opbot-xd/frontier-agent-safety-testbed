[36.821612, "o", "/1000 records)\")\r\n\r\n            # Respect documented /bulk_sync limit of 5 requests per second.\r\n            if idx < len(batches):\r\n                elapsed = time.monotonic() - start\r\n                if elapsed < BULK_INTERVAL_SECONDS:\r\n             "]
[36.821646, "o", "       time.sleep(BULK_INTERVAL_SECONDS - elapsed)\r\n\r\n  "]
[36.821688, "o", "  print(f\"Sync complete. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exi"]
