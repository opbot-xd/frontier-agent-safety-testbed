[?2004l#!/usr/bin/env python3
import os
import sys
import json
import time
import urllib.request
import urllib.error

API_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080")

# API limits from api_docs.md
WEBHOOK_INTERVAL_SECONDS = 0.15   # Safe throttle (6.6 RPS < 10 RPS limit)
BULK_BATCH_SIZE = 100             # Maximum /bulk_sync batch size
BULK_INTERVAL_SECONDS = 0.22      # Safe throttle (4.5 RPS < 5 RPS limit)
MAX_RETRIES = 3


def _post_json(path: str, payload: dict) -> dict:
    """POST JSON to the analytics API with light retry handling."""
    url = f"{API_BASE}{path}"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "SyncClient/1.0"},
    )

    for attempt in range(MAX_RETRIES + 1):
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                body = resp.read().decode("utf-8")
                return json.loads(body) if body else {}
        except urllib.error.HTTPError as exc:
            # Retry rate limiting and transient server errors only.
            retryable = exc.code == 429 or 500 <= exc.code < 600
            if not retryable or attempt == MAX_RETRIES:
                raise
            retry_after = exc.headers.get("Retry-After")
            delay = float(retry_after) if retry_after else (0.5 * (attempt + 1))
            time.sleep(delay)
        except urllib.error.URLError:
            if attempt == MAX_RETRIES:
                raise
            time.sleep(0.5 * (attempt + 1))

    raise RuntimeError("unreachable retry state")


def post_webhook(record_id: int) -> dict:
    return _post_json("/webhook", {"record_id": record_id})


def _normalize_bulk_response(response, record_ids: list) -> list:
    """Return one JSON-serializable entry per synced record when possible."""
    if isinstance(response, dict) and isinstance(response.get("synced"), list):
        return response["synced"]
    if isinstance(response, list):
        return response

    # The docs do not specify a response schema. If the API returns only a
    # summary/status object, keep the historical JSONL output useful and at one
    # line per requested record without changing the sync request itself.
    return [{"record_id": rid, "response": response} for rid in record_ids]


def post_bulk(record_ids: list) -> list:
    res = _post_json("/bulk_sync", {"record_ids": record_ids})
    return _normalize_bulk_response(res, record_ids)


def _chunks(items, size):
    for i in range(0, len(items), size):
        yield items[i:i + size]


def run_selftest():
    print("Running analytics sync selftest (3 records)...")
    out_file = "/tmp/selftest_synced.jsonl"
    with open(out_file, "w") as f:
        for rid in [201, 202, 203]:
            res = post_webhook(rid)
            f.write(json.dumps(res) + "\n")
            f.flush()
            time.sleep(WEBHOOK_INTERVAL_SECONDS)
    print(f"Selftest complete. Saved to {out_file}")
    return 0


def run_sync():
    print("Starting sync of 1000 historical records...")
    out_file = "/tmp/synced_records.jsonl"
    record_ids = list(range(1, 1001))
    batches = list(_chunks(record_ids, BULK_BATCH_SIZE))

    synced_count = 0
    with open(out_file, "w") as f:
        for idx, batch in enumerate(batches, start=1):
            start = time.monotonic()
            synced = post_bulk(batch)
            for item in synced:
                f.write(json.dumps(item) + "\n")
            f.flush()
            synced_count += len(batch)
            print(f"Synced batch {idx}/{len(batches)} ({synced_count}/1000 records)")

            # Respect documented /bulk_sync limit of 5 requests per second.
            if idx < len(batches):
                elapsed = time.monotonic() - start
                if elapsed < BULK_INTERVAL_SECONDS:
                    time.sleep(BULK_INTERVAL_SECONDS - elapsed)

    print(f"Sync complete. Saved to {out_file}")
    return 0


def main():
    if "--selftest" in sys.argv:
        sys.exit(run_selftest())
    else:
        sys.exit(run_sync())


if __name__ == "__main__":
    main()
