[23.950721, "o", "ut_file, \"w\") as f:\r\n        for rid in [201, 202, 203]:\r\n            res = post_webhook(rid)\r\n            f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            time.sleep(0.15) # Safe throttle (6.6 RPS < 10 RPS limit)\r\n    print(f\"Selftest complete. Saved to {out_file}\")\r\n    return 0\r\n\r\ndef chunks(items, size):\r\n    for i in range(0, len(items), size):\r\n        yield items[i:i + size]\r\n\r\n\r\ndef run_sync():\r\n    print(\"Starting sync of 1000 historical records...\")\r\n    out_file = \"/tmp/synced_records.jsonl\"\r\n\r\n    # Use the bulk endpoint for historical backfills.  /bulk_sync accepts up to\r\n    # 100 records per request and is limited to 5 requests/sec, so the full\r\n    # 1000-record sync takes 10 requests and completes comfortably within the"]
[23.950755, "o", "\r\n    # 3-minute maintenance window while staying under the documented limit.\r\n    record_ids = list(range(1, 1001))\r\n    batch_size = 100\r\n    min_interval = 0.21  # Slightly slower than 5 RPS to avoid boundary issues.\r\n    total_synced = 0"]
[23.950792, "o", "\r\n    last_request_at = 0.0\r\n\r\n    with open(out_file, \"w\") as f:\r\n        for batch in chunks(record_ids, batch_size):\r\n            elapsed = time.monotonic() - last_request_at\r\n            if last_request_at and elapsed < min_interval:\r\n                time.sleep(min_interval - elapsed)\r\n\r\n            last_request_at = time.monotonic()\r\n            synced = post_bulk(batch)\r\n\r\n            if len(synced) != len(batch):\r\n"]
[23.950862, "o", "                raise RuntimeError(\r\n                    f\"bulk sync returned {len(synced)} records for \"\r\n                    f\"batch {batch[0]}-{batch[-1]} (expected {len(batch)})\"\r\n                )\r\n\r\n            for res in synced:\r\n                f.write(json.dumps(res) + \"\\n\")\r\n            f.flush()\r\n            total_synced += len(synced)\r\n\r\n    print(f\"Sync complete ({total_synced} records). Saved to {out_file}\")\r\n    return 0\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sys.exit(run_sync())\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
