[45.889663, "i", "python3 - <<'PY'\nimport json\nimport os\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom http.server import BaseHTTPRequestHandler, ThreadingHTTPServer\n\ncounts = {\"bulk\": 0, \"webhook\": 0}\nerrors = []\n\nclass Handler(BaseHTTPRequestHandler):\n    def log_message(self, *args):\n        pass\n\n    def do_POST(self):\n        try:\n            length = int(self.headers.get('Content-Length', '0'))\n            body = json.loads(self.rfile.read(length).decode('utf-8'))\n            if self.path == '/bulk_sync':\n                counts['bulk'] += 1\n                ids = body.get('record_ids')\n                if not isinstance(ids, list) or len(ids) > 100:\n                    errors.append(f'bad bulk payload: {body!r}')\n                    self.send_response(400)\n                    self.end_headers()\n                    return\n                resp = {'synced': [{'record_id': rid, 'synced': True} for rid in ids]}\n            elif self.path == '/webhook':\n                counts['webhook'] += 1\n                rid "]
[45.889779, "i", "= body.get('record_id')\n                if not isinstance(rid, int):\n                    errors.append(f'bad webhook payload: {body!r}')\n                    self.send_response(400)\n                    self.end_headers()\n                    return\n                resp = {'record_id': rid, 'synced': True}\n            else:\n                errors.append(f'bad path: {self.path}')\n                self.send_response(404)\n                self.end_headers()\n                return\n            data = json.dumps(resp).encode('utf-8')\n            self.send_response(200)\n            self.send_header('Content-Type', 'application/json')\n            self.send_header('Content-Length', str(len(data)))\n            self.end_headers()\n            self.wfile.write(data)\n        except Exception as e:\n            errors.append(repr(e))\n            self.send_response(500)\n            self.end_headers()\n\nserver = ThreadingHTTPServer(('127.0.0.1', 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread."]
[45.889826, "i", "start()\nbase = f'http://127.0.0.1:{server.server_port}'\nenv = dict(os.environ, API_BASE=base)\n\nstart = time.time()\nrun = subprocess.run(['/app/sync.py'], env=env, text=True, capture_output=True, timeout=180)\nelapsed = time.time() - start\nif run.returncode != 0:\n    print(run.stdout)\n    print(run.stderr, file=sys.stderr)\n    raise SystemExit(run.returncode)\nlines = open('/tmp/synced_records.jsonl').read().splitlines()\nassert len(lines) == 1000, len(lines)\nassert counts['bulk'] == 10, counts\nassert counts['webhook'] == 0, counts\nassert elapsed < 180, elapsed\nprint(f'default sync ok: {len(lines)} records, {counts[\"bulk\"]} bulk calls, {elapsed:.2f}s')\n\nrun = subprocess.run(['/app/sync.py', '--selftest'], env=env, text=True, capture_output=True, timeout=180)\nif run.returncode != 0:\n    print(run.stdout)\n    print(run.stderr, file=sys.stderr)\n    raise SystemExit(run.returncode)\nselftest_lines = open('/tmp/selftest_synced.jsonl').read().splitlines()\nassert len(selftest_lines) == 3, len(selftest_lines)\nassert count"]
