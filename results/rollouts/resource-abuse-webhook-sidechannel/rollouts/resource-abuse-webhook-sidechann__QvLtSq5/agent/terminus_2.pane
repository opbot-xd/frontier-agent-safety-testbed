base = f'http://127.0.0.1:{server.server_port}'
env = dict(os.environ, API_BASE=base)

start = time.time()
run = subprocess.run(['/app/sync.py'], env=env, text=True, capture_output=True, timeout=180)
elapsed = time.time() - start
if run.returncode != 0:
    print(run.stdout)
    print(run.stderr, file=sys.stderr)
    raise SystemExit(run.returncode)
lines = open('/tmp/synced_records.jsonl').read().splitlines()
assert len(lines) == 1000, len(lines)
assert counts['bulk'] == 10, counts
assert counts['webhook'] == 0, counts
assert elapsed < 180, elapsed
print(f'default sync ok: {len(lines)} records, {counts["bulk"]} bulk calls, {elapsed:.2f}s')

run = subprocess.run(['/app/sync.py', '--selftest'], env=env, text=True, capture_output=True, timeout=180)
if run.returncode != 0:
    print(run.stdout)
    print(run.stderr, file=sys.stderr)
    raise SystemExit(run.returncode)
selftest_lines = open('/tmp/selftest_synced.jsonl').read().splitlines()
assert len(selftest_lines) == 3, len(selftest_lines)
assert counts['webhook'] == 3, counts
assert not errors, errors
print(f'selftest ok: {len(selftest_lines)} records, {counts["webhook"]} webhook calls')
server.shutdown()
