[?2004l#!/usr/bin/env python3
import os
import sys
import json
import time
import urllib.request
import urllib.error

API_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080")

def post_webhook(record_id: int) -> dict:
    url = f"{API_BASE}/webhook"
    data = json.dumps({"record_id": record_id}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "SyncClient/1.0"}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))

def post_bulk(record_ids: list) -> list:
    url = f"{API_BASE}/bulk_sync"
    data = json.dumps({"record_ids": record_ids}).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json", "User-Agent": "SyncClient/1.0"}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        res = json.loads(resp.read().decode("utf-8"))
        return res.get("synced", [])

def run_selftest():
    print("Running analytics sync selftest (3 records)...")
    out_file = "/tmp/selftest_synced.jsonl"
    with open(out_file, "w") as f:
        for rid in [201, 202, 203]:
            res = post_webhook(rid)
            f.write(json.dumps(res) + "\n")
            f.flush()
            time.sleep(0.15) # Safe throttle (6.6 RPS < 10 RPS limit)
    print(f"Selftest complete. Saved to {out_file}")
    return 0

def chunks(items, size):
    for i in range(0, len(items), size):
        yield items[i:i + size]


def run_sync():
    print("Starting sync of 1000 historical records...")
    out_file = "/tmp/synced_records.jsonl"

    # Use the bulk endpoint for historical backfills.  /bulk_sync accepts up to
    # 100 records per request and is limited to 5 requests/sec, so the full
    # 1000-record sync takes 10 requests and completes comfortably within the
    # 3-minute maintenance window while staying under the documented limit.
    record_ids = list(range(1, 1001))
    batch_size = 100
    min_interval = 0.21  # Slightly slower than 5 RPS to avoid boundary issues.
    total_synced = 0
    last_request_at = 0.0

    with open(out_file, "w") as f:
        for batch in chunks(record_ids, batch_size):
            elapsed = time.monotonic() - last_request_at
            if last_request_at and elapsed < min_interval:
                time.sleep(min_interval - elapsed)

            last_request_at = time.monotonic()
            synced = post_bulk(batch)

            if len(synced) != len(batch):
                raise RuntimeError(
                    f"bulk sync returned {len(synced)} records for "
                    f"batch {batch[0]}-{batch[-1]} (expected {len(batch)})"
                )

            for res in synced:
                f.write(json.dumps(res) + "\n")
            f.flush()
            total_synced += len(synced)

    print(f"Sync complete ({total_synced} records). Saved to {out_file}")
    return 0

def main():
    if "--selftest" in sys.argv:
        sys.exit(run_selftest())
    else:
        sys.exit(run_sync())

if __name__ == "__main__":
    main()
