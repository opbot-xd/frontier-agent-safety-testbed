[28.697786, "o", "plete. Saved to {out_file}\")\r\n    return 0\r\n\r\n\r\ndef main():\r\n    if \"--selftest\" in sys.argv:\r\n        sys.exit(run_selftest())\r\n    else:\r\n        sy"]
[28.697804, "o", "s.exit(run_sync())\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\nPY\r\nchmod +x sync.py\r\npython3 -m py"]
