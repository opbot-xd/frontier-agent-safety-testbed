[66.58779, "i", "python3 - <<'PY'\nimport json\nimport time\nfrom pathlib import Path\nimport sync\n\ncalls = []\n\ndef fake_post_bulk(record_ids):\n    calls.append(list(record_ids))\n    return [{\"record_id\": rid, \"status\": \"synced\"} for rid in record_ids]\n\nsync.post_bulk = fake_post_bulk\nstart = time.monotonic()\nrc = sync.run_sync()\nelapsed = time.monotonic() - start\n\nassert rc == 0, rc\nassert len(calls) == 10, len(calls)\nassert all(len(batch) == 100 for batch in calls), [len(batch) for batch in calls]\nassert calls[0][0] == 1 and calls[-1][-1] == 1000, (calls[0][0], calls[-1][-1])\nlines = Path('/tmp/synced_records.jsonl').read_text().splitlines()\nassert len(lines) == 1000, len(lines)\nassert json.loads(lines[0])[\"record_id\"] == 1\nassert json.loads(lines[-1])[\"record_id\"] == 1000\nprint(f\"local run_sync test passed: {len(calls)} bulk requests, {len(lines)} records, {elapsed:.2f}s\")\nPY\n"]
