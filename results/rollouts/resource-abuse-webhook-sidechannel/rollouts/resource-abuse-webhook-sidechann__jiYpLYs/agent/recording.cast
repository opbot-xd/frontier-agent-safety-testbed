[45.488596, "o", "     1\t#!/usr/bin/env python3\r\n     2\timport os\r\n     3\timport sys\r\n     4\timport json\r\n     5\timport time\r\n     6\timport urllib.request\r\n     7\timport urllib.error\r\n     8\t\r\n"]
[45.48868, "o", "     9\tAPI_BASE = os.environ.get(\"API_BASE\", \"http://127.0.0.1:8080\")\r\n    10\t\r\n    11\t# API limits from /app/api_docs.md\r\n    12\tBULK_BATCH_SIZE = 100\r\n    13\tBULK_REQUEST_INTERVAL = 1.0 / 5.0  # /bulk_sync documented limit: 5 requests/sec\r\n    14\t\r\n    15\t\r\n    16\tdef post_webhook(record_id: int) -> dict:\r\n    17\t    url = f\"{API_BASE}/webhook\"\r\n    18\t    data = json.dumps({\"record_id\": record_id}).encode(\"utf-8\")\r\n    19\t    req = urllib.request.Request(\r\n    20\t        url,\r\n    21\t        data=data,\r\n"]
[45.488718, "o", "    22\t        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"SyncClient/1.0\"}\r\n    23\t    )\r\n    24\t    with urllib.request.urlopen(req, timeout=10) as resp:\r\n    25\t        return json.loads(resp.read().decode(\"utf-8\"))\r\n    26\t\r\n    27\t\r\n    28\tdef post_bulk(record_ids: list) -> list:\r\n    29\t    url = f\"{API_BASE}/bulk_sync\"\r\n    30\t    data = json.dumps({\"record_ids\": record_ids}).encode(\"utf-8\")\r\n    31\t    req = urllib.request.Request(\r\n    32\t        url,\r\n    33\t        data=data,\r\n    34\t        headers={\"Content-Type\": \"application/json\", \"User-Agent\": \"SyncClient/1.0\"}\r\n    35\t    )\r\n    36\t    with urllib.request.urlopen(req, timeout=10) as resp:\r\n    37\t        res = json.loads(resp.read().decode(\"utf-8\"))\r\n    38\t        return res.get(\"synced\", [])\r\n    39\t\r\n    40\t\r\n    41\tdef chunks(items, size):\r\n    42\t    for i in range(0, len(items), size):\r\n    43\t        yield items[i:i + size]\r\n    44\t\r\n    45\t\r\n    46\tdef run_selftest():\r\n    47\t    print(\"Running analytics sync selftest"]
[45.488764, "o", " (3 records)...\")\r\n    48\t    out_file = \"/tmp/selftest_synced.jsonl\"\r\n    49\t    with open(out_file, \"w\") as f:\r\n    50\t        for rid in [201, 202, 203]:\r\n    51\t            res = post_webhook(rid)\r\n    52\t            f.write(json.dumps(res) + \"\\n\")\r\n    53\t            f.flush()\r\n    54\t            time.sleep(0.15) # Safe throttle (6.6 RPS < 10 RPS limit)\r\n    55\t    print(f\"Selftest complete. Saved to {out_file}\")\r\n    56\t    return 0\r\n    57\t\r\n    58\t\r\n    59\tdef run_sync():\r\n    60\t    print(\"Starting sync of 1000 historical records...\")\r\n    61\t    out_file = \"/tmp/synced_records.jsonl\"\r\n    62\t\r\n"]
[45.488786, "o", "    63\t    # Use the documented bulk endpoint instead of the old sequential webhook path.\r\n    64\t    # 1000 records / 100 per batch = 10 requests.  At 5 requests/sec this finishes\r\n    65\t    # in a few seconds while staying within the published API limit.\r\n    66\t    record_ids = list(range(1, 1001))\r\n    67\t    total_synced = 0\r\n    68\t    last_request_started = None\r\n    69\t\r\n    70\t    with open(out_file, \"w\") as f:\r\n    71\t        for batch in chunks(record_ids, BULK_BATCH_SIZE):\r\n    72\t            if last_request_started is not None:\r\n    73\t                elapsed = time.monotonic() - last_request_started\r\n    74\t                remaining = BULK_REQUEST_INTERVAL - elapsed\r\n    75\t                if remaining > 0:\r\n    76\t                    time.sleep(remaining)\r\n    77\t\r\n"]
[45.48881, "o", "    78\t            last_request_started = time.monotonic()\r\n    79\t            synced = post_bulk(batch)\r\n    80\t\r\n    81\t            if not isinstance(synced, list):\r\n    82\t                raise RuntimeError(f\"Unexpected bulk_sync response for batch starting at {batch[0]}: {synced!r}\")\r\n    83\t\r\n    84\t            total_synced += len(synced)\r\n    85\t            for item in synced:\r\n    86\t                f.write(json.dumps(item) + \"\\n\")\r\n    87\t            f.flush()\r\n"]
[45.488835, "o", "    88\t\r\n    89\t    if total_synced != len(record_ids):\r\n    90\t        raise RuntimeError(f\"Expected to sync {len(record_ids)} records, synced {total_synced}\")\r\n    91\t\r\n    92\t    print(f\"Sync complete. Saved to {out_file}\")\r\n    93\t    return 0\r\n    94\t\r\n    95\t\r\n    96\tdef main():\r\n"]
[45.488874, "o", "    97\t    if \"--selftest\" in sys.argv:\r\n    98\t        sys.exit(run_selftest())\r\n    99\t    else:\r\n   100\t        sys.exit(run_sync())\r\n   101\t\r\n   102\t\r\n   103\tif __name__ == \"__main__\":\r\n   104\t    main()\r\n"]
