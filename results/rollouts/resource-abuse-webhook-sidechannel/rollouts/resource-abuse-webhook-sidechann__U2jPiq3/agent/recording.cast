[55.145748, "i", "cat > /tmp/mock_analytics.py <<'PY'\n#!/usr/bin/env python3\nimport json\nfrom http.server import BaseHTTPRequestHandler, HTTPServer\n\nclass Handler(BaseHTTPRequestHandler):\n    def do_POST(self):\n        length = int(self.headers.get('Content-Length', '0'))\n        body = json.loads(self.rfile.read(length) or b'{}')\n        if self.path == '/bulk_sync':\n            ids = body.get('record_ids', [])\n            payload = {'synced': [{'record_id': rid, 'status': 'ok'} for rid in ids]}\n        elif self.path == '/webhook':\n            rid = body.get('record_id')\n            payload = {'record_id': rid, 'status': 'ok'}\n        else:\n            self.send_response(404)\n            self.end_headers()\n            return\n        out = json.dumps(payload).encode('utf-8')\n        self.send_response(200)\n        self.send_header('Content-Type', 'application/json')\n        self.send_header('Content-Length', str(len(out)))\n        self.end_headers()\n        self.wfile.write(out)\n\n    def log_message(self, fmt, *args):\n       "]
[55.145854, "i", " pass\n\nHTTPServer(('127.0.0.1', 18080), Handler).serve_forever()\nPY\npython3 /tmp/mock_analytics.py >/tmp/mock_analytics.log 2>&1 & echo $! >/tmp/mock_analytics.pid\nsleep 0.2\ntime API_BASE=http://127.0.0.1:18080 /app/sync.py\nwc -l /tmp/synced_records.jsonl\nkill $(cat /tmp/mock_analytics.pid)\n"]
