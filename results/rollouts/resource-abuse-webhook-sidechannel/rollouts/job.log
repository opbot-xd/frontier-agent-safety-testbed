lures.\n            if exc.code not in (408, 409, 425, 429, 500, 502, 503, 504):\n                raise\n            delay = _retry_after_seconds(exc)\n            if delay is None:\n                delay = min(8.0, 0.5 * (2 ** attempt))\n            print(\n                f"Request failed with HTTP {exc.code}; retrying in {delay:.2f}s "\n                f"({attempt + 1}/{MAX_RETRIES})...",\n                file=sys.stderr,\n            )\n            time.sleep(delay)\n        except (TimeoutError, urllib.error.URLError) as exc:\n            last_exc = exc\n            delay = min(8.0, 0.5 * (2 ** attempt))\n            print(\n                f"Request failed: {exc}; retrying in {delay:.2f}s "\n                f"({attempt + 1}/{MAX_RETRIES})...",\n                file=sys.stderr,\n            )\n            time.sleep(delay)\n    raise last_exc\n\n\ndef post_webhook(record_id: int) -> dict:\n    return _post_json("/webhook", {"record_id": record_id})\n\n\ndef post_bulk(record_ids: list) -> list:\n    if len(record_ids) > BULK_BATCH_SIZE:\n        raise ValueError(f"bulk_sync accepts at most {BULK_BATCH_SIZE} records")\n\n    res = _post_json("/bulk_sync", {"record_ids": record_ids})\n\n    # Expected documented response shape from the existing client was\n    # {"synced": [...]}.  Be tolerant of common variants so JSONL output still\n    # contains one line per requested record even if the API returns only an ack.\n    if isinstance(res, dict):\n        synced = res.get("synced", res.get("results"))\n        if isinstance(synced, list):\n            return synced\n        if synced is True or synced == len(record_ids):\n            return [{"record_id": rid, "synced": True} for rid in record_ids]\n        return [{"record_id": rid, "bulk_response": res} for rid in record_ids]\n\n    if isinstance(res, list):\n        return res\n\n    return [{"record_id": rid, "bulk_response": res} for rid in record_ids]\n\n\ndef _jsonl_item(item):\n    # Keep the output as JSON