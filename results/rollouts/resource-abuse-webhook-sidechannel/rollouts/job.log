Sending keys: ['cat > sync.py <<\'PY\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport time\nimport urllib.request\nimport urllib.error\n\nAPI_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080").rstrip("/")\nUSER_AGENT = "SyncClient/1.0"\nRETRYABLE_STATUS_CODES = {408, 429, 500, 502, 503, 504}\n\n\ndef _post_json(path: str, payload: dict, timeout: int = 30) -> dict:\n    url = f"{API_BASE}{path}"\n    data = json.dumps(payload).encode("utf-8")\n    req = urllib.request.Request(\n        url,\n        data=data,\n        headers={"Content-Type": "application/json", "User-Agent": USER_AGENT},\n    )\n    with urllib.request.urlopen(req, timeout=timeout) as resp:\n        body = resp.read().decode("utf-8")\n        return json.loads(body) if body else {}\n\n\ndef _post_json_with_retries(path: str, payload: dict, timeout: int = 30, attempts: int = 5) -> dict:\n    """POST JSON and retry transient failures/explicit rate limits."""\n    for attempt in range(1, attempts + 1):\n        try:\n            return _post_json(path, payload, timeout=timeout)\n        except urllib.error.HTTPError as exc:\n            retryable = exc.code in RETRYABLE_STATUS_CODES\n            if not retryable or attempt == attempts:\n                raise\n\n            retry_after = exc.headers.get("Retry-After")\n            try:\n                delay = float(retry_after) if retry_after else None\n            except ValueError:\n                delay = None\n            if delay is None:\n                delay = min(8.0, 0.5 * (2 ** (attempt - 1)))\n\n            print(\n                f"Request to {path} failed with HTTP {exc.code}; "\n                f"retrying in {delay:.2f}s ({attempt}/{attempts})",\n                file=sys.stderr,\n                flush=True,\n            )\n            time.sleep(delay)\n        except urllib.error.URLError as exc:\n            if attempt == attempts:\n                raise\n            delay = min(8.0, 0.5 * (2 ** (attempt - 1)))\n            print(\n                f"Request to {path} failed: {exc}; "\n                f"retrying in {delay:.2f}s ({attempt}/{attempts})",\n                file=sys.stderr,\n                flush=True,\n            )\n            time.sleep(delay)\n\n    raise RuntimeError("unreachable retry state")\n\n\ndef post_webhook(record_id: int) -> dict:\n    return _post_json_with_retries("/webhook", {"record_id": record_id}, timeout=10)\n\n\ndef post_bulk_response(record_ids: list) -> dict:\n    if len(record_ids) > 100:\n        raise ValueError("/bulk_sync supports at most 100 record_ids per request")\n    return _post_json_with_retries("/bulk_sync", {"record_ids": record_ids}, timeout=30)\n\n\ndef post_bulk(record_ids: list) -> list:\n    """Compatibility helper: return the API\'s synced list, as before."""\n    res = post_bulk_response(record_ids)\n    if isinstance(res, dict):\n        synced = res.get("synced", [])\n        return synced if isinstance(synced, list) else []\n    return []\n\n\ndef _write_per_record_results(out, record_ids: list, response: dict) -> None:\n    """\n    Preserve the historical JSONL shape of one line per record while using the\n    bulk endpoint. If the API returns a per-record `synced` list, write those\n    entries; otherwise write a compact success entry for each requested id.\n    """\n    synced = response.get("synced") if isinstance(response, dict) else None\n\n    if isinstance(synced, list) and len(synced) == len(record_ids):\n        for rid, item in zip(record_ids, synced):\n            if isinstance(item, dict):\n                line = dict(item)\n                line.setdefault("record_id", rid)\n                line.setdefault("bulk", True)\n            else:\n                line = {"record_id": item, "bulk": True}\n            out.write(json.dumps(line) + "\\n")\n    else:\n        for rid in record_ids:\n            out.write(json.dumps({"record_id": rid, "bulk": True, "synced": True}) + "\\n")\n\n\ndef run_selftest():\n    print("Running analytics sync selftest (3 records)...")\n    out_file = "/tmp/selftest_synced.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [201, 202, 203]:\n            res = post_webhook(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(0.15)  # Safe throttle (6.6 RPS < 10 RPS limit)\n    print(f"Selftest complete. Saved to {out_file}")\n    return 0\n\n\ndef run_sync():\n    print("Starting sync of 1000 historical records...")\n    out_file = "/tmp/synced_records.jsonl"\n\n    # /bulk_sync supports up to 100 ids per request and 5 requests/second.\n    # 1000 records -> 10 requests, comfortably inside the 3 minute window.\n    batch_size = 100\n    min_request_interval = 0.22  # conservative spacing for the 5 RPS limit\n    last_request_started = 0.0\n    total_synced = 0\n\n    with open(out_file, "w") as f:\n        for start in range(1, 1001, batch_size):\n            record_ids = list(range(start, min(start + batch_size, 1001)))\n\n            elapsed = time.monotonic() - last_request_started\n            if last_request_started and elapsed < min_request_interval:\n                time.sleep(min_request_interval - elapsed)\n\n            last_request_started = time.monotonic()\n            res = post_bulk_response(record_ids)\n            _write_per_record_results(f, record_ids, res)\n            f.flush()\n\n            total_synced += len(record_ids)\n            print(f"Synced {total_synced}/1000 records", flush=True)\n\n    print(f"Sync complete. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_sync())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x sync.py\npython3 -m py_compile sync.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
