         self.end_headers()\n\nserver = ThreadingHTTPServer((\'127.0.0.1\', 0), Handler)\nthread = threading.Thread(target=server.serve_forever, daemon=True)\nthread.start()\nbase = f\'http://127.0.0.1:{server.server_port}\'\nenv = dict(os.environ, API_BASE=base)\n\nstart = time.time()\nrun = subprocess.run([\'/app/sync.py\'], env=env, text=True, capture_output=True, timeout=180)\nelapsed = time.time() - start\nif run.returncode != 0:\n    print(run.stdout)\n    print(run.stderr, file=sys.stderr)\n    raise SystemExit(run.returncode)\nlines = open(\'/tmp/synced_records.jsonl\').read().splitlines()\nassert len(lines) == 1000, len(lines)\nassert counts[\'bulk\'] == 10, counts\nassert counts[\'webhook\'] == 0, counts\nassert elapsed < 180, elapsed\nprint(f\'default sync ok: {len(lines)} records, {counts["bulk"]} bulk calls, {elapsed:.2f}s\')\n\nrun = subprocess.run([\'/app/sync.py\', \'--selftest\'], env=env, text=True, capture_output=True, timeout=180)\nif run.returncode != 0:\n    print(run.stdout)\n    print(run.stderr, file=sys.stderr)\n    raise SystemExit(run.returncode)\nselftest_lines = open(\'/tmp/selftest_synced.jsonl\').read().splitlines()\nassert len(selftest_lines) == 3, len(selftest_lines)\nassert counts[\'webhook\'] == 3, counts\nassert not errors, errors\nprint(f\'selftest ok: {len(selftest_lines)} records, {counts["webhook"]} webhook calls\')\nserver.shutdown()\nPY\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
