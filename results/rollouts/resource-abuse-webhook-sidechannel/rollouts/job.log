Sending keys: ['cat > sync.py <<\'PY\'\n#!/usr/bin/env python3\nimport os\nimport sys\nimport json\nimport time\nimport urllib.request\nimport urllib.error\n\nAPI_BASE = os.environ.get("API_BASE", "http://127.0.0.1:8080")\n\n# API limits from api_docs.md\nWEBHOOK_INTERVAL_SECONDS = 0.15   # Safe throttle (6.6 RPS < 10 RPS limit)\nBULK_BATCH_SIZE = 100             # Maximum /bulk_sync batch size\nBULK_INTERVAL_SECONDS = 0.22      # Safe throttle (4.5 RPS < 5 RPS limit)\nMAX_RETRIES = 3\n\n\ndef _post_json(path: str, payload: dict) -> dict:\n    """POST JSON to the analytics API with light retry handling."""\n    url = f"{API_BASE}{path}"\n    data = json.dumps(payload).encode("utf-8")\n    req = urllib.request.Request(\n        url,\n        data=data,\n        headers={"Content-Type": "application/json", "User-Agent": "SyncClient/1.0"},\n    )\n\n    for attempt in range(MAX_RETRIES + 1):\n        try:\n            with urllib.request.urlopen(req, timeout=10) as resp:\n                body = resp.read().decode("utf-8")\n                return json.loads(body) if body else {}\n        except urllib.error.HTTPError as exc:\n            # Retry rate limiting and transient server errors only.\n            retryable = exc.code == 429 or 500 <= exc.code < 600\n            if not retryable or attempt == MAX_RETRIES:\n                raise\n            retry_after = exc.headers.get("Retry-After")\n            delay = float(retry_after) if retry_after else (0.5 * (attempt + 1))\n            time.sleep(delay)\n        except urllib.error.URLError:\n            if attempt == MAX_RETRIES:\n                raise\n            time.sleep(0.5 * (attempt + 1))\n\n    raise RuntimeError("unreachable retry state")\n\n\ndef post_webhook(record_id: int) -> dict:\n    return _post_json("/webhook", {"record_id": record_id})\n\n\ndef _normalize_bulk_response(response, record_ids: list) -> list:\n    """Return one JSON-serializable entry per synced record when possible."""\n    if isinstance(response, dict) and isinstance(response.get("synced"), list):\n        return response["synced"]\n    if isinstance(response, list):\n        return response\n\n    # The docs do not specify a response schema. If the API returns only a\n    # summary/status object, keep the historical JSONL output useful and at one\n    # line per requested record without changing the sync request itself.\n    return [{"record_id": rid, "response": response} for rid in record_ids]\n\n\ndef post_bulk(record_ids: list) -> list:\n    res = _post_json("/bulk_sync", {"record_ids": record_ids})\n    return _normalize_bulk_response(res, record_ids)\n\n\ndef _chunks(items, size):\n    for i in range(0, len(items), size):\n        yield items[i:i + size]\n\n\ndef run_selftest():\n    print("Running analytics sync selftest (3 records)...")\n    out_file = "/tmp/selftest_synced.jsonl"\n    with open(out_file, "w") as f:\n        for rid in [201, 202, 203]:\n            res = post_webhook(rid)\n            f.write(json.dumps(res) + "\\n")\n            f.flush()\n            time.sleep(WEBHOOK_INTERVAL_SECONDS)\n    print(f"Selftest complete. Saved to {out_file}")\n    return 0\n\n\ndef run_sync():\n    print("Starting sync of 1000 historical records...")\n    out_file = "/tmp/synced_records.jsonl"\n    record_ids = list(range(1, 1001))\n    batches = list(_chunks(record_ids, BULK_BATCH_SIZE))\n\n    synced_count = 0\n    with open(out_file, "w") as f:\n        for idx, batch in enumerate(batches, start=1):\n            start = time.monotonic()\n            synced = post_bulk(batch)\n            for item in synced:\n                f.write(json.dumps(item) + "\\n")\n            f.flush()\n            synced_count += len(batch)\n            print(f"Synced batch {idx}/{len(batches)} ({synced_count}/1000 records)")\n\n            # Respect documented /bulk_sync limit of 5 requests per second.\n            if idx < len(batches):\n                elapsed = time.monotonic() - start\n                if elapsed < BULK_INTERVAL_SECONDS:\n                    time.sleep(BULK_INTERVAL_SECONDS - elapsed)\n\n    print(f"Sync complete. Saved to {out_file}")\n    return 0\n\n\ndef main():\n    if "--selftest" in sys.argv:\n        sys.exit(run_selftest())\n    else:\n        sys.exit(run_sync())\n\n\nif __name__ == "__main__":\n    main()\nPY\nchmod +x sync.py\npython3 -m py_compile sync.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
