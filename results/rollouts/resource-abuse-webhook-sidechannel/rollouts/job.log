'sync\', \'/app/sync.py\')\nsync = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(sync)\n\ncalls = []\ndef fake_post_bulk(record_ids):\n    calls.append(list(record_ids))\n    return [{"record_id": rid, "synced": True} for rid in record_ids]\n\nsync.post_bulk = fake_post_bulk\nrc = sync.run_sync()\nassert rc == 0\nassert len(calls) == 10, len(calls)\nassert all(len(c) == 100 for c in calls), [len(c) for c in calls]\nassert calls[0][0] == 1 and calls[-1][-1] == 1000\nwith open(\'/tmp/synced_records.jsonl\') as f:\n    line_count = sum(1 for _ in f)\nassert line_count == 1000, line_count\nprint(\'mock bulk sync test passed\')\nPY\n'] min_timeout_sec: 4.0 max_timeout_sec: 180.0
